<html lang="pt-BR">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Busca de Endereço</title>
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    body {
      min-height: 100vh;
      background: linear-gradient(135deg, #1a73e8 0%, #0d47a1 100%);
      display: flex;
      align-items: center;
      justify-content: center;
      font-family: 'Segoe UI', Roboto, Arial, sans-serif;
      padding: 24px;
    }

    .card {
      background: #fff;
      border-radius: 24px;
      padding: 36px 32px 32px;
      width: 100%;
      max-width: 560px;
      box-shadow: 0 12px 48px rgba(0,0,0,.22);
    }

    .header {
      display: flex;
      align-items: center;
      gap: 12px;
      margin-bottom: 24px;
    }
    .pin-icon {
      width: 40px; height: 40px;
      background: #1a73e8;
      border-radius: 50%;
      display: flex; align-items: center; justify-content: center;
      flex-shrink: 0;
    }
    .pin-icon svg { width: 22px; height: 22px; fill: #fff; }
    .header h1 { font-size: 20px; font-weight: 700; color: #202124; }
    .header p  { font-size: 13px; color: #5f6368; margin-top: 2px; }

    /* ── Campo de busca ── */
    .search-wrap {
      position: relative;
      width: 100%;
    }

    .search-icon {
      position: absolute;
      left: 14px;
      top: 50%;
      transform: translateY(-50%);
      color: #5f6368;
      pointer-events: none;
      z-index: 2;
      line-height: 0;
    }

    #search-input {
      width: 100%;
      height: 52px;
      padding: 0 42px 0 46px;
      border: 2px solid #e8eaed;
      border-radius: 14px;
      font-size: 15px;
      color: #202124;
      background: #fff;
      outline: none;
      font-family: inherit;
      transition: border-color .2s, box-shadow .2s;
    }
    #search-input::placeholder { color: #9aa0a6; }
    #search-input:focus {
      border-color: #1a73e8;
      box-shadow: 0 0 0 3px rgba(26,115,232,.15);
    }

    /* Botão limpar */
    #clear-btn {
      position: absolute;
      right: 12px;
      top: 50%;
      transform: translateY(-50%);
      background: none;
      border: none;
      cursor: pointer;
      color: #9aa0a6;
      padding: 4px;
      border-radius: 50%;
      display: none;
      line-height: 0;
    }
    #clear-btn:hover { color: #5f6368; background: #f1f3f4; }

    /* ── Dropdown de sugestões ── */
    #suggestions {
      position: absolute;
      top: calc(100% + 6px);
      left: 0; right: 0;
      background: #fff;
      border: 1px solid #e8eaed;
      border-radius: 14px;
      box-shadow: 0 8px 28px rgba(0,0,0,.14);
      overflow: hidden;
      z-index: 100;
      display: none;
    }

    .suggestion-item {
      display: flex;
      align-items: flex-start;
      gap: 12px;
      padding: 12px 16px;
      cursor: pointer;
      border-bottom: 1px solid #f1f3f4;
      transition: background .12s;
    }
    .suggestion-item:last-child { border-bottom: none; }
    .suggestion-item:hover, .suggestion-item.active { background: #f0f7ff; }

    .sug-icon {
      width: 34px; height: 34px;
      background: #e8f0fe;
      border-radius: 50%;
      display: flex; align-items: center; justify-content: center;
      flex-shrink: 0;
      margin-top: 1px;
    }
    .sug-icon svg { width: 16px; height: 16px; fill: #1a73e8; }

    .sug-text { flex: 1; min-width: 0; }
    .sug-name {
      font-size: 14px;
      font-weight: 600;
      color: #202124;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }
    .sug-name mark {
      background: none;
      color: #1a73e8;
      font-weight: 700;
    }
    .sug-addr {
      font-size: 12px;
      color: #5f6368;
      margin-top: 2px;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }
    .sug-type {
      font-size: 10px;
      color: #80868b;
      margin-top: 3px;
      text-transform: capitalize;
    }

    .sug-no-results {
      padding: 16px;
      text-align: center;
      font-size: 14px;
      color: #5f6368;
    }

    /* ── Card de resultado ── */
    .result-card {
      display: none;
      margin-top: 18px;
      background: #f8f9fa;
      border: 1px solid #e8eaed;
      border-radius: 14px;
      padding: 16px 18px;
      animation: slideIn .2s ease;
    }
    .result-card.show { display: block; }

    @keyframes slideIn {
      from { opacity: 0; transform: translateY(8px); }
      to   { opacity: 1; transform: translateY(0); }
    }

    .result-badge {
      display: inline-flex;
      align-items: center;
      gap: 4px;
      font-size: 10px;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: .8px;
      color: #1a73e8;
      background: #e8f0fe;
      padding: 3px 9px;
      border-radius: 20px;
      margin-bottom: 10px;
    }

    .result-name    { font-size: 17px; font-weight: 700; color: #202124; margin-bottom: 4px; }
    .result-address { font-size: 13px; color: #5f6368; line-height: 1.5; margin-bottom: 4px; }
    .result-category{ font-size: 11px; color: #80868b; text-transform: capitalize; margin-bottom: 10px; }

    .result-coords {
      font-size: 12px;
      color: #80868b;
      font-family: 'Courier New', monospace;
      padding-top: 10px;
      border-top: 1px solid #e8eaed;
    }

    .result-actions {
      display: flex;
      gap: 8px;
      margin-top: 14px;
    }
    .btn {
      flex: 1;
      padding: 11px 0;
      border: none;
      border-radius: 10px;
      font-size: 13px;
      font-weight: 600;
      cursor: pointer;
      font-family: inherit;
      transition: background .15s, transform .1s;
    }
    .btn:active { transform: scale(.97); }
    .btn-primary   { background: #1a73e8; color: #fff; }
    .btn-primary:hover { background: #1557b0; }
    .btn-secondary { background: #e8f0fe; color: #1a73e8; }
    .btn-secondary:hover { background: #d2e3fc; }

    .footer {
      margin-top: 20px;
      text-align: center;
      font-size: 12px;
      color: #80868b;
      line-height: 1.7;
    }
    .footer a { color: #1a73e8; text-decoration: none; }
    .badge-free {
      display: inline-block;
      background: #e6f4ea;
      color: #1e8e3e;
      font-size: 10px;
      font-weight: 700;
      padding: 2px 7px;
      border-radius: 20px;
      margin-left: 4px;
    }
  </style>
</head>
<body>

<div class="card">

  <div class="header">
    <div class="pin-icon">
      <svg viewBox="0 0 24 24"><path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5S10.62 6.5 12 6.5s2.5 1.12 2.5 2.5S13.38 11.5 12 11.5z"/></svg>
    </div>
    <div>
      <h1>Para onde vamos?</h1>
      <p>Empresas, endereços, pontos turísticos e muito mais</p>
    </div>
  </div>

  <!-- Campo de busca -->
  <div class="search-wrap" id="search-wrap">
    <span class="search-icon">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
        <path d="M15.5 14h-.79l-.28-.27A6.471 6.471 0 0 0 16 9.5 6.5 6.5 0 1 0 9.5 16c1.61 0 3.09-.59 4.23-1.57l.27.28v.79l5 4.99L20.49 19l-4.99-5zm-6 0C7.01 14 5 11.99 5 9.5S7.01 5 9.5 5 14 7.01 14 9.5 11.99 14 9.5 14z"/>
      </svg>
    </span>

    <input
      id="search-input"
      type="text"
      autocomplete="off"
      spellcheck="false"
      placeholder="Buscar empresa, endereço, lugar..."
    />

    <button id="clear-btn" title="Limpar">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
        <path d="M19 6.41L17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12z"/>
      </svg>
    </button>

    <div id="suggestions"></div>
  </div>

  <!-- Resultado selecionado -->
  <div class="result-card" id="result-card">
    <div class="result-badge">📍 Local selecionado</div>
    <div class="result-name"     id="result-name"></div>
    <div class="result-address"  id="result-address"></div>
    <div class="result-category" id="result-category"></div>
    <div class="result-coords"   id="result-coords"></div>
    <div class="result-actions">
      <button class="btn btn-primary"   id="btn-maps">🗺️ Ver no Maps</button>
      <button class="btn btn-secondary" id="btn-copy">📋 Copiar endereço</button>
    </div>
  </div>

  <div class="footer">
    Powered by <a href="https://www.geoapify.com" target="_blank">Geoapify</a>
    &amp; <a href="https://www.openstreetmap.org" target="_blank">OpenStreetMap</a>
    <span class="badge-free">Grátis</span><br>
    3.000 buscas/dia · Sem cartão de crédito
  </div>

  <!-- Painel de debug -->
  <div id="debug-panel" style="
    margin-top: 20px;
    background: #1e1e1e;
    color: #d4d4d4;
    border-radius: 10px;
    padding: 14px 16px;
    font-family: 'Courier New', monospace;
    font-size: 12px;
    line-height: 1.6;
    max-height: 260px;
    overflow-y: auto;
    display: none;
  ">
    <div style="color:#6a9955; margin-bottom:6px; font-weight:700;">🐛 DEBUG</div>
    <div id="debug-log"></div>
  </div>

</div>

<script>
  const API_KEY = 'c1f11cf6a39741e09027462a1dabebe5';
  const API_URL = 'https://api.geoapify.com/v1/geocode/autocomplete';

  const input       = document.getElementById('search-input');
  const clearBtn    = document.getElementById('clear-btn');
  const sugBox      = document.getElementById('suggestions');
  const resultCard  = document.getElementById('result-card');
  const debugPanel  = document.getElementById('debug-panel');
  const debugLog    = document.getElementById('debug-log');

  let debounceTimer = null;
  let activeIndex   = -1;
  let currentItems  = [];
  let selected      = null;

  function dbg(msg, color) {
    debugPanel.style.display = 'block';
    const line = document.createElement('div');
    line.style.color = color || '#d4d4d4';
    line.style.borderBottom = '1px solid #333';
    line.style.paddingBottom = '4px';
    line.style.marginBottom = '4px';
    const time = new Date().toLocaleTimeString('pt-BR');
    line.textContent = `[${time}] ${msg}`;
    debugLog.appendChild(line);
    debugPanel.scrollTop = debugPanel.scrollHeight;
  }

  // ── Ícones por tipo de local ──
  function iconForType(type) {
    const icons = {
      amenity:   '<path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7z"/>',
      building:  '<path d="M17 11V3H7v4H3v14h8v-4h2v4h8V11h-4zM7 19H5v-2h2v2zm0-4H5v-2h2v2zm0-4H5v-2h2v2zm4 4H9v-2h2v2zm0-4H9v-2h2v2zm0-4H9V7h2v2zm4 8h-2v-2h2v2zm0-4h-2v-2h2v2zm0-4h-2V7h2v2zm4 12h-2v-2h2v2zm0-4h-2v-2h2v2z"/>',
      street:    '<path d="M1.5 4v3.5c0 .83.67 1.5 1.5 1.5h1V20c0 1.1.9 2 2 2h12c1.1 0 2-.9 2-2V9h1c.83 0 1.5-.67 1.5-1.5V4H1.5zm12 14.5h-3v-3.5c0-.83.67-1.5 1.5-1.5s1.5.67 1.5 1.5v3.5zm3.5 0H15v-3.5c0-1.93-1.57-3.5-3.5-3.5S8 13.07 8 15v3.5H6.5V9h10.5v9.5zm0-11H5V5.5h12V7.5z"/>',
      postcode:  '<path d="M20 4H4c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 4l-8 5-8-5V6l8 5 8-5v2z"/>',
      city:      '<path d="M15 11V5l-3-3-3 3v2H3v14h18V11h-6zm-8 8H5v-2h2v2zm0-4H5v-2h2v2zm0-4H5v-2h2v2zm6 8h-2v-2h2v2zm0-4h-2v-2h2v2zm0-4h-2v-2h2v2zm0-4h-2V7h2v2zm6 12h-2v-2h2v2zm0-4h-2v-2h2v2z"/>',
      county:    '<path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-2 15l-5-5 1.41-1.41L10 14.17l7.59-7.59L19 8l-9 9z"/>',
      country:   '<path d="M11.99 2C6.47 2 2 6.48 2 12s4.47 10 9.99 10C17.52 22 22 17.52 22 12S17.52 2 11.99 2zm6.93 6h-2.95c-.32-1.25-.78-2.45-1.38-3.56 1.84.63 3.37 1.91 4.33 3.56zM12 4.04c.83 1.2 1.48 2.53 1.91 3.96h-3.82c.43-1.43 1.08-2.76 1.91-3.96zM4.26 14C4.1 13.36 4 12.69 4 12s.1-1.36.26-2h3.38c-.08.66-.14 1.32-.14 2s.06 1.34.14 2H4.26zm.82 2h2.95c.32 1.25.78 2.45 1.38 3.56-1.84-.63-3.37-1.9-4.33-3.56zm2.95-8H5.08c.96-1.66 2.49-2.93 4.33-3.56C8.81 5.55 8.35 6.75 8.03 8zM12 19.96c-.83-1.2-1.48-2.53-1.91-3.96h3.82c-.43 1.43-1.08 2.76-1.91 3.96zM14.34 14H9.66c-.09-.66-.16-1.32-.16-2s.07-1.35.16-2h4.68c.09.65.16 1.32.16 2s-.07 1.34-.16 2zm.25 5.56c.6-1.11 1.06-2.31 1.38-3.56h2.95c-.96 1.65-2.49 2.93-4.33 3.56zM16.36 14c.08-.66.14-1.32.14-2s-.06-1.34-.14-2h3.38c.16.64.26 1.31.26 2s-.1 1.36-.26 2h-3.38z"/>',
    };
    return icons[type] || icons.amenity;
  }

  // ── Busca na API ──
  async function fetchSuggestions(query) {
    const params = new URLSearchParams({
      text:   query,
      apiKey: API_KEY,
      lang:   'pt',
      limit:  '7',
    });

    const url = `${API_URL}?${params}`;
    dbg(`→ GET ${url}`, '#569cd6');

    const res = await fetch(url);
    dbg(`← HTTP ${res.status} ${res.statusText}`, res.ok ? '#6a9955' : '#f44747');

    const text = await res.text();
    dbg(`Resposta bruta: ${text.slice(0, 300)}${text.length > 300 ? '…' : ''}`, '#ce9178');

    let data;
    try {
      data = JSON.parse(text);
    } catch(e) {
      dbg(`ERRO ao parsear JSON: ${e.message}`, '#f44747');
      return [];
    }

    const features = data.features || data.results || [];
    dbg(`features encontrados: ${features.length}`, features.length ? '#6a9955' : '#f44747');

    if (data.message) dbg(`Mensagem da API: ${data.message}`, '#f44747');
    if (data.error)   dbg(`Erro da API: ${JSON.stringify(data.error)}`, '#f44747');

    return features;
  }

  // ── Renderiza o dropdown ──
  function renderSuggestions(items, query) {
    activeIndex  = -1;
    currentItems = items;
    sugBox.innerHTML = '';

    if (!items.length) {
      sugBox.innerHTML = '<div class="sug-no-results">Nenhum resultado encontrado</div>';
      sugBox.style.display = 'block';
      return;
    }

    items.forEach((item, i) => {
      const props = item.properties;
      const name  = props.name || props.address_line1 || props.formatted || '';
      const addr  = props.formatted || '';
      const type  = (props.result_type || '').replace(/_/g, ' ');
      const cat   = props.categories
        ? props.categories[0].split('.').pop().replace(/_/g, ' ')
        : type;

      // Destaca o trecho digitado
      const re          = new RegExp(`(${query.replace(/[.*+?^${}()|[\]\\]/g, '\\$&')})`, 'gi');
      const highlighted = name.replace(re, '<mark>$1</mark>');

      const div = document.createElement('div');
      div.className = 'suggestion-item';
      div.dataset.index = i;
      div.innerHTML = `
        <div class="sug-icon">
          <svg viewBox="0 0 24 24">${iconForType(props.result_type)}</svg>
        </div>
        <div class="sug-text">
          <div class="sug-name">${highlighted}</div>
          <div class="sug-addr">${addr}</div>
          <div class="sug-type">${cat}</div>
        </div>
      `;

      div.addEventListener('mousedown', (e) => {
        e.preventDefault(); // evita blur antes do click
        selectItem(i);
      });

      sugBox.appendChild(div);
    });

    sugBox.style.display = 'block';
  }

  // ── Seleciona um item ──
  function selectItem(index) {
    const item  = currentItems[index];
    if (!item) return;
    selected    = item;
    const props = item.properties;
    const [lng, lat] = item.geometry.coordinates;

    // Preenche o input
    input.value = props.name || props.address_line1 || props.formatted || '';
    closeSuggestions();

    // Preenche o card
    document.getElementById('result-name').textContent =
      props.name || props.address_line1 || 'Local sem nome';

    document.getElementById('result-address').textContent =
      props.formatted || '';

    const cat = props.categories
      ? props.categories.slice(0, 2).map(c => c.split('.').pop().replace(/_/g, ' ')).join(' · ')
      : (props.result_type || '').replace(/_/g, ' ');
    document.getElementById('result-category').textContent = cat;

    document.getElementById('result-coords').textContent =
      `📌 ${lat.toFixed(6)}, ${lng.toFixed(6)}`;

    resultCard.classList.add('show');
  }

  function closeSuggestions() {
    sugBox.style.display = 'none';
    sugBox.innerHTML = '';
    activeIndex = -1;
  }

  // ── Input: dispara busca com debounce ──
  input.addEventListener('input', () => {
    const q = input.value.trim();

    clearBtn.style.display = q ? 'flex' : 'none';

    if (!q) {
      closeSuggestions();
      resultCard.classList.remove('show');
      return;
    }

    clearTimeout(debounceTimer);
    debounceTimer = setTimeout(async () => {
      if (input.value.trim().length < 2) return;
      try {
        dbg(`Buscando: "${input.value.trim()}"`, '#dcdcaa');
        const items = await fetchSuggestions(input.value.trim());
        renderSuggestions(items, input.value.trim());
      } catch (err) {
        dbg(`EXCEÇÃO: ${err.message}`, '#f44747');
        console.error(err);
      }
    }, 220);
  });

  // ── Teclado: navegar com setas + Enter ──
  input.addEventListener('keydown', (e) => {
    const items = sugBox.querySelectorAll('.suggestion-item');
    if (!items.length) return;

    if (e.key === 'ArrowDown') {
      e.preventDefault();
      activeIndex = Math.min(activeIndex + 1, items.length - 1);
    } else if (e.key === 'ArrowUp') {
      e.preventDefault();
      activeIndex = Math.max(activeIndex - 1, 0);
    } else if (e.key === 'Enter') {
      e.preventDefault();
      if (activeIndex >= 0) selectItem(activeIndex);
      return;
    } else if (e.key === 'Escape') {
      closeSuggestions();
      return;
    } else {
      return;
    }

    items.forEach((el, i) => el.classList.toggle('active', i === activeIndex));
  });

  // ── Fechar ao clicar fora ──
  document.addEventListener('click', (e) => {
    if (!document.getElementById('search-wrap').contains(e.target)) {
      closeSuggestions();
    }
  });

  // ── Botão limpar ──
  clearBtn.addEventListener('click', () => {
    input.value = '';
    clearBtn.style.display = 'none';
    closeSuggestions();
    resultCard.classList.remove('show');
    input.focus();
  });

  // ── Ver no Maps ──
  document.getElementById('btn-maps').addEventListener('click', () => {
    if (!selected) return;
    const [lng, lat] = selected.geometry.coordinates;
    window.open(
      `https://www.google.com/maps?q=${lat},${lng}`,
      '_blank'
    );
  });

  // ── Copiar endereço ──
  document.getElementById('btn-copy').addEventListener('click', async () => {
    if (!selected) return;
    const text = selected.properties.formatted || selected.properties.name || '';
    try {
      await navigator.clipboard.writeText(text);
      const btn = document.getElementById('btn-copy');
      btn.textContent = '✅ Copiado!';
      setTimeout(() => { btn.textContent = '📋 Copiar endereço'; }, 2000);
    } catch {
      prompt('Copie o endereço abaixo:', text);
    }
  });
</script>

</body>
</html>
