function ProgramarRegistros(selectedControl) {

    console.log("=== ProgramarRegistros INÍCIO ===");
    console.log("selectedControl:", selectedControl);
    console.log("tipo:", typeof selectedControl);

    // ─── EXTRAIR LINHAS SELECIONADAS ─────────────────────────────────────────
    var selectedRows = null;

    try {
        var grid = selectedControl.getGrid();
        console.log("grid:", grid);
        selectedRows = grid.getSelectedRows();
        console.log("selectedRows via getGrid():", selectedRows);
    } catch (e) {
        console.log("❌ getGrid() falhou:", e.message);
    }

    if (!selectedRows || selectedRows.getLength() === 0) {
        console.log("❌ Nenhuma linha selecionada");
        Xrm.Navigation.openAlertDialog({
            confirmButtonLabel: "OK",
            text: "Selecione ao menos uma reserva antes de continuar."
        }, { height: 120, width: 300 });
        return;
    }

    var total = selectedRows.getLength();
    var label = total === 1 ? "1 serviço" : total + " serviços";
    console.log("✅ Total selecionado:", total);

    // ─── EXTRAIR IDs ─────────────────────────────────────────────────────────
    var ids = [];
    selectedRows.forEach(function (row) {
        try {
            var id = row.getData().getEntity().getId().replace(/[{}]/g, "");
            console.log("ID extraído:", id);
            ids.push(id);
        } catch (e) {
            console.log("❌ Erro ao extrair ID:", e.message);
        }
    });

    console.log("IDs finais:", ids);

    if (ids.length === 0) {
        Xrm.Navigation.openAlertDialog({
            confirmButtonLabel: "OK",
            text: "Não foi possível identificar os registros selecionados."
        }, { height: 120, width: 300 });
        return;
    }

    // ─── LOADING ─────────────────────────────────────────────────────────────
    Xrm.Utility.showProgressIndicator("Programando " + label + "...");

    var promises = ids.map(function (id) {
        return Xrm.WebApi.updateRecord("cr40f_reservadeveculos", id, {
            "cr40f_status": 202410005,
    "new_foiprogramado": true
        }).then(function (result) {
            console.log("✅ Atualizado:", id, result);
            return result;
        }).catch(function (err) {
            console.log("❌ Erro ao atualizar " + id + ":", err.message);
            throw err;
        });
    });

    // ─── EXECUÇÃO ────────────────────────────────────────────────────────────
    Promise.all(promises)
        .then(function () {
            console.log("✅ TODOS atualizados com sucesso");
            Xrm.Utility.closeProgressIndicator();

            Xrm.Navigation.openAlertDialog({
                confirmButtonLabel: "OK",
                title: "Concluído",
                text: label + " marcado(s) como Programado com sucesso!"
            }, { height: 140, width: 300 }).then(function () {
                refreshGridView(selectedControl);
            }).catch(function () {
                refreshGridView(selectedControl);
            });
        })
        .catch(function (error) {
            console.log("❌ ERRO geral:", error.message);
            Xrm.Utility.closeProgressIndicator();

            Xrm.Navigation.openAlertDialog({
                confirmButtonLabel: "OK",
                title: "Erro",
                text: "Erro ao atualizar: " + (error.message || "Erro desconhecido.")
            }, { height: 140, width: 300 }).then(function () {
                refreshGridView(selectedControl);
            }).catch(function () {
                refreshGridView(selectedControl);
            });
        });
}

function refreshGridView(selectedControl) {
    console.log("=== refreshGridView ===");
    try {
        if (selectedControl && typeof selectedControl.refresh === "function") {
            selectedControl.refresh();
            console.log("✅ refresh via selectedControl.refresh()");
        } else if (Xrm.Page && Xrm.Page.data && typeof Xrm.Page.data.refresh === "function") {
            Xrm.Page.data.refresh();
            console.log("✅ refresh via Xrm.Page.data.refresh()");
        } else {
            console.log("❌ Nenhum método de refresh disponível");
        }
    } catch (error) {
        console.log("❌ Erro no refresh:", error.message);
    }
}