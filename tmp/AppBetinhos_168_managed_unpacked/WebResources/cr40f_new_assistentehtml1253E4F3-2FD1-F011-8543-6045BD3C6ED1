<!doctype html>
<html lang="pt-BR">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<title>Assistente de Agendamento — Clean Modern</title>
<style>
  :root{
    --muted:#6b7280;
    --text:#0f1724;
    --accent:#0b5ed7;
    --accent-600:#074bb0;
    --card-bg: rgba(255,255,255,0.95);
    --radius-lg:14px;
    --radius-sm:10px;
    --gap:12px;
    font-family:"Segoe UI", system-ui, -apple-system, "Helvetica Neue", Arial;
  }
  /* page background transparent so resource blends into form section */
  html,body{height:100%;margin:0;padding:0;background:transparent;color:var(--text);-webkit-font-smoothing:antialiased;}
  .wrap{max-width:980px;margin:0 auto;padding:8px;box-sizing:border-box}
  .shell{display:grid;grid-template-columns:1fr 360px;gap:18px;align-items:start}
  @media(max-width:960px){ .shell{grid-template-columns:1fr} }

  /* card with subtle border and glass */
  .card{
    background:var(--card-bg);
    border-radius:var(--radius-lg);
    padding:16px;
    border:1px solid rgba(11,94,215,0.06);
    box-sizing:border-box;
  }
  h1{font-size:16px;margin:0 0 6px 0}
  p.hint{margin:0;color:var(--muted);font-size:13px}

  .tabs{display:flex;gap:8px;margin:12px 0}
  .tab{padding:8px 12px;border-radius:10px;background:transparent;border:1px solid transparent;font-weight:600;color:var(--muted);cursor:pointer}
  .tab.active{background:linear-gradient(90deg,var(--accent),var(--accent-600));color:#fff;border-color:transparent;box-shadow:0 6px 18px rgba(11,94,215,0.06)}

  .grid{display:grid;gap:10px}
  .grid.cols-2{grid-template-columns:1fr 1fr}
  @media(max-width:640px){ .grid.cols-2{grid-template-columns:1fr} }

  .field{display:flex;flex-direction:column;gap:6px}
  label{font-size:12px;color:var(--muted)}
  input[type="text"], input[type="date"], input[type="time"], input[type="datetime-local"], textarea, select{
    padding:10px;border-radius:var(--radius-sm);border:1px solid #e6eefb;background:#fff;font-size:14px;color:var(--text);
    box-sizing:border-box;
  }
  textarea{min-height:64px;resize:vertical}
  input:focus, textarea:focus, select:focus{outline:2px solid rgba(11,94,215,0.12);border-color:rgba(11,94,215,0.15)}

  .inline{display:flex;gap:8px;align-items:center}
  .muted{color:var(--muted);font-size:13px}

  .actions{display:flex;gap:8px;flex-wrap:wrap;margin-top:12px}
  button{border:0;padding:10px 12px;border-radius:10px;font-weight:700;cursor:pointer}
  button.ghost{background:#fff;border:1px solid rgba(11,94,215,0.08);color:var(--accent)}
  button.primary{background:var(--accent);color:#fff}

  /* preview */
  #preview{padding:8px;min-height:120px;max-height:640px;overflow:auto;background:transparent}
  table.debug{width:100%;border-collapse:collapse;font-size:13px}
  table.debug th, table.debug td{padding:8px;border-bottom:1px solid rgba(15,23,36,0.04);text-align:left}
  table.debug th{position:sticky;top:0;background:transparent}

  .footer-note{margin-top:8px;font-size:12px;color:var(--muted)}
</style>
</head>
<body>
  <div class="wrap">
    <div class="shell">

      <!-- LEFT: inputs -->
      <main class="card" aria-labelledby="assistTitle">
        <h1 id="assistTitle">Assistente de Agendamento — Betinhos</h1>
        <p class="hint">Preencha as opções abaixo. Clique <strong>Prever</strong> para inspecionar os serviços e <strong>Executar</strong> para gravar instruções.</p>

        <div class="tabs" role="tablist" style="margin-top:12px">
          <button id="tabBtnRet" class="tab active" role="tab" aria-controls="tabRetorno">Agendar Retorno</button>
          <button id="tabBtnFreq" class="tab" role="tab" aria-controls="tabFreq">Serviços Frequentes</button>
        </div>

        <!-- TAB: RETORNO -->
        <section id="tabRetorno" class="grid">
          <div class="row" style="align-items:center;">
            <label class="inline"><input id="ar_enabled" type="checkbox" /> <span class="muted">Ativar retorno</span></label>
            <div style="flex:1"></div>
            <div class="muted">Campos sincronizam com o formulário nativo até edição manual.</div>
          </div>

          <div class="grid cols-2">
            <div class="field">
              <label for="ar_dataret">Data e hora de retorno</label>
              <input id="ar_dataret" type="datetime-local" />
            </div>
            <div class="field">
              <label for="ar_endsaida">Endereço de saída (retorno)</label>
              <input id="ar_endsaida" type="text" placeholder="Ex.: Aeroporto GRU" />
            </div>
            <div class="field">
              <label for="ar_destino">Destino (retorno)</label>
              <input id="ar_destino" type="text" placeholder="Ex.: Escritório" />
            </div>
            <div class="field">
              <label for="ar_obsop">Observação de operação</label>
              <textarea id="ar_obsop" placeholder="Instruções ao motorista..."></textarea>
            </div>
            <div class="field">
              <label for="ar_obsint">Observação interna</label>
              <textarea id="ar_obsint" placeholder="Notas internas..."></textarea>
            </div>
          </div>
        </section>

        <!-- TAB: FREQUÊNCIA -->
        <section id="tabFreq" class="grid" style="display:none">
          <div class="row" style="align-items:center">
            <label class="inline"><input id="fq_enabled" type="checkbox" /> <span class="muted">Ativar serviços frequentes</span></label>
          </div>

          <div class="grid cols-2">
            <div class="field">
              <label for="fq_inicio">Data de início</label>
              <input id="fq_inicio" type="date" />
            </div>
            <div class="field">
              <label for="fq_fim">Data de fim</label>
              <input id="fq_fim" type="date" />
            </div>
            <div class="field">
              <label for="fq_tipo">Tipo de agendamento</label>
              <select id="fq_tipo">
                <option value="ida">Ida</option>
                <option value="retorno">Retorno</option>
                <option value="ida_retorno">Ida e Retorno</option>
              </select>
            </div>
            <div class="field">
              <label class="inline"><input id="fq_fds" type="checkbox" /> <span class="muted">Contabilizar Sáb e Dom</span></label>
            </div>
          </div>
        </section>

        <!-- actions -->
        <div class="actions">
          <button id="btnPreview" class="ghost">Prever (debug)</button>
          <button id="btnExecute" class="primary">Executar</button>
          <button id="btnCancel" class="ghost">Fechar</button>
        </div>

        <p class="footer-note">Campos sincronizam automaticamente com o formulário pai até você editar o campo aqui — após edição a sincronização daquele campo para.</p>
      </main>

      <!-- RIGHT: preview / debug -->
      <aside>
        <div class="card" style="padding:12px">
          <h3 style="margin:0 0 8px 0">Pré-visualização / Debug</h3>
          <div id="preview" class="muted">Clique em <strong>Prever</strong> para ver o payload de cada serviço.</div>
        </div>
      </aside>
    </div>
  </div>

<script>
/* ===== Flexible Xrm helpers ===== */
function safeXrm(){ try{ return window.parent && window.parent.Xrm ? window.parent.Xrm : null; }catch(e){ return null; } }
function getAttrFlexible(base){
  const X = safeXrm();
  if(!X || !X.Page || !X.Page.getAttribute) return null;
  const tryNames = ["cr40f_" + base, base];
  for(const n of tryNames){
    try{ const a = X.Page.getAttribute(n); if(a) return a; } catch(e){}
  }
  return null;
}
function getValFlexible(base){ const a = getAttrFlexible(base); return a ? a.getValue() : null; }
function setValFlexible(base, value){ const a = getAttrFlexible(base); if(!a) return false; try{ a.setValue(value); return true; } catch(e){ return false; } }

/* ===== Sync rules =====
 For each assistant field we list parent attribute candidates (first found will be used).
 Sync occurs:
  - on load (initial fill)
  - on parent attribute onChange events, while assistant field NOT edited by user
 Once user edits assistant field, that field stops auto-syncing.
*/
const syncMap = {
  ar_dataret: ["cr40f_horrioprevistoderetorno", "cr40f_dataehorriodesada"],
  ar_destino: ["cr40f_destino"],
  ar_endsaida: ["cr40f_endereodesada"],
  ar_obsint: ["cr40f_observaointerna"],
  ar_obsop: ["cr40f_obsdeoperao"]
};

/* track which assistant fields were edited by user (stop syncing those) */
const editedFlags = {};
const parentHandlers = {}; // store handlers to be able to remove if needed

function markEdited(field){
  editedFlags[field] = true;
  // remove parent handlers for this field so no further writes
  if(parentHandlers[field]){
    parentHandlers[field].forEach(h=>{
      try{ h.attribute.removeOnChange(h.handler); }catch(e){}
    });
    parentHandlers[field] = null;
  }
}

/* convert parent attr value to assistant input value */
function parentValueToInput(attrVal, inputType){
  if(!attrVal) return "";
  if(Object.prototype.toString.call(attrVal) === "[object Date]"){
    const d = new Date(attrVal);
    const pad = n => String(n).padStart(2,'0');
    return d.getFullYear()+'-'+pad(d.getMonth()+1)+'-'+pad(d.getDate())+'T'+pad(d.getHours())+':'+pad(d.getMinutes());
  }
  return String(attrVal);
}

/* attach handlers to parent attributes for a given assistant field */
function attachParentListenersFor(field){
  const candidates = syncMap[field];
  if(!candidates || !candidates.length) return;
  parentHandlers[field] = [];
  const X = safeXrm();
  if(!X || !X.Page) return;

  candidates.forEach(attrName=>{
    try{
      const attr = X.Page.getAttribute(attrName);
      if(!attr) return;
      const handler = function(){
        try{
          if(editedFlags[field]) return; // stop if user already edited
          const val = attr.getValue();
          const el = document.getElementById(field);
          if(!el) return;
          // set only if el currently empty or not edited
          const newVal = parentValueToInput(val);
          if(el.value !== newVal) el.value = newVal;
        }catch(e){}
      };
      attr.addOnChange(handler);
      parentHandlers[field].push({ attribute: attr, handler: handler });
    }catch(e){}
  });
}

/* initial autofill and attach listeners */
function initAutoSync(){
  // init edited flags false
  Object.keys(syncMap).forEach(k=> editedFlags[k] = false);

  // attach change listeners for assistant inputs (to mark edited)
  Object.keys(syncMap).forEach(field=>{
    const el = document.getElementById(field);
    if(!el) return;
    // user interaction sets edited flag
    el.addEventListener('input', ()=>{ markEdited(field); });
    el.addEventListener('change', ()=>{ markEdited(field); });
  });

  // initial fill from parent attributes, then attach parent listeners
  const X = safeXrm();
  if(!X || !X.Page) return;
  Object.keys(syncMap).forEach(field=>{
    const candidates = syncMap[field];
    if(!candidates) return;
    for(const attrName of candidates){
      try{
        const attr = X.Page.getAttribute(attrName);
        if(attr){
          const val = attr.getValue();
          const el = document.getElementById(field);
          if(el && (el.value === "" || el.value == null)) el.value = parentValueToInput(val);
          break; // use first found candidate to populate initially
        }
      }catch(e){}
    }
    // attach listeners to remaining candidate attributes
    attachParentListenersFor(field);
  });
}

/* detach all parent listeners (cleanup) */
function detachAllParentListeners(){
  Object.keys(parentHandlers).forEach(field=>{
    const arr = parentHandlers[field];
    if(!arr) return;
    arr.forEach(h=>{
      try{ h.attribute.removeOnChange(h.handler); }catch(e){}
    });
    parentHandlers[field] = null;
  });
}

/* call on load */
initAutoSync();

/* ===== UI behavior: tabs ===== */
const tabBtnRet = document.getElementById('tabBtnRet');
const tabBtnFreq = document.getElementById('tabBtnFreq');
const tabRet = document.getElementById('tabRetorno');
const tabFreq = document.getElementById('tabFreq');
tabBtnRet.addEventListener('click', ()=>{ tabBtnRet.classList.add('active'); tabBtnFreq.classList.remove('active'); tabRet.style.display='block'; tabFreq.style.display='none'; });
tabBtnFreq.addEventListener('click', ()=>{ tabBtnFreq.classList.add('active'); tabBtnRet.classList.remove('active'); tabRet.style.display='none'; tabFreq.style.display='block'; });

/* ===== preview (debug) ===== */
function isoLocalToDisplay(v){ try{ return new Date(v).toLocaleString(); }catch(e){ return v; } }

document.getElementById('btnPreview').addEventListener('click', ()=>{
  const preview = document.getElementById('preview'); preview.innerHTML = '';
  const arEnabled = document.getElementById('ar_enabled').checked;
  const arDate = document.getElementById('ar_dataret').value || null;
  const arEnd = document.getElementById('ar_endsaida').value || null;
  const arDest = document.getElementById('ar_destino').value || null;
  const arObsOp = document.getElementById('ar_obsop').value || null;
  const arObsInt = document.getElementById('ar_obsint').value || null;

  const fqEnabled = document.getElementById('fq_enabled').checked;
  const fqStart = document.getElementById('fq_inicio').value || null;
  const fqEnd = document.getElementById('fq_fim').value || null;
  const fqType = document.getElementById('fq_tipo').value || 'ida';
  const fqFds = document.getElementById('fq_fds').checked;

  // fallback from parent form if needed
  const parentDest = getValFlexible('destino') || getValFlexible('cr40f_destino') || null;
  const parentTraj = getValFlexible('trajeto') || getValFlexible('cr40f_trajeto') || null;
  const parentEnd = getValFlexible('endereodesada') || getValFlexible('cr40f_endereodesada') || null;
  const parentDate = getValFlexible('dataehorriodesada') || getValFlexible('cr40f_dataehorriodesada') || null;

  const services = [];

  if(fqEnabled && fqStart && fqEnd){
    const s = new Date(fqStart); const e = new Date(fqEnd);
    for(let d=new Date(s); d<=e; d.setDate(d.getDate()+1)){
      const day = d.getDay();
      if(!fqFds && (day===0 || day===6)) continue;
      const iso = new Date(d).toISOString();
      if(fqType === 'ida' || fqType === 'ida_retorno'){
        services.push({ type:'Frequência — Ida', date: iso, destino: parentDest || arDest || null, trajeto: parentTraj || null, notes: null, issues: (parentDest || arDest) ? [] : ['destino ausente']});
      }
      if(fqType === 'retorno' || fqType === 'ida_retorno'){
        services.push({ type:'Frequência — Retorno', date: iso, destino: parentEnd || parentDest || arEnd || arDest || null, trajeto: parentTraj ? parentTraj.split(' / ').reverse().join(' / ') : null, notes: null, issues: (parentEnd || parentDest || arEnd || arDest) ? [] : ['destino (retorno) ausente']});
      }
    }
  }

  if(arEnabled){
    let iso = null;
    if(arDate) { const d=new Date(arDate); iso = d.toISOString(); } else if(parentDate){ iso = (new Date(parentDate)).toISOString(); }
    services.push({ type:'Retorno — Único', date: iso, destino: arEnd || arDest || parentEnd || parentDest || null, trajeto: parentTraj ? parentTraj.split(' / ').reverse().join(' / ') : null, notes: (arObsOp||arObsInt)?((arObsOp?('OP: '+arObsOp):'')+(arObsInt?(' INT: '+arObsInt):'')):null, issues:[] });
    if(!iso) services[services.length-1].issues.push('data de retorno ausente');
    if(!services[services.length-1].destino) services[services.length-1].issues.push('destino de retorno ausente');
  }

  if(services.length === 0){ preview.innerHTML = '<div class="muted">Nenhum serviço previsto — ative e preencha opções.</div>'; return; }

  const table = document.createElement('table'); table.className='debug';
  const thead = document.createElement('thead');
  thead.innerHTML = '<tr><th>Tipo</th><th>Data</th><th>Destino</th><th>Trajeto</th><th>Observações</th><th>Issues</th></tr>';
  table.appendChild(thead);
  const tbody = document.createElement('tbody');
  services.forEach(s=>{
    const tr=document.createElement('tr');
    const tdType=document.createElement('td'); tdType.textContent=s.type; tr.appendChild(tdType);
    const tdDate=document.createElement('td'); tdDate.textContent=s.date?isoLocalToDisplay(s.date):'(sem data)'; tr.appendChild(tdDate);
    const tdDest=document.createElement('td'); tdDest.textContent=s.destino||'(vazio)'; tr.appendChild(tdDest);
    const tdTraj=document.createElement('td'); tdTraj.textContent=s.trajeto||'(vazio)'; tr.appendChild(tdTraj);
    const tdObs=document.createElement('td'); tdObs.textContent=s.notes||'(nenhuma)'; tr.appendChild(tdObs);
    const tdIssues=document.createElement('td'); tdIssues.innerHTML=(s.issues && s.issues.length)?('<span style="color:#b00">'+s.issues.join('; ')+'</span>'):'<span style="color:green">ok</span>'; tr.appendChild(tdIssues);
    tbody.appendChild(tr);
    console.log('PREVIEW ITEM:', s);
  });
  table.appendChild(tbody);
  preview.appendChild(table);

  const details=document.createElement('details'); details.style.marginTop='8px';
  details.innerHTML = '<summary style="cursor:pointer">Mostrar JSON</summary><pre style="max-height:220px;overflow:auto;background:transparent;padding:8px">'+JSON.stringify(services,null,2)+'</pre>';
  preview.appendChild(details);
});

/* ===== executar: grava JSON nas hidden fields (flexível) ===== */
document.getElementById('btnExecute').addEventListener('click', ()=>{
  const obj = {
    retorno: {
      enabled: !!document.getElementById('ar_enabled').checked,
      datetime: document.getElementById('ar_dataret').value || null,
      endereco_saida: document.getElementById('ar_endsaida').value || null,
      destino: document.getElementById('ar_destino').value || null,
      obs_interna: document.getElementById('ar_obsint').value || null,
      obs_operacao: document.getElementById('ar_obsop').value || null
    },
    frequencia: {
      enabled: !!document.getElementById('fq_enabled').checked,
      startDate: document.getElementById('fq_inicio').value || null,
      endDate: document.getElementById('fq_fim').value || null,
      tripType: document.getElementById('fq_tipo').value || null,
      countWeekend: !!document.getElementById('fq_fds').checked
    },
    ts: new Date().toISOString()
  };

  const ok1 = setValFlexible('new_assistant_options', JSON.stringify(obj));
  const ok2 = setValFlexible('new_assistant_pending', true);

  if(ok1 && ok2){
    try{ safeXrm().Navigation.openAlertDialog({ text: 'Opções gravadas. Clique SALVAR no formulário para processar.' }); }catch(e){}
    console.log('EXECUTAR -> gravado', obj);
  } else {
    alert('Erro: não conseguiu gravar campos ocultos. Verifique cr40f_new_assistant_options e cr40f_new_assistant_pending no formulário.');
  }
});

/* fechar (se for popup) */
document.getElementById('btnCancel').addEventListener('click', ()=>{ try{ window.close(); }catch(e){} });

/* cleanup on unload */
window.addEventListener('beforeunload', ()=>{ detachAllParentListeners(); });

function detachAllParentListeners(){
  Object.keys(parentHandlers || {}).forEach(field=>{
    const arr = parentHandlers[field];
    if(!arr) return;
    arr.forEach(h=>{
      try{ h.attribute.removeOnChange(h.handler); }catch(e){}
    });
    parentHandlers[field] = null;
  });
}

/* util */
function isoLocalToDisplay(v){ try{ return new Date(v).toLocaleString(); }catch(e){ return v; } }
</script>
</body>
</html>
