// Função que será chamada pelo OnLoad do formulário
function newOpenDialogOnLoad() {
    console.log("✅ new_open_dialog.js - OnLoad executado");
    
    // Esta função não faz nada além de log,
    // porque a inicialização já é feita automaticamente
    // pela função initialize() que já existe no código
    
    // Você pode adicionar aqui qualquer inicialização adicional se necessário
    if (typeof initialize === 'function') {
        initialize();
    }
}

// Expor a função globalmente
window.newOpenDialogOnLoad = newOpenDialogOnLoad;