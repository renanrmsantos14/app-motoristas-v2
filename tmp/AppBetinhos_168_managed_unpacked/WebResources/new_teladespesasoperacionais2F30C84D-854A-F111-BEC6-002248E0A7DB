          endReason: cleanText(row?.cr40f_motivofimposse || row?.cr40f_motivoencerramento || "", ""),
          note: cleanText(row?.cr40f_observacao, ""),
          source: "Dataverse"
        };
      }

      function normalizeCardDriverAssignments(rows, employees) {
        return (Array.isArray(rows) ? rows : [])
          .map((row, index) => cardAssignmentFromDataverse(row, employees, index))
