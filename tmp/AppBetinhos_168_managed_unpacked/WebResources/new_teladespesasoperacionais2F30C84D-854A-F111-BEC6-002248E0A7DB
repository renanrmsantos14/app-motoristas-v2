        const driverName = lookupName(row, "cr40f_motorista", "");
        const driver = findEmployeeById(driverId, employees || []) || findEmployeeByName(driverName, employees || []);
        const resolvedName = driver?.name || driverName || cleanText(row?.cr40f_motoristanome, "");
        const startDate = row?.cr40f_datainicio ? normalizeDateTime(row.cr40f_datainicio) : "";
        const endDate = row?.cr40f_datafim ? normalizeDateTime(row.cr40f_datafim) : "";

        return {
          id,
          name: cleanText(row?.cr40f_nome, last4 ? `Cartao ${last4}` : id),
          last4,
          driverId: driver?.id || driverId,
          driverName: resolvedName,
          driverNick: driver?.nick || compactName(resolvedName),
          accountId: lookupId(row, "cr40f_contafinanceira"),
          accountName: lookupName(row, "cr40f_contafinanceira", ""),
          status: choiceLabel(row, "cr40f_statusvinculo", choiceLabel(row, "cr40f_status", "Ativo")),
          startDate,
