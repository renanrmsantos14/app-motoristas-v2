          <section class="panel"><div class="panel-head"><div class="panel-title"><h2>Categoria</h2><p>Combustível, alimentação, manutenção e demais gastos.</p></div></div><div class="panel-body">${renderChartComparisonCards(spendComparison, money, (item) => `${item.rows.length} transação(ões)`)}${donutChart(groupSum(rows, "category"))}</div></section>
