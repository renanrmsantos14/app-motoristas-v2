      function extractDigits(value) {
        return String(value ?? "").replace(/\D/g, "");
      }

      function toLast4(value) {
        const digits = extractDigits(value);
        return digits.length >= 4 ? digits.slice(-4) : "";
      }

      function strictKeyToken(key) {
        return normalizeSearch(key).replace(/[^a-z0-9]+/g, "");
      }

      function isBlockedIdentifierKey(key) {
        const token = strictKeyToken(key);
        return token === "id" || token.endsWith("id") || token.includes("uuid") || token.includes("guid");
      }

      function isStrictCardContainerKey(key) {
        const token = strictKeyToken(key);
        return (
          token.includes("creditcardmetadata") ||
          token.includes("creditcard") ||
          token.includes("cardmetadata") ||
          token.includes("paymentcard") ||
          token.includes("card") ||
          token.includes("cartao")
        );
      }

      function isExplicitCardNumberKey(key) {
        const token = strictKeyToken(key);
        return (
          token === "last4" ||
          token === "lastfour" ||
          token === "lastfourdigits" ||
          token === "cardlast4" ||
          token === "cardnumberlast4" ||
          token === "cardnumber" ||
          token === "creditcardnumber" ||
          token === "maskedcardnumber" ||
          token === "maskedcard" ||
          token === "pan" ||
          (token.includes("card") && token.includes("number")) ||
          (token.includes("cartao") && (token.includes("numero") || token.includes("number") || token.includes("final")))
        );
      }

      function shouldReadStrictCardLeaf(key, pathTokens) {
        if (isBlockedIdentifierKey(key)) return false;
        const token = strictKeyToken(key);
        const numberInsideCard = (token === "number" || token === "numero" || token === "maskednumber") && pathTokens.some(isStrictCardContainerKey);
        return isExplicitCardNumberKey(key) || numberInsideCard;
      }

      function isCardKey(key) {
        return /(last4|lastfour|last_four|cartao|cartão|card|creditcard|credit_card|masked|number|numero|número)/i.test(String(key || ""));
      }

      function isCardContext(key) {
        return /(payment|pagamento|cartao|cartão|card|credit|account|conta)/i.test(String(key || ""));
      }

      function extractCardLast4(input) {
        const directPaths = [
          ["creditCardMetadata", "cardNumber"],
          ["creditCardMetadata", "cardNumberLast4"],
          ["creditCardMetadata", "cardLast4"],
          ["creditCardMetadata", "last4"],
          ["paymentData", "cardNumber"],
          ["paymentData", "cardNumberLast4"],
          ["paymentData", "cardLast4"],
          ["paymentData", "last4"],
          ["creditCard", "last4"],
          ["creditCard", "number"],
          ["card", "last4"],
          ["card", "number"],
          ["cardLast4"],
          ["last4"],
          ["lastFourDigits"]
        ];

        for (const path of directPaths) {
          let value = input;
          for (const part of path) value = value?.[part];
          const last4 = toLast4(value);
          if (last4) return last4;
        }

        return findStrictCardLast4(input, [], 0);
      }

      function findCardLast4(value, contextKey, depth) {
        if (value == null || depth > 5) return "";
        if (typeof value !== "object") return isCardContext(contextKey) || isCardKey(contextKey) ? toLast4(value) : "";

        if (Array.isArray(value)) {
          for (const item of value) {
            const found = findCardLast4(item, contextKey, depth + 1);
            if (found) return found;
          }
          return "";
        }

        for (const [key, child] of Object.entries(value)) {
          if (isCardKey(key)) {
            const found = toLast4(child);
            if (found) return found;
          }
        }

        for (const [key, child] of Object.entries(value)) {
          const nextContext = isCardContext(key) || isCardKey(key) ? key : contextKey;
          const found = findCardLast4(child, nextContext, depth + 1);
          if (found) return found;
        }

        return "";
      }

      function findStrictCardLast4(value, pathTokens, depth) {
        if (value == null || depth > 5) return "";
        if (typeof value !== "object") return "";

        if (Array.isArray(value)) {
          for (const item of value) {
            const found = findStrictCardLast4(item, pathTokens, depth + 1);
            if (found) return found;
          }
          return "";
        }

        for (const [key, child] of Object.entries(value)) {
          if (shouldReadStrictCardLeaf(key, pathTokens)) {
            const found = toLast4(child);
            if (found) return found;
          }
        }

        for (const [key, child] of Object.entries(value)) {
          if (isBlockedIdentifierKey(key)) continue;
          const found = findStrictCardLast4(child, [...pathTokens, key], depth + 1);
          if (found) return found;
        }

        return "";
      }

      function isCreditAccount(account) {
        const type = String(account?.type || "").toUpperCase();
        const subtype = String(account?.subtype || "").toUpperCase();
        return type === "CREDIT" || subtype === "CREDIT_CARD";
      }

      function isBankAccount(account) {
        const type = String(account?.type || "").toUpperCase();
        const subtype = String(account?.subtype || "").toUpperCase();
        return type === "BANK" || subtype === "CHECKING_ACCOUNT" || subtype === "SAVINGS_ACCOUNT";
      }

      function pluggyFinancialChannel(tx, context) {
        const accountId = tx?.accountId || context?.accountId || "";
        const account = findPluggyAccount(accountId, context);
        if (isCreditAccount(account) || tx?.creditCardMetadata) return "credit_card";
        if (isBankAccount(account)) return "bank_account";
        return resolvePluggyCardLast4(tx, context) ? "credit_card" : "unknown";
      }

      function extractAccountCardLast4(account) {
        if (!isCreditAccount(account)) return "";

        const directPaths = [
          ["number"],
          ["cardNumber"],
          ["cardLast4"],
          ["last4"],
          ["creditData", "cardNumber"],
          ["creditData", "cardLast4"],
          ["creditData", "last4"]
        ];

        for (const path of directPaths) {
          let value = account;
          for (const part of path) value = value?.[part];
          const last4 = toLast4(value);
          if (last4) return last4;
        }

        return "";
      }

      function buildPluggyAccountIndex(accounts) {
        const index = new Map();
        (Array.isArray(accounts) ? accounts : []).forEach((account) => {
          const id = cleanText(account?.id || account?.accountId, "");
          if (id) index.set(id, account);
        });
        return index;
      }

      function findPluggyAccount(accountId, context) {
        if (!context) return null;
        if (context instanceof Map) return context.get(accountId) || null;
        if (Array.isArray(context)) return buildPluggyAccountIndex(context).get(accountId) || null;
        if (Array.isArray(context.accounts)) {
          const index = context.accountIndex instanceof Map ? context.accountIndex : buildPluggyAccountIndex(context.accounts);
          return index.get(accountId || context.accountId) || null;
        }
        if (context.account && (!accountId || context.account.id === accountId || context.account.accountId === accountId)) return context.account;
        return null;
      }

      function resolvePluggyCardLast4(tx, context) {
        const fromTransaction = extractCardLast4(tx);
        if (fromTransaction) return fromTransaction;

        const accountId = tx?.accountId || context?.accountId || "";
        const account = findPluggyAccount(accountId, context);
        return extractAccountCardLast4(account);
      }

      function findEmployeeByName(employeeName, employees) {
        const expected = normalizeKey(employeeName);
        if (!expected) return null;

        const exact = employees.find((employee) => (
          normalizeKey(employee.name) === expected ||
          normalizeKey(employee.nick) === expected
        ));
        if (exact) return exact;

        const tokens = normalizeSearch(employeeName).split(/\s+/).filter((part) => part.length > 2);
        return employees.find((employee) => {
          const haystack = normalizeSearch(`${employee.name} ${employee.nick}`);
          return tokens.length > 0 && tokens.every((token) => haystack.includes(token));
        }) || null;
      }

      function cardAssignmentFromDataverse(row, employees, index) {
        const id = cleanText(row?.cr40f_cartaomotoristaid, cleanText(row?.cr40f_nome, `cartao-motorista-${index + 1}`));
        const last4 = toLast4(row?.cr40f_finalcartao || row?.cr40f_ultimos4digitos || row?.cr40f_finaldocartao);
