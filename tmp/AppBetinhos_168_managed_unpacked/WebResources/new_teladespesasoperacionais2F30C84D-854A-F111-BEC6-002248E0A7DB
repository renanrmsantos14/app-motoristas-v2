    function ensureChartTooltip() {
      return {
        root: document.getElementById("chartTooltip"),
        label: document.getElementById("chartTooltipLabel"),
        value: document.getElementById("chartTooltipValue"),
        meta: document.getElementById("chartTooltipMeta")
      };
    }

    function hideChartTooltip() {
      const tooltip = ensureChartTooltip();
      if (!tooltip.root) return;
      tooltip.root.classList.remove("show");
      tooltip.root.setAttribute("aria-hidden", "true");
    }

    function moveChartTooltip(event) {
      const tooltip = ensureChartTooltip();
      if (!tooltip.root) return;
      const offset = 18;
      const width = tooltip.root.offsetWidth || 200;
      const height = tooltip.root.offsetHeight || 76;
      const maxLeft = Math.max(12, window.innerWidth - width - 12);
      const maxTop = Math.max(12, window.innerHeight - height - 12);
      const left = Math.min(Math.max(12, event.clientX + offset), maxLeft);
      const top = Math.min(Math.max(12, event.clientY + offset), maxTop);
      tooltip.root.style.left = `${left}px`;
      tooltip.root.style.top = `${top}px`;
    }

    function showChartTooltip(target, event) {
      const tooltip = ensureChartTooltip();
      if (!tooltip.root || !target?.dataset) return;
      tooltip.label.textContent = target.dataset.chartTooltip || "";
      tooltip.value.textContent = target.dataset.chartValue || "";
      const meta = target.dataset.chartMeta || "";
      tooltip.meta.textContent = meta;
      tooltip.meta.style.display = meta ? "block" : "none";
      tooltip.root.classList.add("show");
      tooltip.root.setAttribute("aria-hidden", "false");
      moveChartTooltip(event);
    }

    function bindChartTooltips() {
      document.querySelectorAll("[data-chart-tooltip]").forEach((element) => {
        if (element.dataset.chartTooltipBound === "true") return;
        element.dataset.chartTooltipBound = "true";
        element.addEventListener("mouseenter", (event) => showChartTooltip(element, event));
        element.addEventListener("mousemove", moveChartTooltip);
        element.addEventListener("mouseleave", hideChartTooltip);
      });
    }

    function initials(value) {
      return String(value || "?").split(/\s+/).filter(Boolean).slice(0, 2).map((part) => part[0]).join("").toUpperCase();
    }

    function now() {
      return new Date();
    }

    function selectedTransaction() {
      return state.selectedId ? transactions.find((item) => item.id === state.selectedId) || null : null;
    }

    function activeRows() {
      return filteredTransactions();
    }

    function statusKey(status) {
      return Expense.normalizeSearch(status);
    }

    function isClosedStatus(status) {
      return ["aprovada", "reprovada", "cancelado"].includes(statusKey(status));
    }

    function openRows() {
      return activeRows().filter((item) => !isClosedStatus(item.status));
    }

    function pendingRows() {
      return activeRows().filter(expenseNeedsManagerAction);
    }

    function transactionRowsForCurrentView() {
      const rows = filteredTransactions();
      return state.showPendingOnly ? rows.filter(expenseNeedsManagerAction) : rows;
    }

    function financialChannelRows(channel = state.financialChannel, options = {}) {
      const rows = filteredTransactions({ ...options, ignoreFinancialChannel: true });
      if (channel === "consolidated") return rows;
      return rows.filter((item) => item.financialChannel === channel);
    }

    function selectedFilterValues(key, allValue = "all", legacyValue = "") {
      const values = Array.isArray(state[key]) ? state[key] : [];
      const selected = [...new Set(values.map((value) => String(value || "").trim()).filter((value) => value && value !== allValue && value !== "__empty"))];
      if (selected.length) return selected;
      const fallback = String(legacyValue || "").trim();
      return fallback && fallback !== allValue && fallback !== "__empty" ? [fallback] : [];
    }

    function matchesTransactionFilters(item, options) {
      options = options || {};
      const needle = state.search.trim().toLowerCase();
      const ignorePeriod = options.ignorePeriod === true;
      const ignoreFinancialChannel = options.ignoreFinancialChannel === true;
      const selectedTags = Array.isArray(state.tags) ? state.tags : [];
      const selectedDrivers = selectedFilterValues("drivers", "all", state.driver);
      const selectedStatuses = selectedFilterValues("statuses", "all", state.status);
      const selectedCategories = selectedFilterValues("categories", "all", state.category);
      const selectedFinancialChannels = selectedFilterValues("financialChannels", "consolidated", state.financialChannel);
      if (selectedDrivers.length && !selectedDrivers.includes(item.driverId)) return false;
      if (selectedStatuses.length && !selectedStatuses.includes(item.status)) return false;
      if (selectedCategories.length && !selectedCategories.includes(item.category)) return false;
      if (state.origin !== "all" && item.origin !== state.origin) return false;
      if (!ignoreFinancialChannel && selectedFinancialChannels.length && !selectedFinancialChannels.includes(item.financialChannel)) return false;
      if (!ignorePeriod && state.period !== "all") {
        const bounds = resolvePeriodBounds(state.period, now());
        const itemDate = new Date(item.date);
        if (bounds && (itemDate < bounds.start || itemDate > bounds.end)) return false;
      }
      if (state.range === "high" && item.value <= 250) return false;
      if (state.range === "missing" && Expense.normalizeSearch(item.attachment) !== "nao enviado") return false;
      if (state.range === "late" && !isLate(item)) return false;
      if (selectedTags.length) {
        const itemTags = expenseTagLabels(item);
        const hasNoTag = !itemTags.length;
        const matchesTag = selectedTags.some((tag) => tag === "__none" ? hasNoTag : itemTags.includes(tag));
        if (!matchesTag) return false;
      }
      if (!needle) return true;
      return [item.id, item.origin, item.driver, item.nick, item.vehicle, item.place, item.category, item.status, item.pendingType, item.note, item.cardLast4, item.cardExpectedOwner, item.employeeId, item.suggestedCategory, item.suggestionReason, riskFlagsForExpense(item).map((flag) => flag.label).join(" ")]
        .some((value) => String(value || "").toLowerCase().includes(needle));
    }

    function filteredTransactions(options) {
      options = options || {};
      return transactions.map(ensureDerivedExpenseFields).filter((item) => matchesTransactionFilters(item, options));
    }

    function isLate(item) {
      return new Date(item.deadline) < now() && !isClosedStatus(item.status);
    }

    function dashboardStats() {
      const rows = filteredTransactions({ ignoreFinancialChannel: true }).filter((item) => !Expense.isCancelledExpense(item));
      const spend = rows.reduce((sum, item) => sum + item.value, 0);
      const waiting = 0;
      const pending = rows.filter((item) => statusKey(item.status) === "pendente").length;
      const validated = rows.filter((item) => statusKey(item.status) === "aprovada").length;
      const duplicate = rows.filter((item) => item.duplicate).length;
      const missingEvidence = rows.filter((item) => Expense.normalizeSearch(item.attachment) === "nao enviado").length;
      const late = rows.filter(isLate).length;
      const excludedFromAverage = rows.filter(expenseExcludedFromAverage).length;
      const policyDivergence = rows.filter(expenseIsPolicyDivergent).length;
      const cardDivergence = rows.filter((item) => Expense.cardDivergenceReason(item)).length;
      return {
        count: rows.length,
        spend,
        waiting,
        pending,
        validated,
        duplicate,
        missingEvidence,
        late,
        excludedFromAverage,
        policyDivergence,
        cardDivergence,
        avgTicket: rows.length ? spend / rows.length : 0,
        approvalRate: rows.length ? Math.round(validated / rows.length * 100) : 0
      };
    }

    function startOfDay(value) {
      const date = new Date(value);
      date.setHours(0, 0, 0, 0);
      return date;
    }

    function endOfDay(value) {
      const date = new Date(value);
      date.setHours(23, 59, 59, 999);
      return date;
    }

    function addDays(value, days) {
      const date = new Date(value);
      date.setDate(date.getDate() + days);
      return date;
    }

    function addYears(value, years) {
      const date = new Date(value);
      date.setFullYear(date.getFullYear() + years);
      return date;
    }

    function activeChartBounds() {
      const filtered = filteredTransactions({ ignorePeriod: true });
      const resolved = state.period === "all" ? null : resolvePeriodBounds(state.period, now());
      if (resolved) return { key: "current", label: "Atual", start: resolved.start, end: resolved.end };
      const dates = filtered.map((item) => new Date(item.date)).filter((date) => !Number.isNaN(date.getTime())).sort((left, right) => left - right);
      const start = dates[0] ? startOfDay(dates[0]) : startOfDay(now());
      const end = dates.at(-1) ? endOfDay(dates.at(-1)) : endOfDay(now());
      return { key: "current", label: "Atual", start, end };
    }

    function comparisonChartBounds(scope = "current") {
      const current = activeChartBounds();
      if (scope === "lm") {
        const days = Math.max(1, Math.round((current.end - current.start) / (24 * 60 * 60 * 1000)) + 1);
        const end = endOfDay(addDays(current.start, -1));
        return { key: "lm", label: "LM", start: startOfDay(addDays(end, -(days - 1))), end };
      }
      if (scope === "ly") {
        return { key: "ly", label: "LY", start: startOfDay(addYears(current.start, -1)), end: endOfDay(addYears(current.end, -1)) };
      }
      return current;
    }

    function chartRowsForScope(scope = "current") {
      const bounds = comparisonChartBounds(scope);
      return filteredTransactions({ ignorePeriod: true, ignoreFinancialChannel: true }).filter((item) => !Expense.isCancelledExpense(item)).filter((item) => {
        const date = new Date(item.date);
        return bounds.start <= date && date <= bounds.end;
      });
    }

    function pendingChartRowsForScope(scope = "current") {
      return chartRowsForScope(scope).filter((item) => statusKey(item.status) === "pendente");
    }

