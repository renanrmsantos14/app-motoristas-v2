    function spark(points) {
      const max = Math.max(...points, 1);
      const min = Math.min(...points, 0);
      const mapped = points.map((point, index) => {
        const x = index * (100 / Math.max(points.length - 1, 1));
        const y = 30 - ((point - min) / Math.max(max - min, 1)) * 24;
        return { x, y };
      });
      const coords = mapped.map((point) => `${point.x.toFixed(1)},${point.y.toFixed(1)}`).join(" ");
      const area = `M ${mapped[0].x.toFixed(1)} 34 L ${coords.replaceAll(",", " ")} L ${mapped.at(-1).x.toFixed(1)} 34 Z`;
      return `<svg class="spark" viewBox="0 0 100 34" preserveAspectRatio="none" aria-hidden="true"><path class="spark-area" d="${area}"></path><polyline class="spark-line" points="${coords}"></polyline></svg>`;
    }

    function statusBars(rows) {
      const grouped = groupCount(rows, "status");
      const max = Math.max(...grouped.map((row) => row.value), 1);
      if (!grouped.length) return '<div class="empty">Sem dados no filtro atual.</div>';
      return `<div class="status-bars">
        ${statuses.filter((status) => grouped.some((row) => row.label === status)).map((status) => {
        const row = grouped.find((item) => item.label === status);
        return `<div class="status-row" data-chart-tooltip="${esc(status)}" data-chart-value="${esc(`${row.value} despesa(s)`)}" data-chart-meta="${esc(`${Math.round(row.value / Math.max(rows.length || 1, 1) * 100)}% do volume filtrado`)}"><span>${esc(status)}</span><div class="track"><div class="fill ${statusTone(status)}" style="width:${Math.max(8, row.value / max * 100)}%"></div></div><strong>${row.value}</strong></div>`;
      }).join("")}
      </div>`;
    }

    function processStep(title, text, tone) {
      return `<div class="process-step"><span class="pill ${tone}">${esc(title)}</span><strong>${esc(text.split(".")[0])}</strong><span>${esc(text)}</span></div>`;
    }

    function kanbanColumn(title, rows) {
      return `
        <div class="kanban-column">
          <div class="kanban-head"><span>${esc(title)}</span><strong>${rows.length}</strong></div>
          <div class="kanban-body">
            ${rows.length ? rows.map(taskCard).join("") : '<div class="empty">Sem itens.</div>'}
          </div>
        </div>
      `;
    }

    function taskCard(item) {
      return `
        <article class="task-card ${item.id === state.selectedId ? "selected" : ""}" data-card-id="${esc(item.id)}">
          <div class="task-top">
            <h4>${esc(item.place)}</h4>
            <span class="pill ${statusClass(item.status)}">${esc(shortStatus(item.status))}</span>
          </div>
          <div class="task-meta">
            <span>${esc(item.nick)}</span>
            <strong class="right">${money(item.value)}</strong>
            <span>${esc(item.category)}</span>
            <span class="right">${dateFmt.format(new Date(item.date))}</span>
          </div>
        </article>
      `;
    }

    function transactionTable(rows, mode) {
      if (!rows.length) return '<div class="card-pad"><div class="empty">Nenhum registro encontrado com os filtros atuais.</div></div>';
      const pendingMode = mode === "pendencias" || mode === "priority";
      return `
        <div class="table-wrap has-card-fallback">
          <table>
            <thead>
              <tr>
                <th>Despesa</th>
                <th>Cartão / Portador</th>
                <th>Categoria</th>
                <th>Data</th>
                <th class="right">Valor</th>
                <th>Status</th>
                <th>Anexo</th>
                <th>Tags</th>
              </tr>
            </thead>
            <tbody>${rows.map((item) => transactionRow(item, pendingMode)).join("")}</tbody>
          </table>
        </div>
        ${transactionCards(rows)}
      `;
    }

    function transactionCards(rows) {
      if (!rows.length) return "";
      return `<div class="transaction-cards">
        ${rows.map((item) => `
          <article class="transaction-card ${item.id === state.selectedId ? "selected" : ""}" data-card-id="${esc(item.id)}">
            <div class="transaction-card-head">
              <div class="transaction-card-copy">
                <strong>${esc(item.place)}</strong>
                <span>${esc(item.nick)} - ${esc(item.vehicle)}</span>
              </div>
              <strong class="money">${money(item.value)}</strong>
            </div>
            <div class="transaction-card-meta">
              <span class="pill ${statusClass(item.status)}">${esc(item.status)}</span>
              <span class="pill ${attachmentClass(item.attachment)}">${esc(item.attachment)}</span>
              <span class="pill ${financialChannelClass(item.financialChannel)}">${esc(financialChannelLabel(item.financialChannel))}</span>
            </div>
            ${riskFlagChips(item, 3) ? `<div class="transaction-card-meta">${riskFlagChips(item, 3)}</div>` : ""}
            <div class="transaction-card-actions">
              <span class="muted">${dateTimeFmt.format(new Date(item.date))}</span>
              ${priorityLabel(item)}
            </div>
          </article>
        `).join("")}
      </div>`;
    }

    function transactionRow(item, pendingMode) {
      return `
        <tr data-id="${esc(item.id)}" class="${item.id === state.selectedId ? "selected" : ""}">
          <td><strong>${esc(item.place)}</strong><br><span class="muted">${esc(item.id)} · ${esc(item.origin)}</span></td>
          <td>${cardHolderCell(item)}</td>
          <td>${esc(item.category)}</td>
          <td>${dateTimeFmt.format(new Date(item.date))}</td>
          <td class="right money">${money(item.value)}</td>
          <td><span class="pill status-pill ${statusClass(item.status)}">${esc(item.status)}</span></td>
          <td><span class="pill ${attachmentClass(item.attachment)}">${esc(item.attachment)}</span></td>
          <td>${transactionTagsCell(item, pendingMode)}</td>
        </tr>
      `;
    }

    function priorityLabel(item) {
      const flag = riskFlagsForExpense(item)[0];
      if (flag) return `<span class="pill ${esc(flag.tone)}">${esc(flag.label)}</span>`;
      if (isLate(item)) return '<span class="pill orange">SLA vencido</span>';
      if (Expense.normalizeSearch(item.attachment) === "nao enviado") return '<span class="pill warn">Sem anexo</span>';
      return '<span class="pill neutral">Normal</span>';
    }

    function riskFlagChips(item, limit = 4, offset = 0) {
      const flags = riskFlagsForExpense(item).slice(offset, offset + limit);
      if (!flags.length) return "";
      return `<span class="risk-chip-list">${flags.map((flag) => `<span class="pill ${esc(flag.tone)}">${esc(flag.label)}</span>`).join("")}</span>`;
    }

    function cardHolderCell(item) {
      const card = item.cardLast4 ? `Final ${item.cardLast4}` : "Sem cartão";
      const holder = item.cardExpectedOwner || item.nick || item.driver || "Portador não informado";
      return `
        <div class="driver-cell">
          <span class="driver-copy"><strong>${esc(card)}</strong><span>${esc(holder)}</span></span>
        </div>
      `;
    }

    function transactionTagsCell(item, pendingMode) {
      if (pendingMode) {
        return `<div class="table-meta-stack">${priorityLabel(item)}${riskFlagChips(item, 2) || '<span class="muted">Sem tag</span>'}</div>`;
      }
      return `<div class="table-meta-stack">${riskFlagChips(item, 3) || '<span class="muted">Sem tag</span>'}</div>`;
    }

    function driverCell(item) {
      const avatarClass = item.tone === "green" ? "green" : item.tone === "orange" ? "orange" : item.tone === "violet" ? "violet" : "";
      return `
        <div class="driver-cell">
          <span class="driver-copy"><strong>${esc(item.nick)}</strong><span>${esc(item.vehicle)}</span></span>
        </div>
      `;
    }

    function summaryTable(rows) {
      const map = new Map();
      rows.forEach((item) => {
        const key = `${item.date.slice(0, 10)}|${item.nick}`;
        const current = map.get(key) || { date: item.date.slice(0, 10), nick: item.nick, count: 0, value: 0, pending: 0 };
        current.count += 1;
        current.value += item.value;
        if (!isClosedStatus(item.status)) current.pending += 1;
        map.set(key, current);
      });
      const summary = [...map.values()].sort((a, b) => b.date.localeCompare(a.date) || b.value - a.value);
      if (!summary.length) return '<div class="card-pad"><div class="empty">Sem dados para resumir.</div></div>';
      return `
        <div class="table-wrap medium">
          <table>
            <thead><tr><th>Dia</th><th>Motorista</th><th class="right">Transações</th><th class="right">Pendências</th><th class="right">Total</th><th>Leitura</th></tr></thead>
            <tbody>
              ${summary.map((row) => `
                <tr>
                  <td>${dateFmt.format(new Date(row.date))}</td>
                  <td>${esc(row.nick)}</td>
                  <td class="right">${row.count}</td>
                  <td class="right">${row.pending}</td>
                  <td class="right money">${money(row.value)}</td>
                  <td>${row.pending ? '<span class="pill warn">Regularizar</span>' : '<span class="pill good">Fechado</span>'}</td>
                </tr>
              `).join("")}
            </tbody>
          </table>
        </div>
      `;
    }

    function renderInspector() {
      const canShowByView = INSPECTOR_VIEWS.has(state.view);
      const workspace = document.getElementById("workspace");
      const inspector = document.getElementById("inspector");
      const item = selectedTransaction();
      workspace?.setAttribute("data-view", state.view);
      workspace.classList.toggle("no-inspector", !canShowByView || !item);
      if (!canShowByView) {
        inspector.innerHTML = "";
        return;
      }
      if (!item) {
        inspector.innerHTML = "";
        return;
      }
      const inspectorTabs = state.view === "auditoria" ? ["resumo"] : ["resumo", "evidencia", "auditoria"];
      if (!inspectorTabs.includes(state.inspectorTab)) state.inspectorTab = "resumo";
      inspector.innerHTML = `
        <div class="inspector-head">
          <div class="inspector-top">
            <span class="pill ${statusClass(item.status)}">${esc(item.status)}</span>
            <button class="icon-btn" type="button" id="closeInspector" aria-label="Ocultar detalhe">${icons.close}</button>
          </div>
          <h3>${esc(item.place)}</h3>
          <p>${esc(item.id)} · ${esc(item.origin)} · ${dateTimeFmt.format(new Date(item.date))}</p>
        </div>
        <div class="inspector-tabs">
          ${inspectorTabs.map((tab) => `<button type="button" data-inspector-tab="${tab}" class="${state.inspectorTab === tab ? "active" : ""}">${tabLabel(tab)}</button>`).join("")}
        </div>
        <div class="inspector-body">${inspectorBody(item)}</div>
        ${inspectorActionButtons(item)}
      `;
      document.getElementById("closeInspector").addEventListener("click", () => closeSelectedTransaction());
      inspector.querySelectorAll("[data-inspector-tab]").forEach((button) => {
        button.addEventListener("click", () => {
          state.inspectorTab = button.dataset.inspectorTab;
          renderInspector();
        });
      });
      inspector.querySelectorAll("[data-hot-edit]").forEach((field) => {
        const eventName = field.tagName === "TEXTAREA" || field.type === "number" ? "change" : "change";
        field.addEventListener(eventName, () => {
          saveHotEdit(item, field.dataset.hotEdit, field.value).catch((error) => toast(error.message || "Falha no hot edit."));
        });
      });
      inspector.querySelectorAll("[data-hot-edit-unlock]").forEach((button) => {
        button.addEventListener("click", () => {
          state.unlockedHotEditIds.add(button.dataset.hotEditUnlock);
          renderInspector();
        });
      });
      inspector.querySelectorAll("[data-hot-edit-lock]").forEach((button) => {
        button.addEventListener("click", () => {
          state.unlockedHotEditIds.delete(button.dataset.hotEditLock);
          renderInspector();
        });
      });
      const uploadInput = inspector.querySelector("#expenseEvidenceFile");
      const uploadButton = inspector.querySelector("[data-upload-evidence]");
      if (uploadInput && uploadButton) {
        const filenameField = inspector.querySelector("[data-evidence-file-name]");
        const updateUploadState = () => {
          const hasFile = Boolean(uploadInput.files?.[0]);
          if (filenameField) filenameField.textContent = hasFile ? uploadInput.files[0].name : "Sem arquivo";
          uploadButton.disabled = uploadButton.hasAttribute("disabled") || !hasFile;
        };
        updateUploadState();
        uploadInput.addEventListener("change", updateUploadState);
        uploadButton.addEventListener("click", () => uploadEvidenceForItem(item, uploadInput.files?.[0]).catch((error) => toast(error.message || "Falha no upload.")));
      }
      inspector.querySelectorAll("[data-action]").forEach((button) => button.addEventListener("click", () => runNamedAction(button.dataset.action, button)));
      inspector.querySelectorAll("[data-inspector-action]").forEach((button) => button.addEventListener("click", () => runNamedAction(button.dataset.inspectorAction, button)));
      if (state.inspectorTab === "auditoria" && !auditState.cache.has(item.id)) ensureAuditHistoryLoaded(item);
      if (state.inspectorTab === "evidencia" && !evidenceState.cache.has(item.id)) ensureEvidenceLoaded(item);
    }

    function closeSelectedTransaction(options = {}) {
      const inspector = document.getElementById("inspector");
      const shouldAnimate = options.animate !== false && Boolean(inspector?.innerHTML.trim());
      state.selectedId = null;
      state.inspectorTab = "resumo";
      if (options.clearBulk) state.selectedIds.clear();
      updateSelectedRows();
      if (!shouldAnimate) {
        render({ soft: true });
        return;
      }
      inspector.classList.add("closing");
      window.setTimeout(() => render({ soft: true }), 320);
    }

    function updateSelectedRows() {
      document.querySelectorAll("tr[data-id]").forEach((row) => row.classList.toggle("selected", row.dataset.id === state.selectedId));
      document.querySelectorAll("[data-card-id]").forEach((card) => card.classList.toggle("selected", card.dataset.cardId === state.selectedId));
    }

    function applyMotionIndices() {
      const selectors = [".metric", ".panel", ".task-card", ".transaction-card", "tbody tr"];
      selectors.forEach((selector) => {
        document.querySelectorAll(selector).forEach((element, index) => {
          element.style.setProperty("--stagger-index", String(Math.min(index, 24)));
        });
      });
      syncSegmentedControls();
    }

    function segmentedActiveButton(segmented) {
      return segmented?.querySelector("button.active") || segmented?.querySelector("button") || null;
    }

    function segmentedThumbMetrics(segmented, button) {
      if (!segmented || !button) return { x: 4, width: 0 };
      return {
        x: button.offsetLeft,
        width: button.offsetWidth
      };
    }

    function setSegmentedThumb(segmented, thumb, metrics, animate = false) {
      thumb.style.transition = animate ? "" : "none";
      segmented.style.setProperty("--segmented-thumb-x", `${Math.max(0, metrics.x)}px`);
      segmented.style.setProperty("--segmented-thumb-width", `${Math.max(0, metrics.width)}px`);
      if (!animate) thumb.getBoundingClientRect();
    }

    function selectSegmentedButton(segmented, selectedButton) {
      segmented?.querySelectorAll("button").forEach((button) => {
        const selected = button === selectedButton;
        button.classList.toggle("active", selected);
        button.setAttribute("aria-pressed", selected ? "true" : "false");
      });
    }

    function captureSegmentedMotion(segmented) {
      if (!segmented) return null;
      const thumb = segmented.querySelector(".segmented-thumb");
      const segmentedRect = segmented.getBoundingClientRect();
      const thumbRect = thumb?.getBoundingClientRect();
      const id = segmented.dataset.segmented || "";
      if (thumbRect && segmentedRect && thumbRect.width > 0) {
        return {
          id,
          x: thumbRect.left - segmentedRect.left + segmented.scrollLeft,
          width: thumbRect.width
        };
      }
      const metrics = segmentedThumbMetrics(segmented, segmentedActiveButton(segmented));
      return { id, ...metrics };
    }

    function slideSegmentedToButton(segmented, selectedButton) {
      const thumb = segmented?.querySelector(".segmented-thumb");
      if (!segmented || !selectedButton || !thumb) return;
      setSegmentedThumb(segmented, thumb, captureSegmentedMotion(segmented), false);
      selectSegmentedButton(segmented, selectedButton);
      segmented.classList.add("is-sliding");
      requestAnimationFrame(() => {
        setSegmentedThumb(segmented, thumb, segmentedThumbMetrics(segmented, selectedButton), true);
        if (segmented.scrollWidth > segmented.clientWidth) {
          selectedButton.scrollIntoView({ block: "nearest", inline: "nearest", behavior: "smooth" });
        }
      });
      window.setTimeout(() => segmented.classList.remove("is-sliding"), 360);
    }

    function syncSegmentedControls() {
      const motion = state.segmentedMotionFrom;
      document.querySelectorAll(".segmented").forEach((segmented) => {
        const thumb = segmented.querySelector(".segmented-thumb");
        if (!thumb) return;
        const activeButton = segmentedActiveButton(segmented);
        const activeMetrics = segmentedThumbMetrics(segmented, activeButton);
        const segmentedId = segmented.dataset.segmented || "";
        const scopedMotion = motion
          && typeof motion === "object"
          && (motion.id || "") === segmentedId
          && Number.isFinite(motion.x)
          && Number.isFinite(motion.width)
          ? motion
          : null;
        const fromMetrics = scopedMotion
          ? { x: scopedMotion.x, width: scopedMotion.width }
          : activeMetrics;
        const shouldAnimate = scopedMotion
          && (Math.abs(fromMetrics.x - activeMetrics.x) > .5 || Math.abs(fromMetrics.width - activeMetrics.width) > .5);

        setSegmentedThumb(segmented, thumb, fromMetrics, false);

        if (shouldAnimate) {
          requestAnimationFrame(() => {
            requestAnimationFrame(() => {
              setSegmentedThumb(segmented, thumb, segmentedThumbMetrics(segmented, activeButton), true);
              if (segmented.scrollWidth > segmented.clientWidth) {
                activeButton?.scrollIntoView({ block: "nearest", inline: "nearest", behavior: "smooth" });
              }
            });
          });
        } else {
          requestAnimationFrame(() => {
            setSegmentedThumb(segmented, thumb, segmentedThumbMetrics(segmented, activeButton), false);
            thumb.style.transition = "";
          });
        }
      });
      state.segmentedMotionFrom = null;
    }

    function selectTransaction(id) {
      const wasInspectorOpen = Boolean(state.selectedId);
      state.selectedId = id;
      if (!wasInspectorOpen) state.inspectorTab = "resumo";
      document.getElementById("inspector")?.classList.remove("closing");
      updateSelectedRows();
      renderInspector();
    }

    function inspectorActionButtons(item) {
      const key = statusKey(item.status);
      const finalStatus = isClosedStatus(item.status);
      const actions = [];
      if (!finalStatus) {
        actions.push({ label: "Validar", action: "validate-selected", className: "btn success" });
      }
      if (!finalStatus && key !== "cancelado") {
        actions.push({ label: "Invalidar", action: "invalidate-selected", className: "btn danger" });
      }
      if (!actions.length) return "";
      const hasSingleAction = actions.length === 1;
      const duplicateTag = item.duplicate ? '<span class="pill danger inspector-tag">Possível duplicidade</span>' : "";
      return `
        <div class="inspector-actions">
          ${duplicateTag}
          <div class="inspector-action-group">
          ${actions.map((itemAction) => {
        const wideClass = hasSingleAction ? " wide" : "";
        return '<button class="' + itemAction.className + wideClass + '" type="button" data-inspector-action="' + itemAction.action + '">' + itemAction.label + '</button>';
      }).join("")}
          </div>
        </div>
      `;
    }

    function evidenceAttachmentPanel(item) {
      if (evidenceState.uploading.has(item.id)) {
        return `<div class="api-banner loading"><strong>OneDrive Business</strong><span>Enviando comprovante e aguardando link do Flow.</span></div>`;
      }
      if (evidenceState.loading.has(item.id)) {
        return `<div class="api-banner loading"><strong>Anexo do motorista</strong><span>Carregando comprovante vinculado.</span></div>`;
      }
      const error = evidenceState.errors.get(item.id);
      if (error) return "";
      const rows = evidenceState.cache.get(item.id) || [];
      if (!rows.length) return "";
      return `<div class="evidence-gallery">${rows.map((row) => evidenceAttachmentCard(row)).join("")}</div>`;
    }

    function evidenceFileExtension(row) {
      const value = cleanText(row?.mimeType || row?.name || row?.url, "").toLowerCase();
      if (value.includes("pdf") || /\.pdf(\?|$)/i.test(value)) return "PDF";
      if (value.includes("png") || /\.png(\?|$)/i.test(value)) return "PNG";
      if (value.includes("webp") || /\.webp(\?|$)/i.test(value)) return "WEBP";
      if (value.includes("jpeg") || value.includes("jpg") || /\.(jpg|jpeg)(\?|$)/i.test(value)) return "JPG";
      if (value.includes("heic") || value.includes("heif") || /\.(heic|heif)(\?|$)/i.test(value)) return "HEIC";
      return "ARQ";
    }

    function evidenceAttachmentCard(row) {
      const previewUrl = row.previewUrl || row.url;
      const isImage = /^image\//i.test(row.mimeType) || /\.(jpg|jpeg|png|webp|heic|heif)(\?|$)/i.test(row.name || row.url || "");
      const isPdf = /pdf/i.test(row.mimeType) || /\.pdf(\?|$)/i.test(row.name || row.url || "");
      const fileCard = `
        <div class="evidence-file-card">
          <span class="evidence-file-icon">${esc(evidenceFileExtension(row))}</span>
        </div>
      `;
      const preview = isImage && previewUrl
        ? `<img src="${esc(previewUrl)}" alt="${esc(row.name)}" loading="lazy">`
        : isPdf && previewUrl
          ? `<iframe src="${esc(previewUrl)}" title="${esc(row.name)}" loading="lazy"></iframe>`
          : fileCard;
      const previewMarkup = row.url && isPdf && previewUrl
        ? `<div class="evidence-preview-frame">${preview}<a class="evidence-preview-link" href="${esc(row.url)}" target="_blank" rel="noopener" aria-label="Abrir evidencia"></a></div>`
        : row.url
          ? `<a class="evidence-preview-link" href="${esc(row.url)}" target="_blank" rel="noopener" aria-label="Abrir evidencia">${preview}</a>`
          : preview;
      return `
        <div class="evidence-attachment">
          ${previewMarkup}
          <div class="evidence-date">${esc(row.uploadedAt)}</div>
        </div>
      `;
    }

    function inspectorBody(item) {
      const receiptEditState = receiptEditContext(item);
      if (state.inspectorTab === "evidencia") {
        return `
          ${evidenceAttachmentPanel(item)}
          <div class="spacer"></div>
          ${uploadEvidencePanel(item)}
        `;
      }
      if (state.inspectorTab === "auditoria") {
        return auditHistoryPanel(item);
      }
      const cardDivergence = Expense.cardDivergenceReason(item);
      const metrics = Expense.fuelMetricsForExpense(item, policyState.active);
      return `
        ${receiptEditBanner(item, receiptEditState)}
        <div class="receipt-preview ${!receiptEditState.baseBlockedReason && !receiptEditState.unlocked ? "receipt-preview--hot" : ""} ${receiptEditState.unlocked ? "is-editable" : "is-locked"}">
          ${receiptEditUnlockButton(item, receiptEditState)}
          <div class="receipt-line"><span>Motorista</span>${receiptDriverControl(item, receiptEditState)}</div>
          <div class="receipt-line"><span>Estabelecimento</span>${receiptPlaceControl(item, receiptEditState)}</div>
          <div class="receipt-line"><span>Valor</span>${receiptValueControl(item, receiptEditState)}</div>
          <div class="receipt-line"><span>Competência</span>${receiptDateControl(item, receiptEditState)}</div>
          <div class="receipt-line"><span>Canal</span>${receiptFinancialChannelControl(item, receiptEditState)}</div>
          <div class="receipt-line"><span>Cartão</span>${receiptCardControl(item, receiptEditState)}</div>
          <div class="receipt-line"><span>Portador</span>${receiptCardHolderControl(item, receiptEditState)}</div>
          <div class="receipt-line"><span>Categoria</span>${receiptCategoryControl(item, receiptEditState)}</div>
          <div class="receipt-line"><span>Status</span>${receiptStatusControl(item, receiptEditState)}</div>
          <div class="receipt-line"><span>Anexo</span>${receiptAttachmentControl(item, receiptEditState)}</div>
          <div class="receipt-line"><span>Classificação</span>${receiptClassificationControl(item, receiptEditState)}</div>
          <div class="receipt-line"><span>Pendência</span>${receiptPendingTypeControl(item, receiptEditState)}</div>
          <div class="receipt-line"><span>SLA</span><strong>${esc(isLate(item) ? "Vencido" : dateTimeFmt.format(new Date(item.deadline)))}</strong></div>
          <div class="receipt-line"><span>Duplicidade</span>${receiptDuplicateControl(item, receiptEditState)}</div>
          <div class="receipt-line"><span>Política</span><strong>${esc(policyStatusForExpense(item))}</strong></div>
          <div class="receipt-line"><span>Flags</span><strong class="wrap">${riskFlagSummary(item)}</strong></div>
          ${fuelReceiptRows(item, receiptEditState, metrics)}
          <div class="receipt-line"><span>Divergência cartão</span><strong class="wrap">${esc(cardDivergence || "Sem divergência")}</strong></div>
          <div class="receipt-line receipt-line--note"><span>Observação</span>${receiptNoteControl(item, receiptEditState)}</div>
        </div>
      `;
    }

    function riskFlagSummary(item) {
      return riskFlagChips(item) || '<span class="muted">Sem flag</span>';
    }

    function fuelReceiptRows(item, receiptEditState, metrics) {
      if (!isFuelExpense(item)) return "";
      const liters = metrics.liters ? `${metrics.liters.toLocaleString("pt-BR")} L` : "Litros não informados";
      const price = metrics.pricePerLiter ? `${money(metrics.pricePerLiter)} / L` : "Preço/L não calculado";
      const consumption = metrics.consumptionKmPerLiter ? `${metrics.consumptionKmPerLiter} km/L` : "Consumo não calculado";
      return `
