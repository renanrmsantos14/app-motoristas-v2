    }

    .executive-card {
      color: oklch(0.985 0.004 235);
      background: oklch(0.25 0.048 252);
      border: 1px solid oklch(0.34 0.055 252);
      box-shadow: var(--shadow);
    }

    .executive-card::after {
      inset: 12px 14px auto auto;
      width: 96px;
      height: 96px;
      border-color: oklch(0.985 0.004 235 / .18);
      opacity: .9;
    }

    .executive-card span,
    .executive-card p {
      color: oklch(0.89 0.018 235);
    }

    .executive-card strong {
      color: oklch(0.985 0.004 235);
    }

    .line-chart {
      min-height: 260px;
    }

    .chart-grid-line {
      stroke: oklch(0.80 0.018 235);
    }

    .chart-point {
      fill: var(--surface);
    }

    .chart-axis {
      color: var(--muted);
      fill: currentColor;
      font-weight: 600;
    }

    .chart-bar {
      fill: oklch(0.72 0.10 292);
      opacity: .58;
    }

    .table-wrap {
      border: 1px solid var(--line-soft);
      background: var(--surface);
      box-shadow: inset 0 1px 0 oklch(0.995 0.004 235 / .7);
    }

    table {
      width: max(100%, var(--table-min));
      min-width: max(100%, var(--table-min));
    }

    th {
      position: sticky;
      top: 0;
      z-index: 1;
      background: var(--surface-soft);
      color: var(--ink-soft);
    }

    td {
      background: var(--surface);
    }

    tbody tr:hover td {
      background: oklch(0.978 0.011 235);
    }

    tr.selected td {
      background: var(--blue-soft);
    }

    tr.action-flash-ok,
    tr.action-flash-ok td {
      position: relative;
      animation: rowStatusPulseOk 1.05s var(--ease-fluid) both;
    }

    tr.action-flash-warn,
    tr.action-flash-warn td {
      position: relative;
      animation: rowStatusPulseWarn 1.05s var(--ease-fluid) both;
    }

    .status-flash-ok {
      animation: statusPillPulseOk 1.05s var(--ease-fluid) both;
    }

    .status-flash-warn {
      animation: statusPillPulseWarn 1.05s var(--ease-fluid) both;
    }

    input[type="checkbox"] {
      width: 16px;
      height: 16px;
      accent-color: var(--blue);
    }

    .task-card,
    .audit-item {
      background: var(--surface);
      border-color: var(--line);
      box-shadow: var(--shadow-hairline);
    }

    .task-card:hover {
      transform: translateY(-2px);
      border-color: oklch(0.79 0.036 246);
      box-shadow: var(--shadow-soft);
    }

    .task-card.selected,
    tr.selected {
      outline: 2px solid oklch(0.56 0.19 259 / .28);
      outline-offset: -2px;
    }

    .pill {
      min-height: 23px;
      border: 1px solid currentColor;
      border-color: color-mix(in oklch, currentColor 24%, transparent);
    }

    .empty {
      background: var(--surface-soft);
      border-color: var(--line);
    }

    .api-banner {
      background: var(--surface);
      border-color: var(--line);
      box-shadow: var(--shadow-hairline);
    }

    .switch {
      background: var(--green);
      box-shadow: inset 0 0 0 1px oklch(0.22 0.02 155 / .14);
    }

    .switch::after {
      background: var(--surface);
    }

    .modal-backdrop {
      background: oklch(0.21 0.032 250 / .48);
      backdrop-filter: blur(6px);
    }

    .modal {
      border-color: oklch(0.80 0.022 235);
      box-shadow: 0 30px 90px rgb(15 23 42 / .30);
    }

    .toast,
    .skip-link {
      background: var(--ink);
      color: oklch(0.985 0.004 235);
    }

    @keyframes fadeUp {
      from {
        opacity: 0;
        transform: translateY(16px) scale(.988);
        filter: blur(7px);
      }

      to {
        opacity: 1;
        transform: translateY(0) scale(1);
        filter: blur(0);
      }
    }

    @keyframes toastFlash {
      0% {
        transform: translate3d(-12px, 12px, 0) scale(0.97);
        filter: blur(1px);
      }

      65% {
        transform: translate3d(2px, -1px, 0) scale(1.005);
        filter: blur(0);
      }

      100% {
        transform: translate3d(0, 0, 0) scale(1);
      }
    }

    @keyframes toastSheen {
      0% {
        transform: translateX(-100%);
      }

      40% {
        transform: translateX(120%);
      }

      100% {
        transform: translateX(120%);
      }
    }

    @keyframes rowStatusPulseOk {
      0% {
        box-shadow: 0 0 0 0 oklch(0.55 0.16 145 / 0.22);
        background: color-mix(in oklch, var(--green-soft) 38%, var(--surface));
      }
      100% {
        box-shadow: 0 0 0 0 transparent;
        background: var(--surface);
      }
    }

    @keyframes rowStatusPulseWarn {
      0% {
        box-shadow: 0 0 0 0 oklch(0.62 0.19 22 / 0.22);
        background: color-mix(in oklch, var(--red-soft) 36%, var(--surface));
      }
      100% {
        box-shadow: 0 0 0 0 transparent;
        background: var(--surface);
      }
    }

    @keyframes statusPillPulseOk {
      0% {
        transform: scale(1);
        box-shadow: 0 0 0 0 color-mix(in oklch, var(--green) 16%, transparent);
      }
      45% {
        transform: scale(1.07);
        box-shadow: 0 0 0 12px color-mix(in oklch, var(--green) 0%, transparent);
      }
      100% {
        transform: scale(1);
        box-shadow: 0 0 0 0 transparent;
      }
    }

    @keyframes statusPillPulseWarn {
      0% {
        transform: scale(1);
        box-shadow: 0 0 0 0 color-mix(in oklch, var(--red) 20%, transparent);
      }
      45% {
        transform: scale(1.07);
        box-shadow: 0 0 0 12px color-mix(in oklch, var(--red) 0%, transparent);
      }
      100% {
        transform: scale(1);
        box-shadow: 0 0 0 0 transparent;
      }
    }

    @keyframes viewEnter {
      from {
        opacity: 0;
        transform: translateY(20px) scale(.988);
        filter: blur(10px);
      }

      to {
        opacity: 1;
        transform: translateY(0) scale(1);
        filter: blur(0);
      }
    }

    @keyframes stageIn {
      0% {
        opacity: 0;
        transform: translateY(18px) scale(.985);
        filter: blur(8px);
      }

      60% {
        opacity: 1;
        transform: translateY(-2px) scale(1.003);
        filter: blur(0);
      }

      100% {
        opacity: 1;
        transform: translateY(0) scale(1);
        filter: blur(0);
      }
    }

    @keyframes fadeIn {
      from {
        opacity: 0;
        filter: blur(4px);
      }

      to {
        opacity: 1;
        filter: blur(0);
      }
    }

    @keyframes segmentedSheen {
      0% {
        opacity: 0;
        transform: translateX(0) skewX(-18deg);
      }

      18% {
        opacity: .72;
      }

      100% {
        opacity: 0;
        transform: translateX(420%) skewX(-18deg);
      }
    }

    @keyframes modalIn {
      0% {
        opacity: 0;
        transform: translateY(24px) scale(.955);
        filter: blur(12px);
      }

      68% {
        opacity: 1;
        transform: translateY(-4px) scale(1.006);
        filter: blur(0);
      }

      100% {
        opacity: 1;
        transform: translateY(0) scale(1);
        filter: blur(0);
      }
    }

    @keyframes inspectorIn {
      0% {
        opacity: 0;
        transform: translateX(18px) scale(.97);
        filter: blur(10px);
      }

      70% {
        opacity: 1;
        transform: translateX(-2px) scale(1.003);
        filter: blur(0);
      }

      100% {
        opacity: 1;
        transform: translateX(0) scale(1);
        filter: blur(0);
      }
    }

    @keyframes inspectorOut {
      from {
        opacity: 1;
        transform: translateX(0) scale(1);
        filter: blur(0);
      }

      to {
        opacity: 0;
        transform: translateX(20px) scale(.985);
        filter: blur(8px);
      }
    }

    @keyframes pulse {

      0%,
      100% {
        transform: scale(1);
        opacity: 1;
      }

      50% {
        transform: scale(.72);
        opacity: .72;
      }
    }

    @keyframes ambientDrift {
      0% {
        transform: translate3d(-2%, -4%, 0) scale(1);
      }

      50% {
        transform: translate3d(2%, 2%, 0) scale(1.05);
      }

      100% {
        transform: translate3d(-1%, 4%, 0) scale(1.02);
      }
    }

@keyframes drawLine {
      to {
        stroke-dashoffset: 0;
      }
    }

    @keyframes spin {
      to {
        transform: rotate(360deg);
      }
    }

    @keyframes refreshCardPulse {
      0%,
      100% {
        transform: translateY(0) scale(1);
      }
      50% {
        transform: translateY(-2px) scale(1.01);
      }
    }

    @keyframes refreshShine {
      0%,
      100% {
        transform: scale(1);
        opacity: .38;
      }

      50% {
        transform: scale(1.15);
        opacity: .22;
      }
    }

    @keyframes refreshSpin {
      to {
        transform: rotate(360deg);
      }
    }

    @keyframes refreshDot {
      0%,
      100% {
        transform: translateX(-50%) translateY(0) scale(0.85);
      }

      50% {
        transform: translateX(-50%) translateY(-1px) scale(1.1);
      }
    }

    @keyframes barIn {
      from {
        transform: scaleY(.08);
        opacity: .2;
      }

      to {
        transform: scaleY(1);
        opacity: .72;
      }
    }

    @keyframes growX {
      from {
        transform: scaleX(.04);
        transform-origin: left;
      }

