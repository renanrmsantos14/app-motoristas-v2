    function evidenceMimeType(row) {
      const explicit = cleanText(row?.mimeType, "");
      if (explicit) return explicit;
      const name = cleanText(row?.cr40f_nomearquivo || row?.cr40f_nome || row?.fileName, "").toLowerCase();
      if (/\.pdf$/i.test(name)) return "application/pdf";
      if (/\.png$/i.test(name)) return "image/png";
      if (/\.webp$/i.test(name)) return "image/webp";
      if (/\.(jpg|jpeg)$/i.test(name)) return "image/jpeg";
      if (/\.(heic|heif)$/i.test(name)) return "image/heic";
      return "";
    }

