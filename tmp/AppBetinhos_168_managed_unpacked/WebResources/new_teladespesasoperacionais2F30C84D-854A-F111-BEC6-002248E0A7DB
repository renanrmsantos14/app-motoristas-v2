    }

    .metric,
    .panel {
      transition: box-shadow var(--motion-fast) var(--ease-snap), border-color var(--motion-fast) var(--ease-snap), transform var(--motion-fast) var(--ease-snap), filter var(--motion-fast) var(--ease-snap);
    }

    .metric:hover,
    .panel:hover {
      transform: translateY(-3px) scale(1.003);
      border-color: oklch(0.82 0.025 246);
      box-shadow: var(--shadow);
      filter: saturate(1.04);
    }

    .metric {
