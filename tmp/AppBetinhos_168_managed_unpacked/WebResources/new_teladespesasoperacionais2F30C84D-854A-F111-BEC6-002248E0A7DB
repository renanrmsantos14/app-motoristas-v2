    function setupForms() {
      syncDriverControls();
      fillSelect("formOrigin", origins.map((origin) => [origin, origin]), "Digitação Financeiro");
      fillSelect("formCategory", categories.map((category) => [category, category]), "Combustível");
      renderRejectReasonTags();

      document.getElementById("formDriver").addEventListener("change", (event) => {
        const driver = drivers.find((item) => item.id === event.target.value && item.isRealEmployee !== false);
        if (driver) document.getElementById("formVehicle").value = driver.vehicle;
      });

      document.getElementById("expenseForm").addEventListener("submit", async (event) => {
        event.preventDefault();
        const category = document.getElementById("formCategory").value;
        const note = document.getElementById("formNote").value.trim();
        const km = document.getElementById("formKm").value;
        if (category === "Outros" && !note) return toast("Categoria Outros exige observação.");
        if (category === "Combustível" && !km) return toast("Combustível exige KM informado.");
        const id = `tx-${Date.now()}`;
        const driverId = document.getElementById("formDriver").value;
        let driver = drivers.find((item) => item.id === driverId && item.isRealEmployee !== false);
        if (!driver && MOCK_MODE) {
          drivers = [...demoDrivers];
          syncDriverControls();
          driver = drivers[0];
        }
        if (!driver) return toast("Carregue Funcionários do Dataverse antes de lançar.");
        const origin = document.getElementById("formOrigin").value;
        const date = document.getElementById("formDate").value ? new Date(document.getElementById("formDate").value).toISOString() : new Date().toISOString();
        const value = Number(document.getElementById("formValue").value || 0);
        const place = document.getElementById("formPlace").value.trim() || "Sem estabelecimento";
        if (category === "Combustível") {
          const kmAlert = Expense.kmAlertForExpense({ category, km: Number(km), previousKm: previousFuelKmForItem({ driverId, date, id }) }, policyState.active);
          if (kmAlert.severity === "block") return toast(kmAlert.label);
          if (kmAlert.severity === "warn") toast(kmAlert.label);
        }
        const expense = createManualExpense(id, origin, driverId, date, value, place, category, "Pendente", "Financeiro", "Nao Enviado", km ? Number(km) : null, false, "Pendente", note || "Despesa criada manualmente.", { employeeId: driver.id });
        if (!MOCK_MODE) {
          const api = getXrmApi();
          if (!api?.createRecord) return toast("Dataverse indisponivel para criar despesa.");
          try {
            const result = await createDataverseRecord(api, "cr40f_despesa", dataverseExpenseRecordFromAppExpense(expense, { cr40f_criadaporintegracao: false }));
            expense.id = result?.id || expense.id;
            expense.dataverseTable = "cr40f_despesa";
            expense.source = "Dataverse";
          } catch (error) {
            toast(`Dataverse: ${error.message || "falha ao criar despesa"}`);
            return;
          }
        }
        transactions.unshift(expense);
        state.selectedId = expense.id;
        state.selectedIds.clear();
        closeModal("expenseModal");
        event.target.reset();
        toast(MOCK_MODE ? "Despesa criada localmente." : "Despesa criada no Dataverse.");
        render();
        return;
      });

      document.getElementById("rejectForm").addEventListener("submit", async (event) => {
        event.preventDefault();
        const customReason = String(document.getElementById("rejectReasonNewTag").value || "").trim();
        const selectedReason = String(document.getElementById("rejectReasonTag").value || "").trim();
        const reason = customReason || selectedReason;
        const observation = String(document.getElementById("rejectObservation").value || "").trim();
        const confirmation = document.getElementById("rejectConfirm").value.trim();
        if (!reason) return toast("Selecione uma tag ou adicione uma nova tag.");
        if (customReason && !state.rejectReasonTags.includes(customReason)) {
          state.rejectReasonTags.push(customReason);
          state.rejectReasonTags = normalizeRejectTags(state.rejectReasonTags);
        }
        if (confirmation !== "INVALIDAR") return toast("Digite INVALIDAR para confirmar.");
        await invalidateCurrent(reason, observation);
      });

      document.getElementById("valueConfirmForm").addEventListener("submit", confirmPendingValueHotEdit);
      document.getElementById("cardAssignmentForm").addEventListener("submit", saveCardAssignment);
      document.getElementById("cardPossessionForm").addEventListener("submit", finalizeCardPossession);
    }

    function exportCsv() {
      const headers = ["id", "canal", "origem", "cartao_final", "motorista_guid", "motorista", "veiculo", "data", "valor", "estabelecimento", "categoria", "status", "anexo", "pendencia", "divergencia_cartao", "duplicidade", "flags_risco", "visto_supervisao", "litros", "preco_litro", "consumo_km_l", "alerta_km", "hash"];
      const rows = filteredTransactions().map((item) => {
        ensureDerivedExpenseFields(item);
        return [
          item.id,
          financialChannelLabel(item.financialChannel),
          item.origin,
          item.cardLast4 || "",
          item.employeeId || item.driverId,
          item.nick,
          item.vehicle,
          item.date,
          item.value,
          item.place,
          item.category,
          item.status,
          item.attachment,
          item.pendingType,
          Expense.cardDivergenceReason(item),
          item.duplicate ? "sim" : "nao",
          riskFlagsForExpense(item).map((flag) => flag.label).join(", "),
          item.reviewSeen ? "sim" : "nao",
          item.liters || "",
          item.pricePerLiter || "",
          item.consumptionKmPerLiter || "",
          item.kmAlert || "",
          item.hash
        ];
      });
      const csv = `\uFEFF${[headers, ...rows].map((line) => line.map((cell) => `"${String(cell ?? "").replace(/"/g, '""')}"`).join(";")).join("\n")}`;
      const blob = new Blob([csv], { type: "text/csv;charset=utf-8" });
      const url = URL.createObjectURL(blob);
      const anchor = document.createElement("a");
      anchor.href = url;
      anchor.download = "despesas-betinhos.csv";
      anchor.click();
      URL.revokeObjectURL(url);
      toast("CSV exportado com os filtros atuais.");
    }

