    function openCardPossessionModal(id) {
      const assignment = cardAssignments.find((item) => item.id === id);
      if (!assignment) return toast("Vinculo de cartão nao encontrado.");
      state.pendingCardAssignmentId = id;
      document.getElementById("cardPossessionForm").reset();
      document.getElementById("cardPossessionSummary").value = `Final ${assignment.last4} · ${assignment.driverNick || assignment.driverName || "Sem motorista"}`;
      document.getElementById("cardPossessionEnd").value = new Date().toISOString().slice(0, 10);
      openModal("cardPossessionModal");
    }

    async function finalizeCardPossession(event) {
      event.preventDefault();
      const assignment = cardAssignments.find((item) => item.id === state.pendingCardAssignmentId);
      const row = cardAssignmentRows.find((item) => cleanText(item?.cr40f_cartaomotoristaid, "") === state.pendingCardAssignmentId);
      const end = document.getElementById("cardPossessionEnd")?.value;
      const reason = document.getElementById("cardPossessionReason")?.value.trim();
      if (!assignment) return toast("Vinculo de cartão nao encontrado.");
      if (!end) return toast("Informe a data final.");
      if (!reason) return toast("Informe o motivo.");
      const endDateValue = end;
      if (assignment.startDate && new Date(`${endDateValue}T23:59:59`) < new Date(assignment.startDate)) return toast("Data final nao pode ser anterior ao inicio.");

      if (!MOCK_MODE) {
        const api = getXrmApi();
        if (!api?.updateRecord) return toast("Dataverse indisponível para finalizar posse.");
        try {
          await updateDataverseRecord(api, "cr40f_cartaomotorista", assignment.id, {
            cr40f_statusvinculo: 100000001,
            cr40f_datafim: endDateValue,
            cr40f_observacao: trimDataverseText(`${assignment.note ? `${assignment.note} | ` : ""}Fim da posse: ${reason}`, 4000)
          });
        } catch (error) {
          return toast(`Dataverse cartão: ${error.message || "falha ao finalizar posse"}`);
        }
      }

      if (row) {
        row.cr40f_statusvinculo = 100000001;
        row["cr40f_statusvinculo@OData.Community.Display.V1.FormattedValue"] = "Encerrado";
        row.cr40f_datafim = endDateValue;
        row.cr40f_motivofimposse = reason;
        row.cr40f_observacao = `${assignment.note ? `${assignment.note} | ` : ""}Fim da posse: ${reason}`;
      }
      refreshCardAssignments();
      pushMockAudit("Posse de cartão finalizada", `Cartão ${assignment.last4}: ${reason}.`);
      state.pendingCardAssignmentId = "";
      closeModal("cardPossessionModal");
      toast("Posse finalizada e histórico preservado.");
      render();
    }

    async function saveCardAssignment(event) {
      event.preventDefault();
      const driverId = document.getElementById("cardAssignmentDriver").value;
      const driver = drivers.find((item) => item.id === driverId && item.isRealEmployee !== false);
      const last4 = last4FromInput(document.getElementById("cardAssignmentLast4").value);
      const start = document.getElementById("cardAssignmentStart").value;
      const note = document.getElementById("cardAssignmentNote").value.trim();
      if (!driver) return toast("Selecione um motorista válido.");
      if (!last4) return toast("Informe os 4 últimos dígitos do cartão.");
      if (!start) return toast("Informe a data de início.");

      const startDateValue = start;
      const conflictingAssignment = cardAssignmentConflict(last4, driver.id, startDateValue);
      if (conflictingAssignment) {
        toast(`Bloqueado: cartão ${last4} já está ativo para ${conflictingAssignment.driverNick || conflictingAssignment.driverName || "outro motorista"}.`);
        return;
      }
      const name = `Cartão ${last4} - ${driver.nick || driver.name}`;
      let id = `card-${Date.now()}`;

      if (!MOCK_MODE) {
        const api = getXrmApi();
        if (!api?.createRecord) return toast("Dataverse indisponível para salvar o vinculo.");
        try {
          const result = await createDataverseRecord(api, "cr40f_cartaomotorista", {
            cr40f_nome: name,
            cr40f_finalcartao: last4,
            cr40f_statusvinculo: 100000000,
            cr40f_datainicio: startDateValue,
            cr40f_observacao: note,
            "cr40f_Motorista@odata.bind": `/cr40f_funcionarioses(${driver.id})`
          });
          id = result?.id || id;
        } catch (error) {
          toast(`Dataverse cartão: ${error.message || "falha ao salvar"}`);
          return;
        }
      }

      cardAssignmentRows.unshift({
        cr40f_cartaomotoristaid: id,
        cr40f_nome: name,
        cr40f_finalcartao: last4,
        cr40f_datainicio: startDateValue,
        cr40f_statusvinculo: 100000000,
        cr40f_observacao: note,
        "_cr40f_motorista_value": driver.id,
        "_cr40f_motorista_value@OData.Community.Display.V1.FormattedValue": driver.name
      });
      refreshCardAssignments();
      auditLog.unshift({ id: `log-${Date.now()}`, title: `Cartão ${last4} vinculado`, detail: `${driver.nick || driver.name} agora e portador cadastrado.`, date: new Date().toISOString(), actor: "Financeiro" });
      closeModal("cardAssignmentModal");
      const activeCount = driverActiveCardCount(driver.id, startDateValue);
      toast(activeCount > 1 ? `Vínculo salvo. Aviso: ${driver.nick || driver.name} esta com ${activeCount} cartões ativos.` : "Vinculo de cartão salvo.");
      render();
    }

    function urgencyScore(item) {
      const statusWeight = { "Cancelado": 0, "Pendente": 60, "Enviada": 30, "Aprovada": 0 }[item.status] || 0;
      const late = isLate(item) ? 28 : 0;
      const value = Math.min(item.value / 12, 28);
      const attachment = item.attachment === "Não Enviado" ? 18 : 0;
      return statusWeight + late + value + attachment;
    }

    function groupSum(rows, key) {
      const map = new Map();
      rows.forEach((item) => {
        const label = item[key] || "Sem valor";
        map.set(label, (map.get(label) || 0) + item.value);
      });
      return [...map.entries()].map(([label, value]) => ({ label, value })).sort((a, b) => b.value - a.value);
    }

    function groupSumByFinancialChannel(rows) {
      return groupSum(rows, "financialChannel").map((row) => ({ ...row, label: financialChannelLabel(row.label) }));
    }

    function groupCount(rows, key) {
      const map = new Map();
      rows.forEach((item) => {
        const label = item[key] || "Sem valor";
        map.set(label, (map.get(label) || 0) + 1);
      });
      return [...map.entries()].map(([label, value]) => ({ label, value })).sort((a, b) => b.value - a.value);
    }

    function barChart(rows, tone, currency) {
      const total = rows.reduce((sum, row) => sum + row.value, 0) || 1;
      if (!rows.length) return '<div class="empty">Sem dados.</div>';
      return `<div class="bars">
        ${rows.slice(0, 8).map((row) => {
        const percent = Math.max(0, Math.min(100, row.value / total * 100));
        return `
          <div class="bar-row" data-chart-tooltip="${esc(row.label)}" data-chart-value="${esc(currency ? money(row.value) : row.value)}" data-chart-meta="${esc(`${Math.round(row.value / total * 100)}% do total`)}">
            <span title="${esc(row.label)}">${esc(row.label)}</span>
            <div class="track"><div class="fill ${tone}" style="width:${percent}%"></div></div>
            <strong>${currency ? money(row.value) : row.value}</strong>
          </div>
        `;
      }).join("")}
      </div>`;
    }

    function donutChart(rows) {
      const top = rows.slice(0, 5);
      const total = top.reduce((sum, row) => sum + row.value, 0) || 1;
      const lead = top[0];
      let acc = 0;
      const slices = top.map((row) => {
        acc += row.value / total * 100;
        return `${acc}%`;
      });
      const style = `--slice-1:${slices[0] || "0%"};--slice-2:${slices[1] || slices[0] || "0%"};--slice-3:${slices[2] || slices[1] || "0%"};--slice-4:${slices[3] || slices[2] || "0%"};`;
      return `
        <div class="donut-layout">
          <div class="donut" data-chart-tooltip="Distribuição por categoria" data-chart-value="${esc(money(total))}" data-chart-meta="${esc(lead ? `${lead.label} lidera com ${Math.round(lead.value / total * 100)}%` : "Sem dados")}" style="${style}"><div class="donut-center">${money(total)}</div></div>
          <div class="legend">
            ${top.map((row, index) => `
              <div class="legend-item" data-chart-tooltip="${esc(row.label)}" data-chart-value="${esc(money(row.value))}" data-chart-meta="${esc(`${Math.round(row.value / total * 100)}% do total`)}">
                <span class="swatch" style="background:${["#2367f5", "#16b66a", "#f37a21", "#7157d9", "#e75891"][index]}"></span>
                <span>${esc(row.label)}</span>
                <strong>${Math.round(row.value / total * 100)}%</strong>
              </div>
            `).join("")}
          </div>
        </div>
      `;
    }

    function lastDays(total, referenceEnd = new Date()) {
      return Array.from({ length: total }, (_, index) => {
        const date = new Date(referenceEnd);
        date.setDate(date.getDate() - (total - index - 1));
        date.setHours(0, 0, 0, 0);
        return date;
      });
    }

    function buildTrendBuckets(bounds) {
      const totalDays = Math.max(1, Math.round((bounds.end - bounds.start) / (24 * 60 * 60 * 1000)) + 1);
      if (state.period === "year-current" || state.period === "year-last" || totalDays > 90) {
        const buckets = [];
        const cursor = new Date(bounds.start.getFullYear(), bounds.start.getMonth(), 1);
        const last = new Date(bounds.end.getFullYear(), bounds.end.getMonth(), 1);
        while (cursor <= last) {
          const key = `${cursor.getFullYear()}-${String(cursor.getMonth() + 1).padStart(2, "0")}`;
          buckets.push({ key, label: cursor.toLocaleDateString("pt-BR", { month: "short", year: "2-digit" }), value: 0, count: 0, mode: "month" });
          cursor.setMonth(cursor.getMonth() + 1);
        }
        return buckets;
      }
      const buckets = [];
      for (let cursor = startOfDay(bounds.start); cursor <= bounds.end; cursor = addDays(cursor, 1)) {
        buckets.push({ key: cursor.toISOString().slice(0, 10), label: dayFmt.format(cursor), value: 0, count: 0, mode: "day" });
      }
      return buckets;
    }

    function trendChart(rows) {
      const windowBounds = activeChartBounds();
      const buckets = buildTrendBuckets(windowBounds);
      rows.forEach((item) => {
        const date = new Date(item.date);
        const key = buckets[0]?.mode === "month"
          ? `${date.getFullYear()}-${String(date.getMonth() + 1).padStart(2, "0")}`
          : date.toISOString().slice(0, 10);
        const bucket = buckets.find((entry) => entry.key === key);
        if (bucket) {
          bucket.value += item.value;
          bucket.count += 1;
        }
      });
      const values = buckets.map((bucket) => bucket.value);
      const max = Math.max(...values, 1);
      const width = 700;
      const height = 260;
      const padX = 36;
      const padY = 24;
      const graphW = width - padX * 2;
      const graphH = height - padY * 2 - 22;
      if (!buckets.length) return '<div class="empty">Sem dados no período filtrado.</div>';
      const points = buckets.map((bucket, index) => {
        const x = padX + (graphW / Math.max(buckets.length - 1, 1)) * index;
        const y = padY + graphH - (bucket.value / max) * graphH;
        return { x, y, bucket };
      });
      const path = points.map((point, index) => `${index ? "L" : "M"} ${point.x.toFixed(1)} ${point.y.toFixed(1)}`).join(" ");
      const area = `${path} L ${points.at(-1).x.toFixed(1)} ${height - 38} L ${points[0].x.toFixed(1)} ${height - 38} Z`;
      return `
        <svg class="line-chart" viewBox="0 0 ${width} ${height}" role="img" aria-label="Gráfico comparativo da janela selecionada">
          <defs>
            <linearGradient id="chartFill" x1="0" x2="0" y1="0" y2="1">
              <stop offset="0%" stop-color="#2367f5" stop-opacity=".22"></stop>
              <stop offset="100%" stop-color="#2367f5" stop-opacity="0"></stop>
            </linearGradient>
          </defs>
          ${[0, 1, 2, 3].map((line) => `<line class="chart-grid-line" x1="${padX}" x2="${width - padX}" y1="${padY + line * (graphH / 3)}" y2="${padY + line * (graphH / 3)}"></line>`).join("")}
          <path class="chart-area" d="${area}"></path>
          <path class="chart-line" d="${path}"></path>
          ${points.map((point) => `<circle class="chart-point" data-chart-tooltip="${esc(point.bucket.label)}" data-chart-value="${esc(money(point.bucket.value))}" data-chart-meta="${esc(`${point.bucket.count} transações · período filtrado`)}" cx="${point.x.toFixed(1)}" cy="${point.y.toFixed(1)}" r="5"></circle>`).join("")}
          ${points.map((point) => `<text class="chart-axis" x="${point.x.toFixed(1)}" y="${height - 10}" text-anchor="middle">${esc(point.bucket.label)}</text>`).join("")}
        </svg>
      `;
    }

    function renderChartComparisonCards(items, formatter, _valueFormatter = null, horizontal = true) {
        const current = items.find((item) => item.scope === "current") || items[0] || { value: 0 };
        const comparisons = items.filter((item) => item.scope === "lm" || item.scope === "ly");
        const gridClass = horizontal ? "chart-compare-grid chart-compare-grid--horizontal" : "chart-compare-grid";
        const cardClass = horizontal ? "chart-compare-card chart-compare-card--horizontal" : "chart-compare-card";
        return `
          <div class="${gridClass}">
          ${comparisons.map((item) => {
        const ratio = item.value > 0 ? current.value / item.value : (current.value > 0 ? 1.01 : 1);
        const trendClass = ratio >= 1 ? "chart-compare-card--up" : "chart-compare-card--down";
        const percent = ratio * 100;
        const valueTone = percent < 95
          ? "chart-compare-value--danger"
          : percent <= 105
            ? "chart-compare-value--warning"
            : "chart-compare-value--success";
        return `
            <article class="${cardClass} ${trendClass}">
              <span class="chart-compare-label">${esc(item.label)}</span>
              <strong class="chart-compare-value ${valueTone}">${esc(`${Math.round(percent)}%`)}</strong>
              <span class="chart-compare-meta">${esc(formatter(item.value))}</span>
            </article>
          `;
      }).join("")}
        </div>
      `;
    }

    function profitStats(expenseTotal) {
      const revenue = revenueState.total || 0;
      const profit = revenue - expenseTotal;
      const margin = revenue > 0 ? profit / revenue * 100 : null;
      return { revenue, expenseTotal, profit, margin };
    }

    function performanceRevenueSummary(expenseTotal, comparisonHtml = "") {
      const result = profitStats(expenseTotal);
      const marginLabel = result.margin === null ? "--" : `${result.margin.toLocaleString("pt-BR", { maximumFractionDigits: 1 })}%`;
      const meta = revenueState.loading
        ? "Carregando faturamento"
        : revenueState.error
          ? "Faturamento indisponível"
          : `${revenueState.count} composição(ões) concluída(s)`;
      return `
        <div class="performance-summary">
          <div class="performance-left">
            <div class="performance-total">
              <span>Total de despesas</span>
              <strong>${esc(money(expenseTotal))}</strong>
            </div>
            <div class="performance-ratio" data-chart-tooltip="Lucro" data-chart-value="${esc(money(result.profit))}" data-chart-meta="${esc(`faturamento ${money(result.revenue)} menos despesas ${money(expenseTotal)}`)}">
              <span>margem</span>
              <strong>${esc(marginLabel)}</strong>
              <small>${esc(meta)}</small>
            </div>
          </div>
          ${comparisonHtml}
        </div>
      `;
    }

    function channelSummaryCards(rows) {
      const channels = ["credit_card", "bank_account", "fuel_network", "unknown"];
      return `<div class="summary-grid">
        ${channels.map((channel) => {
        const scoped = rows.filter((item) => item.financialChannel === channel);
        const total = scoped.reduce((sum, item) => sum + Number(item.value || 0), 0);
        return `<div class="summary-card"><span>${esc(financialChannelLabel(channel))}</span><strong>${money(total)}</strong><small>${scoped.length} transação(ões)</small></div>`;
      }).join("")}
      </div>`;
    }

    function policyDeltaForExpense(item) {
      const reference = policyReferenceForCategory(item.category);
      const indicator = expenseIndicatorValue(item);
      return {
        reference,
        indicator,
        delta: indicator - reference
      };
    }

    function driverAverageForCategory(item) {
      const rows = chartRowsForScope().filter((row) => row.driverId === item.driverId && row.category === item.category && !Expense.isCancelledExpense(row));
      const total = rows.reduce((sum, row) => sum + Number(row.value || 0), 0);
      return rows.length ? total / rows.length : 0;
    }

    function driverRankingPosition(item) {
      const rows = chartRowsForScope().filter((row) => row.category === item.category && !Expense.isCancelledExpense(row));
      const grouped = groupSum(rows, "nick").sort((left, right) => left.value - right.value);
      const index = grouped.findIndex((row) => row.label === item.nick);
      return index >= 0 ? index + 1 : 0;
    }

    function recentDriverHistory(item) {
      const rows = chartRowsForScope().filter((row) => row.driverId === item.driverId && !Expense.isCancelledExpense(row));
      const byMonth = new Map();
      rows.forEach((row) => {
        const date = new Date(row.date);
        const key = `${date.getFullYear()}-${String(date.getMonth() + 1).padStart(2, "0")}`;
        byMonth.set(key, (byMonth.get(key) || 0) + Number(row.value || 0));
      });
      return [...byMonth.entries()].sort(([left], [right]) => left.localeCompare(right)).slice(-3).map(([key, value]) => `${key}: ${money(value)}`).join(" · ") || "Sem histórico mensal recente";
    }

    function supervisionRows() {
      return chartRowsForScope()
        .filter((item) => !Expense.isCancelledExpense(item))
        .filter((item) => riskFlagsForExpense(item).length && !item.reviewSeen)
        .sort((left, right) => urgencyScore(right) - urgencyScore(left))
        .slice(0, 8);
    }

    function renderSupervisionInbox() {
      const rows = supervisionRows();
      if (!rows.length) {
        return `<section class="panel"><div class="panel-head"><div class="panel-title"><h2>Inbox de supervisão</h2><p>Transações duvidosas ou fora da política.</p></div></div><div class="card-pad"><div class="empty">Sem itens abertos para supervisão.</div></div></section>`;
      }
      return `
        <section class="panel">
          <div class="panel-head">
            <div class="panel-title"><h2>Inbox de supervisão</h2><p>Transações duvidosas ou fora da política para análise do gestor.</p></div>
            <button class="btn primary" type="button" data-jump="transacoes">Abrir fila</button>
          </div>
          <div class="table-wrap wide">
            <table>
              <thead><tr><th>Despesa</th><th>Política</th><th>Motorista</th><th>Ranking</th><th>Histórico</th><th>Ação</th></tr></thead>
              <tbody>
                ${rows.map((item) => {
        const policy = policyDeltaForExpense(item);
        return `
                  <tr data-id="${esc(item.id)}">
                    <td><strong>${esc(item.place)}</strong><br>${riskFlagChips(item, 3)}<br><span class="muted">${esc(item.category)} · ${dateTimeFmt.format(new Date(item.date))}</span></td>
                    <td><span class="muted">Aplicável</span><br><strong>${esc(policy.reference ? money(policy.reference) : "Sem teto")}</strong><br><span class="muted">Dif. ${esc(money(Math.max(0, policy.delta)))}</span></td>
                    <td><strong>${esc(item.nick)}</strong><br><span class="muted">Média ${esc(money(driverAverageForCategory(item)))}</span></td>
                    <td><span class="pill neutral">${driverRankingPosition(item) || "-"}º menor gasto</span></td>
                    <td><span class="muted">${esc(recentDriverHistory(item))}</span></td>
                    <td><button class="btn" type="button" data-action="mark-review-seen" data-review-id="${esc(item.id)}">Marcar visto</button></td>
                  </tr>
                `;
      }).join("")}
              </tbody>
            </table>
          </div>
        </section>
      `;
    }

    function fuelRowsForPanel() {
      return chartRowsForScope()
        .filter((item) => Expense.normalizeSearch(item.category) === "combustivel" || Expense.categorySuggestionForExpense({ place: item.place, category: item.category, date: item.date, type: item.origin }).category === "Combustível")
        .map(ensureDerivedExpenseFields)
        .sort((left, right) => new Date(right.date) - new Date(left.date));
    }

    function renderFuelPanel() {
      const rows = fuelRowsForPanel();
      if (!rows.length) {
        return `<section class="panel"><div class="panel-head"><div class="panel-title"><h2>Abastecimento e consumo</h2><p>CTF, cartão, KM e consumo calculado.</p></div></div><div class="card-pad"><div class="empty">Sem abastecimentos no período.</div></div></section>`;
      }
      const currentAvg = rows.filter((row) => row.consumptionKmPerLiter).reduce((sum, row, _, source) => sum + row.consumptionKmPerLiter / source.length, 0);
      return `
        <section class="panel">
          <div class="panel-head">
            <div class="panel-title"><h2>Abastecimento e consumo</h2><p>Origem, posto, KM, litro, preço e situação contra política.</p></div>
