    function setupGlobalEvents() {
      updateViewportCssVars();
      window.addEventListener("resize", updateViewportCssVars, { passive: true });
      window.visualViewport?.addEventListener("resize", updateViewportCssVars, { passive: true });
      window.visualViewport?.addEventListener("scroll", updateViewportCssVars, { passive: true });
      document.querySelectorAll(".nav-item[data-view]").forEach((button) => {
      button.addEventListener("click", () => {
        const nextView = button.dataset.view;
        state.view = nextView;
        if (!INSPECTOR_VIEWS.has(nextView)) state.selectedId = null;
        state.inspectorTab = nextView === "auditoria" ? "auditoria" : "resumo";
        render();
      });
    });
    bindOptionalClick("refreshBtn", () => {
      if (state.refreshingData) return;
      runRefreshFlow("manual")
        .catch((error) => {
          toast(error.message || "Falha ao atualizar.");
        });
    });
      bindOptionalClick("exportBtn", exportCsv);
      bindOptionalClick("newExpenseBtn", () => {
        let realDrivers = drivers.filter((item) => item.isRealEmployee !== false);
        if (!realDrivers.length) {
          if (!MOCK_MODE) return toast("Carregue Funcionários do Dataverse antes de lançar.");
          drivers = [...demoDrivers];
          syncDriverControls();
          realDrivers = drivers.filter((item) => item.isRealEmployee !== false);
        }
        document.getElementById("expenseForm").reset();
        document.getElementById("formDriver").value = realDrivers[0].id;
        document.getElementById("formVehicle").value = realDrivers[0].vehicle;
        document.getElementById("formOrigin").value = "Digitação Financeiro";
        document.getElementById("formCategory").value = "Combustível";
        document.getElementById("formDate").value = localDateTimeValue(new Date());
        openModal("expenseModal");
      });
      document.querySelectorAll("[data-close]").forEach((button) => {
        button.addEventListener("click", () => closeModal(button.dataset.close));
      });
      document.querySelectorAll(".modal-backdrop").forEach((modal) => {
        modal.addEventListener("click", (event) => {
          if (event.target === modal) closeModal(modal.id);
        });
      });
      document.addEventListener("keydown", (event) => {
        if (event.key === "Escape") {
          document.querySelectorAll(".modal-backdrop.open").forEach((modal) => closeModal(modal.id));
        }
      });
    }

    function queueDataverseReconciliation(options = {}) {
      if (MOCK_MODE) return;
      const reconciliationOptions = { ...options, silent: true, skipRender: true };
      loadDataverseExpenses(reconciliationOptions)
        .catch((error) => {
          apiState.persistError = error.message || "Dataverse reconciliation failed";
        })
        .finally(() => {
          updateSyncStrip();
          render();
        });
    }

    async function runRefreshFlow(source) {
      if (state.refreshingData) return;
      const options = createRefreshOptions(source);
      const labels = {
        bootstrap: "Carregando dados iniciais...",
        manual: "Atualizando despesas em tempo real..."
      };
      const blockingOverlay = true;
      state.refreshingData = true;
      if (blockingOverlay) setRefreshOverlay(true, labels[source] || "Atualizando despesas...");
      debugRefresh(options, "inicio", {
        period: state.period,
        pluggyDateFrom: pluggyDateFrom(),
        before: refreshStateSnapshot()
      });
      try {
        await runPrimaryRefreshLoads(options);
        render({ soft: true });
        await loadPluggyTransactions({ ...options, silent: true, preserveMockOnPluggyError: true });
        debugRefresh(options, "fim", refreshStateSnapshot());
        if (source === "manual" && !apiState.error) toast(`${transactions.length} despesa(s) atualizada(s). Pluggy sincronizado.`);
      } catch (error) {
        debugRefresh(options, "erro", { error: error.message || "Refresh falhou" });
        throw error;
      } finally {
        state.refreshingData = false;
        if (blockingOverlay) setRefreshOverlay(false);
        updateSyncStrip();
      }
    }

    function localDateTimeValue(date) {
      const pad = (value) => String(value).padStart(2, "0");
      return `${date.getFullYear()}-${pad(date.getMonth() + 1)}-${pad(date.getDate())}T${pad(date.getHours())}:${pad(date.getMinutes())}`;
    }

    async function bootstrapData() {
      await runRefreshFlow("bootstrap");
    }

    setupFilters();
    setupForms();
    setupGlobalEvents();
    updateSyncStrip();
    render();
    bootstrapData();
    requestAnimationFrame(() => window.scrollTo({ top: 0, left: 0, behavior: "auto" }));
  </script>
</body>

</html>
