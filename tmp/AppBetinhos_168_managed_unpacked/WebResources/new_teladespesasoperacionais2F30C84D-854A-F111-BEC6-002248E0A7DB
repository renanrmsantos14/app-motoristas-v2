      width: 15px;
      height: 15px;
    }

    .receipt-unlock-btn:hover {
      transform: translateY(-1px);
      border-color: rgba(35, 103, 245, .38);
      background: #fff;
      color: var(--blue);
      box-shadow: 0 8px 18px rgba(31, 45, 68, .12);
    }

    .receipt-unlock-btn:active {
      transform: translateY(1px) scale(.98);
    }

    .receipt-edit-control {
      width: min(100%, 210px);
      min-height: 30px;
      justify-self: end;
      border: 1px solid transparent;
      border-radius: 6px;
      background: transparent;
      color: var(--ink);
      font: inherit;
      font-size: 13px;
      font-weight: 850;
      text-align: right;
      padding: 4px 6px;
      outline: none;
      appearance: none;
      transition: border-color .2s ease, box-shadow .2s ease, background .2s ease, color .2s ease;
    }

    .receipt-money-control,
    .receipt-edit-control[type="number"] {
      max-width: 132px;
      font-variant-numeric: tabular-nums;
    }

    select.receipt-edit-control {
      max-width: 220px;
      padding-right: 24px;
    }

    .receipt-preview.is-locked :is(select.receipt-edit-control, .receipt-edit-control[type="date"]) {
      appearance: none;
      -webkit-appearance: none;
      background-image: none;
      padding-right: 6px;
    }

    .receipt-preview.is-locked .receipt-edit-control[type="date"]::-webkit-calendar-picker-indicator {
      display: none;
      opacity: 0;
    }

    .receipt-preview.is-editable select.receipt-edit-control {
      background-image:
        linear-gradient(45deg, transparent 50%, currentColor 50%),
        linear-gradient(135deg, currentColor 50%, transparent 50%);
      background-position: calc(100% - 13px) 50%, calc(100% - 8px) 50%;
      background-size: 5px 5px, 5px 5px;
      background-repeat: no-repeat;
    }

    textarea.receipt-edit-control {
      width: 100%;
      max-width: 100%;
      min-height: 72px;
      justify-self: stretch;
      resize: vertical;
      text-align: left;
      line-height: 1.35;
    }

    .receipt-preview.is-editable .receipt-edit-control {
      border-color: var(--control-border);
      border-radius: var(--control-radius);
      background-color: var(--control-bg);
      box-shadow: var(--control-shadow);
    }

    .receipt-preview.is-editable .receipt-edit-control:hover {
      border-color: var(--control-border-hover);
      background-color: var(--control-bg-hover);
    }

    .receipt-edit-control:disabled {
      color: var(--ink);
      opacity: 1;
      -webkit-text-fill-color: var(--ink);
      background: transparent;
      border-color: transparent;
      box-shadow: none;
      cursor: default;
    }

    .receipt-preview.is-locked textarea.receipt-edit-control {
      resize: none;
    }

    .receipt-edit-control:focus {
      border-color: rgba(35, 103, 245, .55);
      background-color: #fff;
      box-shadow: 0 0 0 3px rgba(35, 103, 245, .12);
    }

    .evidence-attachment {
      display: grid;
      gap: 10px;
      padding: 12px;
      border: 1px solid var(--line);
      border-radius: var(--radius);
      background: var(--surface-soft);
    }

    .evidence-gallery {
      display: grid;
      gap: 12px;
    }

    .evidence-date {
      color: var(--muted);
      font-size: 11px;
      font-weight: 750;
      text-align: center;
    }

    .upload-panel.evidence-upload-only {
      display: grid;
      grid-template-columns: 1fr auto;
      gap: 10px;
      align-items: center;
      padding: 0;
      border: 0;
      background: transparent;
    }

    .evidence-preview-link {
      display: grid;
      gap: 8px;
      color: inherit;
      text-decoration: none;
    }

    .evidence-preview-frame {
      position: relative;
    }

    .evidence-preview-frame .evidence-preview-link {
      position: absolute;
      inset: 0;
      z-index: 2;
    }

    .evidence-attachment img,
    .evidence-attachment iframe {
      width: 100%;
      max-height: 220px;
      border: 1px solid var(--line-soft);
      border-radius: var(--radius);
      background: #fff;
    }

    .evidence-attachment img {
      object-fit: contain;
    }

    .evidence-attachment iframe {
      height: 220px;
    }

    .evidence-file-card {
      display: grid;
      grid-template-columns: 44px minmax(0, 1fr);
      align-items: center;
      gap: 10px;
      min-height: 72px;
      padding: 12px;
      border: 1px dashed var(--line);
      border-radius: var(--radius);
      background: var(--surface);
    }

    .evidence-file-card strong,
    .evidence-file-card span {
      overflow-wrap: anywhere;
    }

    .evidence-file-icon {
      display: grid;
      place-items: center;
      width: 44px;
      height: 44px;
      border-radius: 12px;
      background: var(--ink);
      color: var(--surface);
      font-weight: 900;
      font-size: 12px;
      letter-spacing: .04em;
    }

    .timeline {
      position: relative;
    }

    .timeline-step {
      align-items: flex-start;
      padding-bottom: 10px;
    }

    .timeline-dot,
    .audit-icon {
      width: 30px;
      height: 30px;
      border-radius: var(--radius);
      display: grid;
      place-items: center;
      color: var(--blue);
      background: var(--blue-soft);
      flex: 0 0 auto;
    }

    .timeline-dot.done {
      color: #0c7a45;
      background: var(--green-soft);
    }

    .timeline-dot.warn {
      color: #9a5b00;
      background: var(--yellow-soft);
    }

    .timeline-dot.danger {
      color: #b4232a;
      background: var(--red-soft);
    }

    .timeline-step strong,
    .audit-item strong {
      display: block;
      font-size: 13px;
      line-height: 1.25;
    }

    .timeline-step span,
    .audit-item span {
