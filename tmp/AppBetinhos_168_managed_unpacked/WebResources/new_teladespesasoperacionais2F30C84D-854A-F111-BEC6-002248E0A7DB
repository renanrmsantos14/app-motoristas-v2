    function parseAuditChanges(row) {
      const raw = cleanText(row?.changedata || row?.attributemask || "", "");
      if (!raw) return [];
      try {
        const parsed = JSON.parse(raw);
        const changes = parsed?.changedAttributes || parsed?.ChangedAttributes || parsed?.attributes || parsed?.Attributes || [];
        if (Array.isArray(changes) && changes.length) {
          return changes.map((change) => {
            const name = change.logicalName || change.name || change.attributeName || change.AttributeLogicalName || "campo";
            const oldValue = change.oldValue ?? change.OldValue ?? change.old ?? "";
            const newValue = change.newValue ?? change.NewValue ?? change.new ?? "";
            return {
              field: auditFieldLabel(name),
              before: cleanAuditValue(oldValue),
              after: cleanAuditValue(newValue)
            };
          });
        }
      } catch {
        return [{ field: "Alteração Dataverse", before: "(não informado)", after: raw.slice(0, 500) }];
      }
      return [{ field: "Alteração Dataverse", before: "(não informado)", after: raw.slice(0, 500) }];
    }

