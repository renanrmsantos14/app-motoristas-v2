      document.getElementById("statusFilter").addEventListener("change", (event) => { applyMultiFilterChange(event.target, "statuses", "status"); });
      document.getElementById("categoryFilter").addEventListener("change", (event) => { applyMultiFilterChange(event.target, "categories", "category"); });
