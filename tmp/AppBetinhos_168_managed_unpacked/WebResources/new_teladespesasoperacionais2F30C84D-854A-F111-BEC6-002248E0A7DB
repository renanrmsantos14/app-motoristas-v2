    function runNamedAction(action, sourceElement = null) {
      const keepOpen = Boolean(sourceElement?.dataset?.inspectorAction);
      const actionRenderOptions = { noMotion: true };
      if (action === "validate-selected") return runBulk("validate", { ...actionRenderOptions, keepOpen: true });
      if (action === "invalidate-selected") return openInvalidateForSelected();
      if (action === "mark-review-seen") return markReviewSeen(sourceElement?.dataset?.reviewId, actionRenderOptions);
    }

    function markReviewSeen(id, options = {}) {
      const targetId = id || state.selectedId;
      const item = transactions.find((row) => row.id === targetId);
      if (!item) return toast("Selecione uma despesa para marcar como vista.");
      item.reviewSeen = true;
      item.managerReviewStatus = item.managerReviewStatus || "Visto pelo gestor";
      pushMockAudit("Supervisão marcada como vista", `${item.id}: ${riskFlagsForExpense(item).map((flag) => flag.label).join(", ") || "sem flags"}.`);
      toast("Item marcado como visto sem alterar o gasto.");
      render({ soft: true, noMotion: options.noMotion === true });
    }

    function selectedIdsOrCurrent() {
      const ids = [...state.selectedIds];
      if (!ids.length && state.selectedId) ids.push(state.selectedId);
      return ids;
    }

    function flashTransactionRows(ids, tone = "ok") {
      const uniqueIds = [...new Set((ids || []).map((id) => String(id)).filter(Boolean))];
      if (!uniqueIds.length) return;
      const rowClass = tone === "warn" ? "action-flash-warn" : "action-flash-ok";
      const pillClass = tone === "warn" ? "status-flash-warn" : "status-flash-ok";
      requestAnimationFrame(() => {
        const rows = [];
        uniqueIds.forEach((id) => {
          const safeId = id.replace(/\\/g, "\\\\").replace(/"/g, '\\"');
          const row = document.querySelector(`tr[data-id="${safeId}"]`);
          if (!row) return;
          const statusPill = row.querySelector(".status-pill");
          row.classList.add(rowClass);
          if (statusPill) statusPill.classList.add(pillClass);
          rows.push([row, statusPill]);
        });
        if (!rows.length) return;
        window.setTimeout(() => {
          rows.forEach(([row, statusPill]) => {
            row.classList.remove(rowClass);
            if (statusPill) statusPill.classList.remove(pillClass);
          });
        }, 1100);
      });
    }

    function validationBlockReason(item) {
      if (MOCK_MODE) return "";
      if (item?.duplicate) return "Possivel duplicidade exige revisao antes de validar.";
      if (Expense.normalizeSearch(item?.category) === "combustivel" && (item?.km == null || item?.km === "")) return "Combustivel exige KM antes de validar.";
      if (Expense.normalizeSearch(item?.classification) === "nao classificada") return "Classificacao obrigatoria ausente.";
      if (["nao enviado", "invalidado"].includes(Expense.normalizeSearch(item?.attachment))) return "Comprovante obrigatorio ausente ou invalido.";
      return "";
    }

    async function runBulk(action, options = {}) {
      const ids = selectedIdsOrCurrent();
      if (!ids.length) return toast("Selecione ao menos uma despesa.");
      const syncs = [];
      const blocked = [];
      const updatedIds = [];
      ids.forEach((id) => {
        const item = transactions.find((row) => row.id === id);
        if (!item) return;
        if (action === "validate") {
          const blockedReason = validationBlockReason(item);
          if (blockedReason) {
            blocked.push(`${item.id}: ${blockedReason}`);
            return;
          }
          item.status = "Aprovada";
          item.pendingType = "Sem pendencia";
          item.duplicate = false;
          updatedIds.push(item.id);
        }
        if (action === "duplicate") {
          item.duplicate = true;
          item.pendingType = "Possível duplicidade";
          updatedIds.push(item.id);
        }
        const changes = dataverseExpenseActionUpdate(action, item);
        if (Object.keys(changes).length) syncs.push(updateDataverseExpense(item, changes));
      });
      if (action === "validate" && blocked.length) {
        toast(`${blocked.length} despesa(s) bloqueada(s): ${blocked[0]}`);
        render({ soft: true, noMotion: options.noMotion === true });
        return;
      }
      const results = await Promise.allSettled(syncs);
      const failures = results.filter((result) => result.status === "rejected");
      if (failures.length) {
        toast(`${failures.length} despesa(s) nao sincronizaram no Dataverse.`);
      } else if (action === "validate") {
        toast(ids.length === 1 ? "Despesa aprovada." : `${ids.length} despesas aprovadas.`);
      } else if (action === "duplicate") {
        toast(ids.length === 1 ? "Despesa marcada como duplicidade." : `${ids.length} despesas marcadas como duplicidade.`);
      } else {
        toast(`${ids.length} despesa(s) atualizada(s).`);
      }
      if (options.keepOpen) {
        render({ soft: true, noMotion: options.noMotion === true });
        flashTransactionRows(updatedIds, action === "duplicate" ? "warn" : "ok");
        if (state.selectedId) renderInspector();
      } else {
        closeSelectedTransaction({ clearBulk: true, animate: !failures.length });
      }
    }

    function openInvalidateForSelected() {
      const item = selectedTransaction();
      if (!item) return toast("Selecione uma despesa.");
      state.pendingRejectId = item.id;
      renderRejectReasonTags();
      const tagSelect = document.getElementById("rejectReasonTag");
      const tagInput = document.getElementById("rejectReasonNewTag");
      const observationInput = document.getElementById("rejectObservation");
      if (tagSelect) tagSelect.value = "";
      if (tagInput) tagInput.value = "";
      document.getElementById("rejectConfirm").value = "";
      if (observationInput) observationInput.value = "";
      openModal("rejectModal");
    }

    async function invalidateCurrent(reason, observation) {
      const item = transactions.find((row) => row.id === state.pendingRejectId);
      if (!item) return;
      const reasonWithObservation = observation ? `${reason} | ${observation}` : reason;
      try {
        await updateDataverseExpense(item, dataverseExpenseActionUpdate("reject", item, reasonWithObservation));
      } catch (error) {
        toast(`Dataverse: ${error.message || "falha ao invalidar"}`);
        return;
      }
      item.status = "Cancelado";
      item.pendingType = "Registro indevido";
      item.managerReviewStatus = "Cancelado";
      item.suppressionKey = Expense.suppressionKeyForExpense(item);
      const logBase = `${reason} | Registro Indevido/Cancelado em ${new Date().toISOString()} | Usuario gestor | Origem ${item.origin} | Identificador ${item.externalId || item.id} | Hash ${item.hash} | Chave supressao ${item.suppressionKey}`;
      item.note = observation ? `${reason} | Observação: ${observation} | ${logBase}` : logBase;
      ensureDerivedExpenseFields(item);
      auditLog.unshift({ id: `log-${Date.now()}`, title: `${item.id} invalidada`, detail: item.note, date: new Date().toISOString(), actor: "Financeiro" });
      closeModal("rejectModal");
      toast("Despesa invalidada.");
      render({ soft: true, noMotion: true });
      flashTransactionRows([item.id], "warn");
      if (state.selectedId) renderInspector();
    }

    function last4FromInput(value) {
      const digits = String(value || "").replace(/\D/g, "");
      return digits.length >= 4 ? digits.slice(-4) : "";
    }

    function activeCardAssignmentsAt(referenceDate = new Date()) {
      return cardAssignments.filter((assignment) => Expense.isActiveCardAssignment(assignment, referenceDate));
    }

    function cardAssignmentConflict(last4, driverId, referenceDate = new Date()) {
      const cleanLast4 = last4FromInput(last4);
      return activeCardAssignmentsAt(referenceDate).find((assignment) => (
        assignment.last4 === cleanLast4 &&
        assignment.driverId &&
        assignment.driverId !== driverId
      )) || null;
    }

    function driverActiveCardCount(driverId, referenceDate = new Date()) {
      const cards = new Set(activeCardAssignmentsAt(referenceDate)
        .filter((assignment) => assignment.driverId === driverId)
        .map((assignment) => assignment.last4));
      return cards.size;
    }

    function openCardAssignmentModal() {
      let realDrivers = drivers.filter((item) => item.isRealEmployee !== false);
      if (!realDrivers.length) {
        if (!MOCK_MODE) return toast("Carregue Funcionários do Dataverse antes de vincular cartão.");
        drivers = [...demoDrivers];
        syncDriverControls();
        realDrivers = drivers.filter((item) => item.isRealEmployee !== false);
      }
      syncDriverControls();
