      function expenseIsPolicyDivergent(item, policy = {}) {
        if (expenseExcludedFromAverage(item)) return false;
        const type = categoryPolicyType(item?.category);
        if (type === "none") return false;
        const reference = policyReferenceForCategory(item?.category, policy);
        const indicator = expenseIndicatorValue(item);
