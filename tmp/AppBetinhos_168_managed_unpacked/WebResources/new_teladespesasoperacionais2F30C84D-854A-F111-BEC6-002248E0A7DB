        const optionValue = event.target?.getAttribute?.("data-tag-option");
        if (!optionValue) return;
        const selectedTags = new Set(Array.isArray(state.tags) ? state.tags : []);
        if (event.target.checked) selectedTags.add(optionValue);
        else selectedTags.delete(optionValue);
        state.tags = [...selectedTags];
        renderFilterChange();
      });
      document.querySelectorAll("[data-custom-trigger]").forEach((trigger) => {
        trigger.addEventListener("click", (event) => {
          event.stopPropagation();
          const id = trigger.getAttribute("data-custom-trigger") || "";
          const root = document.querySelector(`[data-custom-filter="${id}"]`);
          const panel = document.querySelector(`[data-custom-panel="${id}"]`);
          if (!root || !panel) return;
          closeTagFilterPanel();
          const shouldOpen = panel.hidden;
          closeAllCustomFilterPanels(shouldOpen ? id : "");
          root.classList.toggle("open", shouldOpen);
          panel.hidden = !shouldOpen;
          trigger.setAttribute("aria-expanded", shouldOpen ? "true" : "false");
        });
      });
      document.querySelectorAll("[data-custom-panel]").forEach((panel) => {
        panel.addEventListener("change", (event) => {
          const target = event.target;
          const id = target?.getAttribute?.("data-custom-option");
          if (!id) return;
          const select = document.getElementById(id);
          if (!select) return;
          const multiple = select.multiple;
          const allValue = customFilterAllValue(id);
          if (!multiple) {
            [...select.options].forEach((option) => { option.selected = option.value === target.value; });
          } else {
            [...select.options].forEach((option) => {
              if (target.value === allValue) option.selected = false;
              else if (option.value === allValue) option.selected = false;
              else if (option.value === target.value) option.selected = Boolean(target.checked);
            });
          }
          select.dispatchEvent(new Event("change", { bubbles: true }));
          if (!multiple) closeAllCustomFilterPanels();
        });
      });
      document.addEventListener("click", (event) => {
        const tagFilterRoot = document.getElementById("tagFilterRoot");
        if (tagFilterRoot?.contains(event.target) || event.target?.closest?.("[data-custom-filter]")) return;
        closeTagFilterPanel();
        closeAllCustomFilterPanels();
