          <div class="table-wrap wide">
            <table>
              <thead><tr><th>Origem</th><th>Posto</th><th>Motorista</th><th>Veículo</th><th>Data</th><th class="right">Valor</th><th class="right">Litros</th><th class="right">KM</th><th class="right">R$/L</th><th class="right">Km/L</th><th>Situação</th></tr></thead>
              <tbody>
                ${rows.slice(0, 10).map((item) => {
        const metrics = Expense.fuelMetricsForExpense(item, policyState.active);
        const alert = Expense.kmAlertForExpense(item, policyState.active);
        const situation = alert.severity ? alert.label : metrics.situation;
        const tone = alert.severity === "block" ? "danger" : metrics.situation === "Fora da política" || alert.severity ? "orange" : "good";
        return `
                  <tr data-id="${esc(item.id)}">
                    <td><span class="pill ${financialChannelClass(item.financialChannel)}">${esc(financialChannelLabel(item.financialChannel))}</span></td>
                    <td><strong>${esc(item.place)}</strong></td>
                    <td>${esc(item.nick)}</td>
                    <td>${esc(item.vehicle)}</td>
                    <td>${dateTimeFmt.format(new Date(item.date))}</td>
                    <td class="right money">${money(item.value)}</td>
                    <td class="right">${metrics.liters ? metrics.liters.toLocaleString("pt-BR") : "--"}</td>
                    <td class="right">${item.km || "--"}</td>
                    <td class="right">${metrics.pricePerLiter ? money(metrics.pricePerLiter) : "--"}</td>
                    <td class="right">${metrics.consumptionKmPerLiter || "--"}</td>
                    <td><span class="pill ${tone}">${esc(situation)}</span></td>
                  </tr>
                `;
      }).join("")}
              </tbody>
            </table>
          </div>
        </section>
      `;
    }

    function driverConductRows(rows) {
      const byDriver = new Map();
      rows.filter((item) => !Expense.isCancelledExpense(item)).forEach((item) => {
        const current = byDriver.get(item.nick) || { nick: item.nick, total: 0, count: 0, lunch: [], dinner: [], coffee: [], monthly: new Map() };
        current.total += Number(item.value || 0);
        current.count += 1;
        if (item.category === "Almoço") current.lunch.push(Number(item.value || 0));
        if (item.category === "Jantar") current.dinner.push(Number(item.value || 0));
        if (item.category === "Café") current.coffee.push(Number(item.value || 0));
        const date = new Date(item.date);
        const month = `${date.getFullYear()}-${String(date.getMonth() + 1).padStart(2, "0")}`;
        current.monthly.set(month, (current.monthly.get(month) || 0) + Number(item.value || 0));
        byDriver.set(item.nick, current);
      });
      return [...byDriver.values()].map((row) => {
        const avg = (values) => values.length ? values.reduce((sum, value) => sum + value, 0) / values.length : 0;
        const totalAvg = row.count ? row.total / row.count : 0;
        const monthlyValues = [...row.monthly.entries()].sort(([left], [right]) => left.localeCompare(right)).slice(-6).map(([, value]) => value);
        const zone = totalAvg > policyState.active.limitMeal * 1.15 ? "Correção" : totalAvg < policyState.active.limitMeal * .85 ? "Reconhecer" : "Zona neutra";
        return { ...row, totalAvg, lunchAvg: avg(row.lunch), dinnerAvg: avg(row.dinner), coffeeAvg: avg(row.coffee), monthlyValues, zone };
      }).sort((left, right) => right.totalAvg - left.totalAvg);
    }

    function renderDriverConductDashboard(rows) {
      const conduct = driverConductRows(rows);
      if (!conduct.length) return '<section class="panel"><div class="panel-head"><div class="panel-title"><h2>Conduta por motorista</h2><p>Médias e tendência mensal.</p></div></div><div class="card-pad"><div class="empty">Sem dados para conduta.</div></div></section>';
      return `
        <section class="panel">
          <div class="panel-head"><div class="panel-title"><h2>Conduta por motorista</h2><p>Tendência mensal, alimentação separada e ranking de gasto.</p></div></div>
          <div class="table-wrap wide">
            <table>
              <thead><tr><th>Motorista</th><th class="right">Média geral</th><th class="right">Almoço</th><th class="right">Jantar</th><th class="right">Café</th><th>Tendência</th><th>Zona</th></tr></thead>
              <tbody>
                ${conduct.map((row) => `
                  <tr>
                    <td><strong>${esc(row.nick)}</strong></td>
                    <td class="right money">${money(row.totalAvg)}</td>
                    <td class="right money">${row.lunchAvg ? money(row.lunchAvg) : "--"}</td>
                    <td class="right money">${row.dinnerAvg ? money(row.dinnerAvg) : "--"}</td>
                    <td class="right money">${row.coffeeAvg ? money(row.coffeeAvg) : "--"}</td>
                    <td>${spark(row.monthlyValues.length ? row.monthlyValues : [0, 0, 0])}</td>
                    <td><span class="pill ${row.zone === "Correção" ? "orange" : row.zone === "Reconhecer" ? "good" : "neutral"}">${esc(row.zone)}</span></td>
                  </tr>
                `).join("")}
              </tbody>
            </table>
          </div>
        </section>
      `;
    }

    function monthlyCategoryChart(rows) {
      const essential = ["Combustível", "Almoço", "Jantar", "Café", "Hospedagem", "Manutenção", "Pedágio", "Estacionamento", "Outros"];
      const months = [...new Set(rows.map((item) => {
        const date = new Date(item.date);
        return `${date.getFullYear()}-${String(date.getMonth() + 1).padStart(2, "0")}`;
      }))].sort().slice(-6);
      if (!months.length) return '<div class="empty">Sem meses para comparar.</div>';
      return `
        <div class="summary-grid">
          ${essential.map((category) => {
        const categoryRows = rows.filter((item) => item.category === category || (category === "Outros" && !essential.includes(item.category)));
        if (!categoryRows.length && !["Combustível", "Almoço", "Jantar", "Café"].includes(category)) return "";
        const monthCells = months.map((month) => {
          const total = categoryRows.filter((item) => {
            const date = new Date(item.date);
            return `${date.getFullYear()}-${String(date.getMonth() + 1).padStart(2, "0")}` === month;
          }).reduce((sum, item) => sum + Number(item.value || 0), 0);
          return `<span class="pill neutral">${esc(month)} · ${esc(total ? money(total) : "--")}</span>`;
        }).join(" ");
        const total = categoryRows.reduce((sum, item) => sum + Number(item.value || 0), 0);
        return `<div class="summary-card"><span>${esc(category)}</span><strong>${total ? money(total) : "--"}</strong><small>${monthCells}</small></div>`;
      }).join("")}
        </div>
      `;
    }

    function renderDashboard() {
      const stats = dashboardStats();
      const rows = chartRowsForScope();
      const priority = pendingRows().sort((a, b) => urgencyScore(b) - urgencyScore(a)).slice(0, 7);
      const statusComparison = buildChartComparison((windowRows) => windowRows.length);
      const profit = profitStats(stats.spend);
      const profitCaption = revenueState.error
        ? "Faturamento indisponível"
        : `Fat. ${money(profit.revenue)} · Desp. ${money(stats.spend)}${profit.margin === null ? "" : ` · ${profit.margin.toLocaleString("pt-BR", { maximumFractionDigits: 1 })}%`}`;
      return `
        ${dataBanner()}
        <section class="metric-grid" aria-label="Indicadores principais">
          ${metric("Lucro", money(profit.profit), profitCaption, profit.profit >= 0 ? "blue" : "red", [28, 34, 31, 44, 38, 52, 61], icons.cash)}
          ${metric("Pendências", stats.pending + stats.waiting, `${stats.late} fora do SLA`, "orange", [12, 18, 14, 19, 22, 17, 26], icons.warn)}
          ${metric("Validadas", `${stats.approvalRate}%`, `${stats.validated} despesas confirmadas`, "green", [18, 25, 29, 34, 36, 39, 44], icons.check)}
          ${metric("Risco financeiro", stats.policyDivergence + stats.cardDivergence + stats.duplicate, `${stats.policyDivergence} política, ${stats.cardDivergence} cartão, ${stats.duplicate} duplicidade`, "red", [19, 17, 20, 16, 14, 11, 9], icons.clock)}
        </section>

        <div class="dashboard-grid">
