    .receipt-preview .receipt-line>span {
      min-width: 0;
      color: var(--muted);
      font-size: 11px;
      font-weight: 850;
      text-transform: uppercase;
      letter-spacing: .05em;
    }

    .receipt-preview .receipt-line strong {
      min-width: 0;
      justify-self: end;
      color: var(--ink);
      text-align: right;
      font-size: 13px;
      font-weight: 850;
    }

    .receipt-preview .receipt-line strong.wrap {
      max-width: 100%;
      overflow-wrap: anywhere;
    }

    .receipt-line--note {
      align-items: start;
    }

    .receipt-unlock-btn {
      position: absolute;
      top: 9px;
      right: 9px;
      width: 30px;
      height: 30px;
      min-height: 0;
      padding: 0;
      display: grid;
      place-items: center;
      border: 1px solid rgba(143, 157, 180, .42);
      border-radius: 8px;
      background: rgba(255, 255, 255, .9);
      color: var(--ink-soft);
      box-shadow: var(--shadow-hairline);
