      padding: 3px 5px;
      border-radius: 2px;
      font-size: 11px;
      font-weight: 900;
      text-align: center;
      line-height: 1;
    }

    .chart-compare-card--horizontal .chart-compare-meta {
      grid-area: meta;
      color: var(--ink);
