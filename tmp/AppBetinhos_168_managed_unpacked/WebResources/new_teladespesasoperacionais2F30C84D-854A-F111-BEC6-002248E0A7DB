    async function loadCompletedRevenue(options = {}) {
      if (MOCK_MODE) {
        const spend = transactions.reduce((sum, item) => sum + item.value, 0);
        revenueState.total = spend * 7.5;
        revenueState.count = transactions.length;
        revenueState.rawCount = transactions.length;
        revenueState.loaded = true;
        revenueState.error = null;
        revenueState.lastSync = new Date().toISOString();
        return;
      }

      revenueState.loading = true;
      revenueState.error = null;
      try {
        const [rows, reservations] = await Promise.all([
          retrieveCompletedRevenueFromModelDriven(),
          retrieveReservationsForRevenueFromModelDriven()
        ]);
        const bounds = state.period === "all" ? null : resolvePeriodBounds(state.period, now());
        const scopedReservationIds = new Set((reservations || []).filter((row) => {
          if (!bounds) return true;
          const date = row?.cr40f_dataehorriodesada ? new Date(row.cr40f_dataehorriodesada) : null;
          return date && bounds.start <= date && date <= bounds.end;
        }).map((row) => cleanText(row?.cr40f_reservadeveculosid, "")));
        const completedRows = (rows || [])
          .filter(isCompletedPriceComposition)
          .filter((row) => {
            if (!bounds) return true;
            return scopedReservationIds.has(cleanText(row?._cr40f_servicorelacionadogeral_value, ""));
          });
        revenueState.total = completedRows.reduce((sum, row) => sum + priceCompositionRevenue(row), 0);
        revenueState.count = completedRows.length;
        revenueState.rawCount = rows?.length || 0;
        revenueState.loaded = true;
        revenueState.lastSync = new Date().toISOString();
        revenueState.source = "Dataverse cr40f_composicaodeprecos";
        debugRefresh(options, "faturamento:resultado", {
          rawRows: revenueState.rawCount,
          completedRows: revenueState.count,
          total: revenueState.total
        });
      } catch (error) {
        revenueState.loaded = false;
        revenueState.total = 0;
        revenueState.count = 0;
        revenueState.rawCount = 0;
        revenueState.error = error.message || "Falha ao carregar faturamento";
        debugRefresh(options, "faturamento:erro", { error: revenueState.error });
      } finally {
        revenueState.loading = false;
      }
    }

