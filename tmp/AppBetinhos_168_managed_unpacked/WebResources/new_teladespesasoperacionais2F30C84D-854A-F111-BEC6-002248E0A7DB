    function auditHistoryPanel(item) {
      if (MOCK_MODE) {
        const rows = auditState.cache.get(item.id) || [];
        if (!rows.length) return `<div class="api-banner warning"><strong>Auditoria sandbox</strong><span>Sem alterações locais registradas para esta despesa.</span></div>`;
        return auditGallery(flattenAuditRows(rows.map((row) => ({ ...row, item }))));
      }
      if (auditState.loading.has(item.id)) {
        return `<div class="api-banner loading"><strong>Auditoria Dataverse</strong><span>Carregando histórico real da despesa ${esc(item.id)}.</span></div>`;
      }
      const error = auditState.errors.get(item.id);
      if (error) {
        return `<div class="api-banner warning"><strong>Auditoria Dataverse indisponível</strong><span>${esc(error)}</span></div>`;
      }
      const rows = auditState.cache.get(item.id) || [];
      if (!rows.length) {
        return `<div class="api-banner warning"><strong>Sem histórico carregado</strong><span>O Dataverse pode demorar para expor a auditoria ou a tabela/coluna pode estar sem auditoria habilitada.</span></div>`;
      }
      return `
        <div class="audit-list detailed">
          ${rows.map((row) => auditChangeCard(row, item)).join("")}
        </div>
      `;
    }

    function auditChangeCard(row, item) {
      const changes = row.changes?.length ? row.changes : [{ field: "Alteração", before: "(não informado)", after: row.detail || "Registrada pelo Dataverse" }];
      return `
        <article class="audit-change-card">
          <div class="audit-change-head">
            <div>
              <strong>${esc(row.actionLabel)} · ${esc(row.userName)}</strong>
              <span>${esc(row.changedAt)} · ID ${esc(item?.id || row.expenseId || "")} · ${esc(item?.nick || item?.driver || "Despesa")} · ${esc(row.source || "Auditoria nativa Dataverse")}</span>
            </div>
            <span class="pill neutral">${changes.length} campo(s)</span>
          </div>
          ${changes.map((change) => `
            <div class="audit-diff-grid">
              <div class="audit-diff-box">
                <span>${esc(change.field)} antes</span>
                <strong>${esc(change.before)}</strong>
              </div>
              <div class="audit-diff-arrow">${icons.arrow}</div>
              <div class="audit-diff-box after">
                <span>${esc(change.field)} depois</span>
                <strong>${esc(change.after)}</strong>
              </div>
            </div>
          `).join("")}
        </article>
      `;
    }

    function mockAuditScopePanel() {
      const rows = auditLog || [];
      if (!rows.length) return `<div class="empty">Sem registros de auditoria.</div>`;
      const item = transactions[0] || {};
      const events = rows.map((row, index) => ({
        id: row.id || `mock-${index}`,
        actionLabel: row.title || "Registro",
        changedAt: dateTimeFmt.format(new Date(row.date)),
        userName: row.actor || "Sistema",
        source: "Mock data",
        changes: [{ field: "Registro", before: "(estado anterior)", after: row.detail || "Registro operacional" }],
        item
      }));
      return auditWorkbench(events);
    }

    function auditGallery(rows) {
      return `
        <div class="audit-gallery">
          ${rows.map((row) => auditGalleryCard(row)).join("")}
        </div>
      `;
    }

    function auditGalleryCard(row) {
      const selected = state.selectedAuditKey === row.key ? " selected" : "";
      return `
        <article class="audit-card${selected}" data-audit-row="${esc(row.key)}" data-audit-expense="${esc(row.expenseId)}" tabindex="0" role="button" aria-label="Abrir auditoria de ${esc(row.expenseLabel || row.expenseId)}">
          <div class="audit-card-head">
            <div>
              <strong>${esc(row.field)}</strong>
              <span>${esc(row.actionLabel)} · ${esc(row.userName)}</span>
            </div>
            <span class="pill neutral">${esc(row.changedAt)}</span>
          </div>
          <div class="audit-card-meta">
            <div>
              <strong>${esc(row.expenseLabel || row.expenseId)}</strong>
              <span>${esc(row.source || "Auditoria")}</span>
            </div>
            <span class="pill">${esc(row.expenseId)}</span>
          </div>
          <div class="audit-diff-grid">
            <div class="audit-diff-box">
              <span>Antes</span>
              <strong>${esc(row.before)}</strong>
            </div>
            <div class="audit-diff-arrow">${icons.arrow}</div>
            <div class="audit-diff-box after">
              <span>Depois</span>
              <strong>${esc(row.after)}</strong>
            </div>
          </div>
        </article>
