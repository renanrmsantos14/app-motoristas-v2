        note,
        deadline,
        hash,
        financialChannel: Expense.financialChannelFromOrigin(origin, meta)
      };
      return ensureDerivedExpenseFields({ ...base, ...meta });
    }

    function derivedExpenseSignature(item) {
      return [
        item?.place,
        item?.category,
        item?.date,
        item?.origin,
        item?.value,
        item?.status,
        item?.duplicate,
        item?.financialChannel,
        item?.cardLast4,
        item?.cardOwnerStatus,
        item?.km,
        item?.liters,
        item?.previousKm,
        item?.hash,
        item?.externalId,
        policyState.active.limitMeal,
        policyState.active.limitLunch,
        policyState.active.limitDinner,
        policyState.active.limitCoffee,
        policyState.active.limitFuelPerKm,
        policyState.active.expectedKmPerLiter,
        policyState.active.expectedBrlPerLiter,
        policyState.active.fuelTolerancePercent
      ].map((value) => value ?? "").join("|");
    }

    function ensureDerivedExpenseFields(item) {
      if (!item) return item;
      const signature = derivedExpenseSignature(item);
      if (item.__derivedSignature === signature) return item;
      const suggestion = Expense.categorySuggestionForExpense({ place: item.place, category: item.category, date: item.date, type: item.origin });
      const isFuel = isFuelExpense(item);
      const liters = item.liters != null && item.liters !== ""
        ? Number(item.liters)
        : isFuel
          ? Math.round((Number(item.value || 0) / Math.max(Number(policyState.active.expectedBrlPerLiter || 6), 1)) * 10) / 10
          : null;
      const previousKm = item.previousKm != null && item.previousKm !== ""
        ? Number(item.previousKm)
        : isFuel && item.km
          ? Math.max(0, Number(item.km) - 420)
          : null;
      const fuelMetrics = Expense.fuelMetricsForExpense({ ...item, liters, previousKm }, policyState.active);
      const kmAlert = Expense.kmAlertForExpense({ ...item, liters, previousKm }, policyState.active);
      item.reviewSeen = item.reviewSeen === true;
      item.suggestedCategory = suggestion.category;
      item.suggestionReason = suggestion.reason;
      item.liters = liters;
      item.previousKm = previousKm;
      item.pricePerLiter = fuelMetrics.pricePerLiter || null;
      item.consumptionKmPerLiter = fuelMetrics.consumptionKmPerLiter || null;
      item.kmAlert = kmAlert.severity ? kmAlert.label : "";
      item.kmAlertSeverity = kmAlert.severity || "";
      item.suppressionKey = Expense.suppressionKeyForExpense(item);
      item.riskFlags = riskFlagsForExpense(item);
      item.policyStatus = policyStatusForExpense(item);
      item.__derivedSignature = derivedExpenseSignature(item);
      return item;
    }

    function hashFor(origin, date, value, driverId, place) {
      const day = new Date(date).toISOString().slice(0, 10).replace(/-/g, "");
      const cents = Math.round(Number(value) * 100);
      return `${origin.slice(0, 3).toUpperCase()}-${day}-${driverId.slice(-2)}-${cents}-${slug(place).slice(0, 8)}`;
    }

    function slug(value) {
      return String(value || "").normalize("NFD").replace(/[\u0300-\u036f]/g, "").replace(/[^a-z0-9]+/gi, "").toLowerCase();
    }

    function readFrameValue(frame, prop) {
