          </section>

          <aside class="insight-panel">
            <section class="executive-card">
              <span>Leitura executiva</span>
              <strong>${stats.policyDivergence ? stats.policyDivergence : `${stats.approvalRate}%`}</strong>
              <p>${stats.cardDivergence ? "despesas de cartão estão sem portador ativo no Dataverse." : stats.policyDivergence ? "despesas estão acima da política ativa no filtro atual." : "das despesas filtradas já estão validadas para fechamento."}</p>
            </section>
            <section class="panel">
              <div class="panel-head">
                <div class="panel-title"><h3>Status da fila</h3><p>Quantidade por etapa operacional.</p></div>
              </div>
              <div class="panel-body">
                ${renderChartComparisonCards(statusComparison, (value) => `${value}`, (item) => `${item.rows.length ? Math.round(item.rows.filter((row) => !isClosedStatus(row.status)).length / item.rows.length * 100) : 0}% em aberto`)}
                ${statusBars(rows)}
              </div>
            </section>
          </aside>
        </div>

        <div>
          ${renderSupervisionInbox()}
          ${renderFuelPanel()}
          <section class="panel">
            <div class="panel-head">
              <div class="panel-title"><h2>Prioridade operacional</h2><p>Itens que exigem ação agora.</p></div>
              <button class="btn primary" type="button" data-jump="transacoes">Abrir transações</button>
            </div>
            ${transactionTable(priority, "priority")}
          </section>
        </div>
      `;
    }

