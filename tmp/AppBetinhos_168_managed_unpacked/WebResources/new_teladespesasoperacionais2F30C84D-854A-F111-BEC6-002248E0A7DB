      gap: 7px;
      min-width: 0;
    }

    .performance-total {
      display: grid;
      gap: 2px;
    }

    .performance-total span,
    .performance-ratio span {
      color: var(--muted);
      font-size: 11px;
      font-weight: 850;
      letter-spacing: .04em;
      text-transform: uppercase;
    }

    .performance-total strong {
      color: var(--ink);
      font-size: clamp(24px, 4vw, 40px);
      line-height: 1;
      letter-spacing: -.04em;
      font-weight: 900;
    }

    .performance-ratio {
      min-width: 116px;
      padding: 2px 0 0 10px;
      border: 0;
      border-left: 2px solid color-mix(in oklch, var(--line) 82%, var(--blue));
      border-radius: 0;
      background: transparent;
      text-align: left;
    }

    .performance-ratio strong {
      display: inline-block;
      margin-top: 2px;
      padding: 3px 6px;
      border-radius: 4px;
      background: color-mix(in oklch, var(--blue) 12%, white);
