      border-color: var(--control-border-focus);
      background: var(--surface);
      box-shadow: var(--control-focus-shadow);
    }

    .field :is(input, select, textarea):disabled,
    .receipt-edit-control:disabled {
      border-color: color-mix(in oklch, var(--control-border) 68%, transparent);
      background-color: var(--control-bg-disabled);
      color: color-mix(in oklch, var(--control-text) 72%, var(--control-muted));
      box-shadow: none;
      cursor: not-allowed;
    }

    .field select,
    select.receipt-edit-control {
