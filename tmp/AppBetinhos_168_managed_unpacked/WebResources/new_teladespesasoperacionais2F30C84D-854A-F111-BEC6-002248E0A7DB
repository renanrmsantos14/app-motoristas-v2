    async function uploadEvidenceForItem(item, file) {
      const blockedReason = hotEditBlockedReason(item);
      if (blockedReason) throw new Error(blockedReason);
      validateEvidenceFile(file);
      if (evidenceState.uploading.has(item.id)) throw new Error("Upload ja esta em andamento.");
      evidenceState.uploading.add(item.id);
      evidenceState.errors.delete(item.id);
      renderInspector();
      try {
        const base64 = await fileToBase64(file);
        const localPreviewUrl = evidencePreviewDataUrl(file, base64);
        if (MOCK_MODE) {
          const uploadedRows = normalizeEvidenceRows([{
            cr40f_anexodespesaid: `sandbox-${Date.now()}`,
            cr40f_nome: file.name,
            cr40f_nomearquivo: file.name,
            cr40f_urlsharepoint: "",
            previewDataUrl: localPreviewUrl,
            mimeType: file.type || "application/octet-stream",
            size: Number(file.size || 0),
            cr40f_dataenvio: new Date().toISOString(),
            uploadedBy: "sandbox"
          }]);
          const existingRows = evidenceState.cache.get(item.id) || [];
          evidenceState.cache.set(item.id, [...uploadedRows, ...existingRows]);
          item.attachment = "Enviado";
          item.pendingType = Expense.expensePendingTypeByRule(item);
          pushMockAudit("Comprovante sandbox", `${item.id}: ${file.name}.`);
          toast("Comprovante anexado no sandbox local.");
          render({ soft: true });
          return;
        }
        if (!ONEDRIVE_FLOW_CONFIG.uploadUrl) throw new Error("URL do Flow OneDrive ainda nao configurada.");
        const payload = {
          expenseId: item.id,
          externalId: item.externalId || item.id,
          fileName: file.name,
          mimeType: file.type || "application/octet-stream",
          fileSize: Number(file.size || 0),
          base64,
          driverName: item.driver,
          cardLast4: item.cardLast4 || "",
          date: item.date,
          amount: Number(item.value || 0),
          uploadedBy: "gestor"
        };
        const response = await fetch(ONEDRIVE_FLOW_CONFIG.uploadUrl, {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify(payload)
        });
        const result = await response.json().catch(() => ({}));
        if (!response.ok) throw new Error(result.message || result.error || `Flow OneDrive HTTP ${response.status}`);
        const webUrl = cleanText(result.webUrl || result.url || result.link, "");
        if (!webUrl) throw new Error("Flow nao retornou webUrl do OneDrive.");
        await createDataverseAttachment(item, file, { ...result, webUrl });
        item.attachment = "Enviado";
        const uploadedRows = normalizeEvidenceRows([{
          cr40f_anexodespesaid: result.attachmentId || `local-${Date.now()}`,
          cr40f_nome: result.fileName || file.name,
          cr40f_nomearquivo: result.fileName || file.name,
          cr40f_urlsharepoint: webUrl,
          previewDataUrl: result.previewDataUrl || "",
          previewUrl: result.previewUrl || result.thumbnailUrl || result.downloadUrl || result["@microsoft.graph.downloadUrl"] || localPreviewUrl,
          mimeType: file.type || "application/octet-stream",
          size: Number(result.size || file.size || 0),
          cr40f_dataenvio: result.uploadedAt || new Date().toISOString(),
          uploadedBy: result.uploadedBy || "gestor"
        }]);
        const existingRows = evidenceState.cache.get(item.id) || [];
        evidenceState.cache.set(item.id, [...uploadedRows, ...existingRows]);
        item.pendingType = Expense.expensePendingTypeByRule(item);
        toast("Comprovante salvo no OneDrive e vinculado no Dataverse.");
        render({ soft: true });
      } catch (error) {
        evidenceState.errors.set(item.id, error.message || "Falha no upload.");
        throw error;
      } finally {
        evidenceState.uploading.delete(item.id);
        renderInspector();
      }
    }

