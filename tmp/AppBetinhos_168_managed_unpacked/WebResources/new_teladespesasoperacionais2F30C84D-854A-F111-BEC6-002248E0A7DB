      font-size: 10px;
      line-height: 1.15;
      max-width: 126px;
    }

    .chart-toolbar {
      display: flex;
      align-items: center;
      gap: 6px;
      padding: 5px;
      background: var(--surface-soft);
      border-radius: var(--radius);
    }

    .segmented {
      --segmented-thumb-x: 4px;
      --segmented-thumb-width: 0px;
      position: relative;
      isolation: isolate;
      display: inline-flex;
      align-items: stretch;
      gap: 2px;
      max-width: 100%;
      min-height: 42px;
      padding: 4px;
      overflow-x: auto;
      overflow-y: hidden;
      scroll-padding-inline: 4px;
      scrollbar-width: none;
      background:
        linear-gradient(180deg, rgba(255, 255, 255, .9), rgba(244, 248, 252, .86));
      border: 1px solid rgba(31, 45, 68, .12);
      border-radius: 11px;
      box-shadow:
        inset 0 1px 0 rgba(255, 255, 255, .88),
        inset 0 -1px 2px rgba(31, 45, 68, .045),
        0 1px 2px rgba(31, 45, 68, .05);
    }

    .segmented::before {
      content: "";
      position: absolute;
      inset: 1px;
      z-index: 0;
      border-radius: 9px;
      background: linear-gradient(180deg, rgba(255, 255, 255, .34), rgba(255, 255, 255, 0));
      pointer-events: none;
    }

    .segmented::-webkit-scrollbar {
      display: none;
    }

    .segmented-thumb {
      position: absolute;
      z-index: 1;
      top: 4px;
      bottom: 4px;
      left: 0;
      width: var(--segmented-thumb-width);
      border-radius: 8px;
      background:
        linear-gradient(180deg, #fff 0%, color-mix(in oklch, var(--surface) 86%, var(--blue-soft)) 100%);
      box-shadow:
        0 9px 24px rgba(31, 45, 68, .16),
        0 1px 2px rgba(31, 45, 68, .08),
        inset 0 1px 0 rgba(255, 255, 255, .95);
      transform: translate3d(var(--segmented-thumb-x), 0, 0);
      transition:
        transform .3s cubic-bezier(.16, 1, .28, 1),
        width .3s cubic-bezier(.16, 1, .28, 1),
        box-shadow .2s ease;
      overflow: hidden;
      will-change: transform, width;
      pointer-events: none;
    }

    .segmented-thumb::after {
      content: "";
      position: absolute;
      inset: -30% auto -30% -42%;
      width: 38%;
      background: linear-gradient(90deg, transparent, rgba(255, 255, 255, .82), transparent);
      opacity: 0;
      transform: translateX(0) skewX(-18deg);
      pointer-events: none;
    }

    .segmented.is-sliding .segmented-thumb {
      box-shadow:
        0 14px 34px rgba(31, 45, 68, .2),
        0 3px 8px rgba(35, 103, 245, .12),
        inset 0 1px 0 rgba(255, 255, 255, .98);
    }

    .segmented.is-sliding .segmented-thumb::after {
      animation: segmentedSheen .34s var(--ease-snap) both;
    }

    .segmented button {
      position: relative;
      z-index: 2;
      flex: 1 0 auto;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      border: 0;
      border-radius: 8px;
      min-height: 34px;
      padding: 0 14px;
      background: transparent;
      color: var(--muted);
      font-size: 12px;
      font-weight: 780;
      white-space: nowrap;
      cursor: pointer;
      transition:
        color .2s ease,
        transform .22s var(--ease-snap),
        background-color .18s ease,
        text-shadow .18s ease;
    }

    .segmented button:hover:not(.active) {
      background: rgba(255, 255, 255, .42);
      color: var(--ink-soft);
    }

    .segmented button.active {
      background: transparent;
      color: var(--ink);
      font-weight: 900;
      box-shadow: none;
      text-shadow: 0 1px 0 rgba(255, 255, 255, .75);
    }

    .segmented button:active {
      transform: translateY(1px) scale(.985);
    }

    .segmented.is-sliding button.active {
      transform: translateY(-1px);
    }

    .chart-toolbar button,

    .inspector-tabs button {
      border: 0;
      border-radius: 6px;
      min-height: 30px;
      padding: 0 10px;
      background: transparent;
      color: var(--muted);
      font-size: 12px;
      font-weight: 850;
      transition: background .2s ease, color .2s ease;
    }

    .chart-toolbar button.active,
    .inspector-tabs button.active {
      background: oklch(0.985 0.004 235);
      color: var(--ink);
      box-shadow: 0 4px 12px rgba(31, 45, 68, .08);
    }

    .chart-toolbar button {
      min-width: 48px;
      letter-spacing: .04em;
    }

    .line-chart {
      width: 100%;
      min-height: 280px;
      overflow: visible;
      stroke: none
    }

    .chart-grid-line {
      stroke: rgba(104, 115, 134, .18);
      stroke-width: 1;
    }

    .chart-area {
      fill: url(#chartFill);
      opacity: 1;
      border: none;
      margin: none
    }

    .chart-line {
      fill: none;
      stroke: var(--blue);
      stroke-width: 4.5;
      stroke-linecap: round;
      stroke-linejoin: round;
      stroke-dasharray: 0;
      stroke-dashoffset: 0;
      animation: drawLine 1s cubic-bezier(.2, .75, .3, 1) .16s forwards;
    }

    .chart-point {
      fill: oklch(0.985 0.004 235);
      stroke: var(--blue);
      stroke-width: 4;
      transform-box: fill-box;
      transform-origin: center;
    }

    .chart-bar {
      fill: #a895f4;
      opacity: .72;
      transform-origin: bottom;
      animation: barIn .62s ease both;
    }

    .chart-point,
    .chart-bar,
    .status-row,
    .bar-row,
    .legend-item,
    .donut {
      cursor: pointer;
    }

    .chart-point,
    .chart-bar,
    .fill,
    .legend-item,
    .donut {
      transition: transform .18s ease, opacity .18s ease, filter .18s ease, box-shadow .18s ease;
    }

    .chart-point:hover,
    .chart-bar:hover,
    .legend-item:hover,
    .donut:hover {
      filter: saturate(1.08);
    }

    .chart-point:hover {
      transform-box: fill-box;
      transform-origin: center;
      transform: scale(1.18);
    }

    .chart-bar:hover {
      opacity: .92;
    }

    .status-row:hover .fill,
    .bar-row:hover .fill {
      transform: scaleY(1.06);
      box-shadow: 0 0 0 1px rgba(255, 255, 255, .38), 0 8px 18px rgba(35, 103, 245, .18);
    }

    .legend-item:hover {
      transform: translateX(2px);
    }

    .donut:hover {
      transform: scale(1.02);
      box-shadow: 0 16px 34px rgba(35, 103, 245, .16);
    }

    .chart-axis {
      color: var(--muted);
      fill: currentColor;
      stroke: none;
      font: 600 12px/1 "Aptos", "Segoe UI Variable Text", "Segoe UI", Arial, sans-serif;
      letter-spacing: 0;
      text-rendering: optimizeLegibility;
    }

    .chart-compare-grid {
      display: grid;
      grid-template-columns: repeat(2, minmax(56px, 64px));
      justify-content: end;
      width: fit-content;
      gap: 5px;
      margin: 0 0 8px auto;
    }

    .chart-compare-grid--horizontal {
      width: fit-content;
      max-width: 100%;
      margin: 2px 0 8px auto;
      justify-content: end;
      grid-template-columns: minmax(0, 1fr);
      gap: 2px;
    }

    .chart-compare-card {
      min-width: 0;
      padding: 6px 7px;
      border: 1px solid var(--line);
      border-radius: 10px;
      background: linear-gradient(180deg, rgba(255, 255, 255, .98), rgba(247, 249, 252, .96));
      box-shadow: var(--shadow-hairline);
      text-align: right;
    }

    .chart-compare-card--up {
      border-color: color-mix(in oklab, var(--green) 28%, white);
      background: var(--green-soft)
    }

    .chart-compare-card--down {
      border-color: color-mix(in oklab, var(--red) 22%, white);
      background: var(--red-soft)
    }

    .chart-compare-card--horizontal {
      text-align: left;
      padding: 2px 0;
      display: grid;
      align-items: center;
      grid-template-columns: auto minmax(0, max-content) auto;
      grid-template-areas: "label meta value";
      column-gap: 5px;
      min-height: 22px;
      border: 0;
      border-radius: 0;
      background: transparent;
      box-shadow: none;
    }

    .chart-compare-card--horizontal .chart-compare-label {
      grid-area: label;
      margin: 0;
      color: var(--ink-soft);
      font-size: 11px;
      font-weight: 700;
      letter-spacing: 0;
    }

    .chart-compare-card--horizontal .chart-compare-value {
      grid-area: value;
      margin: 0;
