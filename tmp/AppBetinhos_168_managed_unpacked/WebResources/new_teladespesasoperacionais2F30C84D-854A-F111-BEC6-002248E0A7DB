          const resolvedOwner = resolveSelectedCardOwner(item.cardLast4, item);
          const assignmentMatches = resolvedOwner?.driver?.id === driver?.id;
          applyCardOwnerResolution(item, {
            status: assignmentMatches ? "resolved-by-card-assignment" : "resolved",
            expectedName: driver?.name || driver?.nick || "",
            assignment: assignmentMatches ? resolvedOwner.assignment : null
          }, false);
        }
      }
      if (field === "classification") item.classification = value;
      if (field === "km") item.km = value === "" ? null : Number(value);
      if (field === "note") item.note = trimDataverseText(value, 4000);
      if (field !== "pendingType") item.pendingType = Expense.expensePendingTypeByRule(item);
    }

    async function persistHotEdit(item, field, value) {
      const changes = hotEditDataverseChanges(field, value, item);
      if (Object.keys(changes).length) await updateDataverseExpense(item, changes);
      applyHotEditLocal(item, field, value);
      ensureDerivedExpenseFields(item);
      pushMockAudit("Hot edit", `${item.id}: ${field} atualizado para ${value || "(vazio)"}.`);
      toast(MOCK_MODE ? "Alteração aplicada no sandbox local." : "Dataverse salvo. Auditoria nativa registrara a alteracao.");
      render({ soft: true });
