    .chart-compare-value--success {
      background: var(--green);
    }

    .chart-compare-value--warning {
      background: var(--yellow);
    }

    .chart-compare-value--danger {
      background: var(--red);
    }

    .chart-compare-label,
    .chart-compare-meta {
      display: block;
