      color: var(--muted);
      font-size: 12px;
      line-height: 1.35;
      margin-top: 3px;
    }

    .audit-item {
      align-items: flex-start;
      padding: 12px;
      border: 1px solid var(--line-soft);
      border-radius: var(--radius);
      background: oklch(0.985 0.004 235);
    }

    .legend {
      display: grid;
      gap: 8px;
    }

    .legend-item {
      justify-content: space-between;
      color: var(--muted);
      font-size: 12px;
      font-weight: 750;
    }

    .legend-item span:nth-child(2) {
      flex: 1;
      min-width: 0;
      overflow: hidden;
      white-space: nowrap;
      text-overflow: ellipsis;
    }

    .swatch {
      width: 10px;
      height: 10px;
      border-radius: 4px;
      flex: 0 0 auto;
    }

    .donut-layout {
      display: grid;
      grid-template-columns: 150px minmax(0, 1fr);
      gap: 18px;
      align-items: center;
    }

    .donut {
      width: 150px;
      aspect-ratio: 1;
      border-radius: 50%;
      display: grid;
      place-items: center;
      background:
        conic-gradient(var(--blue) 0 var(--slice-1), var(--green) var(--slice-1) var(--slice-2), var(--orange) var(--slice-2) var(--slice-3), var(--violet) var(--slice-3) var(--slice-4), var(--pink) var(--slice-4) 100%);
      animation: fadeUp .42s ease both;
    }

    .donut-center {
      width: 88px;
      aspect-ratio: 1;
      border-radius: 50%;
      display: grid;
      place-items: center;
      padding: 10px;
      background: oklch(0.985 0.004 235);
      color: var(--ink);
      text-align: center;
      font-size: 12px;
      font-weight: 850;
      line-height: 1.1;
    }

    .chart-tooltip {
      position: fixed;
      left: 0;
      top: 0;
      z-index: 80;
      min-width: 176px;
      max-width: min(280px, calc(100vw - 24px));
      padding: 11px 12px;
      border-radius: 14px;
      border: 1px solid rgba(255, 255, 255, .78);
      background: linear-gradient(180deg, rgba(19, 35, 63, .96), rgba(30, 46, 78, .94));
      color: rgba(255, 255, 255, .96);
      box-shadow: 0 20px 50px rgba(19, 35, 63, .26);
      backdrop-filter: blur(18px);
      pointer-events: none;
      opacity: 0;
      transform: translate3d(0, 10px, 0) scale(.98);
      transition: opacity .14s ease, transform .14s ease;
    }

    .chart-tooltip.show {
      opacity: 1;
      transform: translate3d(0, 0, 0) scale(1);
    }

    .chart-tooltip-label {
      display: block;
      font-size: 12px;
      font-weight: 800;
      letter-spacing: .01em;
      color: rgba(255, 255, 255, .74);
    }

    .chart-tooltip-value {
      display: block;
      margin-top: 3px;
      font-size: 18px;
      line-height: 1.05;
      font-weight: 850;
      letter-spacing: -.01em;
    }

    .chart-tooltip-meta {
      display: block;
      margin-top: 5px;
      font-size: 12px;
      line-height: 1.35;
      color: rgba(255, 255, 255, .78);
    }

    .empty {
      min-height: 120px;
      display: grid;
      place-items: center;
      border: 1px dashed var(--line);
      border-radius: var(--radius);
      color: var(--muted);
      background: rgba(255, 255, 255, .58);
      font-size: 13px;
      font-weight: 750;
      text-align: center;
      padding: 18px;
    }

    .api-banner {
      min-height: 46px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      flex-wrap: wrap;
      gap: 12px;
      padding: 10px 12px;
      border: 1px solid var(--line-soft);
      border-radius: var(--radius);
      background: rgba(255, 255, 255, .72);
      color: var(--muted);
      font-size: 12px;
      font-weight: 750;
    }

    .api-banner strong {
      color: var(--ink);
      font-size: 13px;
    }

    .api-banner span {
      text-align: right;
      line-height: 1.35;
    }

    .api-banner.error {
      border-color: rgba(229, 72, 77, .26);
      background: var(--red-soft);
      color: #b4232a;
    }

    .api-banner.loading {
      border-color: rgba(35, 103, 245, .24);
      background: var(--blue-soft);
      color: #1d4ed8;
    }

    .api-banner.warning {
      border-color: rgba(243, 122, 33, .28);
      background: var(--orange-soft);
      color: #9a4a10;
    }

    .switch-row {
      justify-content: space-between;
      gap: 12px;
    }

    .switch {
      width: 42px;
      height: 24px;
      border: 0;
      border-radius: 999px;
      background: var(--green);
      padding: 3px;
      display: flex;
      justify-content: flex-end;
      transition: background var(--motion-fast) var(--ease-snap), justify-content var(--motion-fast) var(--ease-snap);
    }

    .switch::after {
      content: "";
      width: 18px;
      height: 18px;
      border-radius: 50%;
      background: oklch(0.985 0.004 235);
      box-shadow: 0 2px 6px rgba(31, 45, 68, .18);
    }

    .switch.off {
      background: rgba(17, 24, 39, .18);
      justify-content: flex-start;
    }

    .modal-backdrop {
      position: fixed;
      inset: 0;
      z-index: 70;
      display: none;
      place-items: center;
      padding: 18px;
      background: rgba(15, 23, 42, .34);
      backdrop-filter: blur(10px);
    }

    .modal-backdrop.open {
      display: grid;
      animation: fadeIn var(--motion-fast) var(--ease-snap) both;
    }

    .modal {
      width: min(780px, 100%);
      max-height: min(840px, calc(100svh - 36px));
      display: grid;
      grid-template-rows: auto minmax(0, 1fr) auto;
      background: oklch(0.985 0.004 235);
      border-radius: var(--radius);
      box-shadow: 0 28px 90px rgba(15, 23, 42, .28);
      overflow: hidden;
      animation: modalIn var(--motion-med) var(--ease-fluid) both;
    }

    .modal.small {
      width: min(520px, 100%);
    }

    .modal-head,
    .modal-foot {
      padding: 16px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 12px;
      border-bottom: 1px solid var(--line-soft);
    }

    .modal-foot {
      border-top: 1px solid var(--line-soft);
      border-bottom: 0;
      justify-content: flex-end;
      flex-wrap: wrap;
    }

    .modal-head h2 {
      margin: 0;
      font-size: 18px;
      line-height: 1.2;
    }

    .modal-head p {
      margin: 4px 0 0;
      color: var(--muted);
      font-size: 12px;
    }

    .modal-body {
      min-height: 0;
      overflow: auto;
      padding: 16px;
    }

    .form-grid {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 12px;
    }

    .field.wide {
      grid-column: 1 / -1;
    }

    .value-confirm-summary {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 10px;
      margin-bottom: 14px;
    }

    .value-confirm-box {
      min-width: 0;
      padding: 12px;
      border: 1px solid var(--line);
      border-radius: var(--radius);
      background: var(--surface-soft);
    }

    .value-confirm-box span {
      display: block;
      color: var(--muted);
      font-size: 11px;
      font-weight: 850;
      text-transform: uppercase;
      letter-spacing: .05em;
    }

    .value-confirm-box strong {
      display: block;
      margin-top: 5px;
      color: var(--ink);
      font-size: 20px;
      line-height: 1;
      font-weight: 900;
    }

    .wizard-steps {
      display: grid;
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: 10px;
      margin-bottom: 14px;
    }

    .toast {
      position: fixed;
      left: 18px;
      bottom: 18px;
      z-index: 90;
      max-width: min(390px, calc(100vw - 36px));
      padding: 12px 14px;
      border-radius: var(--radius);
      background: #111827;
      color: oklch(0.985 0.004 235);
      box-shadow: 0 20px 55px rgba(17, 24, 39, .28);
      font-size: 13px;
      font-weight: 750;
      opacity: 0;
      transform: translate3d(-12px, 12px, 0) scale(0.98);
      filter: blur(1px);
      pointer-events: none;
      transition: opacity 180ms cubic-bezier(0.25, 1, 0.5, 1), transform 180ms cubic-bezier(0.22, 1, 0.36, 1), filter 180ms cubic-bezier(0.22, 1, 0.36, 1);
      overflow: hidden;
    }

    .toast.show {
      opacity: 1;
      transform: translate3d(0, 0, 0) scale(1);
      filter: blur(0);
      animation: toastFlash 620ms cubic-bezier(0.22, 1, 0.36, 1);
    }

    .toast::after {
      content: "";
      position: absolute;
      inset: 0;
      transform: translateX(-100%);
      background: linear-gradient(100deg, transparent 40%, rgba(255, 255, 255, .26) 55%, transparent 68%);
      animation: toastSheen 620ms cubic-bezier(0.22, 1, 0.36, 1);
      animation-play-state: paused;
      pointer-events: none;
    }

    .toast.show::after {
      animation-play-state: running;
    }

