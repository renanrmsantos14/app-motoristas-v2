    function previousFuelKmForItem(item) {
      const currentDate = new Date(item.date);
      return transactions
        .filter((row) => row.id !== item.id && row.driverId === item.driverId)
        .filter((row) => Expense.normalizeSearch(row.category) === "combustivel" && row.km)
        .filter((row) => new Date(row.date) < currentDate)
        .sort((left, right) => new Date(right.date) - new Date(left.date))[0]?.km || item.previousKm || null;
    }

    function validateKmHotEdit(item, value) {
      if (Expense.normalizeSearch(item.category) !== "combustivel" || value === "") return "";
      const next = Number(value);
      if (!Number.isFinite(next) || next <= 0) return "Informe um KM válido para combustível.";
      const alert = Expense.kmAlertForExpense({ ...item, km: next, previousKm: previousFuelKmForItem(item) }, policyState.active);
      if (alert.severity === "block") return alert.label;
      if (alert.severity === "warn") toast(alert.label);
      return "";
    }

    async function saveHotEdit(item, field, value) {
      const blockedReason = hotEditBlockedReason(item);
      if (blockedReason) return toast(blockedReason);
      if (field === "value") return requestValueHotEditConfirmation(item, value);
      if (field === "km") {
        const kmBlockedReason = validateKmHotEdit(item, value);
        if (kmBlockedReason) {
          renderInspector();
          return toast(kmBlockedReason);
        }
      }
      return persistHotEdit(item, field, value);
    }

    function requestValueHotEditConfirmation(item, value) {
      const newValue = parseReceiptAmountInput(value);
      if (!Number.isFinite(newValue) || newValue <= 0) {
        toast("Informe um valor maior que zero.");
        renderInspector();
        return;
      }
      if (amountCents(newValue) === amountCents(item.value)) {
        renderInspector();
        return;
      }
      state.pendingValueEdit = {
        id: item.id,
        oldValue: Number(item.value || 0),
        newValue: Number(newValue.toFixed(2))
      };
      document.getElementById("valueConfirmOld").textContent = money(state.pendingValueEdit.oldValue);
      document.getElementById("valueConfirmNew").textContent = money(state.pendingValueEdit.newValue);
      const reviewed = document.getElementById("valueConfirmReviewed");
      const repeat = document.getElementById("valueConfirmRepeat");
      if (reviewed) reviewed.checked = false;
      if (repeat) {
        repeat.value = "";
        repeat.placeholder = formatMoneyInputValue(state.pendingValueEdit.newValue);
      }
      openModal("valueConfirmModal");
    }

    async function confirmPendingValueHotEdit(event) {
      event.preventDefault();
      const pending = state.pendingValueEdit;
      if (!pending) return closeModal("valueConfirmModal");
      const reviewed = document.getElementById("valueConfirmReviewed")?.checked;
      if (!reviewed) return toast("Marque a conferência do comprovante.");
      const repeatedValue = parseReceiptAmountInput(document.getElementById("valueConfirmRepeat")?.value);
      if (!Number.isFinite(repeatedValue) || amountCents(repeatedValue) !== amountCents(pending.newValue)) {
        return toast("O valor digitado precisa bater com o novo valor.");
      }
      const item = transactions.find((row) => row.id === pending.id);
      if (!item) return toast("Despesa não encontrada para atualizar.");
      try {
        await persistHotEdit(item, "value", pending.newValue);
        state.pendingValueEdit = null;
        closeModal("valueConfirmModal");
      } catch (error) {
        toast(error.message || "Falha ao salvar valor.");
      }
    }

