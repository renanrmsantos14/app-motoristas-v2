      overflow: visible;
      text-overflow: initial;
      margin: 0;
      font-size: 12px;
      line-height: 1;
      font-weight: 850;
    }

    .chart-compare-value--success,
    .chart-compare-value--warning,
    .chart-compare-value--danger {
      color: #fff;
