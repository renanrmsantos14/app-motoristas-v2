    .chart-compare-label {
      color: var(--muted);
      font-size: 8px;
      font-weight: 850;
      text-transform: uppercase;
      letter-spacing: .1em;
    }

    .chart-compare-value {
      display: block;
      margin-top: 2px;
      font-size: 14px;
      line-height: 1;
      font-weight: 900;
      letter-spacing: -.02em;
    }

    .chart-compare-meta {
      margin-top: 3px;
      color: var(--muted);
      font-size: 9px;
      line-height: 1.1;
      white-space: nowrap;
      overflow: hidden;
