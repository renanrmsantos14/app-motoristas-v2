    async function authenticatePluggyDirect() {
      const response = await fetch(`${PLUGGY_BROWSER_CONFIG.baseUrl}/auth`, {
        method: "POST",
        headers: { "Content-Type": "application/json", Accept: "application/json" },
        body: JSON.stringify({
          clientId: PLUGGY_BROWSER_CONFIG.clientId,
          clientSecret: PLUGGY_BROWSER_CONFIG.clientSecret
        }),
        cache: "no-store"
      });
      const payload = await response.json().catch(() => ({}));
      if (!response.ok) throw new Error(payload.message || payload.error || `Auth Pluggy HTTP ${response.status}`);
      const apiKey = String(payload.apiKey || "").trim();
      if (!apiKey) throw new Error("Auth Pluggy nao retornou apiKey.");
      return apiKey;
    }

    async function pluggyGetDirect(path, params, apiKey) {
      const url = new URL(path, PLUGGY_BROWSER_CONFIG.baseUrl);
      Object.entries(params || {}).forEach(([key, value]) => {
        if (value !== null && value !== undefined && value !== "") url.searchParams.set(key, value);
      });
      const response = await fetch(url.toString(), {
        headers: { Accept: "application/json", "X-API-KEY": apiKey },
        cache: "no-store"
      });
      const payload = await response.json().catch(() => ({}));
      if (!response.ok) throw new Error(payload.message || payload.error || `Pluggy ${path} HTTP ${response.status}`);
      return payload;
    }

    function resolvePeriodBounds(period = state?.period, referenceDate = new Date()) {
      if (!period || period === "all") return null;

      const reference = referenceDate instanceof Date ? new Date(referenceDate.getTime()) : new Date(referenceDate);
      if (Number.isNaN(reference.getTime())) return null;

      const startOfDay = (value) => {
        const date = new Date(value.getTime());
        date.setHours(0, 0, 0, 0);
        return date;
      };
      const endOfDay = (value) => {
        const date = new Date(value.getTime());
        date.setHours(23, 59, 59, 999);
        return date;
      };
      const dateInputToDate = (value, end = false) => {
        const match = String(value || "").match(/^(\d{4})-(\d{2})-(\d{2})$/);
        if (!match) return null;
        const date = new Date(Number(match[1]), Number(match[2]) - 1, Number(match[3]));
        if (Number.isNaN(date.getTime())) return null;
        return end ? endOfDay(date) : startOfDay(date);
      };

      if (period === "custom") {
        const start = dateInputToDate(state?.customStart);
        const end = dateInputToDate(state?.customEnd, true);
        if (!start && !end) return null;
        if (start && end && start > end) {
          return {
            start: dateInputToDate(state?.customEnd),
            end: dateInputToDate(state?.customStart, true)
          };
        }
        return {
          start: start || new Date(-8640000000000000),
          end: end || new Date(8640000000000000)
        };
      }

      const selectedPeriod = Number(period);
      if (Number.isFinite(selectedPeriod) && selectedPeriod > 0) {
        return {
          start: new Date(reference.getTime() - selectedPeriod * 24 * 60 * 60 * 1000),
          end: reference
        };
      }

      if (period === "month-current") {
        return {
          start: startOfDay(new Date(reference.getFullYear(), reference.getMonth(), 1)),
          end: endOfDay(reference)
        };
      }

      if (period === "month-last") {
        return {
          start: startOfDay(new Date(reference.getFullYear(), reference.getMonth() - 1, 1)),
          end: endOfDay(new Date(reference.getFullYear(), reference.getMonth(), 0))
        };
      }

      if (period === "year-current") {
        return {
          start: startOfDay(new Date(reference.getFullYear(), 0, 1)),
          end: endOfDay(reference)
        };
      }

      if (period === "year-last") {
        return {
          start: startOfDay(new Date(reference.getFullYear() - 1, 0, 1)),
          end: endOfDay(new Date(reference.getFullYear() - 1, 11, 31))
        };
      }

      return null;
    }

    function pluggyDateFrom() {
      const referenceDate = new Date();
      const bounds = resolvePeriodBounds(state?.period, referenceDate);
      if (state?.period === "custom") {
        const minDate = new Date(-8640000000000000).getTime();
        if (bounds?.start && Number.isFinite(bounds.start.getTime()) && bounds.start.getTime() > minDate) {
          return bounds.start.toISOString().slice(0, 10);
        }
      }
      const selectedPeriod = Number(state?.period || 0);
      const selectedDays = bounds
        ? Math.ceil((referenceDate.getTime() - bounds.start.getTime()) / (24 * 60 * 60 * 1000))
        : (Number.isFinite(selectedPeriod) ? selectedPeriod : 0);
      const days = Math.max(PLUGGY_BROWSER_CONFIG.dateFromDays, selectedDays);
      if (bounds && selectedDays >= PLUGGY_BROWSER_CONFIG.dateFromDays) return bounds.start.toISOString().slice(0, 10);
      const date = new Date(referenceDate.getTime() - days * 24 * 60 * 60 * 1000);
      return date.toISOString().slice(0, 10);
    }

    async function mapWithConcurrency(items, limit, worker) {
      const results = [];
      let cursor = 0;
      const size = Math.max(1, Math.min(Number(limit) || 1, items.length || 1));
      await Promise.all(Array.from({ length: size }, async () => {
        while (cursor < items.length) {
          const index = cursor;
          cursor += 1;
          results[index] = await worker(items[index], index);
        }
      }));
      return results;
    }

    async function loadTransactionsForPluggyAccount(account, apiKey) {
      const accountId = account?.id || account?.accountId;
      if (!accountId) return [];
      const rows = [];
      let page = 1;
      let totalPages = 1;

      do {
        const payload = await pluggyGetDirect("/transactions", {
          accountId,
          pageSize: PLUGGY_BROWSER_CONFIG.pageSize,
          page,
          dateFrom: pluggyDateFrom()
        }, apiKey);
        const pageRows = normalizePluggyResults(payload).map((row) => ({ ...row, accountId: row.accountId || accountId }));
        rows.push(...pageRows);
        totalPages = Number(payload.totalPages || totalPages || 1);
        page += 1;
      } while (page <= totalPages && page <= PLUGGY_BROWSER_CONFIG.maxPages);

      return rows;
    }

