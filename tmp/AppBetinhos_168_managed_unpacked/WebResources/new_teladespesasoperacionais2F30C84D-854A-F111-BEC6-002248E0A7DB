        --row: 44px;
        --shell-pad: 6px;
        --layout-gap: 8px;
        --sidebar-sticky-top: var(--shell-pad);
        --sidebar-height-offset: calc(var(--sidebar-sticky-top) * 2);
        --topbar-min-height: 54px;
      }

      .app-shell {
        grid-template-columns: 68px minmax(0, 1fr);
        gap: var(--layout-gap);
        padding: var(--shell-pad);
      }

      .sidebar {
        position: sticky;
        top: var(--sidebar-sticky-top);
        height: calc(var(--app-vh) - var(--sidebar-height-offset));
      }

      .brand {
        padding: 10px 8px;
        justify-content: center;
      }

      .brand h1,
      .brand p,
      .sync-strip,
      .nav-label,
      .nav-item .label,
      .nav-pill,
      .mini-profile div {
        display: none;
      }

      .brand-row,
      .mini-profile {
        justify-content: center;
        grid-template-columns: auto;
      }

      .nav-scroll {
        display: grid;
        gap: 8px;
        padding: 8px 6px;
        overflow-y: auto;
      }

      .nav-group {
        display: grid;
        gap: 8px;
      }

      .nav-group+.nav-group {
        margin-top: 0;
      }

      .nav-item {
        width: 100%;
        min-width: 0;
        min-height: 38px;
        grid-template-columns: 1fr;
        justify-items: center;
        padding: 0;
      }


      .app-main {
        gap: 8px;
      }

      .topbar {
        min-height: var(--topbar-min-height);
        grid-template-columns: minmax(190px, .72fr) minmax(230px, 1fr) auto;
        gap: 8px;
        padding: 8px;
        position: static;
      }

      .title-area h2 {
        font-size: 24px;
      }

      .breadcrumb {
        font-size: 11px;
      }

      .search-box {
        min-height: 38px;
      }

      .search-box input,
      .field input,
      .field select,
      .field textarea,
      .btn,
      .icon-btn {
        font-size: 13px;
      }

      .top-actions {
        display: flex;
        flex-wrap: nowrap;
        justify-content: flex-start;
        overflow-x: auto;
        padding-bottom: 1px;
        scrollbar-width: none;
      }

      .top-actions::-webkit-scrollbar {
        display: none;
      }

      .top-actions .btn,
      .top-actions .icon-btn {
        width: 40px;
        min-width: 40px;
        min-height: 38px;
        padding: 0;
        flex: 0 0 auto;
      }

      .top-actions .btn {
        font-size: 0;
        gap: 0;
      }

      .top-actions .btn svg {
        width: 18px;
        height: 18px;
      }

      .top-actions .btn.primary {
        width: 44px;
        min-width: 44px;
      }

      .filter-strip {
        grid-template-columns: repeat(4, minmax(0, 1fr)) auto;
        gap: 8px;
        padding: 8px;
      }

      .filter-strip .btn {
        width: auto;
      }

      .field {
        gap: 4px;
      }

      .field label {
        font-size: 10px;
      }

      .field input,
      .field select {
        min-height: 36px;
      }

      .workspace {
        grid-template-columns: minmax(0, 1fr);
      }

      .inspector {
        display: none;
      }

      .metric-grid {
        grid-template-columns: repeat(4, minmax(0, 1fr));
      }

      .metric {
        min-height: 108px;
        padding: 10px;
        gap: 7px;
      }

      .metric-value {
        font-size: 22px;
      }

      .metric-caption,
      .metric-label {
        font-size: 11px;
      }

      .spark {
        height: 24px;
      }

      .panel-head {
        min-height: 48px;
        padding: 10px 12px;
      }

      .panel-body,
      .card-pad {
        padding: 12px;
      }
    }

    .workspace[data-view]:not([data-view="transacoes"]):not([data-view="auditoria"]) {
      grid-template-columns: minmax(0, 1fr);
    }

    .workspace[data-view]:not([data-view="transacoes"]):not([data-view="auditoria"]) .inspector {
      display: none;
    }

    @media (prefers-reduced-motion: reduce) {

      *,
      *::before,
      *::after {
        animation-duration: .01ms !important;
        animation-iteration-count: 1 !important;
        scroll-behavior: auto !important;
        transition-duration: .01ms !important;
      }
    }
  </style>
</head>

