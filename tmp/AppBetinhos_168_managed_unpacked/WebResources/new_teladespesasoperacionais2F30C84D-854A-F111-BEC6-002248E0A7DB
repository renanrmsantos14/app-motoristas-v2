    function buildChartComparison(metricFn) {
      const items = ["current", "lm", "ly"].map((scope) => {
        const rows = chartRowsForScope(scope);
        return {
          scope,
          label: scope === "current" ? "Atual" : scope.toUpperCase(),
          rows,
          value: metricFn(rows, scope)
        };
      });
      const total = items.reduce((sum, item) => sum + item.value, 0) || 1;
      return items.map((item) => ({
        ...item,
        share: item.value / total
      }));
    }

