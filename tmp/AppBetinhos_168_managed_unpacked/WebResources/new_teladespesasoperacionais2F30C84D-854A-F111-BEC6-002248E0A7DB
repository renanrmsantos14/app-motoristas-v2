  <script>
    (function initExpenseLogic(root) {
      "use strict";

      const CARD_OWNER_RULES = [
        { last4: "7228", employeeName: "Marcos Menecucci" },
        { last4: "4310", employeeName: "Eduardo Calastri" }
      ];

      const tones = ["blue", "green", "orange", "violet"];

      function normalizeSearch(value) {
        return String(value || "")
          .normalize("NFD")
          .replace(/[\u0300-\u036f]/g, "")
          .toLowerCase();
      }

      function normalizeKey(value) {
        return normalizeSearch(value).replace(/[^a-z0-9]+/g, "");
      }

      function cleanText(value, fallback) {
        const text = String(value || "").replace(/\s+/g, " ").trim();
        return text || fallback || "";
      }

      function compactName(name) {
        const parts = cleanText(name, "").split(/\s+/).filter(Boolean);
        if (!parts.length) return "Sem nome";
        if (parts.length === 1) return parts[0];
        return parts[parts.length - 1];
      }

      function formatted(row, field) {
        return row?.[`${field}@OData.Community.Display.V1.FormattedValue`] || "";
      }

      const DATAVERSE_CHOICE_LABELS = {
        cr40f_origem: {
          100000000: "Pluggy",
          100000001: "Itau API",
          100000002: "CTF",
          100000003: "Cartao Corporativo",
          100000004: "Open Finance",
          100000005: "Sistema Interno",
          100000006: "Importacao Controlada",
          100000007: "Outro"
        },
        cr40f_status: {
          100000000: "Pendente",
          100000001: "Pendente",
          100000002: "Pendente",
          100000003: "Aprovada",
