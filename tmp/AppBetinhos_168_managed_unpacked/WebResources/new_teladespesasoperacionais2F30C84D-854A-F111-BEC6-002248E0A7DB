    function flattenAuditRows(loadedRows) {
      return loadedRows.flatMap(({ item, ...row }, rowIndex) => {
        const changes = row.changes?.length ? row.changes : [{ field: "Alteração", before: "(não informado)", after: row.detail || "Registrada pelo Dataverse" }];
        return changes.map((change, changeIndex) => ({
          key: `${item.id}-${rowIndex}-${changeIndex}`,
          expenseId: item.id,
          expenseLabel: item.place || item.category || item.nick || item.id,
          field: change.field,
          changedAt: row.changedAt,
          userName: row.userName,
          actionLabel: row.actionLabel,
          before: change.before,
          after: change.after,
          source: "Auditoria nativa Dataverse"
        }));
      });
    }

    function auditWorkbench(events) {
      const fieldCount = events.reduce((total, event) => total + (event.changes?.length || 1), 0);
      const expenseCount = new Set(events.map((event) => event.item?.id || event.expenseId).filter(Boolean)).size;
      const rows = flattenAuditEventsForLedger(events);
      return `
        <div class="audit-workbench">
          <div class="audit-workbench-head">
            ${info("Eventos", events.length)}
            ${info("Campos alterados", fieldCount)}
            ${info("Despesas", expenseCount || "1")}
          </div>
          <div class="audit-ledger">
            ${rows.map((row) => auditLedgerRow(row)).join("")}
          </div>
        </div>
      `;
    }

    function flattenAuditEventsForLedger(events) {
      return events.flatMap((event, eventIndex) => {
        const item = event.item || {};
        const changes = event.changes?.length ? event.changes : [{ field: "Alteração", before: "(não informado)", after: event.detail || "Registrada pelo Dataverse" }];
        const expenseId = item.id || event.expenseId || "";
        const expenseLabel = item.place || item.category || item.nick || event.expenseLabel || expenseId || "Despesa";
        return changes.map((change, changeIndex) => ({
          key: `${expenseId || event.id || "audit"}-${event.id || eventIndex}-${changeIndex}`,
          expenseId,
          expenseLabel,
          field: change.field,
          before: change.before,
          after: change.after,
          changedAt: event.changedAt || "Sem data",
          userName: event.userName || "Usuário não informado",
          actionLabel: event.actionLabel || "Alteração registrada",
          source: event.source || "Auditoria nativa Dataverse",
          itemDate: item.date ? dateTimeFmt.format(new Date(item.date)) : event.changedAt || "Sem data"
        }));
      });
    }

    function auditLedgerRow(row) {
      const selected = state.selectedAuditKey === row.key ? " selected" : "";
      return `
        <article class="audit-change-row${selected}" data-audit-row="${esc(row.key)}" data-audit-expense="${esc(row.expenseId)}" tabindex="0" role="button" aria-label="Abrir overview da despesa ${esc(row.expenseLabel || row.expenseId)}">
          <div class="audit-field-cell">
            <span>Campo alterado</span>
            <strong>${esc(row.field)}</strong>
          </div>
          <div class="audit-change-main">
            <div class="audit-change-summary">
              <div>
                <strong>${esc(row.actionLabel)}</strong>
                <span>${esc(row.userName)} · ${esc(row.source)}</span>
              </div>
              <span class="pill neutral">${esc(row.changedAt)}</span>
            </div>
            <div class="audit-value-flow">
              <div class="audit-value-box">
                <span>Antes</span>
                <strong>${esc(row.before)}</strong>
              </div>
              <div class="audit-diff-arrow">${icons.arrow}</div>
              <div class="audit-value-box after">
                <span>Depois</span>
                <strong>${esc(row.after)}</strong>
              </div>
            </div>
          </div>
          <div class="audit-item-cell">
            <div class="audit-item-id">
              <span>ID do item</span>
              <strong>${esc(row.expenseId || "Não informado")}</strong>
            </div>
            <div class="audit-item-date">
              <span>Data do item</span>
              <strong>${esc(row.itemDate)}</strong>
            </div>
          </div>
        </article>
      `;
    }

    function auditEventCard(event, index) {
      const item = event.item || {};
      const changes = event.changes?.length ? event.changes : [{ field: "Alteração", before: "(não informado)", after: event.detail || "Registrada pelo Dataverse" }];
      const key = event.key || `${item.id || event.expenseId || "audit"}-${event.id || index}`;
      const selected = state.selectedAuditKey === key ? " selected" : "";
      const expenseLabel = item.place || item.category || item.nick || event.expenseLabel || item.id || event.expenseId || "Despesa";
      return `
        <article class="audit-event-card${selected}" data-audit-row="${esc(key)}" data-audit-expense="${esc(item.id || event.expenseId || "")}" tabindex="0" role="button" aria-label="Abrir auditoria de ${esc(expenseLabel)}">
          <aside class="audit-context-rail">
            <span class="audit-event-kicker">${esc(event.changedAt || "Sem data")}</span>
            <div class="audit-event-title">
              <strong>${esc(event.actionLabel || "Alteração registrada")}</strong>
              <span>${esc(event.userName || "Usuário não informado")}</span>
            </div>
            <div class="audit-context-list">
              <div><span>Despesa</span><strong>${esc(expenseLabel)}</strong></div>
              <div><span>Motorista</span><strong>${esc(item.nick || item.driver || "Não informado")}</strong></div>
              <div><span>Origem</span><strong>${esc(event.source || "Auditoria nativa Dataverse")}</strong></div>
            </div>
          </aside>
          <div class="audit-change-pane">
            <div class="audit-change-pane-head">
              <div>
                <strong>${changes.length} campo(s) alterado(s)</strong>
                <span>ID ${esc(item.id || event.expenseId || "")}</span>
              </div>
              <span class="pill neutral">${esc(event.changedAt || "Agora")}</span>
            </div>
            ${changes.map((change) => `
              <div class="audit-diff-grid">
                <div class="audit-diff-box">
                  <span>${esc(change.field)} antes</span>
                  <strong>${esc(change.before)}</strong>
                </div>
                <div class="audit-diff-arrow">${icons.arrow}</div>
                <div class="audit-diff-box after">
                  <span>${esc(change.field)} depois</span>
                  <strong>${esc(change.after)}</strong>
                </div>
              </div>
            `).join("")}
          </div>
        </article>
      `;
    }

    function auditScopePanel(rows) {
      if (MOCK_MODE) return mockAuditScopePanel();
      if (!rows.length) {
        return `<div class="empty">Nenhuma despesa encontrada com os filtros globais atuais.</div>`;
      }
      const loadedRows = rows.flatMap((item) => (auditState.cache.get(item.id) || []).map((row) => ({ ...row, item })));
      const loadingCount = rows.filter((item) => auditState.loading.has(item.id)).length;
      const errorRows = rows.filter((item) => auditState.errors.has(item.id));
      if (!loadedRows.length && loadingCount) {
        return `<div class="api-banner loading"><strong>Auditoria Dataverse</strong><span>Carregando histórico de ${loadingCount} despesa(s).</span></div>`;
      }
      if (!loadedRows.length && errorRows.length) {
        return `
          <div class="audit-list detailed">
            ${errorRows.map((item) => `
              <div class="audit-item">
                <div class="audit-icon">${icons.file}</div>
                <div>
                  <strong>Auditoria indisponível · ${esc(item.id)}</strong>
                  <span>${esc(item.place || item.category || "Despesa")} · ${esc(item.nick || item.driver || "Motorista não informado")}</span>
                  <span>${esc(auditState.errors.get(item.id))}</span>
                </div>
              </div>
            `).join("")}
          </div>
        `;
      }
      if (!loadedRows.length) {
        return `<div class="api-banner warning"><strong>Sem histórico carregado</strong><span>O Dataverse pode demorar para expor a auditoria ou a tabela/coluna pode estar sem auditoria habilitada.</span></div>`;
      }
      return auditWorkbench(loadedRows);
    }

    function info(label, value) {
      return `<div class="info-box"><span>${esc(label)}</span><strong>${esc(value || "Não informado")}</strong></div>`;
    }

    function step(title, text, kind) {
      const icon = kind === "done" ? icons.check : kind === "danger" ? icons.warn : icons.clock;
      return `<div class="timeline-step"><div class="timeline-dot ${kind}">${icon}</div><div><strong>${esc(title)}</strong><span>${esc(text)}</span></div></div>`;
    }

    function tabLabel(tab) {
      return { resumo: "Resumo", evidencia: "Evidência", auditoria: "Auditoria" }[tab] || tab;
    }

    function expectedEvidence(category) {
      if (category === "Combustível") return "Cupom fiscal + KM";
      if (["Manutenção", "Hospedagem"].includes(category)) return "Nota fiscal";
      if (["Almoço", "Jantar", "Café"].includes(category)) return "Cupom fiscal";
      if (category === "Pedágio") return "Origem integrada";
      return "Comprovante";
    }

