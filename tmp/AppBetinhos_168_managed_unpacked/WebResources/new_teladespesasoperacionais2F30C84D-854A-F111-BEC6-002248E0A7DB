              <div class="panel-title">
                <h2>Performance de despesas</h2>
                <p>Total de despesas no período filtrado, com comparação LM e LY.</p>
              </div>
            </div>
            <div class="panel-body">
              ${performanceRevenueSummary(stats.spend, renderChartComparisonCards(buildChartComparison((windowRows) => windowRows.reduce((sum, item) => sum + item.value, 0)), money, null, true))}
              ${trendChart(rows)}
