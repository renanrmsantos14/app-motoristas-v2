      if (viewportHeight > 0) root.style.setProperty("--app-vh", `${viewportHeight}px`);
      const topbar = document.querySelector(".topbar");
      if (topbar && window.matchMedia("(min-width: 1101px)").matches) {
        root.style.setProperty("--topbar-min-height", `${Math.ceil(topbar.getBoundingClientRect().height)}px`);
