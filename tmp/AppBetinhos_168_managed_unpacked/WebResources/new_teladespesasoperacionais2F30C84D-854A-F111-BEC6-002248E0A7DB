    function statusClass(status) {
      const key = statusKey(status);
      if (key === "aprovada") return "good";
      if (key === "enviada") return "orange";
      if (key === "pendente") return "warn";
      if (key === "reprovada") return "danger";
      if (key === "cancelado") return "danger";
      return "";
    }

    function statusTone(status) {
      const key = statusKey(status);
      if (key === "aprovada") return "green";
      if (key === "enviada") return "orange";
      if (key === "pendente") return "yellow";
      if (key === "reprovada") return "red";
      if (key === "cancelado") return "red";
      return "blue";
    }

    function lotStatusClass(status) {
      if (status === "Processado") return "good";
      if (status === "Em revisão") return "warn";
      if (status === "Pendente") return "violet";
      return "neutral";
    }

    function attachmentClass(status) {
      const key = Expense.normalizeSearch(status);
      if (key === "enviado" || key === "validado") return "good";
      if (key === "nao exigido") return "neutral";
      return "warn";
    }

    function shortStatus(status) {
      return status;
    }

    function expenseTagLabels(item) {
      return riskFlagsForExpense(item).map((flag) => flag.label);
    }

    const tagFilterCache = {
      key: "",
      options: []
    };

    function availableTagFilterOptions() {
      const cacheKey = String(transactions.length);
      if (tagFilterCache.key === cacheKey && tagFilterCache.options.length) return tagFilterCache.options;
      const labels = new Set();
      let hasNoTag = false;
      transactions.map(ensureDerivedExpenseFields).forEach((item) => {
        const itemTags = expenseTagLabels(item);
        if (!itemTags.length) hasNoTag = true;
        itemTags.forEach((label) => labels.add(label));
      });
      const options = [...labels].sort((a, b) => a.localeCompare(b, "pt-BR", { sensitivity: "base" })).map((label) => [label, label]);
      const result = hasNoTag ? [["__none", "Sem tag"], ...options] : options;
      tagFilterCache.key = cacheKey;
      tagFilterCache.options = result;
      return result;
    }

    function syncTagFilter() {
      const tagFilter = document.getElementById("tagFilter");
      const tagFilterPanel = document.getElementById("tagFilterPanel");
      const tagFilterTrigger = document.getElementById("tagFilterTrigger");
      if (!tagFilter || !tagFilterPanel || !tagFilterTrigger) return;
      const options = availableTagFilterOptions();
      const validTags = new Set(options.map(([value]) => value));
      state.tags = (Array.isArray(state.tags) ? state.tags : []).filter((tag) => validTags.has(tag));
      tagFilter.innerHTML = options.length
        ? options.map(([value, label]) => `<option value="${esc(value)}">${esc(label)}</option>`).join("")
        : '<option value="__empty" disabled>Sem tags no período</option>';
      [...tagFilter.options].forEach((option) => {
        option.selected = state.tags.includes(option.value);
      });
      tagFilterPanel.innerHTML = options.length
        ? options.map(([value, label]) => {
          const selected = state.tags.includes(value);
          return `<label class="tag-filter-option"><input type="checkbox" data-tag-option="${esc(value)}" ${selected ? "checked" : ""} /><span>${esc(label)}</span></label>`;
        }).join("")
        : `<span class="tag-filter-option"><span></span><span class="muted">Sem tags no período</span></span>`;
      tagFilterTrigger.textContent = state.tags.length ? `${state.tags.length} selecionada${state.tags.length > 1 ? "s" : ""}` : "Todas";
    }

    function closeTagFilterPanel() {
      const tagFilterRoot = document.getElementById("tagFilterRoot");
      const tagFilterPanel = document.getElementById("tagFilterPanel");
      const tagFilterTrigger = document.getElementById("tagFilterTrigger");
      if (!tagFilterRoot || !tagFilterPanel || !tagFilterTrigger) return;
      tagFilterRoot.classList.remove("open");
      tagFilterPanel.hidden = true;
      tagFilterTrigger.setAttribute("aria-expanded", "false");
    }

    function toggleTagFilterPanel(open) {
      const tagFilterRoot = document.getElementById("tagFilterRoot");
      const tagFilterPanel = document.getElementById("tagFilterPanel");
      const tagFilterTrigger = document.getElementById("tagFilterTrigger");
      if (!tagFilterRoot || !tagFilterPanel || !tagFilterTrigger) return;
      const shouldOpen = typeof open === "boolean" ? open : tagFilterPanel.hidden;
      tagFilterRoot.classList.toggle("open", shouldOpen);
      tagFilterPanel.hidden = !shouldOpen;
      tagFilterTrigger.setAttribute("aria-expanded", shouldOpen ? "true" : "false");
    }

    const customFilterConfig = [
      { id: "periodFilter", multiple: false, emptyLabel: "Selecione" },
      { id: "financialChannelFilter", multiple: true, emptyLabel: "Todos" },
      { id: "driverFilter", multiple: true, emptyLabel: "Todos" },
      { id: "statusFilter", multiple: true, emptyLabel: "Todos" },
      { id: "categoryFilter", multiple: true, emptyLabel: "Todas" }
    ];

    function ensureCustomFilterControl(id, multiple = false) {
      const select = document.getElementById(id);
      if (!select) return null;
      select.multiple = multiple;
      if (multiple) select.setAttribute("multiple", "");
      else select.removeAttribute("multiple");
      select.classList.add("native-filter-select");
      const field = select.closest(".field");
      if (!field) return null;
      let root = field.querySelector(`[data-custom-filter="${id}"]`);
      if (!root) {
        const label = field.querySelector("label")?.textContent?.trim() || "Filtro";
        root = document.createElement("div");
        root.className = "tag-filter";
        root.dataset.customFilter = id;
        root.innerHTML = `
          <button type="button" class="tag-filter-trigger" data-custom-trigger="${id}" aria-label="${esc(label)}" aria-haspopup="listbox" aria-expanded="false">Selecione</button>
          <div class="tag-filter-panel" data-custom-panel="${id}" role="listbox" aria-label="${esc(label)}" hidden></div>
        `;
        select.insertAdjacentElement("afterend", root);
      }
      root.dataset.multiple = multiple ? "true" : "false";
      return root;
    }

    function customFilterAllValue(id) {
      return id === "financialChannelFilter" ? "consolidated" : "all";
    }

    function setSelectValues(id, values = [], fallbackValue = "all") {
      const select = document.getElementById(id);
      if (!select) return;
      const selected = new Set(values);
      [...select.options].forEach((option) => {
        option.selected = select.multiple
          ? selected.has(option.value) || (!selected.size && option.value === fallbackValue)
          : option.value === fallbackValue;
      });
      if (!select.multiple) select.value = fallbackValue;
    }

    function selectedOptionsFromSelect(select, allValue = "all") {
      return [...select.selectedOptions]
        .map((option) => option.value)
        .filter((value) => value && value !== allValue && value !== "__empty");
    }

    function applyMultiFilterChange(select, stateKey, legacyKey, allValue = "all") {
      const values = selectedOptionsFromSelect(select, allValue);
      state[stateKey] = values;
      state[legacyKey] = values.length === 1 ? values[0] : allValue;
      renderFilterChange();
    }

    function syncCustomFilterControl(id, emptyLabel = "Selecione") {
      const select = document.getElementById(id);
      const root = document.querySelector(`[data-custom-filter="${id}"]`);
      if (!select || !root) return;
      const trigger = root.querySelector(`[data-custom-trigger="${id}"]`);
      const panel = root.querySelector(`[data-custom-panel="${id}"]`);
      if (!trigger || !panel) return;
      const multiple = root.dataset.multiple === "true";
      const allValue = customFilterAllValue(id);
      const options = [...select.options].filter((option) => !option.disabled || option.value !== "__empty");
      panel.innerHTML = options.length
        ? options.map((option) => {
          const checked = option.selected || (multiple && !selectedOptionsFromSelect(select, allValue).length && option.value === allValue);
          const inputType = multiple ? "checkbox" : "radio";
          const inputName = multiple ? "" : ` name="${esc(id)}"`;
          return `<label class="tag-filter-option" role="option" aria-selected="${checked ? "true" : "false"}"><input type="${inputType}"${inputName} data-custom-option="${esc(id)}" value="${esc(option.value)}" ${checked ? "checked" : ""} /><span>${esc(option.textContent || "")}</span></label>`;
        }).join("")
        : `<span class="tag-filter-option"><span></span><span class="muted">${esc(emptyLabel)}</span></span>`;

      if (multiple) {
        const selectedOptions = options.filter((option) => option.selected && option.value !== allValue);
        const count = selectedOptions.length;
        const feminine = id === "categoryFilter";
        trigger.textContent = count ? `${count} selecionad${feminine ? "a" : "o"}${count > 1 ? "s" : ""}` : emptyLabel;
      } else {
        const selectedOption = options.find((option) => option.selected) || options[0];
        trigger.textContent = selectedOption?.textContent || emptyLabel;
      }
    }

    function closeAllCustomFilterPanels(exceptId = "") {
      document.querySelectorAll("[data-custom-filter]").forEach((root) => {
        const id = root.dataset.customFilter || "";
        if (id === exceptId) return;
        root.classList.remove("open");
        const trigger = root.querySelector(`[data-custom-trigger="${id}"]`);
        const panel = root.querySelector(`[data-custom-panel="${id}"]`);
        if (trigger) trigger.setAttribute("aria-expanded", "false");
        if (panel) panel.hidden = true;
      });
    }

