    async function persistPluggyPayloadToDataverse(api, payload) {
      const stats = { accountsCreated: 0, transactionsCreated: 0, expensesCreated: 0, skipped: 0, errors: 0 };
      const syncIndex = await buildPluggyDataverseIndex(api);
      for (const account of normalizePluggyAccounts(payload)) {
        try {
          if (await persistPluggyAccount(api, account, syncIndex)) stats.accountsCreated += 1;
          else stats.skipped += 1;
        } catch {
          stats.errors += 1;
        }
      }

      const rows = normalizePluggyResults(payload);
      for (let index = 0; index < rows.length; index += 5) {
        const chunk = rows.slice(index, index + 5);
        const results = await Promise.allSettled(chunk.map(async (tx) => ({
          transactionCreated: await persistPluggyTransaction(api, tx, syncIndex),
          expenseCreated: await persistPluggyExpense(api, tx, syncIndex)
        })));
        results.forEach((result) => {
          if (result.status !== "fulfilled") {
            stats.errors += 1;
            return;
          }
          if (result.value.transactionCreated) stats.transactionsCreated += 1;
          if (result.value.expenseCreated) stats.expensesCreated += 1;
          if (!result.value.transactionCreated && !result.value.expenseCreated) stats.skipped += 1;
        });
      }
      return stats;
    }

    function persistPluggyPayloadInBackground(payload, options = {}) {
      if (!PLUGGY_BROWSER_CONFIG.saveToDataverse) return Promise.resolve();
      const api = getXrmApi();
      if (!api?.createRecord || !api?.retrieveMultipleRecords) return Promise.resolve();

      apiState.persisting = true;
      apiState.persistError = null;
      apiState.persistStats = null;
      updateSyncStrip();

      return persistPluggyPayloadToDataverse(api, payload)
        .then((stats) => {
          apiState.persistStats = stats;
          if (stats.errors) apiState.persistError = `${stats.errors} item(ns) nao foram salvos`;
          else toast(`Dataverse atualizado: ${stats.transactionsCreated} transacao(oes) e ${stats.expensesCreated} despesa(s) nova(s).`);
        })
        .catch((error) => {
          apiState.persistError = error.message || "Falha ao salvar no Dataverse";
        })
        .finally(() => {
          apiState.persisting = false;
          if (options.refreshDataverseAfter !== false) {
            return loadDataverseExpenses({ ...options, silent: true, skipRender: true, preserveExistingOnEmpty: true })
              .catch((error) => {
                apiState.persistError = error.message || "Dataverse reconciliation failed";
              })
              .finally(() => {
                updateSyncStrip();
                render();
              });
          }
          updateSyncStrip();
          render();
        });
    }

    async function loadPluggyTransactions(options = {}) {
      if (!employeeState.loaded && !employeeState.loading && !employeeState.error) {
        await loadFuncionarios({ silent: true, skipRender: true });
      }

      apiState.loading = true;
      apiState.error = null;
      apiState.persistError = null;
      updateSyncStrip();
      render({ soft: true });

      try {
        const payload = await loadPluggyDirectPayload();
        pluggyAccountContext = buildPluggyAccountContext(payload);
        const rawRows = normalizePluggyResults(payload);
        const rows = rawRows.map((tx) => pluggyToExpense(tx, pluggyAccountContext)).filter(Boolean);
        if (MOCK_MODE) {
          if (rows.length) {
            transactions = rows.sort((a, b) => new Date(b.date) - new Date(a.date));
            state.selectedIds.clear();
            if (!transactions.some((item) => item.id === state.selectedId)) state.selectedId = transactions[0]?.id || null;
            applyDuplicateFlags(transactions);
          }
          apiState.mode = "mock-pluggy";
          apiState.source = rows.length ? "Pluggy direto + cadastros mock" : "Pluggy direto sem despesas + cadastros mock";
        } else {
          apiState.mode = "dataverse";
          apiState.source = "Dataverse cr40f_despesa + Pluggy background";
        }
        apiState.lastSync = payload.fetchedAt || new Date().toISOString();
        apiState.rawCount = Number(payload.rawCount ?? rows.length);
        apiState.accountId = payload.accountId || null;
        apiState.itemId = payload.itemId || null;
        apiState.accountIds = payload.accountIds || [];
        upsertPluggyLot(payload, rows.length);
        await persistPluggyPayloadInBackground(payload, { ...options, refreshDataverseAfter: true });
        debugRefresh(options, "pluggy:resultado", {
          dateFrom: pluggyDateFrom(),
          accounts: pluggyAccountContext.accounts.length,
          accountIds: apiState.accountIds,
          rawTransactions: rawRows.length,
          expenseRows: rows.length,
          ignoredRows: Math.max(0, rawRows.length - rows.length),
          selectedId: state.selectedId
        });
        if (!options.silent) {
          toast(MOCK_MODE
            ? `${rows.length} despesa(s) reais Pluggy carregada(s); cadastros auxiliares em mock.`
            : `${rows.length} transacao(oes) Pluggy encontradas. Salvando Dataverse em segundo plano.`
          );
        }
      } catch (error) {
        pluggyAccountContext = { accounts: [], accountId: null, accountIndex: new Map() };
        apiState.mode = MOCK_MODE ? "mock" : (transactions.length ? "dataverse" : "error");
        apiState.error = error.message === "Failed to fetch"
          ? "Falha ao chamar Pluggy direto. Se for CORS, sera preciso usar API intermediaria."
          : error.message || "Erro Pluggy";
        debugRefresh(options, "pluggy:erro", { error: apiState.error });
        if (MOCK_MODE && options.preserveMockOnPluggyError) {
          apiState.source = "Mock data com Pluggy indisponivel";
          apiState.lastSync = apiState.lastSync || new Date().toISOString();
          apiState.rawCount = transactions.length;
        }
        if (!options.silent) toast(`Pluggy: ${apiState.error}`);
      } finally {
        apiState.loading = false;
        updateSyncStrip();
        render();
      }
    }

    function normalizePluggyResults(payload) {
      const source = payload?.results ?? payload?.items ?? payload?.data ?? payload;
      return Array.isArray(source) ? source : [];
    }

    function normalizePluggyAccounts(payload) {
      const source = payload?.accounts ?? payload?.accountResults ?? [];
      return Array.isArray(source) ? source : [];
    }

    function buildPluggyAccountContext(payload) {
      const accounts = normalizePluggyAccounts(payload);
      return {
        accounts,
        accountId: payload?.accountId || null,
        accountIndex: Expense.buildPluggyAccountIndex(accounts)
      };
    }

    function pluggyToExpense(tx, accountContext) {
      const rawId = tx.id || tx.transactionId || tx.providerId || `${tx.date || "sem-data"}-${tx.amount || 0}-${tx.description || ""}`;
      const amount = Number(tx.amount ?? tx.value ?? tx.balance ?? 0);
      if (!Number.isFinite(amount) || amount === 0) return null;

      const place = cleanPluggyText(tx.description || tx.descriptionRaw || tx.merchant?.name || tx.paymentData?.payer?.name || "Transacao Pluggy");
      const financialChannel = Expense.pluggyFinancialChannel(tx, accountContext);
      if (isPluggyCreditOrPayment(tx, amount, place, accountContext)) return null;

      const date = normalizePluggyDate(tx.date || tx.transactionDate || tx.createdAt);
      const category = categoryFromPluggy(tx, place, date);
      const rawStatus = String(tx.status || "").toUpperCase();
      const attachment = Expense.attachmentForCategory(category);
      const review = Expense.deriveExpenseReview({ category, attachment, km: null, rawStatus });
      const cardLast4 = financialChannel === "credit_card" ? Expense.resolvePluggyCardLast4(tx, accountContext) : "";
      const owner = financialChannel === "credit_card"
        ? Expense.resolveCardOwner(cardLast4, drivers, undefined, cardAssignments, date)
        : { status: "", last4: "", expectedName: "", driver: ensureFinancialChannelDriver(financialChannel, tx), assignment: null };
      const driver = owner.driver || ensureUnresolvedCardDriver(owner);
      const pendingType = financialChannel === "credit_card" && !RESOLVED_CARD_OWNER_STATUSES.has(owner.status)
        ? "Cartão sem portador ativo"
        : financialChannel === "unknown"
          ? "Canal a confirmar"
          : review.pendingType;
      const financialChannelNote = financialChannel === "bank_account"
        ? "Conta bancária Pluggy"
        : financialChannel === "fuel_network"
          ? "Rede de combustível/CTF"
          : financialChannel === "unknown"
            ? "Canal financeiro a confirmar"
            : "";
      const note = [
        financialChannel === "credit_card" ? (cardLast4 ? `Cartão final ${cardLast4}` : "Cartão sem final informado") : financialChannelNote,
        owner.expectedName ? `Portador esperado: ${owner.expectedName}` : "",
        financialChannel === "credit_card"
          ? (["resolved", "resolved-by-card-assignment"].includes(owner.status) ? "Portador confirmado no Dataverse" : `Vínculo Dataverse: ${owner.status}`)
          : "Sem portador de cartão aplicável",
        tx.descriptionRaw ? `Raw: ${tx.descriptionRaw}` : "",
        rawStatus ? `Status Pluggy: ${rawStatus}` : "",
        tx.category ? `Categoria Pluggy: ${categoryLabel(tx.category)}` : ""
      ].filter(Boolean).join(" | ") || "Importado da Pluggy.";

      return createManualExpense(
        `pluggy-${rawId}`,
        "Pluggy",
        driver.id,
        date,
        Math.abs(amount),
        place,
        category,
        review.status,
        review.classification,
        attachment,
        null,
        false,
        pendingType,
        note,
        {
          financialChannel,
          cardLast4,
          cardOwnerStatus: owner.status,
          cardExpectedOwner: owner.expectedName,
          cardAssignmentId: owner.assignment?.id || null,
          employeeId: financialChannel === "credit_card" ? owner.driver?.id || null : null
        }
      );
    }

    function cleanPluggyText(value) {
      return String(value || "").replace(/\s+/g, " ").trim().slice(0, 80) || "Transacao Pluggy";
    }

    function normalizePluggyDate(value) {
      const date = value ? new Date(value) : new Date();
      return Number.isNaN(date.getTime()) ? new Date().toISOString() : date.toISOString();
    }

    function categoryLabel(category) {
      return Expense.categoryLabel(category);
    }

    function categoryFromPluggy(tx, place, date) {
      return Expense.categoryFromPluggy(tx, place, date);
    }

    function isPluggyCreditOrPayment(tx, amount, place, accountContext) {
      return Expense.isPluggyCreditOrPayment(tx, amount, place, accountContext);
    }

    function applyDuplicateFlags(rows) {
      const counts = rows.reduce((map, item) => {
        map.set(item.hash, (map.get(item.hash) || 0) + 1);
        return map;
      }, new Map());

      rows.forEach((item) => {
        if (counts.get(item.hash) > 1) {
          item.duplicate = true;
          item.pendingType = "Possivel duplicidade Pluggy";
        }
      });
    }

    function upsertPluggyLot(payload, created) {
      const start = payload.fetchedAt || new Date().toISOString();
      const lotRow = {
        id: "lot-pluggy-live",
        name: "Sync Pluggy Itau Pinda",
        origin: "Pluggy",
        status: apiState.error ? "Erro" : "Processado",
        start,
        end: new Date().toISOString(),
        total: Number(payload.rawCount ?? created),
        created,
        duplicates: transactions.filter((item) => item.duplicate).length,
        errors: Math.max(0, Number(payload.rawCount ?? created) - created),
        file: payload.accountId ? `account:${payload.accountId}` : "Pluggy"
      };
      const index = lots.findIndex((item) => item.id === lotRow.id);
      if (index >= 0) lots.splice(index, 1, lotRow);
      else lots.unshift(lotRow);
    }

    function updateSyncStrip() {
      const strip = document.getElementById("syncStrip");
      if (!strip) return;
      const label = strip.querySelector("span:last-child");
      strip.classList.remove("loading", "error", "neutral");
      if (apiState.loading) {
        strip.classList.add("loading");
        label.textContent = "API buscando";
        return;
      }
      if (apiState.error) {
        strip.classList.add("error");
        label.textContent = MOCK_MODE ? "Pluggy indisponivel" : "API erro";
        return;
      }
      if (MOCK_MODE) {
        strip.classList.add("neutral");
        label.textContent = apiState.lastSync
          ? `${apiState.source} ${dateTimeFmt.format(new Date(apiState.lastSync))}`
          : apiState.source;
        return;
      }
      if (apiState.persisting) {
        strip.classList.add("loading");
        label.textContent = "Dataverse reconciliando";
        return;
      }
      if (apiState.persistError) {
        strip.classList.add("error");
        label.textContent = "Dataverse aviso";
        return;
      }
      if (apiState.persistStats) {
        label.textContent = "Dataverse salvo";
        return;
      }
      if (apiState.lastSync) {
        label.textContent = `API atualizada ${dateTimeFmt.format(new Date(apiState.lastSync))}`;
        return;
      }
      strip.classList.add("neutral");
      label.textContent = "API aguardando";
    }

    let refreshOverlayHideTimer = null;
    let refreshOverlayShownAt = 0;

    function setRefreshOverlay(active, text = "Atualizando despesas...") {
      const overlay = document.getElementById("refreshOverlay");
      const label = document.getElementById("refreshOverlayText");
      const button = document.getElementById("refreshBtn");
      if (!overlay) return;
      if (refreshOverlayHideTimer) {
        window.clearTimeout(refreshOverlayHideTimer);
        refreshOverlayHideTimer = null;
      }
      if (label) label.textContent = text;
      if (active) {
        refreshOverlayShownAt = performance.now();
        overlay.removeAttribute("hidden");
        overlay.setAttribute("aria-hidden", "false");
        overlay.style.display = "grid";
        requestAnimationFrame(() => overlay.classList.add("show"));
        if (button) button.disabled = true;
        return;
      }
      const elapsed = performance.now() - refreshOverlayShownAt;
      const hideDelay = Math.max(0, 450 - elapsed);
      if (button) button.disabled = false;
      refreshOverlayHideTimer = window.setTimeout(() => {
        overlay.classList.remove("show");
        overlay.setAttribute("aria-hidden", "true");
        refreshOverlayHideTimer = window.setTimeout(() => {
          if (!state.refreshingData) {
            overlay.setAttribute("hidden", "");
            overlay.style.display = "";
          }
        }, 220);
      }, hideDelay);
    }

