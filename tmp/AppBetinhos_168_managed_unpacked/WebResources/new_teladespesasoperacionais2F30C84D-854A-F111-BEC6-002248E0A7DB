<!doctype html>
<html lang="pt-BR">

<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="theme-color" content="#eef3f8" />
  <meta name="description"
    content="Tela de despesas para controle financeiro operacional." />
  <title>Despesas</title>
  <style>
    :root {
      --bg: #f2f4f8;
      --bg-soft: #f5f7fa;
      --surface: #ffffff;
      --surface-soft: #f6f8fb;
      --surface-strong: #dde2e8;
      --ink: oklch(0.225 0.029 250);
      --ink-soft: oklch(0.355 0.035 250);
      --muted: oklch(0.51 0.028 250);
      --muted-2: oklch(0.66 0.021 250);
      --line: oklch(0.875 0.016 235);
      --line-soft: oklch(0.928 0.011 235);
      --blue: oklch(0.56 0.19 259);
      --blue-soft: oklch(0.945 0.035 259);
      --green: oklch(0.62 0.16 155);
      --green-soft: oklch(0.945 0.047 155);
      --orange: oklch(0.67 0.17 48);
      --orange-soft: oklch(0.95 0.052 62);
      --red: oklch(0.61 0.19 25);
      --red-soft: oklch(0.95 0.045 25);
      --violet: oklch(0.56 0.17 292);
      --violet-soft: oklch(0.945 0.038 292);
      --pink: oklch(0.63 0.17 345);
      --pink-soft: oklch(0.955 0.04 345);
      --yellow: oklch(0.76 0.15 85);
      --yellow-soft: oklch(0.962 0.06 86);
      --shadow: 0 22px 60px rgb(35 47 68 / .12);
      --shadow-soft: 0 8px 22px rgb(35 47 68 / .075);
      --shadow-hairline: 0 1px 2px rgb(35 47 68 / .08);
      --radius: 8px;
      --control-height: 40px;
      --control-radius: var(--radius);
      --control-bg: oklch(0.988 0.005 245);
      --control-bg-hover: oklch(0.994 0.004 245);
      --control-bg-disabled: oklch(0.957 0.007 245);
      --control-border: oklch(0.855 0.018 245);
      --control-border-hover: oklch(0.765 0.036 248);
      --control-border-focus: oklch(0.58 0.18 258);
      --control-text: var(--ink);
      --control-muted: var(--muted);
      --control-shadow: inset 0 1px 0 oklch(1 0 0 / .72), var(--shadow-hairline);
      --control-focus-shadow: 0 0 0 4px oklch(0.58 0.18 258 / .12), var(--shadow-hairline);
      --control-pad-x: 10px;
      --shell-pad: 14px;
      --app-vh: 100svh;
      --sidebar: 260px;
      --inspector: 360px;
      --row: 56px;
      --topbar-sticky-top: var(--shell-pad);
      --topbar-min-height: 76px;
      --layout-gap: 12px;
      --sidebar-sticky-top: var(--shell-pad);
      --sidebar-height-offset: calc(var(--sidebar-sticky-top) * 2);
      --inspector-sticky-top: calc(var(--topbar-sticky-top) + var(--topbar-min-height) + var(--layout-gap) + 2px);
      --inspector-bottom-gap: var(--shell-pad);
      --inspector-height-offset: calc(var(--inspector-sticky-top) + var(--inspector-bottom-gap));
      --ease-fluid: cubic-bezier(.22, 1, .36, 1);
      --ease-snap: false;
      --motion-fast: .22s;
      --motion-med: .44s;
      --motion-slow: .9s;
      color-scheme: light;
      font-family: "Aptos", "Segoe UI Variable Text", "Segoe UI", Arial, sans-serif;
      font-variant-numeric: tabular-nums;
    }

    * {
      box-sizing: border-box;
    }

    html {
      min-height: 100%;
      scroll-behavior: smooth;
    }

    body {
      margin: 0;
      min-height: var(--app-vh);
      overflow-x: clip;
      background: var(--bg);
    }

    body::before {
      display: none;
    }

    body::after {
      display: none;
    }

    button,
    input,
    select,
    textarea {
      font: inherit;
    }

    input::placeholder,
    textarea::placeholder {
      color: color-mix(in oklch, var(--control-muted) 72%, transparent);
    }

    button {
      cursor: pointer;
    }

    button:focus-visible,
    input:focus-visible,
    select:focus-visible,
    textarea:focus-visible {
      outline: 3px solid rgba(35, 103, 245, .22);
      outline-offset: 2px;
    }

    a {
      color: inherit;
    }

    svg {
      width: 18px;
      height: 18px;
      fill: none;
      stroke: currentColor;
      stroke-width: 2;
      stroke-linecap: round;
      stroke-linejoin: round;
      flex: 0 0 auto;
    }

    .skip-link {
      position: fixed;
      left: 16px;
      top: 12px;
      z-index: 100;
      transform: translateY(-140%);
      background: var(--ink);
      color: oklch(0.985 0.004 235);
      padding: 10px 12px;
      border-radius: var(--radius);
      text-decoration: none;
    }

    .skip-link:focus {
      transform: translateY(0);
    }

    .app-shell {
      min-height: var(--app-vh);
      display: grid;
      grid-template-columns: var(--sidebar) minmax(0, 1fr);
      gap: 16px;
      padding: var(--shell-pad);
    }

    .sidebar {
      position: sticky;
      top: var(--sidebar-sticky-top);
      height: calc(var(--app-vh) - var(--sidebar-height-offset));
      display: grid;
      grid-template-rows: auto 1fr auto;
      background: rgba(255, 255, 255, .78);
      border: 1px solid rgba(255, 255, 255, .92);
      border-radius: var(--radius);
      box-shadow: var(--shadow);
      backdrop-filter: blur(18px);
      overflow: hidden;
    }

    .brand {
      padding: 18px;
      border-bottom: 1px solid var(--line-soft);
      display: grid;
      gap: 14px;
    }

    .brand-row {
      display: flex;
      align-items: center;
      justify-content: center;
      align-self: center;
      gap: 12px;
    }

    .brand-mark {
      width: 38px;
      height: 38px;
      border-radius: 10px;
      display: grid;
      place-items: center;
      color: oklch(0.985 0.004 235);
      font-weight: 850;
      letter-spacing: -.04em;
      background:
        linear-gradient(135deg, #13233f 0%, #2367f5 55%, #16b66a 100%);
      box-shadow: 0 12px 28px rgba(35, 103, 245, .24);
    }

    .brand-logo {
      width: 42px;
      height: 42px;
      border-radius: 999px;
      object-fit: contain;
      background: none;
      padding: 0%;
      box-shadow: 0 10px 22px rgb(35 47 68 / .14);
    }

    .brand h1 {
      margin: 0;
      font-size: 15px;
      line-height: 1.1;
      letter-spacing: -.01em;
      font-weight: 800;
    }

    .brand p {
      margin: 2px 0 0;
      color: var(--muted);
      font-size: 12px;
      line-height: 1.3;
    }

    .sync-strip {
      display: flex;
      align-items: center;
      gap: 8px;
      min-height: 36px;
      padding: 8px 10px;
      border-radius: var(--radius);
      background: var(--green-soft);
      color: #0c7a45;
      font-size: 12px;
      font-weight: 750;
    }

    .sync-strip.loading {
      background: var(--blue-soft);
      color: #1d4ed8;
    }

    .sync-strip.error {
      background: var(--red-soft);
      color: #b4232a;
    }

    .sync-strip.neutral {
      background: var(--surface-strong);
      color: var(--muted);
    }

    .sync-dot {
      width: 8px;
      height: 8px;
      border-radius: 999px;
      background: var(--green);
      box-shadow: 0 0 0 5px rgba(22, 182, 106, .14);
      animation: pulse 1.9s ease-in-out infinite;
    }

    .sync-strip.loading .sync-dot {
      background: var(--blue);
      box-shadow: 0 0 0 5px rgba(35, 103, 245, .14);
    }

    .sync-strip.error .sync-dot {
      background: var(--red);
      box-shadow: 0 0 0 5px rgba(229, 72, 77, .14);
      animation: none;
    }

    .nav-scroll {
      padding: 14px 10px;
      overflow-y: auto;
    }

    .nav-group+.nav-group {
      margin-top: 16px;
    }

    .nav-label {
      margin: 0 8px 8px;
      color: var(--muted-2);
      font-size: 11px;
      font-weight: 800;
      text-transform: uppercase;
      letter-spacing: .08em;
    }

    .nav-item {
      width: 100%;
      min-height: 42px;
      border: 0;
      border-radius: var(--radius);
      padding: 0 9px;
      display: grid;
      grid-template-columns: 28px minmax(0, 1fr) auto;
      align-items: center;
      gap: 8px;
      color: var(--ink-soft);
      background: transparent;
      text-align: left;
      transition: transform var(--motion-fast) var(--ease-snap), background var(--motion-fast) var(--ease-snap), color var(--motion-fast) var(--ease-snap), box-shadow var(--motion-fast) var(--ease-snap);
    }

    .nav-item:hover {
      background: var(--surface-soft);
      transform: translateX(4px) scale(1.01);
    }

    .nav-item.active {
      color: var(--blue);
      background: var(--blue-soft);
      box-shadow: none;
    }

    .nav-icon {
      width: 28px;
      height: 28px;
      border-radius: var(--radius);
      display: grid;
      place-items: center;
      background: rgba(17, 24, 39, .04);
    }

    .nav-item.active .nav-icon {
      background: oklch(0.985 0.004 235);
    }

    .nav-item .label {
      overflow: hidden;
      white-space: nowrap;
      text-overflow: ellipsis;
      font-size: 13px;
      font-weight: 750;
    }

    .nav-pill {
      min-width: 24px;
      height: 22px;
      border-radius: 999px;
      padding: 0 7px;
      display: grid;
      place-items: center;
      color: var(--muted);
      background: rgba(17, 24, 39, .05);
      font-size: 11px;
      font-weight: 800;
    }

   

    .mini-profile {
      display: grid;
      grid-template-columns: 34px 1fr;
      align-items: center;
      gap: 10px;
    }

    .avatar {
      width: 34px;
      height: 34px;
      border-radius: var(--radius);
      display: inline-grid;
      place-items: center;
      color: oklch(0.985 0.004 235);
      background: linear-gradient(135deg, #16213a, #2367f5);
      font-size: 12px;
      font-weight: 850;
      box-shadow: inset 0 1px 0 rgba(255, 255, 255, .28);
    }

    .avatar.green {
      background: linear-gradient(135deg, #0b7a45, #16b66a);
    }

    .avatar.orange {
      background: linear-gradient(135deg, #a54e10, #f37a21);
    }

    .avatar.violet {
      background: linear-gradient(135deg, #45308f, #7157d9);
    }

    .mini-profile strong {
      display: block;
      font-size: 13px;
      line-height: 1.2;
    }

    .mini-profile span:not(.avatar) {
      display: block;
      color: var(--muted);
      font-size: 12px;
      margin-top: 2px;
    }

    .app-main {
      position: relative;
      min-width: 0;
      max-width: 100%;
      display: grid;
      grid-template-rows: auto auto 1fr;
      gap: 12px;
    }

    .topbar {
      min-height: var(--topbar-min-height);
      display: grid;
      grid-template-columns: minmax(220px, .9fr) minmax(260px, 1.15fr) auto;
      gap: 12px;
      align-items: center;
      padding: 12px 14px;
      background: rgba(255, 255, 255, .82);
      border: 1px solid rgba(255, 255, 255, .92);
      border-radius: var(--radius);
      box-shadow: var(--shadow-soft);
      backdrop-filter: blur(18px);
      position: sticky;
      top: var(--topbar-sticky-top);
      z-index: 20;
    }

    .app-main:has(.workspace:not(.no-inspector))> .filter-strip {
      width: calc(100% - var(--inspector) - var(--layout-gap));
    }

    .breadcrumb {
      color: var(--muted);
      font-size: 12px;
      font-weight: 700;
    }

    .title-area h2 {
      margin: 3px 0 0;
      color: var(--ink);
      font-size: 34px;
      line-height: 1;
      font-weight: 850;
      letter-spacing: 0;
      text-wrap: balance;
    }

    .search-box {
      min-height: 46px;
      display: grid;
      grid-template-columns: 20px 1fr auto;
      align-items: center;
      gap: 10px;
      padding: 0 12px;
      border: 1px solid var(--line);
      border-radius: var(--radius);
      background: var(--surface-soft);
      color: var(--muted);
    }

    .search-box input {
      width: 100%;
      border: 0;
      outline: 0;
      background: transparent;
      color: var(--ink);
      min-width: 0;
    }

    .key-hint {
      height: 24px;
      min-width: 30px;
      padding: 0 7px;
      display: inline-grid;
      place-items: center;
      border-radius: 6px;
      border: 1px solid var(--line);
      background: oklch(0.985 0.004 235);
      color: var(--muted);
      font-size: 11px;
      font-weight: 800;
    }

    .top-actions,
    .panel-actions,
    .modal-actions,
    .row-actions {
      min-width: 0;
      display: flex;
      align-items: center;
      justify-content: flex-end;
      flex-wrap: wrap;
      gap: 8px;
    }

    .btn,
    .icon-btn {
      border: 1px solid var(--line);
      background: oklch(0.985 0.004 235);
      color: var(--ink-soft);
      border-radius: var(--radius);
      min-height: 40px;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      font-weight: 800;
      font-size: 13px;
      transition: transform .2s ease, box-shadow .2s ease, background .2s ease, border-color .2s ease, color .2s ease;
    }

    .btn {
      padding: 0 12px;
      white-space: nowrap;
    }

    .icon-btn {
      width: 40px;
      padding: 0;
    }

    .btn:hover,
    .icon-btn:hover {
      transform: translateY(-1px);
      box-shadow: 0 10px 22px rgba(31, 45, 68, .10);
      border-color: #cbd7e6;
    }

    .btn:active,
    .icon-btn:active,
    .nav-item:active {
      transform: translateY(1px) scale(.99);
    }

    .btn.primary {
      border-color: transparent;
      background: var(--blue);
      color: oklch(0.985 0.004 235);
      box-shadow: 0 12px 26px rgba(35, 103, 245, .24);
    }

    .btn.success {
      border-color: transparent;
      background: var(--green);
      color: oklch(0.985 0.004 235);
      box-shadow: 0 12px 26px rgba(22, 182, 106, .22);
    }

    .btn.danger {
      border-color: transparent;
      background: var(--red);
      color: oklch(0.985 0.004 235);
    }

    .filter-strip {
      display: grid;
      grid-template-columns: repeat(6, minmax(118px, 1fr)) auto;
      gap: 10px;
      align-items: end;
      padding: 12px;
      background: rgba(255, 255, 255, .74);
      border: 1px solid rgba(255, 255, 255, .92);
      border-radius: var(--radius);
      box-shadow: var(--shadow-soft);
      backdrop-filter: blur(18px);
    }

    .filter-strip .field input,
    .filter-strip .field select,
    .filter-strip .field textarea {
      min-height: 18px;
    }

    .field {
      min-width: 0;
      display: grid;
      gap: 6px;
    }

    .field.compact-date {
      min-width: 132px;
    }

    .field[hidden] {
      display: none;
    }

    .field label {
      color: var(--muted);
      font-size: 11px;
      font-weight: 850;
      text-transform: uppercase;
      letter-spacing: .06em;
    }

    .field input,
    .field select,
    .field textarea {
      width: 100%;
      min-width: 0;
      min-height: 40px;
      border: 1px solid var(--line);
      border-radius: var(--radius);
      background: oklch(0.985 0.004 235);
      color: var(--ink);
      padding: 0 10px;
      transition: border-color .2s ease, box-shadow .2s ease, background .2s ease;
    }

    .field textarea {
      min-height: 96px;
      resize: vertical;
      padding-top: 10px;
      line-height: 1.45;
    }

    .tag-filter-field {
      min-width: 150px;
    }

    .native-filter-select {
      position: absolute !important;
      width: 1px !important;
      height: 1px !important;
      opacity: 0 !important;
      pointer-events: none !important;
    }

    .tag-filter {
      position: relative;
    }

    .tag-filter-trigger {
      width: 100%;
      min-height: 40px;
      border: 1px solid var(--line);
      border-radius: var(--radius);
      background: oklch(0.985 0.004 235);
      color: var(--ink);
      padding: 0 10px;
      text-align: left;
      font: inherit;
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 8px;
      transition: border-color .2s ease, box-shadow .2s ease, background .2s ease;
    }

    .tag-filter-trigger::after {
      content: "";
      width: 8px;
      height: 8px;
      border-right: 1.7px solid color-mix(in oklch, var(--ink) 72%, transparent);
      border-bottom: 1.7px solid color-mix(in oklch, var(--ink) 72%, transparent);
      transform: translateY(-2px) rotate(45deg);
      transition: transform .2s ease;
      flex: 0 0 auto;
    }

    .tag-filter.open .tag-filter-trigger {
      border-color: rgba(35, 103, 245, .55);
      box-shadow: 0 0 0 4px rgba(35, 103, 245, .08);
      background: color-mix(in oklch, var(--surface) 92%, oklch(0.7 0.12 252) 8%);
    }

    .tag-filter.open .tag-filter-trigger::after {
      transform: translateY(1px) rotate(225deg);
    }

    .tag-filter-panel {
      position: absolute;
      z-index: 40;
      left: 0;
      right: 0;
      top: calc(100% + 6px);
      border: 1px solid color-mix(in oklch, var(--line) 86%, transparent);
      border-radius: 10px;
      background: color-mix(in oklch, var(--surface) 97%, transparent);
      box-shadow: var(--shadow-soft);
      padding: 6px;
      display: grid;
      gap: 1px;
      max-height: 220px;
      overflow-y: auto;
    }

    .tag-filter-panel[hidden] {
      display: none;
    }

    .tag-filter-option {
      display: grid;
      grid-template-columns: 16px minmax(0, 1fr);
      gap: 6px;
      align-items: center;
      padding: 4px 6px;
      border-radius: 8px;
      cursor: pointer;
      font-size: .82rem;
      color: var(--ink);
      text-transform: none;
    }

    .tag-filter-option:hover {
      background: color-mix(in oklch, var(--surface-alt) 74%, transparent);
    }

    .tag-filter-option input {
      width: 14px;
      height: 14px;
      margin: 0;
      accent-color: oklch(0.56 0.17 254);
    }

    .tag-filter-option span {
      text-transform: none;
    }

    .field input:focus,
    .field select:focus,
    .field textarea:focus {
      border-color: rgba(35, 103, 245, .55);
      box-shadow: 0 0 0 4px rgba(35, 103, 245, .08);
    }

    .workspace {
      min-width: 0;
      display: grid;
      grid-template-columns: minmax(0, 1fr) var(--inspector);
      gap: 12px;
      align-items: start;
      transition: grid-template-columns var(--motion-med) var(--ease-fluid), gap var(--motion-med) var(--ease-fluid);
    }

    .workspace.no-inspector {
      grid-template-columns: minmax(0, 1fr);
    }

    .content {
      min-width: 0;
      display: grid;
      gap: 12px;
    }

    .view-anim {
      display: grid;
      gap: 12px;
      animation: viewEnter var(--motion-med) var(--ease-fluid) both;
    }

    .view-anim>* {
      animation: stageIn var(--motion-slow) var(--ease-fluid) both;
      animation-delay: calc(var(--stagger-index, 0) * 70ms);
      transform-origin: center top;
      will-change: transform, opacity;
    }

    .view-anim>*:nth-child(1) {
      --stagger-index: 0;
    }

    .view-anim>*:nth-child(2) {
      --stagger-index: 1;
    }

    .view-anim>*:nth-child(3) {
      --stagger-index: 2;
    }

    .view-anim>*:nth-child(4) {
      --stagger-index: 3;
    }

    .view-anim>*:nth-child(5) {
      --stagger-index: 4;
    }

    .view-anim>*:nth-child(6) {
      --stagger-index: 5;
    }

    .view-anim>*:nth-child(7) {
      --stagger-index: 6;
    }

.view-anim>*:nth-child(8) {
      --stagger-index: 7;
    }

.view-anim>*:nth-child(n+9) {
      --stagger-index: 8;
    }

    .view-anim table tr,
    .view-anim .task-card,
    .view-anim .transaction-card {
      animation: stageIn var(--motion-med) var(--ease-fluid) both;
      animation-delay: calc(var(--stagger-index, 0) * 36ms);
    }

.view-anim.soft {
      animation: none;
    }

.view-anim.soft>* {
      animation: none;
    }

    .view-anim.no-motion,
    .view-anim.no-motion>*,
    .view-anim.no-motion .task-card,
    .view-anim.no-motion .transaction-card,
    .view-anim.no-motion table tr,
    .view-anim.no-motion .panel,
    .view-anim.no-motion .card {
      animation: none !important;
      transition: none !important;
    }

    .app-refresh-overlay {
      position: fixed;
      inset: 0;
      z-index: 95;
      display: grid;
      place-items: center;
      padding: 24px;
      pointer-events: none;
      opacity: 0;
      visibility: hidden;
      transition: opacity var(--motion-med) var(--ease-fluid), visibility 0s linear var(--motion-med);
      background: color-mix(in oklch, var(--ink) 20%, transparent);
      backdrop-filter: blur(8px);
      -webkit-backdrop-filter: blur(8px);
    }

    .app-refresh-overlay.show {
      pointer-events: auto;
      opacity: 1;
      visibility: visible;
      transition: opacity var(--motion-med) var(--ease-fluid);
    }

    .app-refresh-overlay .refresh-card {
      pointer-events: none;
      width: min(300px, calc(100vw - 48px));
      display: grid;
      gap: 10px;
      justify-items: center;
      padding: 16px 14px;
      border-radius: 14px;
      border: 1px solid color-mix(in oklch, var(--line-soft) 72%, transparent);
      background: color-mix(in oklch, var(--surface) 92%, transparent);
      box-shadow: var(--shadow-soft);
      color: var(--ink);
      text-align: center;
      position: relative;
      overflow: hidden;
      animation: refreshCardPulse 2.1s ease-in-out infinite;
      backdrop-filter: blur(16px);
    }

    .app-refresh-overlay .refresh-card::before {
      content: "";
      position: absolute;
      inset: -90px;
      background: radial-gradient(circle at 50% 0%, rgba(35, 103, 245, 0.12), transparent 70%);
      animation: refreshShine 5s ease-in-out infinite;
      pointer-events: none;
      opacity: .5;
    }

    .app-refresh-overlay .refresh-card::after {
      content: "";
      position: absolute;
      inset: 1px;
      border-radius: inherit;
      border: 1px solid rgba(15, 23, 42, 0.08);
      pointer-events: none;
      opacity: .75;
      z-index: 1;
    }

    .app-refresh-overlay .refresh-loader {
      width: 50px;
      height: 50px;
      position: relative;
      display: inline-block;
      z-index: 2;
      border-radius: 999px;
      display: grid;
      place-items: center;
    }

    .app-refresh-overlay .refresh-logo-orbit {
      position: absolute;
      inset: 0;
      border-radius: 999px;
      border: 2px solid color-mix(in oklch, var(--line-soft) 74%, transparent);
      border-top-color: var(--blue);
      animation: refreshSpin 900ms linear infinite;
    }

    .app-refresh-overlay .refresh-logo {
      width: 40px;
      height: 40px;
      border-radius: 999px;
      object-fit: contain;
      background: #fff;
      border: 1px solid color-mix(in oklch, var(--line-soft) 58%, transparent);
    }

    .app-refresh-overlay .refresh-text {
      font-weight: 780;
      font-size: 15px;
      line-height: 1.2;
      color: var(--ink);
      z-index: 2;
      position: relative;
      margin: 0;
    }

    .app-refresh-overlay .refresh-subtext {
      color: var(--ink-soft);
      font-size: 12px;
      margin: 0;
      z-index: 2;
      font-weight: 500;
    }

    .app-refresh-overlay .refresh-loader + .refresh-text {
      margin-top: 4px;
    }

    .metric-grid {
      display: grid;
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: 12px;
    }

    .metric {
      min-width: 0;
      min-height: 146px;
      display: grid;
      grid-template-rows: auto auto 1fr auto;
      gap: 10px;
      padding: 15px;
      border-radius: var(--radius);
      background: oklch(0.985 0.004 235);
      border: 1px solid rgba(255, 255, 255, .94);
      box-shadow: var(--shadow-soft);
      overflow: hidden;
      position: relative;
      transition: transform .24s ease, box-shadow .24s ease;
    }

    .metric:hover,
    .panel:hover {
      transform: translateY(-2px);
      box-shadow: var(--shadow);
    }

    .metric::after {
      content: "";
      position: absolute;
      inset: auto 0 0;
      height: 4px;
      background: var(--blue);
    }

    .metric.green::after {
      background: var(--green);
    }

    .metric.orange::after {
      background: var(--orange);
    }

    .metric.red::after {
      background: var(--red);
    }

    .metric.violet::after {
      background: var(--violet);
    }

    .metric.pink::after {
      background: var(--pink);
    }

    .metric-top {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 10px;
    }

    .metric-icon {
      width: 34px;
      height: 34px;
      border-radius: var(--radius);
      display: grid;
      place-items: center;
      color: var(--blue);
      background: var(--blue-soft);
    }

    .metric.green .metric-icon {
      color: var(--green);
      background: var(--green-soft);
    }

    .metric.orange .metric-icon {
      color: var(--orange);
      background: var(--orange-soft);
    }

    .metric.red .metric-icon {
      color: var(--red);
      background: var(--red-soft);
    }

    .metric.violet .metric-icon {
      color: var(--violet);
      background: var(--violet-soft);
    }

    .metric.pink .metric-icon {
      color: var(--pink);
      background: var(--pink-soft);
    }

    .metric-label {
      color: var(--muted);
      font-size: 12px;
      font-weight: 800;
    }

    .metric-value {
      font-size: 29px;
      line-height: .95;
      letter-spacing: 0;
      font-weight: 850;
      white-space: nowrap;
    }

    .metric-caption {
      color: var(--muted);
      font-size: 12px;
      line-height: 1.35;
    }

    .spark {
      align-self: end;
      width: 100%;
      height: 34px;
      color: currentColor;
      opacity: .88;
    }

    .spark-area {
      fill: currentColor;
      opacity: .14;
    }

    .spark-line {
      fill: none;
      stroke: currentColor;
      stroke-width: 2.8;
      stroke-linecap: round;
      stroke-linejoin: round;
    }

    .panel {
      min-width: 0;
      border-radius: var(--radius);
      background: rgba(255, 255, 255, .92);
      border: 1px solid rgba(255, 255, 255, .96);
      box-shadow: var(--shadow-soft);
      transition: transform .24s ease, box-shadow .24s ease;
      overflow: hidden;
    }

    .panel-head {
      min-width: 0;
      min-height: 64px;
      padding: 14px 16px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 12px;
      border-bottom: 1px solid var(--line-soft);
    }

    .panel-title {
      min-width: 0;
    }

    .panel-title h3,
    .panel-title h2 {
      margin: 0;
      font-size: 16px;
      line-height: 1.2;
      font-weight: 850;
      letter-spacing: -.01em;
    }

    .panel-title p {
      margin: 4px 0 0;
      color: var(--muted);
      font-size: 12px;
      line-height: 1.35;
      text-wrap: pretty;
    }

    .panel-body,
    .card-pad {
      padding: 16px;
    }

    .dashboard-grid {
      display: grid;
      grid-template-columns: minmax(0, 1.45fr) minmax(300px, .65fr);
      gap: 12px;
    }

    .chart-card {
      min-height: 386px;
      display: grid;
      grid-template-rows: auto 1fr;
    }

    .performance-summary {
      display: flex;
      align-items: flex-start;
      justify-content: space-between;
      gap: 14px;
      margin-bottom: 10px;
    }

    .performance-left {
