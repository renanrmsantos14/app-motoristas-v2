    function dateFromOffset(days, hour) {
      const date = new Date();
      date.setDate(date.getDate() + days);
      date.setHours(hour, 0, 0, 0);
      return date.toISOString();
    }

    function createExpense(id, origin, driverId, dayOffset, hour, value, place, category, status, classification, attachment, km, duplicate, pendingType, note, meta = {}) {
      const driver = drivers.find((item) => item.id === driverId) || drivers[0];
      const date = dateFromOffset(dayOffset, hour);
      const deadline = new Date(new Date(date).getTime() + 48 * 60 * 60 * 1000).toISOString();
      const hash = hashFor(origin, date, value, driverId, place);
      const base = {
        id,
        origin,
        driverId,
        driver: driver.name,
        nick: driver.nick,
        vehicle: driver.vehicle,
        center: driver.center,
        tone: driver.tone,
        date,
        value,
        place,
        category,
        status,
        classification,
        attachment,
        km,
        duplicate,
        pendingType,
        note,
        deadline,
        hash,
        financialChannel: Expense.financialChannelFromOrigin(origin, meta)
      };
      return ensureDerivedExpenseFields({ ...base, ...meta });
    }

    function createManualExpense(id, origin, driverId, date, value, place, category, status, classification, attachment, km, duplicate, pendingType, note, meta = {}) {
      const driver = drivers.find((item) => item.id === driverId) || drivers[0];
      const deadline = new Date(new Date(date).getTime() + 48 * 60 * 60 * 1000).toISOString();
      const hash = hashFor(origin, date, value, driverId, place);
      const base = {
