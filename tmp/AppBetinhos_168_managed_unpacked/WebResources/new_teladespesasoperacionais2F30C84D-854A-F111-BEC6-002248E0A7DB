      function currentVehicleFromPossessions(employeeId, vehiclePossessions, referenceDate) {
        const referenceMs = dateTimeMs(referenceDate, Date.now());
        const rows = Array.isArray(vehiclePossessions) ? vehiclePossessions : [];
        const activeRows = rows
          .filter((row) => sameDataverseId(lookupId(row, "new_motorista"), employeeId))
          .filter((row) => {
            const startMs = dateTimeMs(row?.new_iniciodaposse, Number.NEGATIVE_INFINITY);
            const endMs = dateTimeMs(row?.new_fimdaposse, Number.POSITIVE_INFINITY);
            return startMs <= referenceMs && referenceMs <= endMs && possessionVehicleName(row);
          })
          .sort((left, right) => (
            dateTimeMs(right?.new_iniciodaposse, Number.NEGATIVE_INFINITY) -
            dateTimeMs(left?.new_iniciodaposse, Number.NEGATIVE_INFINITY)
          ));

        return possessionVehicleName(activeRows[0]);
