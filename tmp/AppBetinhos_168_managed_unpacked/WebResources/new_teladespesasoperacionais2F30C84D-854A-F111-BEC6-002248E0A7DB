      grid-template-columns: minmax(96px, .76fr) minmax(0, 1fr);
      align-items: center;
      gap: 12px;
      padding: 5px 0;
      border-bottom: 1px dashed rgba(143, 157, 180, .42);
      color: var(--muted);
      font-size: 12px;
