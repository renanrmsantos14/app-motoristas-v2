    function validateEvidenceFile(file) {
      if (!file) throw new Error("Selecione um arquivo.");
      if (!file.size) throw new Error("Arquivo vazio bloqueado.");
      const maxBytes = ONEDRIVE_FLOW_CONFIG.maxFileSizeMb * 1024 * 1024;
      if (file.size > maxBytes) throw new Error(`Arquivo acima de ${ONEDRIVE_FLOW_CONFIG.maxFileSizeMb} MB.`);
      const name = Expense.normalizeSearch(file.name || "");
      const extensionAllowed = /\.(jpg|jpeg|png|webp|pdf|heic|heif)$/i.test(file.name || "");
      const mimeAllowed = ONEDRIVE_FLOW_CONFIG.allowedMimeTypes.includes(file.type);
      if (!mimeAllowed && !extensionAllowed && !name.endsWith("heic") && !name.endsWith("heif")) {
        throw new Error("Formato bloqueado. Use JPG, PNG, WEBP, PDF ou HEIC.");
      }
    }

    function fileToBase64(file) {
      return new Promise((resolve, reject) => {
        const reader = new FileReader();
        reader.onload = () => resolve(String(reader.result || "").split(",")[1] || "");
        reader.onerror = () => reject(new Error("Falha ao ler arquivo."));
        reader.readAsDataURL(file);
      });
    }

    function evidencePreviewDataUrl(file, base64) {
      const mimeType = file?.type || "";
      if (!base64 || !/^image\//i.test(mimeType)) return "";
      return `data:${mimeType};base64,${base64}`;
    }

