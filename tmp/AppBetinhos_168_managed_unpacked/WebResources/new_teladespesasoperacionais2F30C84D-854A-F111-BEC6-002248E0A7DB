      box-shadow: inset 0 0 0 1px currentColor;
    }

    .spark {
      opacity: .72;
    }

    .panel-head {
      min-height: 60px;
      padding: 13px 15px;
      background-color: #ffffff;
    }

    .panel-body,
    .card-pad,
    .inspector-body,
    .modal-body {
