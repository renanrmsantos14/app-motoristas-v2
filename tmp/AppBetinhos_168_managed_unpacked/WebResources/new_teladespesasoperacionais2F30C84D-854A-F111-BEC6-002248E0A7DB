    function dataverseUndeclaredPropertyName(error) {
      const text = [
        error?.message,
        error?.error?.message,
        error?.details,
        error?.raw,
        error?.responseText
      ].filter(Boolean).join(" ");
      const match = text.match(/undeclared property '([^']+)'/i) || text.match(/property named '([^']+)'/i);
      return match?.[1] || "";
    }

    function stripUndeclaredDataverseBind(record, propertyName) {
      const key = `${propertyName}@odata.bind`;
      if (!propertyName) return "";
      if (Object.prototype.hasOwnProperty.call(record, key)) {
        delete record[key];
        return key;
      }
      if (Object.prototype.hasOwnProperty.call(record, propertyName)) {
        delete record[propertyName];
        return propertyName;
      }
      return "";
    }

    async function createDataverseRecord(api, entityName, record) {
      const payload = { ...record };
      for (let attempt = 0; attempt < 5; attempt += 1) {
        try {
          return await api.createRecord(entityName, payload);
        } catch (error) {
          const removedKey = stripUndeclaredDataverseBind(payload, dataverseUndeclaredPropertyName(error));
          if (!removedKey) throw error;
          console.warn(`[Dataverse] ${entityName}: removido lookup invalido ${removedKey} e reenviado.`);
        }
      }
      return api.createRecord(entityName, payload);
    }

    async function updateDataverseRecord(api, entityName, id, changes) {
      const payload = { ...changes };
      for (let attempt = 0; attempt < 5; attempt += 1) {
        try {
          return await api.updateRecord(entityName, id, payload);
        } catch (error) {
          const removedKey = stripUndeclaredDataverseBind(payload, dataverseUndeclaredPropertyName(error));
          if (!removedKey || !Object.keys(payload).length) throw error;
          console.warn(`[Dataverse] ${entityName}: removido lookup invalido ${removedKey} e reenviado.`);
        }
      }
      return api.updateRecord(entityName, id, payload);
    }

