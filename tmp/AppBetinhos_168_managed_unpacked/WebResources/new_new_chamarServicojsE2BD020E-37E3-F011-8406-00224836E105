var BT_MAINT_CFG = {
    envVarName: "new_FlowUrlManutencao",

    fields: {
        veiculo:     { name: "cr40f_placa_carro",  label: "Veículo" },
        agendarPara: { name: "cr40f_agendarpara",  label: "Agendar para" }
    },

    saveBeforeRun:          true,
    saveAndCloseAfterSuccess: true,
    timeoutMs:              60000
};

var __BT_MAINT_RUNNING__ = false;

function TriggerFlow(primaryControl) {
    var formContext = primaryControl;

    if (__BT_MAINT_RUNNING__) {
        console.warn("Já existe uma execução em andamento.");
        return;
    }
    __BT_MAINT_RUNNING__ = true;

    try {
        var recordId = formContext.data.entity.getId();
        if (!recordId) {
            __BT_MAINT_RUNNING__ = false;
            _popupError("Registro não identificado. Salve antes de continuar.");
            return;
        }
        var guid = recordId.replace(/[{}]/g, "");

        var missing = [];
        if (!_hasLookup(_getValue(formContext, BT_MAINT_CFG.fields.veiculo.name)))
            missing.push(BT_MAINT_CFG.fields.veiculo.label);
        if (!_isValidDate(_getValue(formContext, BT_MAINT_CFG.fields.agendarPara.name)))
            missing.push(BT_MAINT_CFG.fields.agendarPara.label);

        if (missing.length > 0) {
            __BT_MAINT_RUNNING__ = false;
            _popupError("Preencha os campos obrigatórios: " + missing.join(", "));
            try {
                var first = (missing[0] === BT_MAINT_CFG.fields.veiculo.label)
                    ? BT_MAINT_CFG.fields.veiculo.name
                    : BT_MAINT_CFG.fields.agendarPara.name;
                var ctrl = formContext.getControl(first);
                if (ctrl) ctrl.setFocus();
            } catch (e) {}
            return;
        }

        // Busca a URL do flow via variável de ambiente
        _getEnvVarValue(BT_MAINT_CFG.envVarName,
            function (flowUrl) {
                if (!flowUrl) {
                    __BT_MAINT_RUNNING__ = false;
                    _popupError("URL do flow não configurada. Contate o administrador.");
                    return;
                }

                var execute = function () { _callFlow(formContext, guid, flowUrl); };

                if (BT_MAINT_CFG.saveBeforeRun && formContext.data.getIsDirty()) {
                    Xrm.Utility.showProgressIndicator("Salvando...");
                    formContext.data.save().then(
                        function () {
                            Xrm.Utility.closeProgressIndicator();
                            execute();
                        },
                        function (err) {
                            Xrm.Utility.closeProgressIndicator();
                            __BT_MAINT_RUNNING__ = false;
                            console.error("Erro ao salvar:", err);
                            _popupError("Erro ao salvar o registro. Corrija os erros e tente novamente.");
                        }
                    );
                } else {
                    execute();
                }
            },
            function (err) {
                __BT_MAINT_RUNNING__ = false;
                console.error("Erro ao buscar variável de ambiente:", err);
                _popupError("Erro ao carregar configuração do flow.");
            }
        );

    } catch (e) {
        __BT_MAINT_RUNNING__ = false;
        console.error("Erro inesperado:", e);
        _popupError("Erro inesperado ao reservar manutenção.");
    }
}

// ---------- Busca variável de ambiente ----------
function _getEnvVarValue(schemaName, onSuccess, onError) {
    // Primeiro tenta pegar o valor sobrescrito (environmentvariablevalue)
    // Se não existir, usa o valor padrão (environmentvariabledefinition)
    Xrm.WebApi.retrieveMultipleRecords(
        "environmentvariablevalue",
        "?$select=value&$expand=EnvironmentVariableDefinitionId($select=schemaname)&$filter=EnvironmentVariableDefinitionId/schemaname eq '" + schemaName + "'"
    ).then(
        function (result) {
            if (result.entities && result.entities.length > 0) {
                onSuccess(result.entities[0].value);
            } else {
                // Sem valor sobrescrito — busca o valor padrão
                Xrm.WebApi.retrieveMultipleRecords(
                    "environmentvariabledefinition",
                    "?$select=defaultvalue&$filter=schemaname eq '" + schemaName + "'"
                ).then(
                    function (defResult) {
                        if (defResult.entities && defResult.entities.length > 0) {
                            onSuccess(defResult.entities[0].defaultvalue);
                        } else {
                            onSuccess(null);
                        }
                    },
                    onError
                );
            }
        },
        onError
    );
}

// ---------- Chama o Flow ----------
function _callFlow(formContext, guid, flowUrl) {
    Xrm.Utility.showProgressIndicator("Reservando ordem de manutenção...");

    var req = new XMLHttpRequest();
    req.open("POST", flowUrl, true);
    req.setRequestHeader("Content-Type", "application/json");
    req.timeout = BT_MAINT_CFG.timeoutMs;

    req.onerror = function () {
        Xrm.Utility.closeProgressIndicator();
        __BT_MAINT_RUNNING__ = false;
        _popupError("Erro de rede ao chamar a automação.");
    };

    req.ontimeout = function () {
        Xrm.Utility.closeProgressIndicator();
        __BT_MAINT_RUNNING__ = false;
        _popupError("Tempo excedido ao chamar a automação.");
    };

    req.onreadystatechange = function () {
        if (req.readyState !== 4) return;

        Xrm.Utility.closeProgressIndicator();
        __BT_MAINT_RUNNING__ = false;

        if (req.status !== 200 && req.status !== 202) {
            console.error("Flow falhou:", req.status, req.responseText);
            _popupError("Falha ao reservar manutenção. Status: " + req.status);
            return;
        }

        var response = null;
        try { response = JSON.parse(req.responseText); } catch (e) {}

        var msg = "Ordem de manutenção reservada com sucesso.";
        if (response && response.message) {
            msg = response.message.replace(/\s\d{2}:\d{2}\b/g, "");
        }

        _popupSuccess(msg).then(function () {
            formContext.data.refresh(false).then(function () {
                if (BT_MAINT_CFG.saveAndCloseAfterSuccess) {
                    if (formContext.data.getIsDirty()) {
                        Xrm.Utility.showProgressIndicator("Salvando...");
                        formContext.data.save().then(
                            function () { Xrm.Utility.closeProgressIndicator(); _closeForm(formContext); },
                            function () { Xrm.Utility.closeProgressIndicator(); _closeForm(formContext); }
                        );
                    } else {
                        _closeForm(formContext);
                    }
                }
            });
        });
    };

    req.send(JSON.stringify({ guids: guid }));
}

// ---------- Popups ----------
function _popupSuccess(message) {
    return Xrm.Navigation.openAlertDialog(
        { confirmButtonLabel: "OK", text: message },
        { height: 160, width: 420 }
    );
}

function _popupError(message) {
    return Xrm.Navigation.openAlertDialog(
        { confirmButtonLabel: "OK", text: message },
        { height: 190, width: 460 }
    );
}

// ---------- Fechar form ----------
function _closeForm(formContext) {
    try {
        if (formContext.ui && typeof formContext.ui.close === "function") {
            formContext.ui.close();
            return;
        }
    } catch (e) {}
    Xrm.Navigation.navigateTo({
        pageType: "entitylist",
        entityName: formContext.data.entity.getEntityName()
    });
}

// ---------- Helpers ----------
function _getValue(formContext, name) {
    var a = formContext.getAttribute(name);
    return a ? a.getValue() : null;
}

function _hasLookup(v) {
    return Array.isArray(v) && v.length > 0 && v[0] && v[0].id;
}

function _isValidDate(v) {
    if (!v) return false;
    if (typeof v === "object" && typeof v.getTime === "function") return !isNaN(v.getTime());
    try { return !isNaN(new Date(v).getTime()); } catch (e) { return false; }
}