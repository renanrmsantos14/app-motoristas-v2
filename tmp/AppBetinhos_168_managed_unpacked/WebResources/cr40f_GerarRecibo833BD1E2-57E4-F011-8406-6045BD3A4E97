// Command Button JS — GerarRecibo
// flowUrl lida de Variável de Ambiente Dataverse: new_FlowUrlGerarRecibo
// Payload enviado ao Flow: { ID_PAG, GUID, PASSAGEIRO_GUID, SEND_EMAIL }

var TAG_GR = "[BT-GERAR-RECIBO]";

// ─── ENV VAR ──────────────────────────────────────────────────────────────────

function getEnvVarValue_GR(schemaName) {
    var baseUrl = Xrm.Utility.getGlobalContext().getClientUrl();
    var url =
        baseUrl +
        "/api/data/v9.2/environmentvariabledefinitions" +
        "?$filter=schemaname eq '" + schemaName + "'" +
        "&$select=defaultvalue,schemaname" +
        "&$expand=environmentvariabledefinition_environmentvariablevalue($select=value)";

    return fetch(url, {
        headers: {
            "OData-MaxVersion": "4.0",
            "OData-Version": "4.0",
            "Accept": "application/json",
            "Content-Type": "application/json; charset=utf-8"
        }
    })
        .then(function (r) { return r.json(); })
        .then(function (data) {
            if (!data || !data.value || !data.value.length) return null;
            var def = data.value[0];
            var cur = def["environmentvariabledefinition_environmentvariablevalue"];
            if (cur && cur.length && cur[0].value) return cur[0].value;
            if (def.defaultvalue) return def.defaultvalue;
            return null;
        })
        .catch(function (e) {
            console.error(TAG_GR, "Erro ao buscar env var:", e);
            return null;
        });
}

// ─── ENTRY POINT ──────────────────────────────────────────────────────────────

function GerarRecibo(primaryControl) {
    var grid = primaryControl.getGrid();
    if (!grid) return;

    var selectedRows = grid.getSelectedRows();
    if (selectedRows.getLength() === 0) return;

    // Coletar IDs e entityName
    var registros = [];
    selectedRows.forEach(function (row) {
        try {
            var entity = row.getData().getEntity();
            var id = entity.getId().replace(/[{}]/g, "");
            var entityName = entity.getEntityName();
            if (id) registros.push({ id: id, entityName: entityName });
        } catch (e) {
            console.warn(TAG_GR, "Erro ao extrair row:", e);
        }
    });

    if (registros.length === 0) return;

    Xrm.Utility.showProgressIndicator("Carregando pagantes...");

    // Fetch paralelo: flowUrl + dados de cada registro
    Promise.all([
        getEnvVarValue_GR("new_FlowUrlGerarRecibo"),
        Promise.all(registros.map(function (reg) {
            return Xrm.WebApi.retrieveRecord(
                reg.entityName,
                reg.id,
                "?$select=cr40f_id,cr40f_valor,cr40f_formadepagamento,_cr40f_bancodedados_value"
            )
                .then(function (record) {
                    // Nome do passageiro via anotação OData do lookup
                    var nomePassageiro =
                        record["_cr40f_bancodedados_value@OData.Community.Display.V1.FormattedValue"] || "";

                    // GUID do passageiro
                    var passageiroGuid = "";
                    for (var prop in record) {
                        if (
                            prop.toLowerCase().indexOf("bancodedados") !== -1 &&
                            prop.endsWith("_value") &&
                            prop.indexOf("@") === -1
                        ) {
                            passageiroGuid = record[prop]
                                ? String(record[prop]).replace(/[{}]/g, "")
                                : "";
                            break;
                        }
                    }

                    // Forma de pagamento — campo choice retorna o rótulo na anotação
                    var formaPagamento =
                        record["cr40f_formadepagamento@OData.Community.Display.V1.FormattedValue"] ||
                        record["cr40f_formadepagamento"] || "";

                    // EntityName da tabela do passageiro (via annotation do lookup)
                    var paxEntityName =
                        record["_cr40f_bancodedados_value@Microsoft.Dynamics.CRM.lookuplogicalname"] || "";

                    var pagamento = {
                        ok: true,
                        id: reg.id,
                        entityName: reg.entityName,
                        seqId: record.cr40f_id || "",
                        valor: record.cr40f_valor != null ? record.cr40f_valor : null,
                        formaPagamento: formaPagamento,
                        passageiroGuid: passageiroGuid,
                        nomePassageiro: nomePassageiro || ("Pagante " + (record.cr40f_id || reg.id.slice(0, 8))),
                        emailPassageiro: ""
                    };

                    if (!passageiroGuid || !paxEntityName) return pagamento;

                    return Xrm.WebApi.retrieveRecord(paxEntityName, passageiroGuid, "?$select=cr40f_email")
                        .then(function (pax) {
                            pagamento.emailPassageiro = (pax && pax.cr40f_email) || "";
                            return pagamento;
                        })
                        .catch(function () { return pagamento; });
                })
                .catch(function (e) {
                    console.error(TAG_GR, "Erro ao buscar registro:", reg.id, e);
                    return {
                        ok: false,
                        id: reg.id,
                        entityName: reg.entityName,
                        seqId: "",
                        valor: null,
                        formaPagamento: "",
                        passageiroGuid: "",
                        nomePassageiro: "Pagante " + reg.id.slice(0, 8),
                        emailPassageiro: ""
                    };
                });
        }))
    ]).then(function (results) {
        try { Xrm.Utility.closeProgressIndicator(); } catch (e) {}

        var flowUrl = results[0];
        var pagantes = results[1];

        if (!flowUrl) {
            Xrm.Navigation.openAlertDialog({
                text:
                    "Variável de ambiente 'new_FlowUrlGerarRecibo' não encontrada ou sem valor.\n" +
                    "Configure-a em Power Apps > Soluções > Variáveis de Ambiente."
            });
            return;
        }

        console.log(TAG_GR, "flowUrl:", flowUrl, "| pagantes:", pagantes);
        mostrarModalGaleria(flowUrl, pagantes);
    });

    // ─── MODAL GALERIA ───────────────────────────────────────────────────zy─────

    function mostrarModalGaleria(flowUrl, pagantes) {
        var targetDoc;
        try {
            targetDoc = window.top.document;
        } catch (e) {
            targetDoc = document;
        }

        // Estado dos toggles: true = enviar email
        var emailState = {};
        pagantes.forEach(function (p) { emailState[p.id] = true; });

        function criarEl(tag, css) {
            var el = targetDoc.createElement(tag);
            if (css) el.style.cssText = css;
            return el;
        }

        // ── Overlay ──────────────────────────────────────────────────────────
        var overlay = criarEl("div", [
            "position:fixed;top:0;left:0;width:100%;height:100%;",
            "background:rgba(0,0,0,0.50);",
            "display:flex;justify-content:center;align-items:center;",
            "z-index:2147483647;",
            "opacity:0;transition:opacity 0.22s ease;"
        ].join(""));

        // ── Modal ─────────────────────────────────────────────────────────────
        var modal = criarEl("div", [
            "background:#f5f5f5;",
            "border-radius:16px;",
            "width:100%;max-width:520px;",
            "max-height:82vh;",
            "display:flex;flex-direction:column;",
            "box-shadow:0 12px 48px rgba(0,0,0,0.28);",
            "transform:scale(0.95);opacity:0;",
            "transition:transform 0.25s cubic-bezier(0.32,0.72,0,1),opacity 0.25s ease;",
            "overflow:hidden;",
            "margin:16px;" // evita tocar nas bordas em telas menores
        ].join(""));

        // ── Header ────────────────────────────────────────────────────────────
        var header = criarEl("div", [
            "padding:20px 24px 16px;",
            "border-bottom:1px solid #e2e2e2;",
            "flex-shrink:0;"
        ].join(""));

        var titulo = criarEl("p", [
            "margin:0;font-size:18px;font-weight:700;color:#1a1a1a;",
            "font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',system-ui,sans-serif;"
        ].join(""));
        titulo.textContent = pagantes.length === 1
            ? "Gerar recibo — 1 pagante"
            : "Gerar recibos — " + pagantes.length + " pagantes";

        var subtitulo = criarEl("p", [
            "margin:4px 0 0;font-size:13px;color:#666;",
            "font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',system-ui,sans-serif;"
        ].join(""));
        subtitulo.textContent = "Ative o toggle para enviar o recibo por e-mail";

        header.appendChild(titulo);
        header.appendChild(subtitulo);

        // ── Lista (scrollable) ────────────────────────────────────────────────
        var lista = criarEl("div", "overflow-y:auto;flex:1;padding:12px 16px 4px;");

        pagantes.forEach(function (p) {
            // Card
            var card = criarEl("div", [
                "background:#fff;border-radius:12px;padding:16px;",
                "margin-bottom:10px;",
                "box-shadow:0 1px 4px rgba(0,0,0,0.08);",
                "border-left:4px solid #0078d4;",
                "display:flex;justify-content:space-between;align-items:center;",
                "gap:12px;"
            ].join(""));

            // Info (esquerda)
            var info = criarEl("div", "flex:1;min-width:0;");

            var rowId = criarEl("div", [
                "font-size:11px;font-weight:700;color:#0078d4;letter-spacing:0.4px;",
                "margin-bottom:3px;",
                "font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',system-ui,sans-serif;"
            ].join(""));
            rowId.textContent = p.seqId ? ("ID " + p.seqId) : "—";

            var nomeEl = criarEl("div", [
                "font-size:14px;font-weight:600;color:#111;",
                "white-space:nowrap;overflow:hidden;text-overflow:ellipsis;",
                "font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',system-ui,sans-serif;"
            ].join(""));
            nomeEl.textContent = p.nomePassageiro;

            var emailEl = criarEl("div", [
                "font-size:12px;color:#0078d4;margin-top:2px;",
                "white-space:nowrap;overflow:hidden;text-overflow:ellipsis;",
                "font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',system-ui,sans-serif;",
                "font-weight:500;"
            ].join(""));
            emailEl.textContent = p.emailPassageiro || "—";

            var detalheEl = criarEl("div", [
                "font-size:12px;color:#777;margin-top:3px;",
                "font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',system-ui,sans-serif;"
            ].join(""));
            var valorStr = p.valor != null
                ? "R$ " + Number(p.valor).toLocaleString("pt-BR", { minimumFractionDigits: 2, maximumFractionDigits: 2 })
                : "—";
            detalheEl.textContent = valorStr + (p.formaPagamento ? " · " + p.formaPagamento : "");

            info.appendChild(rowId);
            info.appendChild(nomeEl);
            info.appendChild(emailEl);
            info.appendChild(detalheEl);

            // Toggle (direita) — implementado com divs, sem CSS classes
            var toggleOuter = criarEl("div", [
                "display:flex;flex-direction:column;align-items:center;gap:4px;",
                "flex-shrink:0;"
            ].join(""));

            var track = criarEl("div", [
                "width:44px;height:26px;border-radius:13px;",
                "background:#0078d4;", // começa ativo (true)
                "position:relative;cursor:pointer;",
                "transition:background 0.2s ease;",
                "flex-shrink:0;"
            ].join(""));

            var thumb = criarEl("div", [
                "position:absolute;top:3px;",
                "width:20px;height:20px;border-radius:50%;",
                "background:#fff;",
                "box-shadow:0 1px 4px rgba(0,0,0,0.25);",
                "transition:transform 0.2s cubic-bezier(0.4,0,0.2,1);",
                "transform:translateX(21px);", // começa à direita (ligado)
                "pointer-events:none;"
            ].join(""));

            var toggleLabel = criarEl("div", [
                "font-size:10px;font-weight:600;color:#0078d4;",
                "font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',system-ui,sans-serif;",
                "letter-spacing:0.3px;"
            ].join(""));
            toggleLabel.textContent = "E-MAIL";

            track.appendChild(thumb);

            // Closure para manter referência correta
            (function (paganteId, trackEl, thumbEl, labelEl) {
                trackEl.addEventListener("click", function () {
                    emailState[paganteId] = !emailState[paganteId];
                    var ativo = emailState[paganteId];
                    trackEl.style.background = ativo ? "#0078d4" : "#ccc";
                    thumbEl.style.transform = ativo ? "translateX(21px)" : "translateX(3px)";
                    labelEl.style.color = ativo ? "#0078d4" : "#aaa";
                    console.log(TAG_GR, "Toggle email →", paganteId, ativo);
                });
            })(p.id, track, thumb, toggleLabel);

            toggleOuter.appendChild(track);
            toggleOuter.appendChild(toggleLabel);

            card.appendChild(info);
            card.appendChild(toggleOuter);
            lista.appendChild(card);
        });

        // ── Rodapé ────────────────────────────────────────────────────────────
        var rodape = criarEl("div", [
            "padding:14px 16px 16px;",
            "border-top:1px solid #e2e2e2;",
            "display:flex;flex-direction:column;gap:10px;",
            "flex-shrink:0;"
        ].join(""));

        var btnGerar = criarEl("button", [
            "display:flex;align-items:center;justify-content:center;gap:8px;",
            "width:100%;padding:15px;",
            "background:#0078d4;color:#fff;",
            "border:none;border-radius:13px;",
            "font-size:15px;font-weight:700;cursor:pointer;",
            "font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',system-ui,sans-serif;",
            "transition:opacity 0.15s,transform 0.1s;",
            "outline:none;"
        ].join(""));
        btnGerar.textContent = "📄  Gerar " + pagantes.length + " recibo" + (pagantes.length > 1 ? "s" : "");

        var btnCancelar = criarEl("button", [
            "width:100%;padding:13px;",
            "background:#e8e8e8;color:#444;",
            "border:none;border-radius:13px;",
            "font-size:14px;font-weight:600;cursor:pointer;",
            "font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',system-ui,sans-serif;",
            "outline:none;"
        ].join(""));
        btnCancelar.textContent = "Cancelar";

        // ── Fechar modal ──────────────────────────────────────────────────────
        function fecharModal() {
            overlay.style.opacity = "0";
            modal.style.transform = "scale(0.95)";
            modal.style.opacity = "0";
            setTimeout(function () {
                if (overlay.parentNode) overlay.parentNode.removeChild(overlay);
            }, 260);
        }

        // ── Gerar recibos ─────────────────────────────────────────────────────
        btnGerar.onclick = function (ev) {
            ev.preventDefault();
            btnGerar.disabled = true;
            btnGerar.style.opacity = "0.7";
            btnGerar.textContent = "Gerando...";

            fecharModal();

            var totalEmail = Object.keys(emailState).filter(function (k) { return emailState[k]; }).length;
            console.log(TAG_GR, "Iniciando geração. Total:", pagantes.length, "| Com email:", totalEmail);

            Xrm.Utility.showProgressIndicator("Gerando " + pagantes.length + " recibo(s)...");
            var ativos = 0;

            function finalizarProcesso() {
                ativos--;
                if (ativos <= 0) {
                    try { Xrm.Utility.closeProgressIndicator(); } catch (e) {}
                }
            }

            pagantes.forEach(function (p) {
                ativos++;

                var payload = {
                    ID_PAG: p.seqId ? String(p.seqId) : "",
                    GUID: String(p.id),
                    PASSAGEIRO_GUID: p.passageiroGuid || "",
                    SEND_EMAIL: emailState[p.id] === true
                };

                console.log(TAG_GR, "Payload →", p.id, payload);

                var req = new XMLHttpRequest();
                req.open("POST", flowUrl, true);
                req.setRequestHeader("Content-Type", "application/json");
                req.responseType = "blob";

                req.onreadystatechange = function () {
                    if (req.readyState !== 4) return;

                    if (req.status === 200 || req.status === 202) {
                        var blob = new Blob([req.response], { type: "application/pdf" });
                        var fileURL = URL.createObjectURL(blob);
                        window.open(fileURL, "_blank");
                    } else {
                        console.error(TAG_GR, "Falha no Flow guid:", p.id, "status:", req.status);
                    }

                    finalizarProcesso();
                };

                req.onerror = function () {
                    console.error(TAG_GR, "Erro de rede guid:", p.id);
                    finalizarProcesso();
                };

                req.send(JSON.stringify(payload));
            });
        };

        btnCancelar.onclick = function (ev) { ev.preventDefault(); fecharModal(); };
        overlay.onclick = function (ev) { if (ev.target === overlay) fecharModal(); };

        // ── Montar DOM ────────────────────────────────────────────────────────
        rodape.appendChild(btnGerar);
        rodape.appendChild(btnCancelar);

        modal.appendChild(header);
        modal.appendChild(lista);
        modal.appendChild(rodape);
        overlay.appendChild(modal);

        targetDoc.body.appendChild(overlay);

        // Animação de entrada
        requestAnimationFrame(function () {
            overlay.style.opacity = "1";
            modal.style.transform = "scale(1)";
            modal.style.opacity = "1";
        });
    }
}