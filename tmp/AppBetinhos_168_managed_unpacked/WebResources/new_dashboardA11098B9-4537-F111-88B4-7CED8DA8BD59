<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <title>Betinhos · Dashboard do Gestor</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link
      href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap"
      rel="stylesheet"
    />
    <script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/4.4.1/chart.umd.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/chartjs-plugin-datalabels@2.2.0/dist/chartjs-plugin-datalabels.min.js"></script>
    <style>
      /* ===== RESET & VARIÁVEIS ===== */
      *,
      *::before,
      *::after {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
      }
      :root {
        --bg: #f0f2f5;
        --surf: #ffffff;
        --surf2: #f8f9fb;
        --b1: #e8eaed;
        --b2: #d0d3d9;
        --t1: #0f1117;
        --t2: #4a5068;
        --t3: #8a91a8;
        --blue: #1a6cf5;
        --blue-l: #eef3ff;
        --blue-d: #1254cc;
        --blue-g: linear-gradient(135deg, #1a6cf5, #4f94ff);
        --teal: #0a9396;
        --teal-l: #e0f7f7;
        --purple: #6c4fd8;
        --purple-l: #f0ecff;
        --orange: #e07000;
        --orange-l: #fff4e6;
        --green: #1a7a40;
        --green-l: #e6f7ed;
        --red: #c0392b;
        --red-l: #fdecea;
        --yellow: #8a6200;
        --yellow-l: #fff8e1;
        --gold: #c9a227;
        --r6: 6px;
        --r8: 8px;
        --r12: 12px;
        --r16: 16px;
        --s1: 0 1px 4px rgba(0, 0, 0, 0.06);
        --s2: 0 4px 16px rgba(0, 0, 0, 0.08);
        --s3: 0 12px 40px rgba(0, 0, 0, 0.12);
        --font: "Plus Jakarta Sans", system-ui, sans-serif;
        --topbar-h: 52px;
      }
      body {
        background: var(--bg);
        color: var(--t1);
        font-family: var(--font);
        font-size: 13px;
        line-height: 1.5;
        min-height: 100vh;
        -webkit-font-smoothing: antialiased;
      }
      .topbar {
        height: var(--topbar-h);
        background: var(--surf);
        border-bottom: 1px solid var(--b1);
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 0 20px;
        position: sticky;
        top: 0;
        z-index: 300;
        box-shadow:
          0 1px 0 var(--b1),
          var(--s1);
      }
      .tb-brand {
        display: flex;
        align-items: center;
        gap: 10px;
      }
      .tb-logo {
        width: 36px;
        height: 36px;
        border-radius: 50%;
        background: transparent;
        display: grid;
        place-items: center;
        box-shadow: 0 2px 8px rgba(26, 108, 245, 0.35);
        overflow: hidden;
        border: 2px solid white;
      }
      .tb-logo img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        display: block;
      }
      .tb-name {
        font-size: 15px;
        font-weight: 800;
        color: var(--t1);
        letter-spacing: -0.3px;
      }
      .tb-sub {
        font-size: 11px;
        color: var(--t3);
        font-weight: 500;
      }
      .tb-right {
        display: flex;
        align-items: center;
        gap: 8px;
      }
      .env-pill {
        font-size: 10px;
        font-weight: 700;
        padding: 3px 10px;
        border-radius: 20px;
        letter-spacing: 0.06em;
        text-transform: uppercase;
      }
      .env-prod {
        background: #e6f7ed;
        color: #1a7a40;
        border: 1px solid #a3d9b8;
      }
      .env-dev {
        background: #fff8e1;
        color: #8a6200;
        border: 1px solid #f0d080;
      }
      .env-local {
        background: var(--blue-l);
        color: var(--blue);
        border: 1px solid #b3ccff;
      }
      .ts {
        font-size: 11px;
        color: var(--t3);
        font-weight: 500;
      }
      .btn-ic {
        width: 34px;
        height: 34px;
        display: grid;
        place-items: center;
        background: transparent;
        border: 1px solid var(--b1);
        border-radius: var(--r8);
        color: var(--t2);
        cursor: pointer;
        font-size: 16px;
        transition: all 0.15s;
      }
      .btn-ic:hover {
        background: var(--bg);
        border-color: var(--b2);
        color: var(--t1);
      }
      .btn-ic:disabled {
        opacity: 0.4;
        cursor: not-allowed;
      }
      .btn-ic.spin svg,
      .btn-ic.spin {
        animation: spinI 0.8s linear infinite;
      }
      @keyframes spinI {
        to {
          transform: rotate(360deg);
        }
      }
      .shell {
        display: flex;
        height: calc(100vh - var(--topbar-h));
      }
      .sidebar {
        width: 220px;
        flex-shrink: 0;
        background: var(--surf);
        border-right: 1px solid var(--b1);
        display: flex;
        flex-direction: column;
        overflow-y: auto;
        padding: 8px 0 16px;
      }
      .sb-section {
        padding: 14px 16px 5px;
        font-size: 10px;
        font-weight: 700;
        color: var(--t3);
        text-transform: uppercase;
        letter-spacing: 0.08em;
      }
      .sb-item {
        display: flex;
        align-items: center;
        gap: 9px;
        padding: 8px 12px;
        margin: 1px 8px;
        border-radius: var(--r8);
        font-size: 13px;
        font-weight: 500;
        color: var(--t2);
        cursor: pointer;
        transition: all 0.12s;
        user-select: none;
      }
      .sb-item:hover {
        background: var(--bg);
        color: var(--t1);
      }
      .sb-item.act {
        background: var(--blue-l);
        color: var(--blue);
        font-weight: 700;
      }
      .sb-item.act .sb-icon {
        filter: none;
      }
      .sb-icon {
        font-size: 14px;
        width: 20px;
        text-align: center;
        flex-shrink: 0;
        opacity: 0.75;
      }
      .sb-item.act .sb-icon {
        opacity: 1;
      }
      .sb-badge {
        margin-left: auto;
        font-size: 10px;
        font-weight: 700;
        background: var(--b1);
        color: var(--t2);
        padding: 1px 7px;
        border-radius: 20px;
        min-width: 22px;
        text-align: center;
        transition: all 0.2s;
      }
      .sb-item.act .sb-badge {
        background: rgba(26, 108, 245, 0.15);
        color: var(--blue);
      }
      .sb-badge.warn {
        background: #fff4e6;
        color: var(--orange);
      }
      .sb-badge.danger {
        background: var(--red-l);
        color: var(--red);
      }
      .sb-div {
        height: 1px;
        background: var(--b1);
        margin: 6px 12px;
      }
      .content {
        flex: 1;
        overflow-y: auto;
        padding: 20px;
        background: var(--bg);
      }
      .fbar {
        background: var(--surf);
        border: 1px solid var(--b1);
        border-radius: var(--r12);
        padding: 14px 16px;
        display: flex;
        flex-direction: column;
        gap: 10px;
        margin-bottom: 18px;
        box-shadow: var(--s1);
      }
      .quick-filters {
        display: flex;
        gap: 6px;
        flex-wrap: wrap;
      }
      .btn-qf {
        font-size: 12px;
        height: 30px;
        padding: 0 13px;
        white-space: nowrap;
        border: 1.5px solid var(--b1);
        border-radius: var(--r8);
        background: var(--surf);
        color: var(--t2);
        cursor: pointer;
        font-family: var(--font);
        font-weight: 600;
        transition: all 0.15s;
      }
      .btn-qf:hover {
        background: var(--bg);
        border-color: var(--b2);
        color: var(--t1);
      }
      .btn-qf.active {
        background: var(--blue);
        color: #fff;
        border-color: var(--blue);
        box-shadow: 0 2px 8px rgba(26, 108, 245, 0.28);
      }
      .filter-row {
        display: flex;
        flex-wrap: wrap;
        gap: 10px;
        align-items: flex-end;
        padding: 8px 0;
      }
      .fg {
        display: flex;
        flex-direction: column;
        gap: 4px;
        flex-shrink: 0;
      }
      .fg label {
        font-size: 10px;
        font-weight: 700;
        color: var(--t3);
        text-transform: uppercase;
        letter-spacing: 0.06em;
      }
      .fg input {
        height: 36px;
        border: 1.5px solid var(--b1);
        border-radius: var(--r8);
        padding: 0 12px;
        font-family: var(--font);
        font-size: 12px;
        font-weight: 500;
        color: var(--t1);
        background: var(--surf);
        outline: none;
        transition:
          border-color 0.15s,
          box-shadow 0.15s;
      }
      .fg input:focus {
        border-color: var(--blue);
        box-shadow: 0 0 0 3px rgba(26, 108, 245, 0.12);
      }
      .ms-wrap {
        position: relative;
        min-width: 180px;
        flex-shrink: 0;
      }
      .ms-btn {
        height: 36px;
        border: 1.5px solid var(--b1);
        border-radius: var(--r8);
        padding: 0 30px 0 12px;
        font-family: var(--font);
        font-size: 12px;
        font-weight: 500;
        color: var(--t1);
        background: var(--surf);
        cursor: pointer;
        display: flex;
        align-items: center;
        transition: all 0.15s;
        white-space: nowrap;
        overflow: hidden;
      }
      .ms-btn:hover {
        border-color: var(--blue);
        background: var(--bg);
      }
      .ms-btn.open {
        border-color: var(--blue);
        box-shadow: 0 0 0 3px rgba(26, 108, 245, 0.12);
      }
      .ms-btn::after {
        content: "▾";
        position: absolute;
        right: 10px;
        font-size: 10px;
        color: var(--t3);
      }
      .sel-count {
        background: var(--blue);
        color: #fff;
        font-size: 10px;
        font-weight: 700;
        padding: 1px 6px;
        border-radius: 10px;
        margin-left: 6px;
        flex-shrink: 0;
      }
      .ms-dd {
        display: none;
        position: absolute;
        top: calc(100% + 4px);
        left: 0;
        background: var(--surf);
        border: 1.5px solid var(--b1);
        border-radius: var(--r12);
        box-shadow: var(--s3);
        z-index: 200;
        max-height: 280px;
        overflow-y: auto;
        min-width: 100%;
        padding: 6px;
      }
      .ms-dd.open {
        display: block;
        animation: ddIn 0.12s ease;
      }
      @keyframes ddIn {
        from {
          opacity: 0;
          transform: translateY(-4px);
        }
        to {
          opacity: 1;
          transform: none;
        }
      }
      .ms-search {
        width: 100%;
        padding: 6px 8px;
        margin-bottom: 6px;
        border: 1.5px solid var(--b1);
        border-radius: var(--r6);
        font-family: var(--font);
        font-size: 12px;
        outline: none;
        transition: border-color 0.15s;
      }
      .ms-search:focus {
        border-color: var(--blue);
      }
      .ms-dd label {
        display: flex;
        align-items: center;
        gap: 8px;
        padding: 6px 8px;
        border-radius: var(--r6);
        cursor: pointer;
        font-size: 12px;
        font-weight: 500;
        transition: background 0.1s;
      }
      .ms-dd label:hover {
        background: var(--bg);
      }
      .ms-dd input[type="checkbox"] {
        accent-color: var(--blue);
        width: 13px;
        height: 13px;
        cursor: pointer;
        margin: 0;
      }
      .ms-actions {
        display: flex;
        gap: 6px;
        padding: 6px 8px;
        border-top: 1px solid var(--b1);
        margin-top: 4px;
      }
      .ms-actions button {
        flex: 1;
        font-size: 11px;
        font-weight: 600;
        padding: 4px;
        border: 1.5px solid var(--b1);
        border-radius: var(--r6);
        background: var(--surf);
        cursor: pointer;
        color: var(--t2);
        font-family: var(--font);
        transition: all 0.1s;
      }
      .ms-actions button:hover {
        background: var(--bg);
        border-color: var(--blue);
        color: var(--blue);
      }
      .fa {
        display: flex;
        gap: 6px;
        align-items: flex-end;
        margin-left: auto;
      }
      .btn {
        height: 32px;
        border: none;
        border-radius: var(--r8);
        padding: 0 16px;
        font-family: var(--font);
        font-size: 12px;
        font-weight: 700;
        cursor: pointer;
        transition: all 0.15s;
        white-space: nowrap;
        letter-spacing: 0.01em;
      }
      .btn-p {
        background: var(--blue);
        color: #fff;
        box-shadow: 0 2px 8px rgba(26, 108, 245, 0.28);
      }
      .btn-p:hover {
        background: var(--blue-d);
        box-shadow: 0 3px 12px rgba(26, 108, 245, 0.38);
      }
      .btn-s {
        background: var(--surf);
        color: var(--t2);
        border: 1.5px solid var(--b1);
      }
      .btn-s:hover {
        background: var(--bg);
        border-color: var(--b2);
      }
      .alert {
        display: flex;
        align-items: flex-start;
        gap: 10px;
        padding: 12px 16px;
        border-radius: var(--r12);
        font-size: 13px;
        margin-bottom: 16px;
        font-weight: 500;
      }
      .al-err {
        background: var(--red-l);
        border: 1px solid #f0b0aa;
        color: var(--red);
      }
      .al-warn {
        background: var(--yellow-l);
        border: 1px solid #f0d080;
        color: var(--yellow);
      }
      .al-info {
        background: var(--blue-l);
        border: 1px solid #b3ccff;
        color: var(--blue);
      }
      .al-suc {
        background: var(--green-l);
        border: 1px solid #a8d5c0;
        color: var(--green);
      }
      .kpi-row {
        display: grid;
        gap: 12px;
        margin-bottom: 10px;
      }
      .kpi-5 {
        grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
      }
      .kpi-6 {
        grid-template-columns: repeat(auto-fit, minmax(196px, 1fr));
      }
      .kpi-4 {
        grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
      }
      .kpi-3 {
        grid-template-columns: repeat(3, 1fr);
      }
      .kpi {
        background: var(--surf);
        border: 1px solid var(--b1);
        border-radius: var(--r12);
        padding: 16px;
        box-shadow: var(--s1);
        position: relative;
        overflow: hidden;
        transition:
          box-shadow 0.25s,
          transform 0.2s;
        cursor: default;
        display: flex;
        flex-direction: column;
        min-height: 140px;
      }
      .kpi.executive {
        min-height: 182px;
        padding: 16px 16px 12px;
        container-type: inline-size;
      }
      .kpi.executive .kpi-main {
        min-height: 82px;
        display: flex;
        flex-direction: column;
        gap: 8px;
      }
      .kpi-tone-blue { --kpi-color: #1a6cf5; --kpi-soft: rgba(26,108,245,.12); }
      .kpi-tone-teal { --kpi-color: #0a9396; --kpi-soft: rgba(10,147,150,.12); }
      .kpi-tone-purple { --kpi-color: #6c4fd8; --kpi-soft: rgba(108,79,216,.12); }
      .kpi-tone-green { --kpi-color: #1a7a40; --kpi-soft: rgba(26,122,64,.12); }
      .kpi-tone-orange { --kpi-color: #e07000; --kpi-soft: rgba(224,112,0,.12); }
      .kpi-tone-red { --kpi-color: #c0392b; --kpi-soft: rgba(192,57,43,.12); }
      .kpi:hover {
        box-shadow: var(--s2);
        transform: translateY(-2px);
      }
      .kpi-accent {
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        height: 3px;
        border-radius: var(--r12) var(--r12) 0 0;
      }
      .kpi-main {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        gap: 12px;
      }
      .kpi-left {
        flex: 1;
        min-width: 0;
      }
      .kpi-lbl {
        font-size: 10px;
        font-weight: 700;
        color: var(--t3);
        text-transform: uppercase;
        letter-spacing: 0.07em;
        margin-bottom: 6px;
        line-height: 1.25;
        text-wrap: balance;
      }
      .kpi-val {
        font-size: 22px;
        font-weight: 800;
        letter-spacing: -0.6px;
        line-height: 1.1;
        color: var(--t1);
        font-variant-numeric: tabular-nums;
      }
      .kpi-val.sm {
        font-size: 17px;
        font-weight: 700;
      }
      .kpi.executive .kpi-val {
        font-size: clamp(18px, 10cqi, 24px);
      }
      .kpi.executive .kpi-val.sm {
        font-size: clamp(18px, 9cqi, 22px);
        font-weight: 800;
      }
      .kpi-right {
        display: flex;
        flex-direction: column;
        align-items: flex-start;
        gap: 6px;
        min-width: 0;
        max-width: 100%;
      }
      .kpi-delta {
        display: flex;
        flex-direction: column;
        gap: 4px;
        align-items: flex-start;
      }
      .kpi-spark {
        margin-top: auto;
        height: 42px;
        border-radius: var(--r8);
        background: linear-gradient(180deg, var(--kpi-soft), rgba(255,255,255,0));
        padding-top: 4px;
        position: relative;
      }
      .kpi-spark canvas {
        width: 100% !important;
        height: 38px !important;
        display: block;
      }
      .kpi-spark .chart-empty {
        inset: 4px 0 0;
        min-height: auto;
        border: 0;
        background: transparent;
        font-size: 9px;
      }
      .exec-alerts {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 10px;
        margin: 0 0 10px;
      }
      .exec-alert {
        background: var(--surf);
        border: 1px solid var(--b1);
        border-radius: var(--r12);
        padding: 12px 14px;
        box-shadow: var(--s1);
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 10px;
        min-height: 64px;
      }
      .exec-alert strong {
        display: block;
        font-size: 18px;
        line-height: 1;
        color: var(--t1);
      }
      .exec-alert span {
        display: block;
        margin-top: 3px;
        color: var(--t3);
        font-size: 11px;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: .04em;
      }
      .exec-alert b {
        font-size: 11px;
        border-radius: 999px;
        padding: 4px 8px;
        background: var(--blue-l);
        color: var(--blue);
        white-space: nowrap;
      }
      .exec-alert.warn b { background: var(--orange-l); color: var(--orange); }
      .exec-alert.danger b { background: var(--red-l); color: var(--red); }
      .exec-alert.ok b { background: var(--green-l); color: var(--green); }
      .kpi-delta-row {
        display: flex;
        align-items: center;
        gap: 6px;
      }
      /* ── KPI comparison chips (LM / LY / META) ── */
      .badge-kpi {
        display: inline-flex;
        align-items: center;
        gap: 0;
        border-radius: 5px;
        font-size: 10px;
        font-weight: 600;
        white-space: nowrap;
        overflow: hidden;
        border: none;
        height: 22px;
        max-width: 100%;
      }
      .badge-kpi .bk-label {
        padding: 0 5px;
        font-size: 9px;
        font-weight: 700;
        letter-spacing: 0.4px;
        opacity: 0.85;
        height: 100%;
        display: flex;
        align-items: center;
      }
      .badge-kpi .bk-val {
        padding: 0 5px;
        font-size: 10px;
        font-weight: 700;
        height: 100%;
        display: flex;
        align-items: center;
        font-variant-numeric: tabular-nums;
      }
      .badge-kpi .bk-pct {
        padding: 0 5px;
        font-size: 9px;
        font-weight: 800;
        height: 100%;
        display: flex;
        align-items: center;
        gap: 2px;
      }
      /* LM — teal */
      .badge-lm { background: #e0f4f4; color: #0a7a7d; }
      .badge-lm .bk-label { background: #0a9396; color: #fff; }
      .badge-lm .bk-pct.du { color: #0a7a7d; }
      .badge-lm .bk-pct.dd { color: #c0392b; }
      /* LY — purple */
      .badge-ly { background: #ede9fb; color: #4a30a8; }
      .badge-ly .bk-label { background: #6c4fd8; color: #fff; }
      .badge-ly .bk-pct.du { color: #4a30a8; }
      .badge-ly .bk-pct.dd { color: #c0392b; }
      /* META — green when achieved, orange when not */
      .badge-meta { background: #e6f7ed; color: #1a7a40; }
      .badge-meta .bk-label { background: #1a7a40; color: #fff; }
      .badge-meta.below { background: #fff4e6; color: #a05000; }
      .badge-meta.below .bk-label { background: #e07000; }
      /* legacy delta helpers */
      .du { color: var(--green); }
      .dd { color: var(--red); }
      .dn { color: var(--t3); }
      .badge-val { font-weight: 800; font-size: 11px; }
      .badge-delta {
        display: inline-flex; align-items: center; gap: 3px;
        font-size: 9px; font-weight: 700;
      }
