<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Reserva de Veículos com Retorno</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }
        
        body {
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, sans-serif;
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            min-height: 100vh;
            display: flex;
            justify-content: center;
            align-items: center;
            padding: 20px;
        }
        
        .reserva-container {
            background: white;
            border-radius: 16px;
            box-shadow: 0 20px 60px rgba(0,0,0,0.3);
            width: 100%;
            max-width: 1000px;
            overflow: hidden;
        }
        
        .secao-header {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            color: white;
            padding: 24px 32px;
        }
        
        .secao-header h1 {
            font-size: 28px;
            font-weight: 600;
            display: flex;
            align-items: center;
            gap: 12px;
        }
        
        .secao-header h1 i {
            font-size: 32px;
        }
        
        .form-content {
            padding: 32px;
        }
        
        .secao {
            margin-bottom: 40px;
            border: 1px solid #e1e5e9;
            border-radius: 12px;
            overflow: hidden;
        }
        
        .secao-titulo {
            background: #f8f9fa;
            padding: 16px 24px;
            border-bottom: 1px solid #e1e5e9;
            font-size: 18px;
            font-weight: 600;
            color: #2d3748;
            display: flex;
            align-items: center;
            gap: 10px;
        }
        
        .secao-campos {
            padding: 24px;
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
            gap: 20px;
        }
        
        .campo {
            position: relative;
        }
        
        .campo label {
            display: block;
            margin-bottom: 8px;
            font-weight: 500;
            color: #4a5568;
            font-size: 14px;
        }
        
        .campo input,
        .campo select,
        .campo textarea {
            width: 100%;
            padding: 12px 16px;
            border: 2px solid #e2e8f0;
            border-radius: 8px;
            font-size: 14px;
            transition: all 0.3s ease;
            background: white;
        }
        
        .campo input:focus,
        .campo select:focus,
        .campo textarea:focus {
            outline: none;
            border-color: #667eea;
            box-shadow: 0 0 0 3px rgba(102, 126, 234, 0.1);
        }
        
        .campo textarea {
            min-height: 100px;
            resize: vertical;
        }
        
        .toggle-retorno {
            display: flex;
            align-items: center;
            gap: 12px;
            padding: 24px;
            background: #f0f7ff;
            border-bottom: 1px solid #e1e5e9;
        }
        
        .toggle-retorno input[type="checkbox"] {
            width: 24px;
            height: 24px;
            cursor: pointer;
        }
        
        .toggle-retorno label {
            font-size: 18px;
            font-weight: 600;
            color: #2d3748;
            cursor: pointer;
            display: flex;
            align-items: center;
            gap: 8px;
        }
        
        .campos-retorno {
            padding: 24px;
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
            gap: 20px;
            background: #f9fafc;
            transition: all 0.3s ease;
        }
        
        .campos-retorno.oculto {
            display: none;
        }
        
        .botoes-container {
            padding: 24px 32px;
            background: #f8f9fa;
            border-top: 1px solid #e1e5e9;
            display: flex;
            gap: 16px;
            justify-content: flex-end;
        }
        
        .btn {
            padding: 14px 28px;
            border: none;
            border-radius: 8px;
            font-size: 16px;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.3s ease;
            display: flex;
            align-items: center;
            gap: 8px;
        }
        
        .btn-salvar {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            color: white;
        }
        
        .btn-salvar:hover {
            transform: translateY(-2px);
            box-shadow: 0 10px 25px rgba(102, 126, 234, 0.3);
        }
        
        .btn-cancelar {
            background: #e2e8f0;
            color: #4a5568;
        }
        
        .btn-cancelar:hover {
            background: #cbd5e0;
        }
        
        .status-mensagem {
            padding: 16px;
            border-radius: 8px;
            margin-bottom: 20px;
            display: none;
            align-items: center;
            gap: 12px;
            animation: slideIn 0.3s ease;
        }
        
        .status-mensagem.sucesso {
            background: #d1fae5;
            color: #065f46;
            border: 1px solid #a7f3d0;
        }
        
        .status-mensagem.erro {
            background: #fee2e2;
            color: #991b1b;
            border: 1px solid #fecaca;
        }
        
        @keyframes slideIn {
            from {
                opacity: 0;
                transform: translateY(-10px);
            }
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }
        
        @media (max-width: 768px) {
            .secao-campos {
                grid-template-columns: 1fr;
            }
            
            .botoes-container {
                flex-direction: column;
            }
            
            .btn {
                width: 100%;
                justify-content: center;
            }
        }
    </style>
</head>
<body>
    <div class="reserva-container">
        <!-- Cabeçalho -->
        <div class="secao-header">
            <h1>
                <span>🚗</span>
                Reserva de Veículo com Retorno
            </h1>
        </div>
        
        <!-- Mensagens de Status -->
        <div id="statusMensagem" class="status-mensagem" style="display: none;"></div>
        
        <!-- Conteúdo do Formulário -->
        <div class="form-content">
            <!-- Seção 1: Dados Principais -->
            <section class="secao">
                <div class="secao-titulo">
                    <span>📋</span>
                    Dados da Reserva Principal
                </div>
                <div class="secao-campos" id="camposPrincipais">
                    <!-- Os campos serão populados via JavaScript -->
                </div>
            </section>
            
            <!-- Seção 2: Retorno -->
            <section class="secao">
                <div class="secao-titulo">
                    <span>🔄</span>
                    Configuração do Serviço de Retorno
                </div>
                <div class="toggle-retorno">
                    <input type="checkbox" id="ativarRetorno" onclick="toggleCamposRetorno()">
                    <label for="ativarRetorno">
                        <span>⚡</span>
                        Criar serviço de retorno automático
                    </label>
                </div>
                <div class="campos-retorno oculto" id="camposRetorno">
                    <div class="campo">
                        <label for="dataRetorno">📅 Data e Hora do Retorno *</label>
                        <input type="datetime-local" id="dataRetorno" required>
                    </div>
                    <div class="campo">
                        <label for="enderecoRetorno">📍 Endereço de Saída do Retorno *</label>
                        <input type="text" id="enderecoRetorno" required>
                    </div>
                    <div class="campo">
                        <label for="destinoRetorno">🎯 Destino do Retorno *</label>
                        <input type="text" id="destinoRetorno" required>
                    </div>
                    <div class="campo full-width">
                        <label for="obsInternaRetorno">📝 Observação Interna do Retorno</label>
                        <textarea id="obsInternaRetorno" rows="3"></textarea>
                    </div>
                    <div class="campo full-width">
                        <label for="obsOperacaoRetorno">⚙️ Observação de Operação do Retorno</label>
                        <textarea id="obsOperacaoRetorno" rows="3"></textarea>
                    </div>
                </div>
            </section>
        </div>
        
        <!-- Botões -->
        <div class="botoes-container">
            <button class="btn btn-cancelar" onclick="cancelar()">
                <span>✖</span>
                Cancelar
            </button>
            <button class="btn btn-salvar" onclick="processarReservaCompleta()">
                <span>💾</span>
                Salvar Reserva e Retorno
            </button>
        </div>
    </div>

    <script>
        // Configuração dos campos da entidade
        const CAMPOS_ENTIDADE = [
            // Lookups
            { nome: "cr40f_cliente", label: "Cliente *", tipo: "lookup", obrigatorio: true, entidade: "cr40f_clientes1" },
            { nome: "cr40f_solicitante", label: "Solicitante", tipo: "lookup", obrigatorio: false, entidade: "cr40f_bancodedados" },
            { nome: "cr40f_passageiro1", label: "Passageiro 1", tipo: "lookup", obrigatorio: false, entidade: "cr40f_bancodedados" },
            { nome: "cr40f_passageiro2", label: "Passageiro 2", tipo: "lookup", obrigatorio: false, entidade: "cr40f_bancodedados" },
            { nome: "cr40f_passageiro3", label: "Passageiro 3", tipo: "lookup", obrigatorio: false, entidade: "cr40f_bancodedados" },
            { nome: "cr40f_passageiro4", label: "Passageiro 4", tipo: "lookup", obrigatorio: false, entidade: "cr40f_bancodedados" },
            
            // Textos
            { nome: "cr40f_cotao", label: "Cotação", tipo: "text", obrigatorio: false },
            { nome: "cr40f_cr", label: "CR", tipo: "text", obrigatorio: false },
            { nome: "cr40f_destino", label: "Destino *", tipo: "text", obrigatorio: true },
            { nome: "cr40f_endereodesada", label: "Endereço de Saída *", tipo: "text", obrigatorio: true },
            { nome: "cr40f_obsdeoperacao", label: "Observação de Operação", tipo: "textarea", obrigatorio: false },
            { nome: "cr40f_observaointerna", label: "Observação Interna", tipo: "textarea", obrigatorio: false },
            { nome: "cr40f_trajeto", label: "Trajeto", tipo: "text", obrigatorio: false },
            { nome: "cr40f_motoristalookupvalue", label: "Motorista", tipo: "text", obrigatorio: false }, // NÃO É LOOKUP!
            
            // Datas
            { nome: "cr40f_dataehorriodesada", label: "Data e Hora de Saída *", tipo: "datetime-local", obrigatorio: true },
            { nome: "cr40f_horrioprevistoderetorno", label: "Horário Previsto de Retorno", tipo: "datetime-local", obrigatorio: false },
            
            // Choices (serão populados via API)
            { nome: "cr40f_formadepagamento", label: "Forma de Pagamento", tipo: "select", obrigatorio: false },
            { nome: "cr40f_status", label: "Status", tipo: "select", obrigatorio: false },
            { nome: "cr40f_tipodeveiculo", label: "Tipo de Veículo *", tipo: "select", obrigatorio: true },
            { nome: "cr40f_tipodoservico", label: "Tipo do Serviço *", tipo: "select", obrigatorio: true }
        ];
        
        // Inicialização
        document.addEventListener('DOMContentLoaded', async function() {
            await inicializarFormulario();
        });
        
        async function inicializarFormulario() {
            try {
                // Criar campos principais
                criarCamposPrincipais();
                
                // Carregar opções de choices via API
                await carregarOpcoesChoices();
                
                // Preencher dados se estiver editando
                await preencherDadosSeEdicao();
                
                console.log('✅ Formulário inicializado com sucesso');
                
            } catch (error) {
                console.error('❌ Erro ao inicializar formulário:', error);
                mostrarMensagem('Erro ao carregar formulário: ' + error.message, 'erro');
            }
        }
        
        function criarCamposPrincipais() {
            const container = document.getElementById('camposPrincipais');
            
            CAMPOS_ENTIDADE.forEach(campo => {
                const campoDiv = document.createElement('div');
                campoDiv.className = `campo ${campo.tipo === 'textarea' ? 'full-width' : ''}`;
                
                const label = document.createElement('label');
                label.htmlFor = campo.nome;
                label.textContent = campo.label;
                
                let input;
                
                switch(campo.tipo) {
                    case 'text':
                    case 'datetime-local':
                        input = document.createElement('input');
                        input.type = campo.tipo;
                        input.id = campo.nome;
                        if (campo.obrigatorio) input.required = true;
                        break;
                        
                    case 'textarea':
                        input = document.createElement('textarea');
                        input.id = campo.nome;
                        input.rows = 3;
                        if (campo.obrigatorio) input.required = true;
                        break;
                        
                    case 'select':
                        input = document.createElement('select');
                        input.id = campo.nome;
                        if (campo.obrigatorio) input.required = true;
                        
                        // Option placeholder
                        const placeholder = document.createElement('option');
                        placeholder.value = '';
                        placeholder.textContent = `Selecione ${campo.label.toLowerCase()}...`;
                        placeholder.disabled = true;
                        placeholder.selected = true;
                        input.appendChild(placeholder);
                        break;
                        
                    case 'lookup':
                        input = document.createElement('div');
                        input.className = 'lookup-container';
                        input.innerHTML = `
                            <input type="text" id="${campo.nome}_search" 
                                   placeholder="Buscar ${campo.label.toLowerCase()}..."
                                   oninput="buscarLookup('${campo.nome}', '${campo.entidade}')">
                            <input type="hidden" id="${campo.nome}_id">
                            <div class="lookup-results" id="${campo.nome}_results"></div>
                        `;
                        break;
                }
                
                campoDiv.appendChild(label);
                campoDiv.appendChild(input);
                container.appendChild(campoDiv);
            });
        }
        
        function toggleCamposRetorno() {
            const ativarRetorno = document.getElementById('ativarRetorno');
            const camposRetorno = document.getElementById('camposRetorno');
            
            if (ativarRetorno.checked) {
                camposRetorno.classList.remove('oculto');
                // Preencher automaticamente alguns campos
                const destinoPrincipal = document.getElementById('cr40f_destino')?.value;
                const enderecoPrincipal = document.getElementById('cr40f_endereodesada')?.value;
                
                if (destinoPrincipal && !document.getElementById('destinoRetorno').value) {
                    document.getElementById('destinoRetorno').value = enderecoPrincipal || '';
                }
                
                if (enderecoPrincipal && !document.getElementById('enderecoRetorno').value) {
                    document.getElementById('enderecoRetorno').value = destinoPrincipal || '';
                }
                
                // Preencher data de retorno (4 horas após a saída)
                const dataSaida = document.getElementById('cr40f_dataehorriodesada')?.value;
                if (dataSaida) {
                    const dataSaidaObj = new Date(dataSaida);
                    dataSaidaObj.setHours(dataSaidaObj.getHours() + 4);
                    const dataRetornoStr = dataSaidaObj.toISOString().slice(0, 16);
                    document.getElementById('dataRetorno').value = dataRetornoStr;
                }
            } else {
                camposRetorno.classList.add('oculto');
            }
        }
        
        async function processarReservaCompleta() {
            try {
                mostrarMensagem('⏳ Processando reserva...', 'info');
                
                // 1. Validar dados principais
                const dadosPrincipais = coletarDadosPrincipais();
                if (!dadosPrincipais) return;
                
                // 2. Salvar reserva principal
                mostrarMensagem('💾 Salvando reserva principal...', 'info');
                const reservaId = await salvarReservaPrincipal(dadosPrincipais);
                
                // 3. Verificar retorno
                const retornoAtivo = document.getElementById('ativarRetorno').checked;
                
                if (retornoAtivo) {
                    // 4. Validar dados do retorno
                    const dadosRetorno = coletarDadosRetorno();
                    if (!dadosRetorno) return;
                    
                    // 5. Preparar dados completos do retorno
                    mostrarMensagem('🔄 Criando serviço de retorno...', 'info');
                    
                    const dadosCompletosRetorno = {
                        ...dadosPrincipais,
                        ...dadosRetorno,
                        cr40f_status: 202410001, // Status inicial
                        cr40f_observaointerna: `${dadosPrincipais.cr40f_observaointerna || ''}\n\n--- RETORNO AUTOMÁTICO ---\nCriado em: ${new Date().toLocaleString()}\nOrigem: ${reservaId}`
                    };
                    
                    // 6. Criar registro de retorno
                    const retornoId = await criarRegistroRetorno(dadosCompletosRetorno);
                    
                    // 7. Atualizar reserva original
                    await atualizarReservaOriginalComRetorno(reservaId, retornoId);
                    
                    mostrarMensagem(`✅ Sucesso! Reserva: ${reservaId}, Retorno: ${retornoId}`, 'sucesso');
                    
                    // Redirecionar após 3 segundos
                    setTimeout(() => {
                        window.location.href = `/main.aspx?appid=${getAppId()}&pagetype=entityrecord&etn=cr40f_reservadeveculos&id=${reservaId}`;
                    }, 3000);
                    
                } else {
                    mostrarMensagem(`✅ Reserva salva com sucesso! ID: ${reservaId}`, 'sucesso');
                    
                    setTimeout(() => {
                        window.location.href = `/main.aspx?appid=${getAppId()}&pagetype=entityrecord&etn=cr40f_reservadeveculos&id=${reservaId}`;
                    }, 2000);
                }
                
            } catch (error) {
                console.error('❌ Erro no processamento:', error);
                mostrarMensagem(`❌ Erro: ${error.message}`, 'erro');
            }
        }
        
        function coletarDadosPrincipais() {
            const dados = {};
            const erros = [];
            
            CAMPOS_ENTIDADE.forEach(campo => {
                const elemento = document.getElementById(campo.nome);
                
                if (!elemento && campo.tipo !== 'lookup') {
                    console.warn(`Campo ${campo.nome} não encontrado no DOM`);
                    return;
                }
                
                let valor;
                
                if (campo.tipo === 'lookup') {
                    const idElemento = document.getElementById(`${campo.nome}_id`);
                    if (idElemento && idElemento.value) {
                        valor = [{
                            id: idElemento.value,
                            name: document.getElementById(`${campo.nome}_search`)?.value || '',
                            entityType: campo.entidade
                        }];
                    }
                } else {
                    valor = elemento.value;
                    
                    // Converter datas para ISO
                    if (campo.tipo === 'datetime-local' && valor) {
                        valor = new Date(valor).toISOString();
                    }
                    
                    // Validar obrigatórios
                    if (campo.obrigatorio && !valor) {
                        erros.push(campo.label);
                        elemento.style.borderColor = '#f56565';
                    } else if (elemento) {
                        elemento.style.borderColor = '';
                    }
                }
                
                // Não adicionar valores vazios
                if (valor !== undefined && valor !== null && valor !== '') {
                    dados[campo.nome] = valor;
                }
            });
            
            if (erros.length > 0) {
                mostrarMensagem(`Preencha os campos obrigatórios:\n${erros.join('\n')}`, 'erro');
                return null;
            }
            
            return dados;
        }
        
        function coletarDadosRetorno() {
            const camposRetorno = [
                { id: 'dataRetorno', campo: 'cr40f_dataehorriodesada' },
                { id: 'enderecoRetorno', campo: 'cr40f_endereodesada' },
                { id: 'destinoRetorno', campo: 'cr40f_destino' },
                { id: 'obsInternaRetorno', campo: 'cr40f_observaointerna' },
                { id: 'obsOperacaoRetorno', campo: 'cr40f_obsdeoperacao' }
            ];
            
            const dados = {};
            const erros = [];
            
            camposRetorno.forEach(item => {
                const elemento = document.getElementById(item.id);
                if (elemento && elemento.required && !elemento.value) {
                    erros.push(elemento.previousElementSibling.textContent);
                    elemento.style.borderColor = '#f56565';
                } else if (elemento) {
                    elemento.style.borderColor = '';
                    
                    let valor = elemento.value;
                    
                    // Converter data
                    if (item.id === 'dataRetorno' && valor) {
                        valor = new Date(valor).toISOString();
                    }
                    
                    if (valor) {
                        dados[item.campo] = valor;
                    }
                }
            });
            
            if (erros.length > 0) {
                mostrarMensagem(`Preencha os campos obrigatórios do retorno:\n${erros.join('\n')}`, 'erro');
                return null;
            }
            
            return dados;
        }
        
        async function salvarReservaPrincipal(dados) {
            try {
                console.log('Dados para salvar:', dados);
                
                // Usar Xrm.WebApi que formata automaticamente
                const resultado = await Xrm.WebApi.createRecord("cr40f_reservadeveculos", dados);
                
                console.log('Reserva criada:', resultado);
                return resultado.id;
                
            } catch (error) {
                console.error('Erro ao salvar reserva:', error);
                throw new Error(`Falha ao criar reserva: ${error.message}`);
            }
        }
        
        async function criarRegistroRetorno(dados) {
            try {
                console.log('Dados do retorno (antes de formatar):', dados);
                
                // IMPORTANTE: Formatar campos corretamente para evitar erros OData
                const dadosFormatados = {};
                
                Object.keys(dados).forEach(key => {
                    let valor = dados[key];
                    
                    // CASO ESPECIAL: cr40f_motoristalookupvalue (NÃO É LOOKUP)
                    if (key === 'cr40f_motoristalookupvalue') {
                        dadosFormatados[key] = String(valor || '');
                        return;
                    }
                    
                    // Para lookups (array com objeto)
                    if (Array.isArray(valor) && valor[0] && valor[0].id) {
                        dadosFormatados[key] = valor; // Xrm.WebApi formata automaticamente
                    }
                    // Para outros valores
                    else if (valor !== undefined && valor !== null && valor !== '') {
                        dadosFormatados[key] = valor;
                    }
                });
                
                console.log('Dados formatados do retorno:', dadosFormatados);
                
                const resultado = await Xrm.WebApi.createRecord("cr40f_reservadeveculos", dadosFormatados);
                
                console.log('Retorno criado:', resultado);
                return resultado.id;
                
            } catch (error) {
                console.error('Erro detalhado ao criar retorno:', error);
                
                // Log extra para debugging
                if (error.message && error.message.includes('cr40f_cliente')) {
                    console.error('PROBLEMA COM LOOKUP cr40f_cliente');
                    console.error('Valor enviado:', dados.cr40f_cliente);
                }
                
                throw new Error(`Falha ao criar retorno: ${error.message}`);
            }
        }
        
        async function atualizarReservaOriginalComRetorno(reservaId, retornoId) {
            try {
                await Xrm.WebApi.updateRecord("cr40f_reservadeveculos", reservaId, {
                    cr40f_status: 202410002, // Status: Com retorno
                    cr40f_observaointerna: `Serviço de retorno criado: ${retornoId}\nData: ${new Date().toLocaleString()}`
                });
                
                console.log('Reserva original atualizada com referência ao retorno');
                
            } catch (error) {
                console.warn('Não foi possível atualizar a reserva original:', error);
                // Não falhar o processo por causa deste erro
            }
        }
        
        function mostrarMensagem(texto, tipo) {
            const elemento = document.getElementById('statusMensagem');
            elemento.textContent = texto;
            elemento.className = `status-mensagem ${tipo}`;
            elemento.style.display = 'flex';
            
            if (tipo === 'sucesso') {
                setTimeout(() => {
                    elemento.style.display = 'none';
                }, 5000);
            }
        }
        
        function cancelar() {
            if (confirm('Tem certeza que deseja cancelar? Todas as alterações serão perdidas.')) {
                window.history.back();
            }
        }
        
        function getAppId() {
            // Extrair appId da URL atual
            const match = window.location.href.match(/appid=([^&]*)/);
            return match ? match[1] : '';
        }
        
        // Funções auxiliares (simplificadas para exemplo)
        async function carregarOpcoesChoices() {
            // Implementar carregamento de option sets via API
