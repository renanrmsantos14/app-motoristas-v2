function preencherEnderecoPassageiro(executionContext) {
    var formContext = executionContext.getFormContext();
    
    console.log("🔄 Função preencherEnderecoPassageiro executada");
    
    // Pega o campo Passageiro
    var campoPassageiro = formContext.getAttribute("cr40f_passageiro1");
    
    if (campoPassageiro == null) {
        console.error("❌ Campo cr40f_passageiro1 não encontrado!");
        return;
    }
    
    var passageiro = campoPassageiro.getValue();
    
    // Pega o campo Endereço de Saída
    var campoEnderecoServico = formContext.getAttribute("cr40f_enderecodesada");
    
    if (campoEnderecoServico == null) {
        console.error("❌ Campo cr40f_enderecodesada não encontrado!");
        return;
    }
    
    var enderecoAtual = campoEnderecoServico.getValue();
    
    // Se já tem endereço digitado, NÃO faz nada
    if (enderecoAtual != null && enderecoAtual != "") {
        console.log("✅ Campo de endereço já preenchido. Não será sobrescrito.");
        console.log("📍 Endereço atual: " + enderecoAtual);
        return;
    }
    
    // Se passageiro foi selecionado
    if (passageiro != null && passageiro.length > 0) {
        var passageiroId = passageiro[0].id.replace(/[{}]/g, "");
        var passageiroNome = passageiro[0].name;
        
        console.log("🔍 Buscando endereço do passageiro: " + passageiroNome);
        console.log("🆔 ID do passageiro: " + passageiroId);
        
        formContext.ui.setFormNotification(
            "Buscando endereço de " + passageiroNome + "...", 
            "INFO", 
            "buscando_endereco"
        );
        
        // Busca os dados do passageiro no Dataverse
        Xrm.WebApi.retrieveRecord(
            "cr40f_passageiro1", // Nome da tabela Passageiros
            passageiroId,
            "?$select=cr40f_enderecodesaida,cr40f_nomedopassageiro"
        ).then(
            function success(passageiroData) {
                console.log("✅ Dados do passageiro encontrados!");
                console.log("📦 Dados completos:", passageiroData);
                
                formContext.ui.clearFormNotification("buscando_endereco");
                
                // Pega o endereço do passageiro
                var enderecoPassageiro = passageiroData.cr40f_enderecodesaida;
                
                console.log("📍 Endereço do passageiro:", enderecoPassageiro);
                
                if (enderecoPassageiro != null && enderecoPassageiro != "") {
                    // Preenche o campo
                    campoEnderecoServico.setValue(enderecoPassageiro);
                    console.log("✅ Endereço preenchido com sucesso!");
                    
                    formContext.ui.setFormNotification(
                        "Endereço preenchido! Você pode editar o campo se necessário.", 
                        "INFO", 
                        "endereco_preenchido"
                    );
                    
                    setTimeout(function() {
                        formContext.ui.clearFormNotification("endereco_preenchido");
                    }, 4000);
                } else {
                    console.log("⚠️ Passageiro não possui endereço cadastrado.");
                    
                    formContext.ui.setFormNotification(
                        "Este passageiro não possui endereço de saída cadastrado.", 
                        "WARNING", 
                        "sem_endereco"
                    );
                    
                    setTimeout(function() {
                        formContext.ui.clearFormNotification("sem_endereco");
                    }, 4000);
                }
            },
            function error(error) {
                console.error("❌ Erro ao buscar passageiro:", error);
                console.error("📋 Mensagem de erro:", error.message);
                
                formContext.ui.clearFormNotification("buscando_endereco");
                
                formContext.ui.setFormNotification(
                    "Erro ao buscar endereço do passageiro. Verifique o console (F12).", 
                    "ERROR", 
                    "erro_buscar"
                );
                
                setTimeout(function() {
                    formContext.ui.clearFormNotification("erro_buscar");
                }, 5000);
            }
        );
    } else {
        console.log("ℹ️ Passageiro removido, mas campo de endereço mantido.");
    }
}

function onLoad(executionContext) {
    var formContext = executionContext.getFormContext();
    
    console.log("🚀 Script carregado - Betins Executive Service");
    console.log("📅 Versão: 1.0 - cr40f");
    
    // Adiciona evento onChange no campo Passageiro
    var campoPassageiro = formContext.getAttribute("cr40f_passageiro1");
    
    if (campoPassageiro != null) {
        campoPassageiro.addOnChange(preencherEnderecoPassageiro);
        console.log("✅ Evento onChange adicionado ao campo cr40f_passageiro1");
    } else {
        console.error("❌ Campo cr40f_passageiro1 não encontrado no formulário!");
        console.log("💡 Verifique se o campo está no formulário e se o nome está correto.");
    }
}