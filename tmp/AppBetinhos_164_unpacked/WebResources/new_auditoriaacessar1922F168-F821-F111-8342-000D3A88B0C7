"use strict";

var BETINHOS_AUDITORIA_VERSION = "7.0.0";

function AbrirAuditoriaDialog(primaryControl) {
    console.log("[Betinhos Auditoria v" + BETINHOS_AUDITORIA_VERSION + "] Iniciando...");

    if (!primaryControl) {
        console.error("[Betinhos Auditoria v" + BETINHOS_AUDITORIA_VERSION + "] ERRO: primaryControl null");
        Xrm.Navigation.openAlertDialog({ text: "Erro: contexto não disponível.", title: "Auditoria — Erro" });
        return;
    }

    var selectedIds = [];
    var entityName  = "";

    if (typeof primaryControl.getGrid === "function") {
        console.log("[Betinhos Auditoria v" + BETINHOS_AUDITORIA_VERSION + "] Contexto: GRADE");
        entityName = primaryControl.getEntityName
            ? primaryControl.getEntityName()
            : primaryControl._entityName || "";
        try {
            primaryControl.getGrid().getSelectedRows().forEach(function (row) {
                var id = row.data.entity.getId().replace(/[{}]/g, "").toLowerCase();
                selectedIds.push(id);
            });
        } catch (e) {
            console.error("[Betinhos Auditoria v" + BETINHOS_AUDITORIA_VERSION + "] ERRO seleção:", e);
        }
    } else if (primaryControl.data && primaryControl.data.entity) {
        console.log("[Betinhos Auditoria v" + BETINHOS_AUDITORIA_VERSION + "] Contexto: FORMULÁRIO");
        entityName = primaryControl.data.entity.getEntityName();
        selectedIds.push(primaryControl.data.entity.getId().replace(/[{}]/g, "").toLowerCase());
    } else {
        console.error("[Betinhos Auditoria v" + BETINHOS_AUDITORIA_VERSION + "] ERRO: contexto não reconhecido");
        Xrm.Navigation.openAlertDialog({ text: "Contexto não reconhecido.", title: "Auditoria — Erro" });
        return;
    }

    if (!entityName) {
        Xrm.Navigation.openAlertDialog({ text: "Não foi possível identificar a tabela.", title: "Auditoria — Erro" });
        return;
    }

    var guidRegex = /^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/;
    var validIds  = selectedIds.filter(function (id) { return guidRegex.test(id); });
    var orgUrl    = Xrm.Utility.getGlobalContext().getClientUrl();

    // Buscar entity set name via metadados antes de abrir o dialog
    var metaUrl = orgUrl + "/api/data/v9.2/EntityDefinitions(LogicalName='" + entityName + "')?$select=EntitySetName";
    console.log("[Betinhos Auditoria v" + BETINHOS_AUDITORIA_VERSION + "] Buscando EntitySetName...");

    var xhr = new XMLHttpRequest();
    xhr.open("GET", metaUrl, true);
    xhr.setRequestHeader("Accept", "application/json");
    xhr.setRequestHeader("OData-MaxVersion", "4.0");
    xhr.setRequestHeader("OData-Version", "4.0");

    xhr.onreadystatechange = function () {
        if (xhr.readyState !== 4) return;

        var entitySetName = entityName + "s"; // fallback
        if (xhr.status === 200) {
            try {
                var meta = JSON.parse(xhr.responseText);
                entitySetName = meta.EntitySetName || entitySetName;
                console.log("[Betinhos Auditoria v" + BETINHOS_AUDITORIA_VERSION + "] EntitySetName:", entitySetName);
            } catch (e) {
                console.warn("[Betinhos Auditoria v" + BETINHOS_AUDITORIA_VERSION + "] Fallback EntitySetName:", entitySetName);
            }
        }

        Xrm.Navigation.navigateTo(
            {
                pageType:        "webresource",
                webresourceName: "new_betinhos_AuditoriaViewer",
                data:            JSON.stringify({
                    version:       BETINHOS_AUDITORIA_VERSION,
                    orgUrl:        orgUrl,
                    entityName:    entityName,
                    entitySetName: entitySetName,
                    validIds:      validIds
                })
            },
            {
                target:   2,
                width:    { value: 92, unit: "%" },
                height:   { value: 88, unit: "%" },
                position: 1
            }
        ).then(
            function () { console.log("[Betinhos Auditoria v" + BETINHOS_AUDITORIA_VERSION + "] Dialog fechado."); },
            function (error) {
                console.error("[Betinhos Auditoria v" + BETINHOS_AUDITORIA_VERSION + "] ERRO dialog:", error);
                Xrm.Navigation.openAlertDialog({ text: "Erro ao abrir auditoria: " + (error.message || error), title: "Auditoria — Erro" });
            }
        );
    };

    xhr.onerror = function () {
        console.warn("[Betinhos Auditoria v" + BETINHOS_AUDITORIA_VERSION + "] ERRO rede metadados — usando fallback");
        Xrm.Navigation.navigateTo(
            {
                pageType:        "webresource",
                webresourceName: "new_betinhos_AuditoriaViewer",
                data:            JSON.stringify({
                    version:       BETINHOS_AUDITORIA_VERSION,
                    orgUrl:        orgUrl,
                    entityName:    entityName,
                    entitySetName: entityName + "s",
                    validIds:      validIds
                })
            },
            { target: 2, width: { value: 92, unit: "%" }, height: { value: 88, unit: "%" }, position: 1 }
        );
    };

    xhr.send();
}