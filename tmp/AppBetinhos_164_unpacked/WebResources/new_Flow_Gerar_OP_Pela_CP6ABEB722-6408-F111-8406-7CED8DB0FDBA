// Command Button JS — TriggerFlow (CP → Geral → OP)
// flowUrl lida de Variável de Ambiente Dataverse: new_FlowUrlCriarOP

var CONFIG = {
    CP_ENTITY:           "cr40f_composicaodeprecos",
    CP_LOOKUP_GERAL:     "_cr40f_servicorelacionadogeral_value",
    CP_NAME_FIELD:       "cr40f_id",

    GERAL_ENTITY:        "cr40f_reservadeveculos",
    GERAL_LOOKUP_OP:     "_cr40f_financeiro_value",
    GERAL_NAME_FIELD:    "cr40f_id",

    ENV_VAR_FLOW_URL:    "new_FlowUrlCriarOP",  // ← variável de ambiente
    MAX_DISPLAY_ITEMS:   20
};

// ===== BUSCA VARIÁVEL DE AMBIENTE =====
function _getEnvVarValue_CP(schemaName, onSuccess, onError) {
    Xrm.WebApi.retrieveMultipleRecords(
        "environmentvariablevalue",
        "?$select=value&$expand=EnvironmentVariableDefinitionId($select=schemaname)&$filter=EnvironmentVariableDefinitionId/schemaname eq '" + schemaName + "'"
    ).then(
        function (result) {
            if (result.entities && result.entities.length > 0) {
                onSuccess(result.entities[0].value);
            } else {
                Xrm.WebApi.retrieveMultipleRecords(
                    "environmentvariabledefinition",
                    "?$select=defaultvalue&$filter=schemaname eq '" + schemaName + "'"
                ).then(
                    function (defResult) {
                        onSuccess(
                            defResult.entities && defResult.entities.length > 0
                                ? defResult.entities[0].defaultvalue
                                : null
                        );
                    },
                    onError
                );
            }
        },
        onError
    );
}

// ===== ENTRY POINT =====
function TriggerFlow(selectedItems) {
    console.log("=== INÍCIO TriggerFlow (CP → Geral → OP) ===");
    console.log("selectedItems:", selectedItems);

    if (!selectedItems || selectedItems.length === 0) {
        Xrm.Navigation.openAlertDialog(
            { confirmButtonLabel: "OK", text: "Nenhuma Composição de Preço foi selecionada!" },
            { height: 120, width: 280 }
        );
        return;
    }

    var cpIds = selectedItems.map(function (item) {
        return item.Id.replace(/[{}]/g, "");
    });

    console.log("cpIds:", cpIds);
    Xrm.Utility.showProgressIndicator("Mapeando Composições de Preço...");

    mapCpToGeral(cpIds, function (result) {
        var geralIds   = result.geralIds;
        var cpSemGeral = result.cpSemGeral;
        var cpComErro  = result.cpComErro;

        console.log("Geral encontrados:", geralIds.length, "Sem Geral:", cpSemGeral.length, "Erro:", cpComErro.length);
        Xrm.Utility.closeProgressIndicator();

        if (geralIds.length === 0) {
            var msg = "Nenhum serviço encontrado nas CPs selecionadas.";
            if (cpSemGeral.length > 0) msg += "\n\n⚠️ " + cpSemGeral.length + " CP(s) sem serviço vinculado.";
            if (cpComErro.length  > 0) msg += "\n❌ " + cpComErro.length + " CP(s) com erro de leitura.";
            Xrm.Navigation.openAlertDialog({ confirmButtonLabel: "OK", text: msg }, { height: 180, width: 320 });
            return;
        }

        Xrm.Utility.showProgressIndicator("Validando serviços...");

        validateGeralRecords(geralIds, function (validationResult) {
            var validIds        = validationResult.validIds;
            var invalidRecords  = validationResult.invalidRecords;

            console.log("Válidos:", validIds.length, "Inválidos:", invalidRecords.length);
            Xrm.Utility.closeProgressIndicator();

            if (invalidRecords.length > 0) {
                var displayLimit = Math.min(invalidRecords.length, CONFIG.MAX_DISPLAY_ITEMS);
                var message = invalidRecords.length + " serviço(s) já possui(em) OP criada:\n\n";
                for (var i = 0; i < displayLimit; i++) {
                    message += "• " + (invalidRecords[i].name || invalidRecords[i].id) + "\n";
                }
                if (invalidRecords.length > CONFIG.MAX_DISPLAY_ITEMS) {
                    message += "... e mais " + (invalidRecords.length - CONFIG.MAX_DISPLAY_ITEMS) + " serviço(s)\n";
                }

                if (validIds.length > 0) {
                    message += "\nDeseja criar OP para os " + validIds.length + " serviço(s) restante(s)?";
                    Xrm.Navigation.openConfirmDialog({
                        title: "Serviços com OP existente",
                        text: message,
                        confirmButtonLabel: "Sim, continuar",
                        cancelButtonLabel: "Cancelar"
                    }).then(function (r) {
                        if (r.confirmed) processFlow(validIds);
                    });
                } else {
                    Xrm.Navigation.openAlertDialog(
                        { confirmButtonLabel: "OK", text: "Todos os serviços das CPs selecionadas já possuem OP criada." },
                        { height: 150, width: 320 }
                    );
                }
            } else {
                processFlow(validIds);
            }
        });
    });
}

// ===== MAP CP → GERAL =====
function mapCpToGeral(cpIds, callback) {
    var geralSet      = {};
    var cpSemGeral    = [];
    var cpComErro     = [];
    var processedCount = 0;

    cpIds.forEach(function (cpId, index) {
        var query = "?$select=" + CONFIG.CP_LOOKUP_GERAL + "," + CONFIG.CP_NAME_FIELD;

        Xrm.WebApi.retrieveRecord(CONFIG.CP_ENTITY, cpId, query)
            .then(function (cp) {
                processedCount++;
                var geralId = cp[CONFIG.CP_LOOKUP_GERAL];
                var cpName  = cp[CONFIG.CP_NAME_FIELD] || cpId;

                if (geralId) {
                    var clean = geralId.replace(/[{}]/g, "");
                    if (!geralSet[clean]) geralSet[clean] = true;
                } else {
                    cpSemGeral.push({ id: cpId, name: cpName });
                }

                if (processedCount === cpIds.length) finalizarMapeamento();
            })
            .catch(function (error) {
                processedCount++;
                console.error("Erro CP:", cpId, error.message);
                cpComErro.push({ id: cpId, error: error.message });
                if (processedCount === cpIds.length) finalizarMapeamento();
            });
    });

    function finalizarMapeamento() {
        callback({ geralIds: Object.keys(geralSet), cpSemGeral: cpSemGeral, cpComErro: cpComErro });
    }
}

// ===== VALIDAR GERAL → OP =====
function validateGeralRecords(geralIds, callback) {
    var validIds       = [];
    var invalidRecords = [];
    var geralComErro   = [];
    var processedCount = 0;

    geralIds.forEach(function (geralId) {
        var query = "?$select=" + CONFIG.GERAL_LOOKUP_OP + "," + CONFIG.GERAL_NAME_FIELD;

        Xrm.WebApi.retrieveRecord(CONFIG.GERAL_ENTITY, geralId, query)
            .then(function (geral) {
                processedCount++;
                var opId      = geral[CONFIG.GERAL_LOOKUP_OP];
                var geralName = geral[CONFIG.GERAL_NAME_FIELD] || geralId;

                if (opId) {
                    invalidRecords.push({ id: geralId, name: geralName });
                } else {
                    validIds.push(geralId);
                }

                if (processedCount === geralIds.length) finalizarValidacao();
            })
            .catch(function (error) {
                processedCount++;
                console.error("Erro Geral:", geralId, error.message);
                validIds.push(geralId); // não bloqueia
                geralComErro.push({ id: geralId, error: error.message });
                if (processedCount === geralIds.length) finalizarValidacao();
            });
    });

    function finalizarValidacao() {
        callback({ validIds: validIds, invalidRecords: invalidRecords, geralComErro: geralComErro });
    }
}

// ===== DISPARO DO FLOW =====
function processFlow(validGeralIds) {
    console.log("processFlow — registros:", validGeralIds.length);
    if (validGeralIds.length === 0) return;

    Xrm.Utility.showProgressIndicator("Buscando configuração...");

    _getEnvVarValue_CP(
        CONFIG.ENV_VAR_FLOW_URL,
        function (flowUrl) {
            if (!flowUrl) {
                try { Xrm.Utility.closeProgressIndicator(); } catch (e) {}
                Xrm.Navigation.openAlertDialog({
                    confirmButtonLabel: "OK",
                    text: "Variável de ambiente '" + CONFIG.ENV_VAR_FLOW_URL + "' não encontrada ou sem valor.\nConfigure-a em Power Apps > Soluções > Variáveis de Ambiente."
                }, { height: 160, width: 420 });
                return;
            }

            console.log("flowUrl resolvida:", flowUrl);

            var guidsString = validGeralIds.join(",");
            var requestBody = JSON.stringify({ guids: guidsString });

            Xrm.Utility.showProgressIndicator("Criando OP para " + validGeralIds.length + " serviço(s)...");

            var req = new XMLHttpRequest();
            req.open("POST", flowUrl, true);
            req.setRequestHeader("Content-Type", "application/json");

            req.onreadystatechange = function () {
                if (req.readyState !== 4) return;

                console.log("Resposta Flow — status:", req.status, req.responseText);
                Xrm.Utility.closeProgressIndicator();

                if (req.status === 200 || req.status === 202) {
                    Xrm.Navigation.openAlertDialog({
                        confirmButtonLabel: "OK",
                        text: "OP criada com sucesso para " + validGeralIds.length + " serviço(s)!"
                    }, { height: 120, width: 280 });
                } else {
                    var errorMsg = "Erro ao acionar o Flow.\nStatus: " + req.status;
                    try {
                        var response = JSON.parse(req.responseText);
                        if (response.error && response.error.message) errorMsg += "\n\n" + response.error.message;
                    } catch (e) {}
                    Xrm.Navigation.openAlertDialog(
                        { confirmButtonLabel: "OK", text: errorMsg },
                        { height: 180, width: 320 }
                    );
                }
            };

            req.onerror = function () {
                Xrm.Utility.closeProgressIndicator();
                Xrm.Navigation.openAlertDialog(
                    { confirmButtonLabel: "OK", text: "Erro de conexão ao tentar acionar o Flow." },
                    { height: 120, width: 280 }
                );
            };

            req.send(requestBody);
        },
        function (err) {
            try { Xrm.Utility.closeProgressIndicator(); } catch (e) {}
            console.error("Erro ao buscar env var:", err);
            Xrm.Navigation.openAlertDialog(
                { confirmButtonLabel: "OK", text: "Erro ao carregar configuração do flow." },
                { height: 120, width: 260 }
            );
        }
    );
}