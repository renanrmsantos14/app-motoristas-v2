          <div class="landscape-card-time">
            <strong>${escapeHtml(formatHour(s.saida) || "—")}</strong>
            <span>${escapeHtml(formatDateShort(s.saida || state.date))}</span>
          </div>
          <span class="status-tag" style="background:${statusC.bg};color:${statusC.fg}"><span class="dot"></span>${escapeHtml(s.status)}</span>
        </div>
        <div class="landscape-card-grid">
          <div class="landscape-card-field"><span>Motorista</span><strong>${escapeHtml(s.motoristaName || "Sem motorista")}</strong></div>
          <div class="landscape-card-field"><span>Veículo</span><strong>${escapeHtml(s.tipoVeiculo || "—")}</strong></div>
          <div class="landscape-card-field full"><span>Trajeto</span><strong>${escapeHtml(composeTrajetoResumo(s))}</strong></div>
          <div class="landscape-card-field"><span>Solicitante</span><strong>${escapeHtml(s.solicitanteName || s.clienteName || "—")}</strong></div>
          <div class="landscape-card-field"><span>Passageiros</span><strong>${escapeHtml(composePassageirosResumo(s))}</strong></div>
        </div>
      </button>`;
    }

    function renderTimelineMode(main, snap) {
      $("#section-title").textContent = "Agenda do dia";
      $("#section-meta").textContent = `${state.reservas.length} serviço(s)`;
      const html = [];
      if (snap.alerts.length > 0) html.push(renderAlertStrip(snap.alerts));
      html.push(renderSubsection("Atenção", snap.attention, "Sem pendências críticas."));
      html.push(renderSubsection("Em curso agora", snap.inProgress, "Nenhum serviço em operação agora."));
      html.push(renderSubsection("A seguir — Próxima hora", snap.nextHour, "Sem saídas na próxima hora."));
      html.push(renderSubsection("A seguir — Tarde", snap.afternoon, "Sem saídas para a tarde."));
      html.push(renderSubsection("A seguir — Noite", snap.night, "Sem saídas para a noite."));
