    function setSelectedService(serviceId, options) {
      const cfg = options || {};
      const svc = state.reservas.find(r => r.id === serviceId);
      if (!svc) return;
      state.selectedServiceId = serviceId;
      if (isSplitDetailMode()) {
        renderDetailPanel(svc);
