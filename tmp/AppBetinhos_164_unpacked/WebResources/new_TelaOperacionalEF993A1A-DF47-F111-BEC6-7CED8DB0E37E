    function syncSelectionUi() {
      if (isLandscapeCompactMode()) {
        $("#app-detail-panel").classList.add("hidden");
        return;
      }
      if (isSplitDetailMode()) {
        if (!getSelectedService() && state.reservas.length) {
          state.selectedServiceId = state.reservas[0].id;
