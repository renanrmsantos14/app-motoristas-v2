                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.1" stroke-linecap="round" stroke-linejoin="round"><path d="M8 6h13"/><path d="M8 12h13"/><path d="M8 18h13"/><path d="M3 6h.01"/><path d="M3 12h.01"/><path d="M3 18h.01"/></svg>
                Agenda do dia
              </button>
              <button class="desktop-menu-btn ${state.viewMode === "motorista" ? "active" : ""}" data-rail-view="motorista">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.1" stroke-linecap="round" stroke-linejoin="round"><circle cx="8" cy="7" r="4"/><path d="M2 21v-2a6 6 0 0 1 12 0v2"/><path d="M17 11l2 2 4-4"/><path d="M17 19h5"/></svg>
                Por motorista
              </button>
            </nav>
          </section>
          <section class="rail-block">
            <div class="rail-block-title">Filtros</div>
            <div class="desktop-filter-stack">
              <label class="desktop-filter-field">
                <span class="desktop-filter-label">Data</span>
                <input class="desktop-filter-input" type="date" data-desktop-filter="date" value="${escapeAttr(toIsoDate(state.date))}" />
              </label>
              <label class="desktop-filter-field">
                <span class="desktop-filter-label">Motorista</span>
                <select class="desktop-filter-input" data-desktop-filter="driver">
                  ${motoristaOptions}
                </select>
              </label>
              <label class="desktop-filter-field">
                <span class="desktop-filter-label">Ordenação</span>
                <select class="desktop-filter-input" data-desktop-filter="sort">
                  <option value="saida_asc" ${state.sortOrder === "saida_asc" ? "selected" : ""}>Saída crescente</option>
                  <option value="saida_desc" ${state.sortOrder === "saida_desc" ? "selected" : ""}>Saída decrescente</option>
                </select>
              </label>
            </div>
          </section>
          <section class="rail-stats">
            <article class="rail-stat">
              <span class="rail-stat-label">Serviços</span>
              <span class="rail-stat-value">${state.reservas.length}</span>
              <span class="rail-stat-meta">${state.sortOrder === "saida_desc" ? "Saída decrescente" : "Saída crescente"}</span>
            </article>
            <article class="rail-stat">
              <span class="rail-stat-label">Em curso</span>
              <span class="rail-stat-value">${inProgress}</span>
              <span class="rail-stat-meta">${next} na próxima hora</span>
            </article>
            <article class="rail-stat">
              <span class="rail-stat-label">Motoristas</span>
              <span class="rail-stat-value">${state.grouped.length}</span>
              <span class="rail-stat-meta">${semMotorista} sem alocação</span>
            </article>
            <article class="rail-stat">
              <span class="rail-stat-label">Críticos</span>
              <span class="rail-stat-value">${snap.alerts.length}</span>
              <span class="rail-stat-meta">${snap.concluded.length} concluídos</span>
            </article>
          </section>
