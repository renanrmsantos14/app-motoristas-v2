    }

    function renderLandscapeMode(main) {
      const useTable = getViewportSize().width >= 820;
      const items = state.reservas.slice();
      $("#section-title").textContent = "Visão compacta";
      $("#section-meta").textContent = `${items.length} serviço(s)`;
      main.innerHTML = `
        <section class="landscape-shell">
          <div class="landscape-head">
            <div>
              <strong>${escapeHtml(formatDateLong(state.date))}</strong>
              <span>${escapeHtml(state.motoristaName)} · ${escapeHtml(state.sortOrder === "saida_desc" ? "Saída decrescente" : "Saída crescente")}</span>
            </div>
          </div>
          ${useTable ? renderLandscapeTable(items) : renderLandscapeGallery(items)}
        </section>`;
    }

    function renderLandscapeTable(items) {
      return `<div class="landscape-table-wrap">
        <div class="landscape-table-scroll">
          <table class="landscape-table">
            <thead>
              <tr>
                <th style="width:4px;padding:0"></th>
                <th style="width:88px">Saída</th>
                <th>Motorista</th>
                <th>Veículo</th>
                <th>Trajeto</th>
                <th>Solicitante</th>
                <th>Passageiros</th>
              </tr>
            </thead>
