    function consumeBackdropDismiss(e) {
      e.preventDefault();
      e.stopPropagation();
      if (typeof e.stopImmediatePropagation === "function") e.stopImmediatePropagation();
      if (e.type === "pointerdown") state.suppressNextPopupClick = true;
      if (e.type === "click" && state.suppressNextPopupClick) state.suppressNextPopupClick = false;
      closeAllOverlays();
    }

    function captureOutsidePopupDismiss(e) {
      if (e.type === "click" && state.suppressNextPopupClick) {
        state.suppressNextPopupClick = false;
        e.preventDefault();
        e.stopPropagation();
        if (typeof e.stopImmediatePropagation === "function") e.stopImmediatePropagation();
        return;
      }

      const sheetOpen = $("#sheet").classList.contains("open");
      const pickerOpen = $("#picker").classList.contains("open");
      if (!sheetOpen && !pickerOpen) return;

      const sheet = $("#sheet");
      const picker = $("#picker");
      const clickedInsideSheet = sheetOpen && sheet.contains(e.target);
      const clickedInsidePicker = pickerOpen && picker.contains(e.target);

      if (clickedInsideSheet || clickedInsidePicker) return;

      e.preventDefault();
      e.stopPropagation();
      if (typeof e.stopImmediatePropagation === "function") e.stopImmediatePropagation();
      if (e.type === "pointerdown") state.suppressNextPopupClick = true;
      closeAllOverlays();
    }

    function isSplitDetailMode() {
      return !isLandscapeCompactMode() && getViewportSize().width >= 860;
