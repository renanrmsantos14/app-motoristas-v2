    .pax-item .pax-phone { font-size: 10.5px; color: var(--text-2); }
    .pax-item .pax-address { display: flex; align-items: flex-start; gap: 3px; font-size: 10px; color: var(--text-3); margin-top: 2px; line-height: 1.3; }
    .pax-item .pax-address svg { width: 9px; height: 9px; flex-shrink: 0; margin-top: 1px; }
    .pax-source-tag { margin-left: 6px; padding: 1px 5px; border-radius: 4px; font-size: 9px; font-weight: 700; background: var(--info-bg); color: var(--info); text-transform: uppercase; letter-spacing: .04em; vertical-align: middle; }

    /* Alturas pequenas */
