            <div class="rail-block-title">Ações rápidas</div>
            <div class="rail-actions">
              <button class="rail-action" data-rail-action="refresh">Atualizar</button>
              <button class="rail-action" data-rail-action="filters">Abrir filtros avançados</button>
            </div>
          </section>
