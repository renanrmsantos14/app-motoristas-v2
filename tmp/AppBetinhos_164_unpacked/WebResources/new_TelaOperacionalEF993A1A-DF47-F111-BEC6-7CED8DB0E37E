<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1, viewport-fit=cover" />
  <meta name="theme-color" content="#0078D4" />
  <title>Operacional · Betinhos</title>
  <style>
    :root {
      --primary: #0078D4;
      --primary-dark: #005A9E;
      --primary-light: #E6F2FB;
      --navy: #000E23;
      --navy-2: #0A1B36;
      --bg: #F8FAFB;
      --bg-elev: #FFFFFF;
      --card: #FFFFFF;
      --card-hover: #F9FAFB;
      --text: #1A202C;
      --text-2: #4A5568;
      --text-3: #A0AEC0;
      --border: #E2E8F0;
      --border-soft: #F0F4F8;
      --success: #10B981;
      --success-bg: #ECFDF5;
      --warning: #F59E0B;
      --warning-bg: #FFFBEB;
      --danger: #EF4444;
      --danger-bg: #FEF2F2;
      --info: #3B82F6;
      --info-bg: #EFF6FF;
      --purple: #8B5CF6;
      --purple-bg: #F5F3FF;
      --orange: #F97316;
      --orange-bg: #FFF7ED;
      --teal: #14B8A6;
      --teal-bg: #F0FDFA;
      --shadow-xs: 0 1px 2px rgba(0,0,0,.04);
      --shadow-sm: 0 2px 4px rgba(0,0,0,.06);
      --shadow-md: 0 4px 12px rgba(0,0,0,.08);
      --shadow-lg: 0 12px 32px rgba(0,0,0,.12);
      --radius-sm: 8px;
      --radius: 12px;
      --radius-lg: 16px;
      --radius-xl: 22px;
      --safe-bottom: env(safe-area-inset-bottom, 0px);
      --safe-top: env(safe-area-inset-top, 0px);
      --vvh: 100dvh;
      --vvw: 100vw;
    }

    * { box-sizing: border-box; -webkit-tap-highlight-color: transparent; }
    html, body {
      margin: 0; padding: 0;
      background: var(--bg);
      color: var(--text);
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", "Roboto", "Helvetica Neue", Arial, sans-serif;
      font-size: 14px;
      line-height: 1.5;
      -webkit-font-smoothing: antialiased;
      overscroll-behavior-y: none;
    }
    body { min-height: 100vh; min-height: 100dvh; }
    button { font-family: inherit; cursor: pointer; border: none; background: none; padding: 0; color: inherit; }
    input, select { font-family: inherit; }

    /* HEADER */
    .app-header {
      position: sticky; top: 0; z-index: 50;
      background: linear-gradient(135deg, var(--navy) 0%, var(--navy-2) 100%);
      color: #fff;
      padding-top: var(--safe-top);
      box-shadow: var(--shadow-md);
      transition: transform .2s ease, box-shadow .15s ease;
    }
    .app-header.compact {
      transform: translateY(calc(-1 * (44px + var(--safe-top))));
      box-shadow: 0 4px 16px rgba(0,0,0,.12);
    }
    .header-row {
      display: flex; align-items: center; gap: 8px;
      padding: 8px 10px 6px;
    }
    .header-actions {
      display: flex; align-items: center; gap: 4px; flex-shrink: 0;
    }
    .header-title { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 0px; }
    .header-title h1 { margin: 0; font-size: 16px; font-weight: 700; letter-spacing: -.01em; }
    .header-title .sub { font-size: 11px; color: rgba(255,255,255,.7); font-weight: 500; }
    .header-btn {
      width: 36px; height: 36px; border-radius: 8px;
      background: rgba(255,255,255,.12); color: #fff;
      display: inline-flex; align-items: center; justify-content: center;
      transition: all .15s;
      flex-shrink: 0;
    }
    .header-btn:active { background: rgba(255,255,255,.25); transform: scale(0.95); }
    .header-btn svg { width: 18px; height: 18px; }
    .header-filter-btn { display: none; }

    .filter-row {
      display: flex; gap: 8px;
      padding: 10px;
      align-items: stretch;
      flex-wrap: wrap;
      background: rgba(0,0,0,.05);
    }
    .filter-summary-row {
      display: none;
      align-items: center; gap: 6px;
      padding: 0 10px 8px;
      overflow-x: auto;
    }
    @media (min-width: 1200px) {
      .filter-row {
        gap: 10px;
        padding: 12px;
      }
    }
    .filter-summary-btn {
      height: 32px; min-width: auto;
      padding: 0 10px;
      border-radius: 8px;
      background: rgba(255,255,255,.1);
      border: 1px solid rgba(255,255,255,.15);
      color: #fff;
      display: inline-flex; align-items: center; justify-content: center; gap: 6px;
      font-size: 12px; font-weight: 600; letter-spacing: 0;
      flex-shrink: 0;
      white-space: nowrap;
    }
    .filter-summary-btn:active { background: rgba(255,255,255,.2); }
    .filter-summary-btn svg { width: 14px; height: 14px; opacity: .9; }
    .filter-summary-text {
      min-width: 0; flex: 1;
      font-size: 11px; font-weight: 500; color: rgba(255,255,255,.7);
      white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
    }
    .filter-drawer {
      overflow: hidden;
      max-height: 0;
      opacity: 0;
      transition: all .28s ease;
      padding: 0 10px;
    }
    .filter-drawer.open {
      max-height: 150px;
      opacity: 1;
      padding: 0 10px 8px;
    }
    .pill {
      flex: 1; min-width: 0;
      display: flex; align-items: center; gap: 6px;
      background: rgba(255,255,255,.1);
      border: 1px solid rgba(255,255,255,.15);
      color: #fff; padding: 0 8px; height: 32px;
      border-radius: 8px; font-weight: 500; font-size: 12px;
      transition: background .15s;
    }
    .pill:active { background: rgba(255,255,255,.2); }
    .pill svg { width: 14px; height: 14px; flex-shrink: 0; opacity: .85; }
    .pill .pill-label { font-size: 9px; font-weight: 600; opacity: .6; text-transform: uppercase; letter-spacing: .03em; }
    .pill .pill-value { font-size: 12px; font-weight: 600; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .pill > .pill-meta { display: flex; flex-direction: column; min-width: 0; flex: 1; line-height: 1.2; }
    .pill .chev { margin-left: auto; opacity: .6; }
    .hidden-date { position: absolute; opacity: 0; pointer-events: none; width: 0; height: 0; }
    .sort-pill { width: 100%; justify-content: flex-start; }
    .sort-pill .sort-value { margin-left: auto; font-size: 11px; font-weight: 600; opacity: .85; }

    /* VIEW TOGGLE */
    .view-toggle {
      display: none;
    }
    .header-view-toggle {
      display: flex; gap: 2px; margin-left: auto;
    }
    .view-btn {
      height: 28px; width: 60px; border-radius: 6px;
      border: 1px solid rgba(255,255,255,.2);
      background: rgba(255,255,255,.08); color: rgba(255,255,255,.7);
      font-weight: 600; font-size: 11px; letter-spacing: 0;
      transition: all .15s;
      flex-shrink: 0;
    }
    .view-btn:active { background: rgba(255,255,255,.15); }
    .view-btn.active { background: rgba(255,255,255,.25); color: #fff; border-color: rgba(255,255,255,.4); }
    @media (min-width: 720px) { .header-view-toggle { display: none; } }
    body.landscape-compact .header-view-toggle { display: none; }

    /* SECTION BAR */
    .section-bar {
      display: flex; align-items: center; justify-content: space-between;
      padding: 10px 10px 6px;
    }
    .section-bar h2 { margin: 0; font-size: 11px; font-weight: 700; color: var(--text-2); text-transform: uppercase; letter-spacing: .05em; }
    .section-bar .section-meta { font-size: 11px; color: var(--text-3); font-weight: 500; }
    body.landscape-compact .section-bar { padding: 0 10px 4px; display: none; }
    body.landscape-compact .section-bar h2 { font-size: 10px; }
    body.landscape-compact .filter-summary-row { display: none; }
    body.landscape-compact .header-filter-btn { display: inline-flex; }
    body.landscape-compact .header-row { gap: 6px; padding: 6px 8px 4px; }
    body.landscape-compact .app-header.compact { transform: translateY(0); }
    body.landscape-compact .header-title h1 { font-size: 14px; }
    body.landscape-compact .header-title .sub { font-size: 10px; }

    /* ALERT STRIP */
    .alert-strip {
      background: var(--danger-bg); border: 1px solid rgba(239,68,68,.25);
      color: #7f1d1d; border-radius: var(--radius);
      padding: 8px 10px; font-size: 12px; font-weight: 600;
      margin: 0 0 8px;
    }
    .alert-strip ul { margin: 4px 0 0; padding-left: 16px; font-weight: 500; }
    .alert-strip li { margin: 2px 0; }

    /* SUBSECTION */
    .subsection { margin-bottom: 8px; }
    .subsection.empty { display: none; }
    .subsection-header {
      font-size: 10px; font-weight: 700; color: var(--text-3);
      text-transform: uppercase; letter-spacing: .05em;
      margin: 0 4px 6px;
      display: flex; align-items: center; gap: 4px;
      position: sticky; top: 0; background: var(--bg); padding: 4px 4px 2px; z-index: 10;
    }
    @media (min-width: 720px) {
      .subsection-header { position: relative; top: auto; background: transparent; padding: 0 4px 6px; }
    }

    .app-container {
      display: grid;
      grid-template-columns: minmax(0, 1fr);
      gap: 12px;
      min-height: calc(100dvh - var(--safe-top) - var(--safe-bottom));
      width: 100%;
      padding: 10px;
      align-items: start;
    }
    .app-sidebar {
      display: none;
    }
    .app-main-shell {
      min-width: 0;
      display: flex;
      flex-direction: column;
      gap: 10px;
    }
    main {
      padding: 0 0 calc(34px + var(--safe-bottom));
      display: flex;
      flex-direction: column;
      gap: 10px;
      min-height: 0;
      min-width: 0;
    }
    .section-bar {
      padding: 12px 14px;
      border: 1px solid rgba(226,232,240,.9);
      border-radius: 18px;
      background: rgba(255,255,255,.9);
      backdrop-filter: blur(12px);
      box-shadow: var(--shadow-xs);
      gap: 10px;
    }
    .section-bar h2 {
      font-size: 12px;
      letter-spacing: .08em;
      color: #526071;
    }
    .section-bar-right {
      display: flex;
      align-items: center;
      gap: 8px;
      min-width: 0;
    }
    .section-view-toggle {
      display: none;
      align-items: center;
      gap: 4px;
      padding: 4px;
      border-radius: 12px;
      background: #EEF3F8;
      border: 1px solid #D7E1EC;
      flex-shrink: 0;
    }
    .section-meta {
      white-space: nowrap;
    }
    .app-rail-surface {
      display: flex;
      flex-direction: column;
      gap: 12px;
      padding: 16px;
      border-radius: 22px;
      background: linear-gradient(180deg, #FDFEFF 0%, #F3F7FA 100%);
      border: 1px solid #E1EAF2;
      box-shadow: var(--shadow-sm);
    }
    .rail-hero {
      padding: 14px 14px 12px;
      border-radius: 18px;
      color: #fff;
      background: linear-gradient(160deg, #071529 0%, #13325A 68%, #1E5C9C 100%);
      box-shadow: 0 14px 30px rgba(7,21,41,.18);
    }
    .rail-hero h3 {
      margin: 0 0 4px;
      font-size: 15px;
      font-weight: 800;
      letter-spacing: -.02em;
    }
    .rail-hero p {
      margin: 0;
      font-size: 12px;
      color: rgba(255,255,255,.78);
      line-height: 1.45;
    }
    .rail-stats {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 8px;
    }
    .rail-stat {
      padding: 10px 12px;
      border-radius: 16px;
      background: #fff;
      border: 1px solid #E5ECF3;
      box-shadow: var(--shadow-xs);
      min-width: 0;
    }
    .rail-stat-label {
      display: block;
      margin-bottom: 4px;
      font-size: 10px;
      font-weight: 800;
      text-transform: uppercase;
      letter-spacing: .08em;
      color: #7B8899;
    }
    .rail-stat-value {
      display: block;
      font-size: 20px;
      font-weight: 800;
      line-height: 1;
      color: var(--text);
    }
    .rail-stat-meta {
      display: block;
      margin-top: 4px;
      font-size: 11px;
      color: var(--text-2);
    }
    .rail-block {
      display: flex;
      flex-direction: column;
      gap: 8px;
    }
    .rail-block-title {
      font-size: 10px;
      font-weight: 800;
      text-transform: uppercase;
      letter-spacing: .08em;
      color: #7B8899;
    }
    .rail-chip-list {
      display: flex;
      flex-wrap: wrap;
      gap: 6px;
    }
    .rail-chip {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      min-width: 0;
      padding: 8px 10px;
      border-radius: 999px;
      border: 1px solid #DCE6F0;
      background: #fff;
      font-size: 11px;
      font-weight: 700;
      color: var(--text-2);
      white-space: nowrap;
    }
    .rail-chip strong {
      color: var(--text);
      overflow: hidden;
      text-overflow: ellipsis;
    }
    .rail-actions {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 8px;
    }
    .rail-action {
      height: 42px;
      border-radius: 14px;
      padding: 0 12px;
      background: #fff;
      border: 1px solid #DCE6F0;
      color: var(--text);
      font-size: 12px;
      font-weight: 700;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 6px;
      box-shadow: var(--shadow-xs);
    }
    .rail-action:active {
      transform: scale(.98);
      background: #F7FAFD;
    }
    .rail-alerts {
      display: flex;
      flex-direction: column;
      gap: 6px;
    }
    .rail-alert {
      padding: 10px 12px;
      border-radius: 14px;
      background: #FFF7ED;
      border: 1px solid rgba(249,115,22,.16);
      font-size: 11.5px;
      font-weight: 600;
      color: #9A4B16;
      line-height: 1.4;
    }
    .rail-alert.danger {
      background: #FEF2F2;
      border-color: rgba(239,68,68,.16);
      color: #A12E2E;
    }
    .rail-empty {
      padding: 10px 12px;
      border-radius: 14px;
      background: #fff;
      border: 1px dashed #D5E0EA;
      color: var(--text-3);
      font-size: 12px;
    }
    @media (min-width: 860px) {
      .app-container {
        grid-template-columns: minmax(0, 1fr) 340px;
        gap: 14px;
        padding: 12px;
      }
      .section-view-toggle {
        display: inline-flex;
      }
      main {
        padding-bottom: 18px;
      }
    }
    @media (min-width: 1240px) {
      .app-container {
        grid-template-columns: 280px minmax(0, 1fr) 360px;
        gap: 16px;
        padding: 14px;
      }
      .app-sidebar {
        display: block;
        position: sticky;
        top: calc(var(--safe-top) + 76px);
      }
    }
    body.landscape-compact .app-container {
      display: block;
      padding: 0;
    }
    body.landscape-compact .app-sidebar,
    body.landscape-compact .section-view-toggle {
      display: none !important;
    }
    body.landscape-compact main {
      padding: 1px 8px 1px;
      gap: 0;
      height: calc(var(--vvh) - 44px - var(--safe-top) - var(--safe-bottom));
      overflow: hidden;
    }

    /* DRIVER CARD */
    .driver-card {
      background: linear-gradient(180deg, #FFFFFF 0%, #FBFDFF 100%);
      border: 1px solid #E2EAF2;
      border-radius: 22px;
      box-shadow: var(--shadow-sm);
      overflow: hidden;
      transition: box-shadow .15s, border-color .15s, transform .15s;
    }
    .driver-card.has-conflict {
      border-color: rgba(239,68,68,.32);
      box-shadow: 0 0 0 1px rgba(239,68,68,.08), var(--shadow-sm);
    }
    .driver-card.unassigned {
      border-color: rgba(245,158,11,.35);
      box-shadow: 0 0 0 1px rgba(245,158,11,.08), var(--shadow-sm);
    }
    /* cards colapsáveis: services-list oculta por padrão, visível quando expanded */
    .driver-card.collapsible .services-list { display: none; }
    .driver-card.collapsible.expanded .services-list { display: flex; }
    .driver-header {
      display: flex;
      gap: 12px;
      padding: 14px;
      align-items: center;
      width: 100%;
      text-align: left;
    }
    .driver-header:active { background: rgba(246,249,252,.8); }
    .avatar {
      flex-shrink: 0;
      width: 44px;
      height: 44px;
      border-radius: 15px;
      background: linear-gradient(150deg, #0A2345 0%, #1E6AB0 100%);
      color: #fff;
      display: flex;
      align-items: center;
      justify-content: center;
      font-weight: 800;
      font-size: 13px;
      letter-spacing: .02em;
      box-shadow: 0 10px 22px rgba(10,35,69,.18);
    }
    .avatar.unassigned { background: linear-gradient(150deg, #F59E0B 0%, #D97706 100%); }
    .driver-info { flex: 1; min-width: 0; }
    .driver-name {
      font-size: 15px;
      font-weight: 800;
      color: var(--text);
      letter-spacing: -.02em;
      display: flex;
      align-items: center;
      gap: 6px;
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
    }
    .driver-meta {
      margin-top: 3px;
      font-size: 12px;
      color: var(--text-2);
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
    }
    .driver-stats {
      display: flex;
      flex-direction: column;
      align-items: flex-end;
      flex-shrink: 0;
      gap: 2px;
    }
    .driver-stats .count {
      font-size: 18px;
      font-weight: 800;
      color: var(--text);
      letter-spacing: -.03em;
      line-height: 1;
    }
    .driver-stats .count-label {
      font-size: 10px;
      color: var(--text-3);
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: .08em;
    }
    .driver-chev {
      margin-left: 2px;
      color: var(--text-3);
      transition: transform .2s;
      flex-shrink: 0;
    }

    /* SERVICE LIST */
    .services-list {
      display: flex;
      flex-direction: column;
      gap: 10px;
      padding: 0 14px 14px;
      border-top: none;
    }
    .service-item {
      position: relative;
      display: flex;
      gap: 12px;
      padding: 12px;
      width: 100%;
      text-align: left;
      border: 1px solid #E3EAF1;
      border-radius: 20px;
      background: linear-gradient(180deg, #FFFFFF 0%, #F9FBFD 100%);
      align-items: stretch;
      transition: background .15s, border-color .15s, box-shadow .15s, transform .12s;
      box-shadow: var(--shadow-xs);
      overflow: hidden;
    }
    .service-item::before {
      content: "";
      position: absolute;
      left: 0;
      top: 0;
      bottom: 0;
      width: 5px;
      background: #D6DFE8;
    }
    .service-item:last-child { border-bottom: 1px solid #E3EAF1; }
    .service-item:active {
      background: #F6FAFD;
      transform: scale(.997);
    }
    .service-item.is-selected {
      border-color: rgba(0,120,212,.5);
      box-shadow: 0 0 0 3px rgba(0,120,212,.12), 0 10px 26px rgba(15,23,42,.08);
    }
    .service-item[data-urgency="attention"]::before { background: var(--danger); }
    .service-item[data-urgency="in-progress"]::before { background: var(--warning); }
    .service-item[data-urgency="next"]::before { background: var(--info); }
    .service-item[data-urgency="future"]::before { background: #CBD5E1; }
    .service-item[data-urgency="concluded"]::before { background: var(--success); }

    .service-time {
      flex-shrink: 0;
      width: 84px;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      padding: 8px 6px;
      background: #F3F7FB;
      border-radius: 16px;
      border: 1px solid #E4EDF5;
    }
    .service-time .t-from {
      font-size: 18px;
      font-weight: 800;
      color: var(--text);
      letter-spacing: -.04em;
      line-height: 1;
    }
    .service-time .t-arrow {
      color: #7C8A9B;
      font-size: 8px;
      margin: 5px 0 4px;
      line-height: 1;
      text-transform: uppercase;
      letter-spacing: .12em;
      font-weight: 800;
    }
    .service-time .t-to {
      font-size: 11px;
      color: var(--text-2);
      font-weight: 700;
      line-height: 1.2;
      text-align: center;
    }

    .service-body {
      flex: 1;
      min-width: 0;
      display: flex;
      flex-direction: column;
      gap: 8px;
    }
    .service-topline {
      display: flex;
      align-items: flex-start;
      justify-content: space-between;
      gap: 8px;
    }
    .service-type-row {
      display: flex;
      align-items: center;
      gap: 5px;
      flex-wrap: wrap;
      min-width: 0;
    }
    .service-code {
      flex-shrink: 0;
      font-size: 10px;
      font-weight: 800;
      color: #7C8A9B;
      letter-spacing: .08em;
      text-transform: uppercase;
    }

    .type-tag {
      display: inline-flex; align-items: center; gap: 3px; padding: 2px 7px;
      border-radius: 6px; font-size: 10.5px; font-weight: 700;
      white-space: nowrap; max-width: 100%; overflow: hidden; text-overflow: ellipsis;
    }
    .status-tag {
      display: inline-flex; align-items: center; gap: 3px; padding: 2px 7px;
      border-radius: 6px; font-size: 10px; font-weight: 700;
      background: var(--bg); color: var(--text-2);
      text-transform: uppercase; letter-spacing: .03em;
    }
    .status-tag .dot { width: 5px; height: 5px; border-radius: 50%; background: currentColor; }
    .conflict-badge {
      display: inline-flex; align-items: center; gap: 2px; padding: 2px 6px;
