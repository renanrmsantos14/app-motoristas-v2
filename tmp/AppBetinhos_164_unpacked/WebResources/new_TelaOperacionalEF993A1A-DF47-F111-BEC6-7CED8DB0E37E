    function highlightSelectedServices() {
      const selectedId = state.selectedServiceId;
      $$(".service-item, .service-item-landscape").forEach(el => {
        el.classList.toggle("is-selected", !!selectedId && el.dataset.serviceId === selectedId);
      });
