    /* BOTTOM SHEET */
    .sheet-backdrop {
      position: fixed;
      inset: 0;
      background: rgba(15,23,42,.56);
      backdrop-filter: blur(1.5px);
      z-index: 200;
      opacity: 0;
      pointer-events: none;
      transition: opacity .22s ease;
      touch-action: none;
    }
    .sheet-backdrop.open { opacity: 1; pointer-events: auto; }
    .sheet {
      position: fixed; left: 0; right: 0; bottom: 0;
      max-height: calc(100vh - 20px);
      background: var(--card); z-index: 201;
      border-radius: 20px 20px 0 0;
      box-shadow: 0 -10px 40px rgba(0,0,0,.18);
      transform: translateY(100%);
      transition: transform .3s cubic-bezier(.32,.72,0,1);
      display: flex; flex-direction: column; overflow: hidden;
      padding-bottom: var(--safe-bottom);
    }
    .sheet.open { transform: translateY(0); }
    .sheet-handle { flex-shrink: 0; padding: 6px 0 4px; display: flex; justify-content: center; cursor: grab; }
    .sheet-handle::before { content: ""; width: 40px; height: 4px; border-radius: 99px; background: var(--border); }
    .sheet-header { padding: 10px 14px; border-bottom: 1px solid var(--border-soft); }
    .sheet-header-top { display: flex; align-items: flex-start; justify-content: space-between; gap: 10px; }
    .sheet-header-top .sheet-time { flex: 1; }
    .sheet-close-btn { width: 34px; height: 34px; border-radius: 8px; background: var(--bg); color: var(--text-2); display: flex; align-items: center; justify-content: center; transition: background .15s, color .15s, transform .1s; flex-shrink: 0; cursor: pointer; border: 1px solid var(--border); }
    .sheet-close-btn:hover { background: var(--border); color: var(--text); }
    .sheet-close-btn:active { background: var(--primary); color: #fff; transform: scale(0.95); }
    .sheet-header .sheet-time { display: flex; align-items: center; gap: 8px; margin-bottom: 6px; }
    .sheet-header .sheet-time .t { font-size: 20px; font-weight: 800; color: var(--text); letter-spacing: -.02em; line-height: 1; }
    .sheet-header .sheet-time .duration { margin-left: auto; font-size: 10.5px; font-weight: 700; color: var(--text-2); background: var(--bg); padding: 3px 8px; border-radius: 6px; }
    .sheet-header .sheet-tags { display: flex; gap: 3px; flex-wrap: wrap; }
    .sheet-body { overflow-y: auto; padding: 8px 14px 16px; flex: 1; -webkit-overflow-scrolling: touch; display: grid; grid-template-columns: 1fr 1fr; gap: 10px 8px; }
    .sheet-col { display: contents; }
    .field-block { padding: 0; border-bottom: none; }
    .field-block:last-child { border-bottom: none; }
    .field-block.full { grid-column: 1 / -1; }
    .field-label { font-size: 9.5px; color: var(--text-3); font-weight: 700; text-transform: uppercase; letter-spacing: .04em; margin-bottom: 3px; display: flex; align-items: center; gap: 4px; }
    .field-label svg { width: 11px; height: 11px; opacity: .75; }
    .field-value { font-size: 12.5px; color: var(--text); word-break: break-word; white-space: pre-wrap; line-height: 1.35; }
    .field-value.muted { color: var(--text-3); font-style: italic; font-size: 11.5px; }
    .pax-list { display: flex; flex-direction: column; gap: 5px; grid-column: 1 / -1; }
    .pax-item { display: flex; align-items: center; gap: 7px; padding: 7px 9px; background: var(--bg); border-radius: 9px; }
    .pax-item .pax-avatar { width: 26px; height: 26px; border-radius: 50%; background: var(--primary-light); color: var(--primary-dark); display: flex; align-items: center; justify-content: center; font-weight: 700; font-size: 10.5px; flex-shrink: 0; }
    .pax-item .pax-info { flex: 1; min-width: 0; }
