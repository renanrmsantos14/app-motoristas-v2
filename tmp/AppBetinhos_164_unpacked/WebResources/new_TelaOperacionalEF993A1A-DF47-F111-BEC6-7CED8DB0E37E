    function renderDriverMode(main, snap) {
      const groups = state.motoristaId === "ALL" ? state.grouped : state.grouped.filter(g => g.id === state.motoristaId);
      $("#section-title").textContent = state.motoristaId === "ALL" ? "Por motorista" : escapeHtml(state.motoristaName);
      $("#section-meta").textContent = `${groups.length} motorista(s)`;
      const html = [];
      if (snap.alerts.length > 0) html.push(renderAlertStrip(snap.alerts));
      if (state.motoristaId === "ALL" && state.orphan.length > 0) html.push(renderOrphanCard(state.orphan));
      for (const g of groups) html.push(renderDriverCard(g));
