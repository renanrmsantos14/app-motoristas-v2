        ${items.map(s => renderLandscapeCard(s)).join("")}
      </div>`;
    }

    function renderLandscapeCard(s) {
      const statusC = STATUS_COLORS[s.status] || { bg: "var(--bg)", fg: "var(--text-2)" };
      return `<button class="landscape-card service-item-landscape" data-service-id="${s.id}">
