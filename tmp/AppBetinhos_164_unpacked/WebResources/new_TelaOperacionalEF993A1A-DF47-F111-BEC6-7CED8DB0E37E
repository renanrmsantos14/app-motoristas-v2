    body.landscape-compact .sheet-body {
      flex: 1 1 auto;
      min-height: 0;
      display: grid !important;
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      overflow: hidden !important;
    }
    body.landscape-compact .sheet-col {
      min-height: 0;
      overflow-y: auto;
      padding: 8px 10px !important;
      -webkit-overflow-scrolling: touch;
    }
    body.landscape-compact .sheet-col-pax {
      border-left: 1px solid var(--border-soft);
    }
    @media (orientation: landscape) {
      body.landscape-compact .sheet {
        position: fixed !important;
        inset: max(8px, var(--safe-top)) 8px max(8px, var(--safe-bottom)) 8px !important;
        width: auto !important;
        max-width: none !important;
        max-height: none !important;
        height: auto !important;
        transform: none !important;
        opacity: 0;
        pointer-events: none;
        border-radius: 12px !important;
        padding-bottom: 0 !important;
        display: flex;
        flex-direction: column;
        overflow: hidden;
      }
      body.landscape-compact .sheet.open {
        transform: none !important;
        opacity: 1;
        pointer-events: auto;
      }
      body.landscape-compact .sheet-header {
        flex: 0 0 auto;
        padding: 6px 10px !important;
      }
      body.landscape-compact .sheet-header .sheet-time {
        min-width: 0;
      }
      body.landscape-compact .sheet-header .sheet-time .t {
        font-size: 15px !important;
      }
      body.landscape-compact .sheet-header .sheet-time .duration {
        max-width: 48vw;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
      }
      body.landscape-compact .sheet-body {
        flex: 1 1 auto;
        min-height: 0;
