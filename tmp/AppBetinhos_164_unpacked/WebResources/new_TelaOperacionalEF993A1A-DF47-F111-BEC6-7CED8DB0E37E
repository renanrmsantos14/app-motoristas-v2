    @media (min-width: 1180px) and (max-width: 1360px) {
      .app-container {
        grid-template-columns: 236px minmax(0, 1fr) 340px;
      }
      .rail-hero h3 {
        font-size: 13px;
      }
      .service-body {
        grid-template-columns: 1fr;
      }
      .service-route {
        grid-column: 1;
        grid-row: auto;
      }
      .service-meta-grid {
        grid-column: 1;
        grid-row: auto;
        grid-template-columns: repeat(2, minmax(0, 1fr));
      }
    }

    body.landscape-compact {
      background: var(--bg);
    }
    body.landscape-compact,
    body.landscape-compact .app-header,
    body.landscape-compact .app-container {
      width: var(--vvw);
      max-width: var(--vvw);
    }
