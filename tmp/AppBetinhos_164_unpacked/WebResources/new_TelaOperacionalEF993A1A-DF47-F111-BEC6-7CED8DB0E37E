    function buildSnapshot(now) {
      const services = state.reservas.slice().sort((a,b) => (a.saida.getTime()||0) - (b.saida.getTime()||0));
      const inProgress=[], upcoming=[], delayed=[], concluded=[], noDriver=[], next2h=[], alerts=[];
      const attentionById = new Map();

      for (const s of services) {
        const info = getServiceState(s, now);
        if (info.kind === "in_progress") inProgress.push(s);
        if (info.kind === "upcoming")    upcoming.push(s);
        if (info.kind === "delayed")     delayed.push(s);
        if (info.kind === "concluded")   concluded.push(s);
        if (!s.motoristaId && info.kind !== "concluded") noDriver.push(s);
        if (info.kind === "upcoming" && info.minutes <= 120) next2h.push(s);

        if (!s.motoristaId && info.kind === "upcoming" && info.minutes <= 30) {
          alerts.push({ priority: 1, message: `${formatHour(s.saida)} — sem motorista designado` });
          attentionById.set(s.id, s);
        }
        if (isStatusOpen(normalizeStatus(s.status)) && info.kind === "upcoming" && info.minutes <= 30) {
          alerts.push({ priority: 2, message: `${formatHour(s.saida)} — em aberto com saída em <30min` });
          attentionById.set(s.id, s);
        }
        if (info.kind === "delayed") {
          alerts.push({ priority: 2, message: `${formatHour(s.saida)} — saída atrasada` });
          attentionById.set(s.id, s);
        }
      }

      for (const g of state.grouped) {
        for (const gap of g.closeIntervals) {
          alerts.push({ priority: 3, message: `${escapeHtml(g.name)}: duas saídas em ${gap.diff}min` });
          attentionById.set(gap.a.id, gap.a);
          attentionById.set(gap.b.id, gap.b);
        }
      }

      alerts.sort((a,b) => a.priority - b.priority);
      const attention = Array.from(attentionById.values()).sort((a,b) => (a.saida.getTime()||0) - (b.saida.getTime()||0));

      return {
        inProgress, upcoming, delayed, concluded, noDriver, next2h, alerts, attention,
        nextHour:  upcoming.filter(s => { const m = getServiceState(s,now).minutes; return m >= 0 && m <= 60; }),
        afternoon: upcoming.filter(s => { const m = getServiceState(s,now).minutes; const h = s.saida.getHours()||0; return m > 60 && h < 18; }),
        night:     upcoming.filter(s => { const m = getServiceState(s,now).minutes; const h = s.saida.getHours()||0; return m > 60 && h >= 18; })
      };
    }

    function getDriverBadge(group) {
      const now = new Date();
      const inProgress = group.services.filter(s => getServiceState(s,now).kind === "in_progress")
        .sort((a,b) => (a.saida.getTime()||0) - (b.saida.getTime()||0));
      if (inProgress.length > 0) {
        const since = formatHour(inProgress[0].saida) || "--:--";
        return { tone: "warning", label: "Em serviço", meta: `Desde ${since}` };
      }
      const upcoming = group.services.filter(s => getServiceState(s,now).kind === "upcoming")
        .sort((a,b) => (a.saida.getTime()||0) - (b.saida.getTime()||0));
      if (upcoming.length > 0) {
        const next = formatHour(upcoming[0].saida) || "--:--";
        return { tone: "info", label: `Próximo ${next}`, meta: `Próxima saída às ${next}` };
      }
      const done = group.services.filter(s => getServiceState(s,now).kind === "concluded")
        .sort((a,b) => (b.saida.getTime()||0) - (a.saida.getTime()||0));
      if (done.length > 0) {
        const last = formatHour(done[0].saida) || "--:--";
        return { tone: "success", label: "Livre", meta: `Último concluído ${last}` };
      }
      return { tone: "success", label: "Livre", meta: "Sem serviços ativos" };
    }

    function getServiceState(svc, now) {
      if (!svc.saida) return { kind: "unknown", text: "sem horário", short: "—  ", tone: "info", minutes: Number.MAX_SAFE_INTEGER };
      const status   = normalizeStatus(svc.status);
      const deltaMin = Math.round((svc.saida - now) / 60000);

      if (isStatusConcluded(status))   return { kind: "concluded",  text: "concluí­do",  short: "",  tone: "success", minutes: Number.MAX_SAFE_INTEGER };
      if (isStatusInProgress(status)) {
        const elapsed = Math.max(0, Math.round((now - svc.saida) / 60000));
        return { kind: "in_progress", text: `em serviço há ${fmt(elapsed)}`, short: `+${fmt(elapsed)}`, tone: "warning", minutes: -elapsed };
      }
      if (deltaMin >= 0) {
        return { kind: "upcoming", text: `sai em ${fmt(deltaMin)}`, short: `-${fmt(deltaMin)}`, tone: deltaMin <= 30 ? "warning" : "info", minutes: deltaMin };
      }
      if (isStatusScheduled(status)) {
        const elapsed = Math.abs(deltaMin);
        return { kind: "in_progress", text: `saiu há ${fmt(elapsed)} — sem conclusão`, short: `+${fmt(elapsed)}`, tone: "warning", minutes: -elapsed };
      }
      const late = Math.abs(deltaMin);
      return { kind: "delayed", text: `atrasado ${fmt(late)}`, short: `+${fmt(late)}`, tone: "danger", minutes: -late };
    }

    function normalizeStatus(v) {
      return String(v||"").normalize("NFD").replace(/[̀-ͯ]/g,"").trim().toLowerCase();
    }
    function isStatusInProgress(s) { return s==="em operacao"||s==="em andamento"||s==="em execucao"; }
    function isStatusScheduled(s)  { return ["programado","confirmada","confirmado","pre-reserva","solicitado","requer analise","em aberto","aberta"].includes(s); }
    function isStatusConcluded(s)  { return ["concluida","concluido","finalizada","cancelada","cancelado","cancelado com ressalvas"].includes(s); }
    function isStatusOpen(s)       { return ["em aberto","aberta","solicitado","requer analise","pre-reserva"].includes(s); }

    function fmt(totalMin) {
      const m = Math.max(0, Math.round(totalMin));
      if (m < 60) return `${m}min`;
      const h = Math.floor(m/60), r = m%60;
      return r === 0 ? `${h}h` : `${h}h${String(r).padStart(2,"0")}`;
    }

