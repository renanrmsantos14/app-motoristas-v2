function abrirPainelResumo() {
    console.log("=== INÍCIO DA FUNÇÃO abrirPainelResumo ===");

    try {
        var screenWidth = window.innerWidth;
        var screenHeight = window.innerHeight;

        console.log("🖥️ Resolução detectada:", screenWidth, "x", screenHeight);

        var isSmallScreen = screenWidth < 768;

        var finalWidth  = isSmallScreen ? screenWidth  : 600;
        var finalHeight = isSmallScreen ? screenHeight : Math.floor(screenHeight * 0.85);

        console.log("📏 Width final:", finalWidth, "px");
        console.log("📏 Height final:", finalHeight, "px");
        console.log("📱 Tela pequena?", isSmallScreen);

        var pageInput = {
            pageType: "custom",
            name: "cr40f_funesoperacionais_d5e5a",
            entityName: "cr40f_reservadeveculos"
        };

        var navigationOptions = {
            target: 2,
            width:  { value: finalWidth,  unit: "px" },
            height: { value: finalHeight, unit: "px" },
            position: 1
        };

        console.log("📦 pageInput:", JSON.stringify(pageInput));
        console.log("📦 navigationOptions:", JSON.stringify(navigationOptions));
        console.log("🚀 Chamando Xrm.Navigation.navigateTo...");

        if (!Xrm) {
            console.error("❌ Xrm não está disponível!");
            return;
        }
        if (!Xrm.Navigation) {
            console.error("❌ Xrm.Navigation não está disponível!");
            return;
        }
        if (!Xrm.Navigation.navigateTo) {
            console.error("❌ Xrm.Navigation.navigateTo não está disponível!");
            return;
        }

        Xrm.Navigation.navigateTo(pageInput, navigationOptions).then(
            function() {
                console.log("✅ Popup aberto com sucesso!");
            },
            function(error) {
                console.error("❌ Erro no .then rejection:", error);
                console.error("❌ error.message:", error && error.message);
                console.error("❌ error.code:", error && error.code);
                console.error("❌ JSON completo:", JSON.stringify(error));
                Xrm.Navigation.openAlertDialog({
                    text: "Erro ao abrir a página: " + (error && error.message ? error.message : JSON.stringify(error)),
                    title: "Erro"
                });
            }
        ).catch(function(ex) {
            console.error("❌ Erro no .catch:", ex);
            console.error("❌ ex.message:", ex && ex.message);
            console.error("❌ JSON completo:", JSON.stringify(ex));
        });

    } catch (ex) {
        console.error("❌ Exceção geral capturada:", ex);
        console.error("❌ ex.message:", ex && ex.message);
        console.error("❌ ex.stack:", ex && ex.stack);
    }

    console.log("=== FIM DA FUNÇÃO abrirPainelResumo ===");
}