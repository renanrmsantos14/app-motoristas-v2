        function mostrarStatus(tipo, titulo, mensagem) {
            const statusMessage = document.getElementById('statusMessage');
            const statusTitle = document.getElementById('statusTitle');
            const statusText = document.getElementById('statusText');
            const statusIcon = statusMessage.querySelector('.status-icon');
            
            statusMessage.className = 'status-message';
            statusMessage.classList.add(tipo);
            statusMessage.classList.add('active');
            
            statusTitle.textContent = titulo;
            statusText.textContent = mensagem;
            
            const icones = {
                'success': 'fa-check-circle',
                'error': 'fa-exclamation-circle',
                'warning': 'fa-exclamation-triangle',
                'info': 'fa-info-circle'
            };
            
            statusIcon.className = `status-icon fas ${icones[tipo] || 'fa-info-circle'}`;
            
            if (tipo !== 'error') {
                setTimeout(() => {
                    statusMessage.classList.remove('active');
                }, 5000);
            }
        }

        function mostrarLoading(mostrar, mensagem = 'Processando sua solicitação...') {
            const loadingOverlay = document.getElementById('loadingOverlay');
            const loadingText = document.getElementById('loadingText');
            
            if (mostrar) {
                loadingText.textContent = mensagem;
                loadingOverlay.classList.add('active');
            } else {
                loadingOverlay.classList.remove('active');
            }
        }

        function mostrarErroValidacao(campoId, mensagem) {
            const campo = document.getElementById(campoId);
            const erroElement = document.getElementById(`${campoId}Error`);
            
            if (campo) campo.classList.add('error');
            if (erroElement) {
                erroElement.textContent = mensagem;
                erroElement.classList.add('active');
            }
        }

        function limparErrosValidacao() {
            document.querySelectorAll('.form-control.error').forEach(campo => {
                campo.classList.remove('error');
            });
            
            document.querySelectorAll('.validation-error.active').forEach(erro => {
                erro.classList.remove('active');
            });
        }

        function validarCampo(event) {
            const campo = event.target;
            const campoId = campo.id;
            
            campo.classList.remove('error');
            const erroElement = document.getElementById(`${campoId}Error`);
            if (erroElement) erroElement.classList.remove('active');
            
            return true;
        }

