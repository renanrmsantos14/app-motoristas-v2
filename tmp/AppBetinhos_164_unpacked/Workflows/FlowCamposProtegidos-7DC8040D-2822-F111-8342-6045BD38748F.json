              "inputs": "@if(\r\n  empty(trim(string(outputs('Compose_ProtegidosAtual')))),\r\n  body('Select_NomesCamposMudaram'),\r\n  union(\r\n    split(string(outputs('Compose_ProtegidosAtual')), ','),\r\n    body('Select_NomesCamposMudaram')\r\n  )\r\n)",
              "runAfter": {
