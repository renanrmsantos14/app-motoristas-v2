{
  "properties": {
    "connectionReferences": {
      "shared_commondataserviceforapps": {
        "api": {
          "name": "shared_commondataserviceforapps"
        },
        "connection": {
          "connectionReferenceLogicalName": "new_sharedcommondataserviceforapps_8b47d"
        },
        "runtimeSource": "embedded"
      },
      "shared_office365": {
        "api": {
          "name": "shared_office365"
        },
        "connection": {
          "connectionReferenceLogicalName": "new_sharedoffice365_de4c0"
        },
        "runtimeSource": "embedded"
      }
    },
    "definition": {
      "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
      "contentVersion": "1.0.0.0",
      "parameters": {
        "$authentication": {
          "defaultValue": {},
          "type": "SecureObject"
        },
        "$connections": {
          "defaultValue": {},
          "type": "Object"
        }
      },
      "triggers": {
        "Recurrence": {
          "type": "Recurrence",
          "recurrence": {
            "interval": 1,
            "frequency": "Day",
            "timeZone": "E. South America Standard Time",
            "schedule": {
              "hours": [
                "10"
              ]
            }
          }
        }
      },
      "actions": {
        "Initialize_variable_varDia2": {
          "type": "InitializeVariable",
          "inputs": {
            "variables": [
              {
                "name": "varDia2",
                "type": "string",
                "value": "@formatDateTime(addDays(utcNow(), 2), 'yyyy-MM-dd')"
              }
            ]
          },
          "runAfter": {}
        },
        "Initialize_variable_varDia5": {
          "type": "InitializeVariable",
          "inputs": {
            "variables": [
              {
                "name": "varDia5",
                "type": "string",
                "value": "@formatDateTime(addDays(utcNow(), 5), 'yyyy-MM-dd')"
              }
            ]
          },
          "runAfter": {
            "Initialize_variable_varDia2": [
              "Succeeded"
            ]
          }
        },
        "Scope": {
          "type": "Scope",
          "actions": {
            "List_rows": {
              "type": "OpenApiConnection",
              "inputs": {
                "parameters": {
                  "entityName": "cr40f_multases",
                  "$select": "cr40f_id_multa,\ncr40f_dataehorario,\ncr40f_dataparaindicar,\ncr40f_status,\n_cr40f_placa_value,\n_cr40f_motorista_value\n",
                  "$filter": "cr40f_status eq 202410000",
                  "$expand": "cr40f_Placa,cr40f_Motorista\n"
                },
                "host": {
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps",
                  "operationId": "ListRecords",
                  "connectionName": "shared_commondataserviceforapps"
                }
              }
            },
            "Filter_array": {
              "type": "Query",
              "inputs": {
                "from": "@outputs('List_rows')?['body/value']",
                "where": "@and(\r\n  not(equals(item()?['cr40f_dataparaindicar'], null)),\r\n  not(empty(string(item()?['cr40f_dataparaindicar']))),\r\n\r\n  or(\r\n    equals(int(coalesce(item()?['cr40f_status'], -1)), 202410000),\r\n    equals(int(coalesce(item()?['cr40f_status'], -1)), 202410004)\r\n  ),\r\n\r\n  or(\r\n    equals(\r\n      formatDateTime(item()?['cr40f_dataparaindicar'], 'yyyy-MM-dd'),\r\n      variables('varDia2')\r\n    ),\r\n    equals(\r\n      formatDateTime(item()?['cr40f_dataparaindicar'], 'yyyy-MM-dd'),\r\n      variables('varDia5')\r\n    )\r\n  )\r\n)\r\n"
              },
              "runAfter": {
                "List_rows": [
                  "Succeeded"
                ]
              }
            },
            "Condition_existe_item": {
              "type": "If",
              "expression": {
                "and": [
                  {
                    "greater": [
                      "@length(body('Filter_array'))",
                      0
                    ]
                  }
                ]
              },
              "actions": {
                "Create_HTML_table": {
                  "type": "Table",
                  "inputs": {
                    "from": "@body('Filter_array')",
                    "format": "HTML",
                    "columns": [
                      {
                        "header": "ID",
                        "value": "@item()?['cr40f_id_multa']"
                      },
                      {
                        "header": "Data da Multa",
                        "value": "@formatDateTime(item()?['cr40f_dataehorario'], 'dd/MM/yyyy hh:mm')"
                      },
                      {
                        "header": "Data Limite",
                        "value": "@formatDateTime(item()?['cr40f_dataparaindicar'], 'dd/MM/yyyy')"
                      },
                      {
                        "header": "Placa",
                        "value": "@coalesce(\r\n  item()?['cr40f_Placa']?['cr40f_placa'],\r\n  item()?['_cr40f_placa_value@OData.Community.Display.V1.FormattedValue'],\r\n  '-'\r\n)\r\n"
                      },
                      {
                        "header": "Condutor",
                        "value": "@coalesce(\r\n  item()?['cr40f_Motorista']?['cr40f_nomecompleto'],\r\n  item()?['_cr40f_motorista_value@OData.Community.Display.V1.FormattedValue'],\r\n  '-'\r\n)\r\n"
                      },
                      {
                        "header": "Status",
                        "value": "@coalesce(\r\n  item()?['cr40f_status@OData.Community.Display.V1.FormattedValue'],\r\n  string(item()?['cr40f_status']),\r\n  '-'\r\n)\r\n"
                      }
                    ]
                  }
                },
                "Send_an_email_(V2)": {
                  "type": "OpenApiConnection",
                  "inputs": {
                    "parameters": {
                      "emailMessage/To": "noreply@betinhos.onmicrosoft.com, junior@betinhos.com.br",
                      "emailMessage/Subject": "LEMBRETE: Multas Pendentes",
                      "emailMessage/Body": "<div style=\"font-family:Segoe UI, Arial; font-size:13px\">\n  <p style=\"margin:0 0 12px 0\">\n    Olá Júnior,<br><br>\n    Segue abaixo a lista de <strong>multas pendentes:</strong>\n  </p>\n\n  <div style=\"overflow-x:auto; border:1px solid #e6e6e6; border-radius:8px\">\n\n    <div>\n      @{outputs('Compose_Tabela_Estilo')}\n    </div>\n  </div>\n\n  <p style=\"margin:12px 0 0 0; font-size:12px; color:#777\">\n    Aviso automático — Betinhos Executive Service\n  </p>\n</div>\n",
                      "emailMessage/From": "noreply@betinhos.com.br",
                      "emailMessage/Importance": "High"
                    },
                    "host": {
                      "apiId": "/providers/Microsoft.PowerApps/apis/shared_office365",
                      "operationId": "SendEmailV2",
                      "connectionName": "shared_office365"
                    }
                  },
                  "runAfter": {
                    "Compose_Tabela_Estilo": [
                      "Succeeded"
                    ]
                  }
                },
                "Compose_Tabela_Estilo": {
                  "type": "Compose",
                  "inputs": "@replace(\r\n  replace(\r\n    replace(\r\n      replace(\r\n        string(body('Create_HTML_table')),\r\n        '<table>',\r\n        '<table style=\"border-collapse:collapse;width:100%;font-size:13px;background:#fff\">'\r\n      ),\r\n      '<th>',\r\n      '<th style=\"background:#2F80ED;color:#fff;padding:10px;text-align:left;border-bottom:1px solid #1f6fd1\">'\r\n    ),\r\n    '<td>',\r\n    '<td style=\"padding:10px;border-bottom:1px solid #eee;vertical-align:top\">'\r\n  ),\r\n  '<tr>',\r\n  '<tr style=\"border-bottom:1px solid #eee\">'\r\n)\r\n",
                  "runAfter": {
                    "Create_HTML_table": [
                      "Succeeded"
                    ]
                  }
                }
              },
              "else": {
                "actions": {}
              },
              "runAfter": {
                "Filter_array": [
                  "Succeeded"
                ]
              }
            }
          },
          "runAfter": {
            "Initialize_variable_varDia5": [
              "Succeeded"
            ]
          }
        },
        "Scope_1": {
          "type": "Scope",
          "actions": {
            "Send_an_email_(V2)_1": {
              "type": "OpenApiConnection",
              "inputs": {
                "parameters": {
                  "emailMessage/To": "noreply@betinhos.onmicrosoft.com; financeiro@betinhos.com..br; junior@betinhos.com.br",
                  "emailMessage/Subject": "ERRO NO FLUXO - Lembrete Multa Não Indicada",
                  "emailMessage/Body": "<p class=\"editor-paragraph\">Ocorreu um erro ao Lembrete Multa Não Indicada.</p>",
                  "emailMessage/From": "noreply@betinhos.com.br",
                  "emailMessage/Importance": "Normal"
                },
                "host": {
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_office365",
                  "operationId": "SendEmailV2",
                  "connectionName": "shared_office365"
                }
              }
            },
            "Terminate_1": {
              "type": "Terminate",
              "inputs": {
                "runStatus": "Failed",
                "runError": {
                  "code": "400"
                }
              },
              "runAfter": {
                "Send_an_email_(V2)_1": [
                  "Succeeded"
                ]
              }
            }
          },
          "runAfter": {
            "Scope": [
              "TimedOut",
              "Skipped",
              "Failed"
            ]
          }
        }
      },
      "outputs": {}
    },
    "templateName": null
  },
  "schemaVersion": "1.0.0.0"
}