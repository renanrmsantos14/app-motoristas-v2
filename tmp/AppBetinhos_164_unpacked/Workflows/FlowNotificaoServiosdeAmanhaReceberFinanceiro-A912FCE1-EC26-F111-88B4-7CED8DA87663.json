          "name": "shared_commondataserviceforapps"
        }
      },
      "shared_office365": {
        "runtimeSource": "embedded",
        "connection": {
          "connectionReferenceLogicalName": "new_sharedoffice365_f87d5"
        },
        "api": {
          "name": "shared_office365"
        }
      }
    },
    "definition": {
      "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
      "contentVersion": "1.0.0.0",
      "parameters": {
        "$authentication": {
          "defaultValue": {},
          "type": "SecureObject"
        },
        "$connections": {
          "defaultValue": {},
          "type": "Object"
        }
      },
      "triggers": {
        "Recurrence": {
          "recurrence": {
            "interval": 1,
            "frequency": "Day",
            "timeZone": "E. South America Standard Time",
            "schedule": {
              "hours": [
                "15"
              ]
            }
          },
          "evaluatedRecurrence": {
            "interval": 1,
            "frequency": "Day",
            "timeZone": "E. South America Standard Time",
            "schedule": {
              "hours": [
                "15"
              ]
            }
          },
          "type": "Recurrence"
        }
      },
      "actions": {
        "Scope": {
          "actions": {
            "Condition_é_pra_rodar": {
              "actions": {
                "List_rows_funcionários_Notifcação_Financeira": {
                  "runAfter": {
                    "Compose_body_email": [
                      "Succeeded"
                    ]
                  },
                  "type": "OpenApiConnection",
                  "inputs": {
                    "parameters": {
                      "entityName": "cr40f_funcionarioses",
                      "$select": "cr40f_emailmicrosoft, cr40f_emailbetinhos",
                      "$filter": "new_notificacoesfinanceiras eq true",
                      "accept": "application/json;odata.metadata=minimal"
                    },
                    "host": {
                      "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps",
                      "connectionName": "shared_commondataserviceforapps-1",
                      "operationId": "ListRecords"
                    },
                    "authentication": "@parameters('$authentication')"
                  }
                },
                "For_each_Notificação_Financeira": {
                  "foreach": "@outputs('List_rows_funcionários_Notifcação_Financeira')?['body/value']",
                  "actions": {
                    "Send_an_email_(V2)": {
                      "type": "OpenApiConnection",
                      "inputs": {
                        "parameters": {
                          "emailMessage/To": "@items('For_each_Notificação_Financeira')?['cr40f_emailbetinhos']",
                          "emailMessage/Subject": "@if(equals(outputs('Compose_é_sexta'), true), 'Serviços a Receber do Final de Semana', 'Serviços a Receber de Amanhã')",
                          "emailMessage/Body": "@outputs('Compose_body_email')",
                          "emailMessage/From": "noreply@betinhos.com.br",
                          "emailMessage/Importance": "High"
                        },
                        "host": {
                          "apiId": "/providers/Microsoft.PowerApps/apis/shared_office365",
                          "connectionName": "shared_office365",
                          "operationId": "SendEmailV2"
                        },
                        "authentication": "@parameters('$authentication')"
                      }
                    }
                  },
                  "runAfter": {
                    "List_rows_funcionários_Notifcação_Financeira": [
                      "Succeeded"
                    ]
                  },
                  "type": "Foreach"
                },
                "Apply_to_each": {
                  "foreach": "@outputs('List_rows_Geral')?['body/value']",
                  "actions": {
                    "Append_to_string_variable": {
                      "type": "AppendToStringVariable",
                      "inputs": {
                        "name": "varLinhasTabela",
                        "value": "<tr style=\"border-bottom: 2px solid #e2e8f0;\">\n  <td style=\"padding: 20px 16px; color: #0f172a; font-size: 14px; font-weight: 700; line-height: 1.6; vertical-align: top;\"><span class=\"mobile-label\">ID</span>@{items('Apply_to_each')?['cr40f_id']}</td>\n  <td style=\"padding: 20px 16px; color: #334155; font-size: 14px; line-height: 1.6; vertical-align: top;\"><span class=\"mobile-label\">STATUS</span>@{items('Apply_to_each')?['cr40f_status@OData.Community.Display.V1.FormattedValue']}</td>\n  <td style=\"padding: 20px 16px; color: #334155; font-size: 14px; line-height: 1.6; vertical-align: top;\"><span class=\"mobile-label\">DATA E HORÁRIO DE SAÍDA</span>@{items('Apply_to_each')?['cr40f_dataehorriodesada@OData.Community.Display.V1.FormattedValue']}</td>\n  <td style=\"padding: 20px 16px; color: #334155; font-size: 14px; line-height: 1.6; vertical-align: top;\"><span class=\"mobile-label\">HORÁRIO DE RETORNO</span>@{if(empty(items('Apply_to_each')?['cr40f_horrioprevistoderetorno']), '', items('Apply_to_each')?['cr40f_horrioprevistoderetorno@OData.Community.Display.V1.FormattedValue'])}</td>\n  <td style=\"padding: 20px 16px; color: #334155; font-size: 14px; line-height: 1.6; vertical-align: top; word-wrap: break-word;\"><span class=\"mobile-label\">OBSERVAÇÃO</span>@{trim(concat(coalesce(items('Apply_to_each')?['cr40f_obsdeoperao'], ''), if(empty(items('Apply_to_each')?['cr40f_observaointerna']), '', concat(' - ', items('Apply_to_each')?['cr40f_observaointerna']))))}</td>\n  <td style=\"padding: 20px 16px; color: #334155; font-size: 14px; line-height: 1.6; vertical-align: top; word-wrap: break-word;\"><span class=\"mobile-label\">PASSAGEIROS</span>@{items('Apply_to_each')?['cr40f_passageirosetelefonedecontato']}</td>\n  <td style=\"padding: 20px 16px; color: #334155; font-size: 14px; line-height: 1.6; vertical-align: top; word-wrap: break-word;\"><span class=\"mobile-label\">TRAJETO</span>@{items('Apply_to_each')?['cr40f_trajeto']}</td>\n  <td style=\"padding: 20px 16px; color: #334155; font-size: 14px; line-height: 1.6; vertical-align: top; word-wrap: break-word;\"><span class=\"mobile-label\">ENDEREÇO DE SAÍDA</span>@{items('Apply_to_each')?['cr40f_endereodesada']}</td>\n  <td style=\"padding: 20px 16px; color: #334155; font-size: 14px; line-height: 1.6; vertical-align: top; word-wrap: break-word; max-width: 300px;\"><span class=\"mobile-label\">DESTINO</span>@{items('Apply_to_each')?['cr40f_destino']}</td>\n  <td style=\"padding: 20px 16px; color: #334155; font-size: 14px; line-height: 1.6; vertical-align: top;\"><span class=\"mobile-label\">RECEBER</span>@{items('Apply_to_each')?['cr40f_receber@OData.Community.Display.V1.FormattedValue']}</td>\n</tr>"
                      }
                    }
