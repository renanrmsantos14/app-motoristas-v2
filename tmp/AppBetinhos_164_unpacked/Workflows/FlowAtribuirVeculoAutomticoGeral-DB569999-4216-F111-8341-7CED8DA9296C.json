    "definition": {
      "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
      "contentVersion": "1.0.0.0",
      "parameters": {
        "$authentication": {
          "defaultValue": {},
          "type": "SecureObject"
        },
        "$connections": {
          "defaultValue": {},
          "type": "Object"
        }
      },
      "triggers": {
        "When_a_row_is_added,_modified_or_deleted": {
          "type": "OpenApiConnectionWebhook",
          "inputs": {
            "parameters": {
              "subscriptionRequest/message": 4,
              "subscriptionRequest/entityname": "cr40f_reservadeveculos",
              "subscriptionRequest/scope": 4,
              "subscriptionRequest/filteringattributes": "cr40f_motorista",
              "subscriptionRequest/filterexpression": "_cr40f_motorista_value ne null and new_categoriadoitem ne 100000001"
            },
            "host": {
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps",
              "operationId": "SubscribeWebhookTrigger",
              "connectionName": "shared_commondataserviceforapps"
            }
          }
        }
      },
      "actions": {
        "Scope": {
          "type": "Scope",
          "actions": {
            "Get_a_row_by_ID_Funcionarios": {
              "type": "OpenApiConnection",
              "inputs": {
                "parameters": {
                  "entityName": "cr40f_funcionarioses",
                  "recordId": "@triggerOutputs()?['body/_cr40f_motorista_value']"
                },
                "host": {
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps",
                  "operationId": "GetItem",
                  "connectionName": "shared_commondataserviceforapps"
                }
              }
            },
            "List_rows_Posse": {
              "type": "OpenApiConnection",
              "inputs": {
                "parameters": {
                  "entityName": "new_possedeveiculos",
                  "$filter": "_new_motorista_value eq '@{outputs('Get_a_row_by_ID_Funcionarios')?['body/cr40f_funcionariosid']}' and new_fimdaposse eq null",
                  "$top": 1
                },
                "host": {
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps",
                  "operationId": "ListRecords",
                  "connectionName": "shared_commondataserviceforapps"
                }
              },
              "runAfter": {
                "Get_a_row_by_ID_Funcionarios": [
                  "Succeeded"
                ]
              }
            },
            "List_rows_Trocas_de_Carro": {
              "type": "OpenApiConnection",
              "inputs": {
                "parameters": {
                  "entityName": "cr40f_trocasdecarros",
                  "$filter": "(_cr40f_motorista1_value eq '@{outputs('Get_a_row_by_ID_Funcionarios')?['body/cr40f_funcionariosid']}' or _cr40f_motorista2_value eq '@{outputs('Get_a_row_by_ID_Funcionarios')?['body/cr40f_funcionariosid']}') and cr40f_statusdatroca ne 202410002 and cr40f_statusdatroca ne 202410001 and cr40f_iniciodajaneladetroca lt '@{triggerOutputs()?['body/cr40f_dataehorriodesada']}'",
                  "$orderby": "cr40f_iniciodajaneladetroca asc"
                },
                "host": {
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps",
                  "operationId": "ListRecords",
                  "connectionName": "shared_commondataserviceforapps-1"
                }
              },
              "runAfter": {
                "List_rows_Posse": [
                  "Succeeded"
                ]
              }
            },
            "Compose_MotoristaID": {
              "type": "Compose",
              "inputs": "@outputs('Get_a_row_by_ID_Funcionarios')?['body/cr40f_funcionariosid']",
              "runAfter": {
                "List_rows_Trocas_de_Carro": [
                  "SUCCEEDED"
                ]
              }
            },
            "Compose_HorarioServico": {
              "type": "Compose",
              "inputs": "@triggerOutputs()?['body/cr40f_dataehorriodesada']",
              "runAfter": {
                "Compose_MotoristaID": [
                  "SUCCEEDED"
                ]
              }
            },
            "For_each_1": {
              "type": "foreach",
              "foreach": "@outputs('List_rows_Trocas_de_Carro')?['body/value']",
              "actions": {
                "Switch_Tipo_de_Troca": {
                  "type": "Switch",
                  "description": "\nTroca\n100.000.000\nDevolução à base\n100.000.001\nRetirada da base\n100.000.002\n",
                  "expression": "@item()?['new_tipodetroca']",
                  "default": {
                    "actions": {}
                  },
                  "cases": {
                    "Case_Troca": {
                      "actions": {
                        "Condition_Mot1": {
                          "type": "If",
                          "expression": {
                            "and": [
                              {
                                "equals": [
                                  "@outputs('Compose_MotoristaID')",
                                  "@item()?['_cr40f_motorista1_value']"
                                ]
                              }
                            ]
                          },
                          "actions": {
                            "Set_variable_veic": {
                              "type": "SetVariable",
                              "inputs": {
                                "name": "varVeiculoPrevisto",
                                "value": "@item()?['_cr40f_veiculo2antesdatroca_value']"
                              }
                            }
                          },
                          "else": {
                            "actions": {
                              "Condition_Mot2": {
                                "type": "If",
                                "expression": {
                                  "and": [
                                    {
                                      "equals": [
                                        "@outputs('Compose_MotoristaID')",
                                        "@item()?['_cr40f_motorista2_value']"
                                      ]
                                    }
                                  ]
                                },
                                "actions": {
                                  "Set_variable_veiculo": {
                                    "type": "SetVariable",
                                    "inputs": {
                                      "name": "varVeiculoPrevisto",
                                      "value": "@item()?['_cr40f_veiculo1antesdatroca_value']"
                                    }
                                  }
                                },
                                "else": {
                                  "actions": {}
                                }
                              }
                            }
                          }
                        }
                      },
                      "case": 100000000
                    },
                    "Case_Devolução": {
                      "actions": {
                        "Set_variable_veic_2": {
                          "type": "SetVariable",
                          "inputs": {
                            "name": "varVeiculoPrevisto",
                            "value": "@null"
                          }
                        }
                      },
                      "case": 100000001
                    },
                    "Case_Retirada": {
                      "actions": {
                        "Set_variable_veic_3": {
                          "type": "SetVariable",
                          "inputs": {
                            "name": "varVeiculoPrevisto",
                            "value": "@item()?['_cr40f_veiculo2antesdatroca_value']"
                          }
                        }
                      },
                      "case": 100000002
                    }
                  }
                }
              },
              "runAfter": {
                "Set_variable_Veiculo_da_posse": [
                  "SUCCEEDED"
                ]
              }
            },
            "Set_variable_Veiculo_da_posse": {
              "type": "SetVariable",
              "inputs": {
                "name": "varVeiculoPrevisto",
                "value": "@first(outputs('List_rows_Posse')?['body/value'])?['_new_veiculo_value']"
              },
              "runAfter": {
                "Compose_HorarioServico": [
                  "SUCCEEDED"
                ]
              }
            },
            "Update_a_row": {
              "type": "OpenApiConnection",
              "inputs": {
                "parameters": {
                  "entityName": "cr40f_reservadeveculoses",
                  "recordId": "@triggerOutputs()?['body/cr40f_reservadeveculosid']",
                  "item/cr40f_Veiculo@odata.bind": "@if(\n  or(\n    equals(variables('varVeiculoPrevisto'), null),\n    equals(variables('varVeiculoPrevisto'), '')\n  ),\n  null,\n  concat('/cr40f_veiculoses(', variables('varVeiculoPrevisto'), ')')\n)"
                },
                "host": {
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps",
                  "operationId": "UpdateOnlyRecord",
                  "connectionName": "shared_commondataserviceforapps"
                }
              },
              "runAfter": {
                "For_each_1": [
                  "SUCCEEDED"
                ]
              }
            }
          },
          "runAfter": {
            "Initialize_variable_varVeiculoPrevisto": [
              "SUCCEEDED"
            ]
          }
        },
        "Scope_1": {
          "type": "Scope",
          "actions": {
            "Send_an_email_(V2)": {
              "type": "OpenApiConnection",
              "inputs": {
                "parameters": {
                  "emailMessage/To": "junior@betinhos.com.br;renan.mendonca@betinhos.com.br;noreply@betinhos.onmicrosoft.com",
                  "emailMessage/Subject": "ERRO NO FLOW - Flow Atribuir Veículo Automático | Geral",
                  "emailMessage/Body": "<p class=\"editor-paragraph\">ERRO NO FLOW - Flow Atribuir Veículo Automático | Geral</p>",
                  "emailMessage/From": "noreply@betinhos.com.br",
                  "emailMessage/Importance": "Normal"
                },
                "host": {
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_office365",
                  "operationId": "SendEmailV2",
                  "connectionName": "shared_office365"
                }
              }
            },
            "Terminate": {
              "type": "Terminate",
              "inputs": {
                "runStatus": "Failed"
              },
              "runAfter": {
                "Send_an_email_(V2)": [
                  "Succeeded"
                ]
              }
            }
          },
          "runAfter": {
            "Scope": [
              "TimedOut",
              "Skipped",
              "Failed"
            ]
          }
        },
        "Initialize_variable_varVeiculoPrevisto": {
          "type": "InitializeVariable",
          "inputs": {
            "variables": [
              {
                "name": "varVeiculoPrevisto",
                "type": "string"
              }
            ]
          },
          "runAfter": {}
        }
      },
      "outputs": {}
    },
    "templateName": null
  },
  "schemaVersion": "1.0.0.0"
}