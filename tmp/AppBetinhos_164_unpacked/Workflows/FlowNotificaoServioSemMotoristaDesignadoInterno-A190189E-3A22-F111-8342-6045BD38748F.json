                          "Succeeded"
                        ]
                      }
                    }
                  },
                  "runAfter": {
                    "List_rows_funcionários_Notifcação_Operacional": [
                      "Succeeded"
                    ]
                  },
                  "runtimeConfiguration": {
                    "concurrency": {
                      "repetitions": 50
                    }
                  }
                }
              },
              "else": {
                "actions": {
                  "Terminate_1": {
                    "type": "Terminate",
                    "inputs": {
                      "runStatus": "Cancelled"
                    }
                  }
                }
              },
              "runAfter": {
                "List_rows_Geral": [
                  "Succeeded"
                ]
              }
            }
          },
          "runAfter": {
            "Initialize_variable_varListaAlertas": [
              "Succeeded"
            ]
          }
        },
