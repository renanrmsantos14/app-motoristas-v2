                                  "item/title": "Serviço sem motorista designado",
                                  "item/AppModuleId@odata.bind": "/appmodules(@{parameters('ID App Betinhos Interno (new_IDAppBetinhosInterno)')})",
                                  "item/body": "O Serviço de @{if(\n  equals(\n    formatDateTime(convertFromUtc(items('For_each_Serviço')?['cr40f_dataehorriodesada'], 'E. South America Standard Time'), 'yyyy-MM-dd'),\n    formatDateTime(convertFromUtc(utcNow(), 'E. South America Standard Time'), 'yyyy-MM-dd')\n  ),\n  concat('HOJE ', formatDateTime(convertFromUtc(items('For_each_Serviço')?['cr40f_dataehorriodesada'], 'E. South America Standard Time'), 'HH:mm')),\n  if(\n    equals(\n      formatDateTime(convertFromUtc(items('For_each_Serviço')?['cr40f_dataehorriodesada'], 'E. South America Standard Time'), 'yyyy-MM-dd'),\n      formatDateTime(addDays(convertFromUtc(utcNow(), 'E. South America Standard Time'), 1), 'yyyy-MM-dd')\n    ),\n    concat('AMANHÃ ', formatDateTime(convertFromUtc(items('For_each_Serviço')?['cr40f_dataehorriodesada'], 'E. South America Standard Time'), 'HH:mm')),\n    if(\n      equals(\n        formatDateTime(convertFromUtc(items('For_each_Serviço')?['cr40f_dataehorriodesada'], 'E. South America Standard Time'), 'yyyy-MM-dd'),\n        formatDateTime(addDays(convertFromUtc(utcNow(), 'E. South America Standard Time'), -1), 'yyyy-MM-dd')\n      ),\n      concat('ONTEM ', formatDateTime(convertFromUtc(items('For_each_Serviço')?['cr40f_dataehorriodesada'], 'E. South America Standard Time'), 'HH:mm')),\n      formatDateTime(convertFromUtc(items('For_each_Serviço')?['cr40f_dataehorriodesada'], 'E. South America Standard Time'), 'dd/MM/yyyy HH:mm')\n    )\n  )\n)} está sem motorista designado!\nID: @{items('For_each_Serviço')?['cr40f_id']}",
                                  "item/ttlinseconds": 86400,
                                  "item/icontype": 100000003,
                                  "item/priority": 200000001,
                                  "item/ownerid@odata.bind": "/systemusers(@{first(outputs('List_rows_systemusers')?['body/value'])?['systemuserid']})"
                                },
                                "host": {
                                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps",
                                  "operationId": "CreateRecord",
                                  "connectionName": "shared_commondataserviceforapps-1"
                                }
                              }
                            },
                            "Send_push_notification_V2": {
                              "type": "OpenApiConnection",
                              "inputs": {
                                "parameters": {
                                  "payload/playerType": "PowerApps",
                                  "payload/app": "{\"appIdentifier\":\"cr40f_ModelDrivenBetinhos\",\"displayName\":\"App Betinhos Interno\",\"type\":\"AppModule\"}",
                                  "payload/recipients": [
                                    "@items('For_each_Funcionario_Notificação_Operacional')?['cr40f_emailmicrosoft']"
                                  ],
                                  "payload/message": "O Serviço de @{if(\r\n  equals(\r\n    formatDateTime(convertFromUtc(items('For_each_Serviço')?['cr40f_dataehorriodesada'], 'E. South America Standard Time'), 'yyyy-MM-dd'),\r\n    formatDateTime(convertFromUtc(utcNow(), 'E. South America Standard Time'), 'yyyy-MM-dd')\r\n  ),\r\n  concat('HOJE ', formatDateTime(convertFromUtc(items('For_each_Serviço')?['cr40f_dataehorriodesada'], 'E. South America Standard Time'), 'HH:mm')),\r\n  if(\r\n    equals(\r\n      formatDateTime(convertFromUtc(items('For_each_Serviço')?['cr40f_dataehorriodesada'], 'E. South America Standard Time'), 'yyyy-MM-dd'),\r\n      formatDateTime(addDays(convertFromUtc(utcNow(), 'E. South America Standard Time'), 1), 'yyyy-MM-dd')\r\n    ),\r\n    concat('AMANHÃ ', formatDateTime(convertFromUtc(items('For_each_Serviço')?['cr40f_dataehorriodesada'], 'E. South America Standard Time'), 'HH:mm')),\r\n    if(\r\n      equals(\r\n        formatDateTime(convertFromUtc(items('For_each_Serviço')?['cr40f_dataehorriodesada'], 'E. South America Standard Time'), 'yyyy-MM-dd'),\r\n        formatDateTime(addDays(convertFromUtc(utcNow(), 'E. South America Standard Time'), -1), 'yyyy-MM-dd')\r\n      ),\r\n      concat('ONTEM ', formatDateTime(convertFromUtc(items('For_each_Serviço')?['cr40f_dataehorriodesada'], 'E. South America Standard Time'), 'HH:mm')),\r\n      formatDateTime(convertFromUtc(items('For_each_Serviço')?['cr40f_dataehorriodesada'], 'E. South America Standard Time'), 'dd/MM/yyyy HH:mm')\r\n    )\r\n  )\r\n)} está sem motorista designado!\nID: @{items('For_each_Serviço')?['cr40f_id']}",
                                  "payload/openApp": true,
                                  "payload/dynamicParams/entityLogicalName": "cr40f_reservadeveculos",
                                  "payload/dynamicParams/entityPage": "{\"id\":\"0a8e5497-fa18-f111-8341-6045bd3c7605\",\"displayName\":\"View - Visualização Mobile\",\"type\":\"entitylist\",\"viewType\":1039}",
                                  "payload/dynamicParams/recordId": "@variables('varGUIDServico')"
                                },
                                "host": {
                                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_powerappsnotificationv2",
                                  "operationId": "SendPushNotificationV2",
                                  "connectionName": "shared_powerappsnotificationv2"
                                }
