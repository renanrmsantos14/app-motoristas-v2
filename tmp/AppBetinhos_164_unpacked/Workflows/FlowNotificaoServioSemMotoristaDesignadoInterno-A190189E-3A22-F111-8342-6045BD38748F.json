                              },
                              {
                                "header": "Endereço de Saída",
                                "value": "@item()?['cr40f_endereodesada']"
                              },
                              {
                                "header": "Destino",
                                "value": "@item()?['cr40f_destino']"
                              },
                              {
                                "header": "Trajeto",
                                "value": "@item()?['cr40f_trajeto']"
                              },
                              {
                                "header": "Cliente",
                                "value": "@item()?['_cr40f_cliente_value@OData.Community.Display.V1.FormattedValue']"
                              },
                              {
                                "header": "Obs de Operação",
                                "value": "@item()?['cr40f_obsdeoperao']"
                              },
                              {
                                "header": "Tipo de Veículo",
                                "value": "@item()?['cr40f_tipodeveiculo@OData.Community.Display.V1.FormattedValue']"
                              },
                              {
                                "header": "Receber",
                                "value": "@if(equals(item()?['cr40f_receber'], true), 'Sim', 'Não')"
                              },
                              {
                                "header": "Passageiros",
                                "value": "@item()?['cr40f_passageirosetelefonedecontato']"
                              }
                            ]
                          }
                        },
                        "Compose_Tabela_Estilo": {
                          "type": "Compose",
                          "inputs": "@replace(\r\n  replace(\r\n    replace(\r\n      replace(\r\n        string(body('Create_HTML_table')),\r\n        '<table>',\r\n        '<table style=\"border-collapse:collapse;width:100%;font-size:13px;background:#fff\">'\r\n      ),\r\n      '<th>',\r\n      '<th style=\"background:#2F80ED;color:#fff;padding:10px;text-align:left;border-bottom:1px solid #1f6fd1\">'\r\n    ),\r\n    '<td>',\r\n    '<td style=\"padding:10px;border-bottom:1px solid #eee;vertical-align:top\">'\r\n  ),\r\n  '<tr>',\r\n  '<tr style=\"border-bottom:1px solid #eee\">'\r\n)\r\n",
                          "runAfter": {
                            "Create_HTML_table": [
                              "Succeeded"
                            ]
                          }
                        },
                        "Send_an_email_(V2)_1": {
                          "type": "OpenApiConnection",
                          "inputs": {
                            "parameters": {
                              "emailMessage/To": "@items('For_each_Funcionario_Notificação_Operacional')?['cr40f_emailbetinhos']",
                              "emailMessage/Subject": "AVISO: Serviço Sem Motorista Designado",
                              "emailMessage/Body": "<div style=\"font-family:Segoe UI, Arial; font-size:13px\">\n<p style=\"margin:0 0 12px 0\">\nOlá @{\nitems('For_each_Funcionario_Notificação_Operacional')?['new_apelido']},<br><br>\nSegue abaixo a lista de pedidos com <strong>motoristas faltantes:</strong>\n</p>\n\n<div style=\"overflow-x:auto; border:1px solid #e6e6e6; border-radius:8px\">\n\n<div>\n@{outputs('Compose_Tabela_Estilo')}\n</div>\n</div>\n\n<p style=\"margin:12px 0 0 0; font-size:12px; color:#777\">\nAviso automático — Betinhos Executive Service\n</p>\n</div>\n",
                              "emailMessage/From": "noreply@betinhos.com.br",
                              "emailMessage/Importance": "Normal"
                            },
                            "host": {
                              "apiId": "/providers/Microsoft.PowerApps/apis/shared_office365",
                              "operationId": "SendEmailV2",
                              "connectionName": "shared_office365"
                            }
                          },
                          "runAfter": {
                            "Compose_Tabela_Estilo": [
                              "Succeeded"
                            ]
                          }
                        }
                      },
                      "else": {
                        "actions": {}
                      },
                      "runAfter": {
