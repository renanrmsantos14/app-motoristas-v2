                      "actions": {
                        "Set_variable_minutosRestantes": {
                          "type": "SetVariable",
                          "inputs": {
                            "name": "minutosRestantes",
                            "value": "@div(\r\n  sub(\r\n    ticks(items('For_each_Serviço')?['cr40f_dataehorriodesada']),\r\n    ticks(utcNow())\r\n  ),\r\n  600000000\r\n)"
                          }
                        },
                        "Compose_é_pra_notificar": {
                          "type": "Compose",
                          "inputs": "@if(\r\n  lessOrEquals(variables('minutosRestantes'), 60),\r\n  true,\r\n  less(mod(variables('minutosRestantes'), 30), 10)\r\n)",
                          "runAfter": {
                            "Set_variable_GUID_Geral": [
                              "Succeeded"
