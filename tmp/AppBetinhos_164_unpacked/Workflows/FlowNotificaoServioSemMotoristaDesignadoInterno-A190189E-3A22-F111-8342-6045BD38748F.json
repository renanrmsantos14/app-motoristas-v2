            "frequency": "Minute",
            "timeZone": "E. South America Standard Time",
            "startTime": "2017-03-04T15:00:00Z"
          }
        }
      },
      "actions": {
        "Scope": {
          "type": "Scope",
          "actions": {
            "List_rows_Geral": {
              "type": "OpenApiConnection",
              "inputs": {
                "parameters": {
                  "entityName": "cr40f_reservadeveculoses",
                  "$filter": "@concat(\r\n  '_cr40f_motorista_value eq null',\r\n  ' and cr40f_dataehorriodesada ge ', formatDateTime(utcNow(), 'yyyy-MM-ddTHH:mm:ssZ'),\r\n  ' and cr40f_dataehorriodesada le ', formatDateTime(addHours(utcNow(), 3), 'yyyy-MM-ddTHH:mm:ssZ'),\r\n  ' and (cr40f_status eq 202410001 or cr40f_status eq 202410005)'\r\n)",
                  "$top": 100
                },
                "host": {
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps",
                  "operationId": "ListRecords",
                  "connectionName": "shared_commondataserviceforapps-1"
                }
              }
            },
            "Condition_é_pra_rodar": {
              "type": "If",
              "expression": {
                "and": [
                  {
                    "equals": [
                      "@empty(outputs('List_rows_Geral')?['body/value'])",
                      false
                    ]
                  }
                ]
              },
              "actions": {
                "List_rows_funcionários_Notifcação_Operacional": {
                  "type": "OpenApiConnection",
                  "inputs": {
                    "parameters": {
                      "entityName": "cr40f_funcionarioses",
                      "$select": "cr40f_emailmicrosoft, cr40f_emailbetinhos,new_apelido",
                      "$filter": "new_notificacoesoperacionais eq true"
                    },
                    "host": {
                      "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps",
                      "operationId": "ListRecords",
                      "connectionName": "shared_commondataserviceforapps-1"
                    }
                  }
                },
                "For_each_Funcionario_Notificação_Operacional": {
                  "type": "Foreach",
                  "foreach": "@outputs('List_rows_funcionários_Notifcação_Operacional')?['body/value']",
                  "actions": {
                    "For_each_Serviço": {
                      "type": "Foreach",
