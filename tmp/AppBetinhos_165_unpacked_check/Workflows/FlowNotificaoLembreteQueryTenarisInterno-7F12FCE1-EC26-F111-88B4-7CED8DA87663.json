          "type": "String",
          "metadata": {
            "schemaName": "new_IDAppBetinhosInterno"
          }
        }
      },
      "triggers": {
        "Recurrence": {
          "type": "Recurrence",
          "recurrence": {
            "interval": 1,
            "frequency": "Day",
            "schedule": {
              "hours": [
                "8",
                "10",
                "14",
                "12",
                "16",
                "17"
              ]
            },
            "timeZone": "E. South America Standard Time"
          }
        }
      },
      "actions": {
        "Scope": {
          "type": "Scope",
          "actions": {
            "Condition_é_pra_rodar": {
              "type": "If",
              "expression": {
                "and": [
                  {
                    "equals": [
                      "@length(outputs('List_rows_Geral')?['body/value'])",
                      0
                    ]
                  }
                ]
              },
              "actions": {
                "Add_a_new_row_Notificações_1": {
                  "type": "OpenApiConnection",
                  "inputs": {
                    "parameters": {
                      "entityName": "appnotifications",
                      "item/title": "Deborah, talvez seja a hora de atualizar o query da Tenaris!",
                      "item/AppModuleId@odata.bind": "/appmodules(@{parameters('ID App Betinhos Interno (new_IDAppBetinhosInterno)')})",
                      "item/ttlinseconds": 86400,
                      "item/icontype": 100000003,
                      "item/priority": 200000001,
                      "item/ownerid@odata.bind": "/systemusers(@{first(outputs('List_rows_systemusers')?['body/value'])?['systemuserid']})"
                    },
                    "host": {
                      "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps",
                      "operationId": "CreateRecord",
                      "connectionName": "shared_commondataserviceforapps"
                    }
                  },
                  "runAfter": {
                    "List_rows_systemusers": [
                      "Succeeded"
                    ]
                  }
                },
                "Send_push_notification_V2": {
                  "type": "OpenApiConnection",
                  "inputs": {
                    "parameters": {
                      "payload/playerType": "PowerApps",
                      "payload/app": "{\"appIdentifier\":\"cr40f_ModelDrivenBetinhos\",\"displayName\":\"App Betinhos Interno\",\"type\":\"AppModule\"}",
                      "payload/recipients": [
                        "deborah.keila@betinhos.onmicrosoft.com"
                      ],
                      "payload/message": "Deborah, talvez seja a hora de atualizar o query da Tenaris!",
                      "payload/openApp": true,
                      "payload/dynamicParams/entityLogicalName": "cr40f_reservadeveculos"
                    },
                    "host": {
                      "apiId": "/providers/Microsoft.PowerApps/apis/shared_powerappsnotificationv2",
                      "operationId": "SendPushNotificationV2",
                      "connectionName": "shared_powerappsnotificationv2"
                    }
                  },
                  "runAfter": {
                    "Add_a_new_row_Notificações_1": [
                      "Succeeded"
                    ]
                  }
                },
                "List_rows_systemusers": {
                  "type": "OpenApiConnection",
                  "inputs": {
                    "parameters": {
                      "entityName": "systemusers",
                      "$filter": "internalemailaddress eq 'deborah.keila@betinhos.onmicrosoft.com'"
                    },
                    "host": {
                      "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps",
                      "operationId": "ListRecords",
                      "connectionName": "shared_commondataserviceforapps"
                    }
                  }
                }
              },
              "else": {
                "actions": {
                  "Terminate": {
                    "type": "Terminate",
                    "inputs": {
                      "runStatus": "Cancelled"
                    }
                  }
                }
              },
              "runAfter": {
                "List_rows_Geral": [
                  "Succeeded"
                ]
              }
            },
            "List_rows_Geral": {
              "type": "OpenApiConnection",
              "inputs": {
                "parameters": {
                  "entityName": "cr40f_reservadeveculoses",
                  "$filter": "modifiedon gt @{formatDateTime(addMinutes(utcNow(), -90, 'yyyy-MM-ddTHH:mm:ssZ'))} and _cr40f_cliente_value eq '564bdd2e-74cf-f011-8543-6045bd3adc1c'",
                  "$orderby": "modifiedon desc",
                  "$top": 1
                },
                "host": {
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps",
                  "operationId": "ListRecords",
                  "connectionName": "shared_commondataserviceforapps"
                }
              }
            }
          },
          "runAfter": {}
        },
        "Scope_1": {
          "type": "Scope",
          "actions": {
            "Send_an_email_(V2)": {
              "type": "OpenApiConnection",
              "inputs": {
                "parameters": {
                  "emailMessage/To": "noreply@betinhos.onmicrosoft.com;deborah.keila@betinhos.com.br",
                  "emailMessage/Subject": "ERRO NO FLOW - Flow Notificação Lembrete Query Tenaris | Interno",
                  "emailMessage/Body": "<p class=\"editor-paragraph\">ERRO NO FLOW - Flow Notificação Lembrete Query Tenaris | Interno</p>",
                  "emailMessage/From": "noreply@betinhos.com.br",
                  "emailMessage/Importance": "Normal"
                },
                "host": {
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_office365",
                  "operationId": "SendEmailV2",
                  "connectionName": "shared_office365"
                }
              }
            },
            "Terminate_1": {
              "type": "Terminate",
              "inputs": {
                "runStatus": "Failed"
              },
              "runAfter": {
                "Send_an_email_(V2)": [
                  "Succeeded"
                ]
              }
            }
          },
          "runAfter": {
            "Scope": [
              "TimedOut",
              "Skipped",
              "Failed"
            ]
          }
        }
