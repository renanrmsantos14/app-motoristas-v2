{
  "properties": {
    "connectionReferences": {
      "shared_onedriveforbusiness-1": {
        "api": {
          "name": "shared_onedriveforbusiness"
        },
        "connection": {
          "connectionReferenceLogicalName": "new_sharedonedriveforbusiness_1f480"
        },
        "runtimeSource": "embedded"
      },
      "shared_office365-1": {
        "api": {
          "name": "shared_office365"
        },
        "connection": {
          "connectionReferenceLogicalName": "new_sharedoffice365_f87d5"
        },
        "runtimeSource": "embedded"
      }
    },
    "definition": {
      "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
      "contentVersion": "1.0.0.0",
      "parameters": {
        "$authentication": {
          "defaultValue": {},
          "type": "SecureObject"
        },
        "$connections": {
          "defaultValue": {},
          "type": "Object"
        }
      },
      "triggers": {
        "manual": {
          "type": "Request",
          "kind": "Http",
          "inputs": {
            "triggerAuthenticationType": "All",
            "schema": {
              "type": "object",
              "properties": {
                "passengerId": {
                  "type": "string"
                },
                "passengerName": {
                  "type": "string"
                },
                "clientName": {
                  "type": "string"
                },
                "fileName": {
                  "type": "string"
                },
                "mimeType": {
                  "type": "string"
                },
                "fileSize": {
                  "type": "number"
                },
                "base64": {
                  "type": "string"
                }
              }
            }
          },
          "metadata": {}
        }
      },
      "actions": {
        "Scope": {
          "type": "Scope",
          "actions": {
            "ClienteSeguro": {
              "type": "Compose",
              "inputs": "@trim(replace(replace(replace(replace(replace(replace(coalesce(triggerBody()?['clientName'], 'Sem cliente'), '/', '-'), '\\', '-'), ':', '-'), '*', '-'), '?', '-'), '#', '-'))",
              "runAfter": {
                "NomePassageiroSeguro": [
                  "Succeeded"
                ]
              }
            },
            "PastaDestino": {
              "type": "Compose",
              "inputs": "/Banco de Dados",
              "runAfter": {
                "ClienteSeguro": [
                  "Succeeded"
                ]
              }
            },
            "Create_file": {
              "type": "OpenApiConnection",
              "inputs": {
                "parameters": {
                  "folderPath": "@outputs('PastaDestino')",
                  "name": "@outputs('FileName')",
                  "body": "@base64ToBinary(triggerBody()?['base64'])"
                },
                "host": {
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_onedriveforbusiness",
                  "operationId": "CreateFile",
                  "connectionName": "shared_onedriveforbusiness-1"
                }
              },
              "runAfter": {
                "FileName": [
                  "Succeeded"
                ]
              },
              "runtimeConfiguration": {
                "contentTransfer": {
                  "transferMode": "Chunked"
                }
              }
            },
            "Create_share_link": {
              "type": "OpenApiConnection",
              "inputs": {
                "parameters": {
                  "id": "@outputs('Create_file')?['body/Id']",
                  "type": "View",
                  "scope": "Organization"
                },
                "host": {
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_onedriveforbusiness",
                  "operationId": "CreateShareLinkV2",
                  "connectionName": "shared_onedriveforbusiness-1"
                }
              },
              "runAfter": {
                "Create_file": [
                  "Succeeded"
                ]
              }
            },
            "Response": {
              "type": "Response",
              "kind": "Http",
              "inputs": {
                "statusCode": 200,
                "body": {
                  "webUrl": "@{outputs('Create_share_link')?['body/WebUrl']}",
                  "driveItemId": "@{outputs('Create_file')?['body/Id']}",
                  "fileName": "@{outputs('Create_file')?['body/Name']}",
                  "uploadedAt": "@{utcNow()}"
                }
              },
              "runAfter": {
                "Create_share_link": [
                  "Succeeded"
                ]
              }
            },
            "NomePassageiroSeguro": {
              "type": "Compose",
              "inputs": "@trim(replace(replace(replace(replace(replace(replace(coalesce(triggerBody()?['passengerName'], triggerBody()?['candidateName'], 'Sem nome'), '/', '-'), '\\', '-'), ':', '-'), '*', '-'), '?', '-'), '#', '-'))"
            },
            "FileName": {
              "type": "Compose",
              "inputs": "@concat(outputs('NomePassageiroSeguro'), ' - ', outputs('ClienteSeguro'), '.', if(greater(length(split(coalesce(triggerBody()?['fileName'], ''), '.')), 1), last(split(triggerBody()?['fileName'], '.')), 'jpg'))",
              "runAfter": {
                "PastaDestino": [
                  "Succeeded"
                ]
              }
            }
          },
          "runAfter": {}
        },
        "Scope_1": {
          "type": "Scope",
          "actions": {
            "Send_an_email_(V2)": {
              "type": "OpenApiConnection",
              "inputs": {
                "parameters": {
                  "emailMessage/To": "noreply@betinhos.onmicrosoft.com;junior@betinhos.com.br",
                  "emailMessage/Subject": "ERRO NO FLOW - Flow Salvar Foto BD - Onedrive",
                  "emailMessage/Body": "<p class=\"editor-paragraph\">ERRO NO FLOW - Flow Salvar Foto BD - Onedrive</p>",
                  "emailMessage/From": "noreply@betinhos.com.br",
                  "emailMessage/Importance": "Normal"
                },
                "host": {
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_office365",
                  "operationId": "SendEmailV2",
                  "connectionName": "shared_office365-1"
                }
              }
            },
            "Terminate": {
              "type": "Terminate",
              "inputs": {
                "runStatus": "Failed"
              },
              "runAfter": {
                "Send_an_email_(V2)": [
                  "Succeeded"
                ]
              }
            }
          },
          "runAfter": {
            "Scope": [
              "Failed"
            ]
          }
        }
      },
      "outputs": {}
    },
    "templateName": null
  },
  "schemaVersion": "1.0.0.0"
}