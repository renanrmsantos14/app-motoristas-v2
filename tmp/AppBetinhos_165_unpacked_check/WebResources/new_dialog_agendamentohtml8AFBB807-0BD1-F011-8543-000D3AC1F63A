
<!DOCTYPE html>
<html lang="pt-BR" data-theme="light"> <!-- troque para "dark" se desejar -->
<head>
  <meta charset="utf-8" />
  <title>Assistente de Agendamento • Betinhos Executive Service</title>
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <style>
    /* ===== THEME (UCI-Like, Fluent-ish) ===== */
    :root {
      /* Light */
      --bg:            #f5f6f8;
      --surface:       #ffffff;
      --surface-alt:   #f9fafb;
      --text:          #111827;
      --muted:         #6b7280;
      --border:        #e5e7eb;
      --primary:       #005ec2; /* parecido com UCI/Dataverse */
      --primary-700:   #004a98;
      --accent:        #0ea5e9;
      --danger:        #b91c1c;
      --ok:            #16a34a;
      --shadow:        0 6px 20px rgba(17, 24, 39, 0.06);
      --radius:        12px;
      --radius-sm:     8px;
    }
    [data-theme="dark"] {
      /* Dark */
      --bg:            #0f172a;
      --surface:       #111827;
      --surface-alt:   #0b1220;
      --text:          #e5e7eb;
      --muted:         #94a3b8;
      --border:        #1f2937;
      --primary:       #4f9df3;
      --primary-700:   #3a82d2;
      --accent:        #38bdf8;
      --danger:        #ef4444;
      --ok:            #22c55e;
      --shadow:        0 10px 24px rgba(2, 6, 23, 0.35);
    }

    /* ===== RESET & BASE ===== */
    * { box-sizing: border-box; }
    html, body { height: 100%; }
    body {
      margin: 0; padding: 0;
      font-family: "Segoe UI", system-ui, -apple-system, Roboto, Arial, Helvetica, sans-serif;
      color: var(--text); background: var(--bg);
    }
    .wrap {
      max-width: 1100px; margin: 0 auto; padding: 16px;
    }

    /* ===== HEADER ===== */
    .header {
      display: grid; grid-template-columns: auto 1fr auto; align-items: center; gap: 12px;
      background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius);
      padding: 12px 16px; box-shadow: var(--shadow);
      position: sticky; top: 0; z-index: 9;
    }
    .brand {
      display: flex; align-items: center; gap: 10px;
    }
    .logo {
      width: 32px; height: 32px; border-radius: 8px;
      background: linear-gradient(135deg, var(--primary), var(--accent));
      box-shadow: 0 8px 20px rgba(0,0,0,.12);
    }
    .title {
      font-size: 16px; font-weight: 700;
    }
    .breadcrumb { font-size: 12px; color: var(--muted); }
    .badge {
      font-size: 12px; padding: 6px 10px; border-radius: 999px; font-weight: 600;
      background: var(--surface-alt); border: 1px solid var(--border);
    }

    /* ===== CARD & LAYOUT ===== */
    .card {
      background: var(--surface); border: 1px solid var(--border);
      border-radius: var(--radius); box-shadow: var(--shadow);
      padding: 14px; margin-top: 14px;
    }
    .section-title { font-size: 14px; font-weight: 700; margin-bottom: 10px; }
    .grid { display: grid; gap: 12px; }
    .grid-1 { grid-template-columns: 1fr; }
    .grid-2 { grid-template-columns: 1fr; }
    @media (min-width: 720px) { .grid-2 { grid-template-columns: 1fr 1fr; } }
    @media (min-width: 980px) { .grid-3 { grid-template-columns: 1fr 1fr 1fr; } }

    /* ===== FORMS ===== */
    label { display: block; font-size: 12px; color: var(--muted); margin-bottom: 6px; }
    input[type="date"], input[type="time"], select, textarea {
      width: 100%; padding: 10px 12px; border-radius: var(--radius-sm);
      border: 1px solid var(--border); background: var(--surface-alt);
      color: var(--text); font-size: 14px; outline: none;
    }
    input[type="date"]:focus, input[type="time"]:focus, select:focus, textarea:focus {
      border-color: var(--primary); box-shadow: 0 0 0 3px rgba(0,94,194,.15);
    }
    .field {
      display: grid; gap: 6px;
    }
    .row { display: flex; align-items: center; gap: 10px; flex-wrap: wrap; }

    /* Switch */
    .switch {
      display: inline-flex; align-items: center; gap: 10px; cursor: pointer;
      user-select: none; font-size: 14px;
    }
    .switch input { display: none; }
    .track {
      width: 46px; height: 26px; border-radius: 13px;
      background: var(--border); position: relative; transition: background .2s ease;
      border: 1px solid var(--border);
    }
    .thumb {
      width: 20px; height: 20px; border-radius: 50%; background: var(--surface);
      position: absolute; top: 2px; left: 2px; box-shadow: var(--shadow); transition: left .2s ease;
    }
    .switch input:checked + .track { background: var(--primary); border-color: var(--primary); }
    .switch input:checked + .track .thumb { left: 24px; }

    /* ===== BUTTONS ===== */
    .actions { display: flex; gap: 10px; align-items: center; flex-wrap: wrap; }
    .btn {
      border: 0; border-radius: 10px; padding: 10px 16px; font-weight: 600; cursor: pointer;
      display: inline-flex; align-items: center; gap: 8px; font-size: 14px;
      transition: transform .03s ease, background .15s ease;
    }
    .btn:active { transform: translateY(1px); }
    .btn-primary { background: var(--primary); color: #fff; }
    .btn-primary:hover { background: var(--primary-700); }
    .btn-ghost { background: var(--surface-alt); color: var(--text); border: 1px solid var(--border); }
    .btn-ghost:hover { background: #eef2f7; }
    .btn-danger { background: var(--danger); color: #fff; }
    .status { font-size: 12px; color: var(--muted); }

    /* ===== PREVIEW TABLE ===== */
    #preview {
      margin-top: 10px; border: 1px solid var(--border); border-radius: var(--radius);
      overflow: hidden; background: var(--surface-alt);
    }
    .tbl {
      width: 100%; border-collapse: collapse;
    }
    .tbl thead { background: var(--surface); position: sticky; top: 0; z-index: 1; }
    .tbl th, .tbl td {
      font-size: 13px; padding: 10px 12px; border-bottom: 1px solid var(--border); text-align: left;
    }
    .tbl tbody tr:nth-child(odd) { background: var(--surface-alt); }
    .pill {
      display: inline-block; padding: 4px 8px; border-radius: 999px; font-size: 12px; font-weight: 600;
      border: 1px solid var(--border);
    }
    .pill--ida     { color: var(--primary); border-color: var(--primary); background: rgba(0,94,194,.08); }
    .pill--retorno { color: var(--accent);  border-color: var(--accent);  background: rgba(14,165,233,.10); }

    /* ===== FOOTER HINT ===== */
    .hint { font-size: 12px; color: var(--muted); }
  </style>
</head>
<body>
  <div class="wrap">
    <!-- HEADER -->
    <div class="header">
      <div class="brand">
        <div class="logo" aria-hidden="true"></div>
        <div>
          <div class="title">Assistente de Agendamento</div>
          <div class="breadcrumb">Serviços • Ida e Retorno • Betinhos Executive Service</div>
        </div>
      </div>
      <span></span>
      <div class="badge">Model‑Driven • UCI</div>
    </div>

    <!-- PARAMS CARD -->
    <div class="card">
      <div class="section-title">Parâmetros</div>
      <div class="grid grid-2">
        <div class="field">
          <label for="dpInicio">Data inicial</label>
          <input type="date" id="dpInicio" />
        </div>
        <div class="field">
          <label for="dpFim">Data final</label>
          <input type="date" id="dpFim" />
        </div>

        <div class="field">
          <label for="tpHoraIda">Horário da ida</label>
          <input type="time" id="tpHoraIda" />
        </div>
        <div class="field">
          <label for="tpHoraRetorno">Horário do retorno</label>
          <input type="time" id="tpHoraRetorno" />
        </div>

        <div class="row">
          <label class="switch" title="Incluir sábados e domingos">
            <input type="checkbox" id="tglFDS" />
            <span class="track"><span class="thumb"></span></span>
            <span>Incluir sábados e domingos</span>
          </label>
        </div>

        <div class="field">
          <label for="selStatus">Status dos serviços gerados</label>
          <select id="selStatus">
            <option value="Confirmado">Confirmado</option>
            <option value="Pré-reserva">Pré‑reserva</option>
            <option value="Cancelado">Cancelado</option>
          </select>
        </div>
      </div>
    </div>

    <!-- NOTES CARD -->
    <div class="card">
      <div class="section-title">Observações (opcional)</div>
      <div class="grid grid-2">
        <div class="field">
          <label for="obsOperacao">Obs. de operação</label>
          <textarea id="obsOperacao" rows="2" placeholder="Instruções ao motorista, etc."></textarea>
        </div>
        <div class="field">
          <label for="obsInterna">Observação interna</label>
          <textarea id="obsInterna" rows="2" placeholder="Notas internas…"></textarea>
        </div>
      </div>
      <div class="hint" style="margin-top:6px;">Se habilitado no JS, estas observações são copiadas para cada serviço criado.</div>
    </div>

    <!-- ACTIONS & STATUS -->
    <div class="card">
      <div class="row" style="justify-content: space-between;">
        <div class="actions">
          <button class="btn btn-ghost"  id="btnPrever"   title="Simula e exibe os serviços">🔎 Prever</button>
          <button class="btn btn-primary" id="btnExecutar" title="Cria os serviços em lote">🚀 Executar</button>
          <button class="btn btn-danger"  id="btnCancelar" title="Fechar">✖ Cancelar</button>
        </div>
        <div class="status" id="statusMsg">Pronto.</div>
      </div>

      <!-- PREVIEW TABLE -->
      <div id="preview" aria-live="polite" aria-busy="false" style="margin-top:12px;">
        <!-- seu JS vai injetar a tabela aqui:
        <table class="tbl">
          <thead>...</thead>
          <tbody>...</tbody>
        </table>
        -->
      </div>
    </div>

    <div class="hint" style="margin-top:8px;">
      Dica: publique este HTML como Web Resource e abra pelo botão do Command Bar. Seu JS fará o
      <code>wireUiButtons(formContext)</code> para ligar os eventos.
    </div>
  </div>

  <!-- Bootstrap da página (opcional, não conflita com seu JS principal) -->
  <script>
    document.addEventListener("DOMContentLoaded", function(){
      const status = document.getElementById("statusMsg");
      if(status){ status.textContent = "Pronto para prever e executar."; }
      // Seu Web Resource JS deve chamar: wireUiButtons(formContext)
      // Se quiser testar sem formContext, comente a linha acima e chame wireUiButtons(null).
    });
  </script>
</body>
</html>
