// Command Button JS — GerarVoucher
// Gera voucher de confirmação em HTML direto na tela, sem Flow
// Entidade: cr40f_reservadeveculos

var TAG_GV = "[BT-GERAR-VOUCHER]";

function GerarVoucher(primaryControl) {
    var grid = primaryControl.getGrid();
    if (!grid) return;

    var selectedRows = grid.getSelectedRows();
    if (selectedRows.getLength() === 0) return;

    var registros = [];
    selectedRows.forEach(function (row) {
        try {
            var entity = row.getData().getEntity();
            var id = entity.getId().replace(/[{}]/g, "");
            var entityName = entity.getEntityName();
            if (id) registros.push({ id: id, entityName: entityName });
        } catch (e) {
            console.warn(TAG_GV, "Erro ao extrair row:", e);
        }
    });

    if (registros.length === 0) return;

    Xrm.Utility.showProgressIndicator("Carregando serviço(s)...");

    var SELECT = [
        "cr40f_id", "cr40f_idnovo", "cr40f_cr",
        "cr40f_dataehorriodesada", "cr40f_horrioprevistoderetorno",
        "cr40f_enderecodesaida1", "cr40f_enderecodesaida2",
        "cr40f_enderecodesaida3", "cr40f_enderecodesaida4",
        "cr40f_endereodesada", "cr40f_destino",
        "cr40f_email",
        "_cr40f_veiculo_value",
        "_cr40f_cliente_value", "_cr40f_solicitante_value", "_cr40f_financeiro_value",
        "cr40f_tipodeveiculo", "cr40f_tipodoservico", "cr40f_status",
        "cr40f_obsdeoperao", "cr40f_perfildopassageiro"
    ].join(",");

    function buscarPassageiros(servicoId) {
        return Xrm.WebApi.retrieveMultipleRecords(
            "cr40f_servicosporpassageiro",
            "?$filter=_cr40f_geral_value eq " + servicoId +
            "&$select=_cr40f_bancodedados_value" +
            "&$orderby=cr40f_ordemdeselecao asc"
        ).then(function (res) { return res.entities || []; })
         .catch(function () { return []; });
    }

    Promise.all(registros.map(function (reg) {
        return Promise.all([
            Xrm.WebApi.retrieveRecord(reg.entityName, reg.id, "?$select=" + SELECT),
            buscarPassageiros(reg.id)
        ]).then(function (res) {
            var record = res[0];
            record._passageiros = res[1];
            return { ok: true, data: record };
        }).catch(function (e) {
            console.error(TAG_GV, "Erro ao buscar:", reg.id, e);
            return { ok: false, data: null };
        });
    })).then(function (results) {
        try { Xrm.Utility.closeProgressIndicator(); } catch (e) {}

        var servicos = results
            .filter(function (r) { return r.ok && r.data; })
            .map(function (r) { return r.data; });

        if (servicos.length === 0) {
            Xrm.Navigation.openAlertDialog({ text: "Não foi possível carregar os dados dos serviços selecionados." });
            return;
        }

        abrirVoucher(servicos);
    });

    // ─── VOUCHER ──────────────────────────────────────────────────────────────

    function abrirVoucher(servicos) {
        var targetDoc;
        try { targetDoc = window.top.document; } catch (e) { targetDoc = document; }

        // ── helpers ──────────────────────────────────────────────────────────

        function fmt(dt) {
            if (!dt) return "—";
            var d = new Date(dt);
            return d.toLocaleDateString("pt-BR") + " " +
                   d.toLocaleTimeString("pt-BR", { hour: "2-digit", minute: "2-digit" });
        }

        function fv(obj, name) {
            return obj[name + "@OData.Community.Display.V1.FormattedValue"] || "";
        }

        function esc(v) {
            return String(v || "")
                .replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;")
                .replace(/"/g, "&quot;").replace(/'/g, "&#39;");
        }

        function passageiros(s) {
            if (s._passageiros && s._passageiros.length) {
                return s._passageiros
                    .map(function (p) { return fv(p, "_cr40f_bancodedados_value"); })
                    .filter(Boolean).join(", ");
            }
            return "—";
        }

        function endSaida(s) {
            return [
                s.cr40f_enderecodesaida1, s.cr40f_enderecodesaida2,
                s.cr40f_enderecodesaida3, s.cr40f_enderecodesaida4
            ].filter(Boolean).join(" / ") || s.cr40f_endereodesada || "—";
        }

        function normalizarServico(s, i) {
            return {
                indice:      i + 1,
                id:          s.cr40f_idnovo || s.cr40f_id || "—",
                financeiro:  fv(s, "_cr40f_financeiro_value"),
                tipo:        fv(s, "cr40f_tipodoservico") || "—",
                veiculoTipo: fv(s, "cr40f_tipodeveiculo") || "—",
                veiculo:     fv(s, "_cr40f_veiculo_value") || "A confirmar",
                status:      fv(s, "cr40f_status") || "Em processamento",
                cliente:     fv(s, "_cr40f_cliente_value") || fv(s, "_cr40f_solicitante_value") || "—",
                email:       s.cr40f_email || "—",
                passageiros: passageiros(s),
                origem:      endSaida(s),
                destino:     s.cr40f_destino || "—",
                dataHora:    s.cr40f_dataehorriodesada ? fmt(s.cr40f_dataehorriodesada) : "—",
                retorno:     s.cr40f_horrioprevistoderetorno ? fmt(s.cr40f_horrioprevistoderetorno) : "—",
                cr:          s.cr40f_cr || "",
                obs:         s.cr40f_obsdeoperao || "",
                perfil:      s.cr40f_perfildopassageiro || ""
            };
        }

        var dados = servicos.map(normalizarServico);
        var n = dados.length;
        var hoje = new Date().toLocaleDateString("pt-BR", { day: "2-digit", month: "long", year: "numeric" });

        // Densidade: normal 1-2 | compact 3-4 | tight 5-6 | ultra 7-8 | extreme 9+
        // Cada nível reduz progressivamente espaçamento, fontes e campos visíveis.
        // "extreme" muda completamente para layout de linha (tabular), sem cards.
        var nivel = n >= 9 ? "extreme" : n >= 7 ? "ultra" : n >= 5 ? "tight" : n >= 3 ? "compact" : "normal";

        var resumoPassageiros = dados
            .map(function (d) { return d.passageiros; })
            .filter(function (p) { return p && p !== "—"; })
            .join(" | ") || "—";
        var resumoCliente = dados[0] ? dados[0].cliente : "—";
        var resumoEmail   = dados[0] ? dados[0].email   : "—";

        // ── CSS ──────────────────────────────────────────────────────────────

        var css = [
            // Tokens
            ":root{--navy:#0c1a2e;--gold:#b89038;--gold-soft:#d9c07a;--ink:#111820;--muted:#68788a;--line:#d6dfe8;--panel:#f3f6f9;--white:#ffffff;}",
