        // ── render ────────────────────────────────────────────────────────────

        function field(label, value, extraClass) {
            return '<div class="vch-field' + (extraClass ? " " + extraClass : "") + '">' +
                   '<span class="vch-label">' + esc(label) + '</span>' +
                   '<div class="vch-value">' + esc(value || "—") + '</div></div>';
        }

        function renderServicoCard(item) {
            // Campos ocultados por nível:
            //   tight/ultra/extreme: perfil, email
            //   ultra/extreme: retorno (mantém dataHora), motorista
            var showPerfil    = nivel === "normal" || nivel === "compact";
            var showEmail     = nivel === "normal" || nivel === "compact" || nivel === "tight";
            var showRetorno   = nivel !== "ultra";
            var showVeiculo   = true;
            // Motorista é sempre "A confirmar" — só exibir quando há espaço
            var showMotorista = nivel === "normal";

            var gridFields = [
                field("Passageiro(s)", item.passageiros, "vch-field-full"),
                field("Cliente / Empresa", item.cliente),
                showEmail     ? field("E-mail", item.email)                   : "",
                field("Data / Hora Saída", item.dataHora),
                showRetorno   ? field("Prev. de Retorno", item.retorno)        : "",
                field("Tipo de Veículo", item.veiculoTipo),
                showMotorista ? field("Motorista", "A confirmar")              : "",
                showVeiculo   ? field("Veículo / Placa", item.veiculo)        : "",
                showPerfil && item.perfil ? field("Perfil", item.perfil, "vch-field-full") : ""
            ].join("");

            var routeHtml = [
                '<div class="vch-route">',
                '<div><span class="vch-label">Saída</span><div class="vch-value">' + esc(item.origem) + '</div></div>',
                '<div class="vch-route-arrow">→</div>',
                '<div><span class="vch-label">Destino</span><div class="vch-value">' + esc(item.destino) + '</div></div>',
                '</div>'
            ].join("");

            var obsHtml = item.obs
                ? '<div><span class="vch-label">Observações</span><div class="vch-obs">' + esc(item.obs) + '</div></div>'
                : "";

            return [
                '<div class="vch-service">',
                '<div class="vch-service-head">',
                '  <div class="vch-service-title-wrap">',
                '    <div class="vch-idx">' + item.indice + '</div>',
                '    <div>',
                '      <div class="vch-service-title">Serviço ' + esc(item.id) + '</div>',
                '      <div class="vch-service-meta">' + esc(item.tipo) +
                            (item.cr ? " · CR " + esc(item.cr) : "") +
                            (item.financeiro ? " · OP " + esc(item.financeiro) : "") + '</div>',
                '    </div>',
                '  </div>',
                '  <div class="vch-badge">' + esc(item.status) + '</div>',
                '</div>',
                '<div class="vch-service-body">',
                '  <div class="vch-grid">' + gridFields + '</div>',
                routeHtml,
                obsHtml,
                '</div>',
                '</div>'
            ].join("");
        }

        function renderServicoRow(item) {
            // Layout de linha para extreme — cabeçalho único + 1 linha por serviço
            var trajeto = esc(item.origem) + " → " + esc(item.destino);
            return [
                '<div class="vch-row">',
                '  <div class="vch-idx" style="width:19px;height:19px;font-size:8px;border-radius:3px;">' + item.indice + '</div>',
                '  <div class="vch-row-cell">',
                '    <span class="vch-row-label">Serviço · Tipo</span>',
                '    <div class="vch-row-value">' + esc(item.id) + ' · ' + esc(item.tipo) + (item.cr ? " · CR " + esc(item.cr) : "") + '</div>',
                '  </div>',
                '  <div class="vch-row-cell">',
                '    <span class="vch-row-label">Passageiro · Cliente</span>',
                '    <div class="vch-row-value">' + esc(item.passageiros) + ' · ' + esc(item.cliente) + '</div>',
                '  </div>',
                '  <div class="vch-row-cell">',
                '    <span class="vch-row-label">Data/Hora · Trajeto</span>',
                '    <div class="vch-row-value">' + esc(item.dataHora) + ' · ' + trajeto + '</div>',
                item.obs ? '<div class="vch-row-obs">' + esc(item.obs) + '</div>' : '',
                '  </div>',
                '  <div class="vch-row-cell" style="text-align:right;">',
                '    <div class="vch-badge">' + esc(item.status) + '</div>',
                '  </div>',
                '</div>'
            ].join("");
        }

        function renderVoucherHtml() {
            var renderServico = nivel === "extreme" ? renderServicoRow : renderServicoCard;
            return [
                '<div class="vch-page ' + nivel + '" id="bt-voucher-root">',
                '  <section class="vch-hero">',
                '    <div class="vch-hero-top">',
                '      <div>',
                '        <div class="vch-brand-kicker">Executive Ground Transport</div>',
                '        <div class="vch-brand-name">BETINHOS</div>',
                '        <div class="vch-brand-sub">Booking Confirmation</div>',
                '      </div>',
                '      <div class="vch-hero-meta">',
                '        <div class="vch-doc-label">Documento operacional</div>',
                '        <div class="vch-doc-title">' + n + ' serviço' + (n > 1 ? 's' : '') + '</div>',
                '        <div class="vch-doc-sub">Emitido em ' + esc(hoje) + '</div>',
                '      </div>',
                '    </div>',
                '    <div class="vch-summary">',
                '      <div class="vch-summary-card"><span class="vch-summary-label">Passageiro(s)</span><div class="vch-summary-value">' + esc(resumoPassageiros) + '</div></div>',
                '      <div class="vch-summary-card"><span class="vch-summary-label">Cliente</span><div class="vch-summary-value">' + esc(resumoCliente) + '</div></div>',
                '      <div class="vch-summary-card"><span class="vch-summary-label">Contato</span><div class="vch-summary-value">' + esc(resumoEmail) + '</div></div>',
                '    </div>',
                '  </section>',
                '  <section class="vch-body">',
                '    <div class="vch-service-list">',
                       dados.map(renderServico).join(""),
                '    </div>',
                '  </section>',
                '  <footer class="vch-footer">',
                '    <div><strong>Betinhos Executive Service</strong> &nbsp;|&nbsp; Júnior de Paula · Concierge · <a href="tel:+5512997236961">+55 12 99723-6961</a> · <a href="mailto:junior@betinhos.com.br">junior@betinhos.com.br</a> &nbsp;|&nbsp; Deborah Keila · Operações · <a href="tel:+5512996159093">+55 12 99615-9093</a></div>',
                '    <div class="vch-footer-note">BETINHOS EXECUTIVE SERVICE LTDA EPP<br>CNPJ 07.108.241/0001-06</div>',
                '  </footer>',
                '</div>'
            ].join("");
        }

        var htmlVoucher = renderVoucherHtml();

        // ── janela de impressão ───────────────────────────────────────────────
        // O script inline mede se o conteúdo excede 297mm e aplica scale uniforme
        // de segurança antes de acionar window.print(). Mantém proporção real.

        function imprimirVoucher() {
            var pw = window.open("", "_blank", "width=900,height=720");
            if (!pw) {
                Xrm.Navigation.openAlertDialog({ text: "O navegador bloqueou a janela de impressão." });
                return;
            }

            var inlineScript = [
                "(function(){",
                "  var A4H=1123,A4W=794;",
                "  function fit(){",
                "    var p=document.getElementById('bt-voucher-root');",
                "    if(!p)return;",
                "    p.style.transform='none';",
                "    var s=Math.min(A4H/p.scrollHeight,A4W/p.scrollWidth,1);",
                "    if(s<1){p.style.transformOrigin='top left';p.style.transform='scale('+s+')';}",
                "  }",
                "  window.onload=function(){fit();setTimeout(function(){window.print();},220);};",
                "  window.onafterprint=function(){window.close();};",
                "})();"
            ].join("");

            pw.document.open();
            pw.document.write(
                '<!doctype html><html lang="pt-BR"><head><meta charset="utf-8">' +
                '<title>Voucher Betinhos</title><style>' + css + '</style></head><body>' +
                htmlVoucher + '<script>' + inlineScript + '<\/script></body></html>'
            );
            pw.document.close();
        }

        // ── preview overlay ───────────────────────────────────────────────────
        // Escala uniforme (sem distorção): ajusta o page inteiro ao viewport.
        // scaleWrap recebe dimensões visuais exatas para que o stage não exiba
        // espaço em branco desnecessário abaixo da página.

        function ajustarEscala() {
            var wrap = targetDoc.getElementById("bt-voucher-scale-wrap");
            if (!wrap) return;

            var topWin = window;
            try { if (window.top) topWin = window.top; } catch (e) {}

            var vw = topWin.innerWidth  || 1400;
            var vh = topWin.innerHeight || 900;
            var tbEl = targetDoc.querySelector(".vch-toolbar");
            var tbH  = tbEl ? tbEl.offsetHeight + 10 : 50;

            var availW = Math.max(vw - 40, 280);
            var availH = Math.max(vh - tbH - 50, 280);

            // Dimensões canônicas de 210×297mm a 96 dpi
            var pageW = 794;
            var pageH = 1123;

            var scale = Math.min(availH / pageH, availW / pageW, 1);

            // Aplica scale ao page element (posição absoluta dentro de wrap)
            var page = wrap.querySelector(".vch-page");
            if (page) {
                page.style.transformOrigin = "top left";
                page.style.transform = "scale(" + scale + ")";
            }

            // Restringe wrap às dimensões visuais para o stage não sobrar espaço
            wrap.style.width  = Math.round(pageW * scale) + "px";
            wrap.style.height = Math.round(pageH * scale) + "px";
        }

        // ── montar DOM ────────────────────────────────────────────────────────

        var styleEl = targetDoc.createElement("style");
        styleEl.textContent = css;

        var overlay = targetDoc.createElement("div");
        overlay.className = "vch-overlay";

        var toolbar = targetDoc.createElement("div");
        toolbar.className = "vch-toolbar";

        var btnPrint = targetDoc.createElement("button");
        btnPrint.className = "vch-btn vch-btn-print";
        btnPrint.textContent = "Imprimir / Salvar PDF";
        btnPrint.onclick = imprimirVoucher;

        var btnClose = targetDoc.createElement("button");
        btnClose.className = "vch-btn vch-btn-close";
        btnClose.textContent = "Fechar";

        function fechar() {
            targetDoc.body.style.overflow = "";
            targetDoc.removeEventListener("keydown", onKeyDown, true);
            window.removeEventListener("resize", ajustarEscala);
            try { window.top.removeEventListener("resize", ajustarEscala); } catch (e) {}
            if (overlay.parentNode) overlay.parentNode.removeChild(overlay);
            if (styleEl.parentNode)  styleEl.parentNode.removeChild(styleEl);
        }

        btnClose.onclick = fechar;

        function onKeyDown(ev) { if (ev.key === "Escape") fechar(); }

        toolbar.appendChild(btnPrint);
        toolbar.appendChild(btnClose);
        overlay.appendChild(toolbar);

        var stage = targetDoc.createElement("div");
        stage.className = "vch-stage";

        var scaleWrap = targetDoc.createElement("div");
        scaleWrap.id = "bt-voucher-scale-wrap";
        scaleWrap.className = "vch-scale-wrap";
        scaleWrap.innerHTML = htmlVoucher;

        stage.appendChild(scaleWrap);
        overlay.appendChild(stage);

        overlay.addEventListener("click", function (ev) {
            if (ev.target === overlay) fechar();
        });

        targetDoc.head.appendChild(styleEl);
        targetDoc.body.appendChild(overlay);
        targetDoc.body.style.overflow = "hidden";
        targetDoc.addEventListener("keydown", onKeyDown, true);
        window.addEventListener("resize", ajustarEscala);
        try { window.top.addEventListener("resize", ajustarEscala); } catch (e) {}
        ajustarEscala();
    }
}
