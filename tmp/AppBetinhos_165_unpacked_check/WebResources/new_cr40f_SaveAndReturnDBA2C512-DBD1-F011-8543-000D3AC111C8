/**
 * Função principal para salvar e criar retorno
 * @param {object} PrimaryControl - Contexto do formulário
 */
async function salvarComRetorno(PrimaryControl) {
    console.log("🚀 [BOTÃO] salvarComRetorno executado!");
    
    try {
        const formContext = PrimaryControl;
        console.log("✅ formContext obtido");
        
        // 1. SALVAR O REGISTRO ATUAL PRIMEIRO
        console.log("💾 Salvando registro atual...");
        
        // Método robusto para salvar
        const savePromise = new Promise((resolve, reject) => {
            formContext.data.save().then(
                function() {
                    console.log("✅ Registro atual salvo com sucesso");
                    resolve();
                },
                function(error) {
                    console.error("❌ Erro ao salvar registro atual:", error);
                    reject(error);
                }
            );
        });
        
        await savePromise;
        
        // 2. VERIFICAR PENDÊNCIAS DO ASSISTENTE
        console.log("📊 Verificando pendências do assistente...");
        
        const pendingField = formContext.getAttribute("cr40f_new_assistant_pending");
        const optionsField = formContext.getAttribute("cr40f_new_assistant_options");
        
        if (!pendingField || !optionsField) {
            console.error("❌ Campos do assistente não encontrados!");
            Xrm.Navigation.openAlertDialog({
                title: "Erro de Configuração",
                text: "Campos do assistente não configurados corretamente."
            });
            return;
        }
        
        const pending = pendingField.getValue();
        const optionsJson = optionsField.getValue();
        
        console.log(`📊 Status: pending=${pending}, options=${!!optionsJson}`);
        
        if (pending && optionsJson) {
            console.log("🎯 AÇÃO PENDENTE DETECTADA! Criando retorno...");
            
            // 3. PROCESSAR DADOS DO ASSISTENTE
            let assistantData;
            try {
                assistantData = JSON.parse(optionsJson);
                console.log("📦 Dados do assistente:", assistantData);
            } catch (e) {
                console.error("❌ Erro ao parsear JSON:", e);
                Xrm.Navigation.openAlertDialog({
                    title: "Erro de Dados",
                    text: "Dados do assistente inválidos."
                });
                return;
            }
            
            if (!assistantData.retorno) {
                console.error("❌ Dados de retorno não encontrados");
                return;
            }
            
            // 4. PREPARAR PAYLOAD PARA CRIAÇÃO
            const retornoData = assistantData.retorno;
            
            // REMOVER CAMPOS QUE NÃO EXISTEM NA ENTIDADE
            // Verifique quais campos existem na sua entidade
            delete retornoData.cr40f_name; // Este campo não existe
            
            // ADICIONAR CAMPOS OBRIGATÓRIOS OU AJUSTES NECESSÁRIOS
            // Exemplo: garantir que o campo principal está correto
            if (retornoData.cr40f_destino) {
                // Já existe, tudo bem
            } else if (retornoData.destino) {
                // Se o JSON veio com 'destino' sem prefixo
                retornoData.cr40f_destino = retornoData.destino;
                delete retornoData.destino;
            }
            
            // Garantir que o status inicial seja definido (se aplicável)
            if (!retornoData.cr40f_status) {
                retornoData.cr40f_status = 202410001; // Status inicial (ajuste conforme sua Option Set)
            }
            
            // Adicionar data de criação
            retornoData.cr40f_dataehorriodesada = new Date().toISOString();
            
            console.log("📦 Payload final para criação:", retornoData);
            
            // 5. CRIAR REGISTRO DE RETORNO
            console.log("🔄 Criando registro de retorno...");
            try {
                const createdRecord = await Xrm.WebApi.createRecord(
                    "cr40f_reservadeveculos",
                    retornoData
                );
                
                console.log("✅ Retorno criado com sucesso! ID:", createdRecord.id);
                
                // 6. LIMPAR CAMPOS OCULTOS
                pendingField.setValue(false);
                optionsField.setValue(null);
                
                // 7. SALVAR AS ALTERAÇÕES (limpeza dos campos)
                await new Promise((resolve, reject) => {
                    formContext.data.save().then(resolve, reject);
                });
                
                console.log("✅ Campos limpos e salvos");
                
                // 8. FEEDBACK PARA O USUÁRIO
                Xrm.Navigation.openAlertDialog({
                    title: "Sucesso",
                    text: `Reserva salva e serviço de retorno criado com sucesso! ID do retorno: ${createdRecord.id}`
                }).then(() => {
                    // 9. ATUALIZAR A PÁGINA PARA MOSTRAR AS ALTERAÇÕES
                    formContext.data.refresh(false);
                });
                
            } catch (createError) {
                console.error("❌ Erro ao criar retorno:", createError);
                
                // Erro específico do campo cr40f_name
                if (createError.message && createError.message.includes("cr40f_name")) {
                    Xrm.Navigation.openAlertDialog({
                        title: "Erro de Configuração",
                        text: "Campo 'cr40f_name' não existe na entidade. Verifique os dados do assistente."
                    });
                } else {
                    Xrm.Navigation.openAlertDialog({
                        title: "Erro ao Criar Retorno",
                        text: "Não foi possível criar o serviço de retorno: " + createError.message
                    });
                }
            }
            
        } else {
            console.log("ℹ️ Nenhuma pendência detectada. Apenas salvando.");
            Xrm.Navigation.openAlertDialog({
                title: "Salvo",
                text: "Registro salvo com sucesso."
            });
        }
        
    } catch (error) {
        console.error("❌ Erro geral no processo:", error);
        
        let errorMessage = error.message || "Erro desconhecido";
        
        if (errorMessage.includes("Salvamento em Andamento")) {
            errorMessage = "Aguarde o salvamento atual ser concluído antes de tentar novamente.";
        } else if (errorMessage.includes("preventDefault")) {
            errorMessage = "Conflito com outro processo de salvamento. Verifique outros scripts OnSave.";
        }
        
        Xrm.Navigation.openAlertDialog({
            title: "Erro no Processo",
            text: errorMessage
        });
    }
}

/**
 * Função auxiliar para verificar campos da entidade (para debug)
 */
function debugCamposEntidade(formContext) {
    console.log("🔍 DEBUG: Listando campos da entidade...");
    const attributes = formContext.data.entity.attributes.get();
    
    const camposInfo = [];
    attributes.forEach(attr => {
        camposInfo.push({
            nome: attr.getName(),
            valor: attr.getValue(),
            tipo: typeof attr.getValue()
        });
    });
    
    console.table(camposInfo);
    
    // Verificar campos específicos do assistente
    const camposAssistente = [
        "cr40f_new_assistant_pending",
        "cr40f_new_assistant_options"
    ];
    
    camposAssistente.forEach(campoNome => {
        const campo = formContext.getAttribute(campoNome);
        if (campo) {
            console.log(`✅ ${campoNome}:`, campo.getValue());
        } else {
            console.warn(`⚠️ ${campoNome}: Campo não encontrado!`);
        }
    });
}