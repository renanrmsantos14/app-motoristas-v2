
// cr40f_formhooks.js
var cr40fFormHooks = (function(){
  let _fc = null;
  let _iframeWin = null;
  let _pendingOptions = null; // mantemos em memória (sem coluna Dataverse)

  // Helper: pegar janela do web resource (iframe)
  function getAssistantWindow(){
    try{
      // Substitua "new_assistente.html" pelo NOME do controle do seu Web Resource no formulário
      var ctrl = _fc.ui.controls.get("new_assistente.html"); // ou o "Name" do controle Web Resource
      if(!ctrl || !ctrl.getContentWindow) return null;
      return ctrl.getContentWindow();
    }catch(e){
      return null;
    }
  }

  // Converte valores para ISO Datetime (Z) a partir de inputs do HTML
  function toISO(dateYYYYMMDD, timeHHmm){
    return `${dateYYYYMMDD}T${timeHHmm}:00Z`;
  }

  function invertTrajeto(t){
    if(!t) return t; const p=String(t).split(" / ");
    return (p.length>=2) ? (p[1]+" / "+p[0]) : t;
  }

  function buildItemsFromOptions(opts){
    const origem  = _fc.getAttribute("cr40f_endereodesada")?.getValue();
    const destino = _fc.getAttribute("cr40f_destino")?.getValue();
    const trajeto = _fc.getAttribute("cr40f_trajeto")?.getValue();
    const tipoServ= _fc.getAttribute("cr40f_tipodoservico")?.getValue(); // choice (num)
    const tipoVeic= _fc.getAttribute("cr40f_tipodeveiculo")?.getValue(); // choice (num)

    if(!origem || !destino || !trajeto) throw new Error("Origem/Destino/Trajeto estão vazios.");

    const items = [];

    // RETORNO único
    if(opts.retorno?.enabled && opts.retorno?.data){
      // data vem como yyyy-MM-ddTHH:mm (do input datetime-local) -> completa com Z
      const iso = opts.retorno.data.includes("T") ? (opts.retorno.data + ":00Z") : null;
      items.push({
        tipo:"retorno",
        dt: iso,
        origem: opts.retorno.destino || destino,     // sai do destino
        destino: opts.retorno.endSaida || origem,    // volta à origem
        trajeto: invertTrajeto(trajeto),
        tipoServ, tipoVeic,
        obsInt: opts.retorno.obsInt || null,
        obsOp:  opts.retorno.obsOp  || null
      });
    }

    // FREQUENTE
    if(opts.frequente?.enabled && opts.frequente?.inicio && opts.frequente?.fim){
      const start = new Date(opts.frequente.inicio);
      const end   = new Date(opts.frequente.fim);
      const incluirFDS = !!opts.frequente.incluirFDS;
      const tipo = opts.frequente.tipo || "Ida";

      if(end < start) throw new Error("Data final não pode ser anterior à inicial.");

      // Horários: lê do próprio formulário (se preferir) ou peça ao operador criar campos HTML para hora
      const hIda  = _fc.getAttribute("cr40f_horarioida")?.getValue();     // HH:mm
      const hRet  = _fc.getAttribute("cr40f_horarioretorno")?.getValue(); // HH:mm

      for(let d=new Date(start); d<=end; d.setDate(d.getDate()+1)){
        const dow=d.getDay(); // 0 dom / 6 sáb
        if(incluirFDS || (dow!==0 && dow!==6)){
          const dia = d.toISOString().slice(0,10);
          if(hIda && (tipo==="Ida" || tipo==="Ida e Retorno")){
            items.push({
              tipo:"ida",
              dt: toISO(dia, hIda),
              origem, destino, trajeto, tipoServ, tipoVeic
            });
          }
          if(hRet && (tipo==="Retorno" || tipo==="Ida e Retorno")){
            items.push({
              tipo:"retorno",
              dt: toISO(dia, hRet),
              origem: destino, destino: origem, trajeto: invertTrajeto(trajeto), tipoServ, tipoVeic
            });
          }
        }
      }
    }

    return items;
  }

  async function createAll(items){
    // Campos comuns
    const commons = {
      cr40f_email: _fc.getAttribute("cr40f_email")?.getValue(),
      cr40f_cotao: _fc.getAttribute("cr40f_cotao")?.getValue(),
      cr40f_cr:    _fc.getAttribute("cr40f_cr")?.getValue(),
      cr40f_receber: _fc.getAttribute("cr40f_receber")?.getValue(),
      cr40f_passageirosetelefonedecontato: _fc.getAttribute("cr40f_passageirosetelefonedecontato")?.getValue(),
      cr40f_perfildopassageiro: _fc.getAttribute("cr40f_perfildopassageiro")?.getValue()
    };

    // Lookups (GUID via getValue()[0].id)
    function getGuid(name){
      const v = _fc.getAttribute(name)?.getValue(); if(!v) return null;
      const o = Array.isArray(v)?v[0]:v; return o?.id ? String(o.id).replace(/[{}]/g,"") : null;
    }
    const lookups = {
      cr40f_passageiro1: getGuid("cr40f_passageiro1"),
      cr40f_passageiro2: getGuid("cr40f_passageiro2"),
      cr40f_passageiro3: getGuid("cr40f_passageiro3"),
      cr40f_passageiro4: getGuid("cr40f_passageiro4"),
      cr40f_solicitante: getGuid("cr40f_solicitante"),
      cr40f_cliente:     getGuid("cr40f_cliente")
    };
    // Ajuste os entity set names se necessário:
    const setNames = {
      cr40f_passageiro1:"contacts",
      cr40f_passageiro2:"contacts",
      cr40f_passageiro3:"contacts",
      cr40f_passageiro4:"contacts",
      cr40f_solicitante:"contacts", // ou "accounts"
      cr40f_cliente:"accounts"
    };

    let ok=0, fail=0;
    for(const i of items){
      const data = {
        cr40f_endereodesada: i.origem,
        cr40f_destino:       i.destino,
        cr40f_trajeto:       i.trajeto,
        cr40f_dataehorriodesada: i.dt,                     // ISO
        cr40f_status:        202410001,                    // Confirmado (sem ponto)
        cr40f_tipodoservico: i.tipoServ,
        cr40f_tipodeveiculo: i.tipoVeic
      };
      Object.assign(data, commons);
      if(i.obsInt!==undefined) data.cr40f_observaointerna = i.obsInt;
      if(i.obsOp!==undefined)  data.cr40f_obsdeoperao     = i.obsOp;

      // Lookups bind
      Object.keys(lookups).forEach(f=>{
        const guid = lookups[f]; if(!guid) return;
        data[`${f}@odata.bind`] = `/${setNames[f]}(${guid})`;
      });

      try{
        await Xrm.WebApi.createRecord("cr40f_reservadeveculos", data);
        ok++;
      }catch(e){
        console.error("Create error:", e?.message||e);
        fail++;
      }
    }
    return {ok, fail};
  }

  // ==== Eventos do formulário ====
  async function onLoad(executionContext){
    _fc = executionContext.getFormContext();

    // Obter janela do web resource e injetar formContext
    const winPromise = getAssistantWindow();
    if(winPromise){
      _iframeWin = await winPromise;
      if(_iframeWin && _iframeWin.assistenteInit){
        _iframeWin.assistenteInit(_fc); // passa o formContext para o HTML
      }
    }

    // Registrar pós-salvar (criação dos serviços)
    _fc.data.entity.addOnPostSave(async function(){
      try{
        if(!_pendingOptions) return; // nada a fazer
        const items = buildItemsFromOptions(_pendingOptions);
        const res = await createAll(items);
        _pendingOptions = null; // limpa memória
        Xrm.Navigation.openAlertDialog({ text: `Concluído. Criados: ${res.ok}. Falhas: ${res.fail}.` });
      }catch(err){
        console.error("PostSave error:", err);
        Xrm.Navigation.openAlertDialog({ text: "Erro ao gerar serviços: " + (err.message || JSON.stringify(err)) });
      }
    });
  }

  async function onSave(executionContext){
    // Coletar opções do HTML na hora de salvar (um único botão, sem extras)
    if(_iframeWin && _iframeWin.assistenteGetOptions){
      _pendingOptions = _iframeWin.assistenteGetOptions();
    }
    // Não bloqueamos o save; deixamos o pós‑salvar criar os registros (ID garantido). [3](https://www.pragmatic-development.io/blog/calling-dataverse-custom-api-from-javascript/)
    return Promise.resolve();
  }

  return { onLoad:onLoad, onSave:onSave };
