<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net462</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <AssemblyName>Betinhos.DriverRecordSharing</AssemblyName>
    <RootNamespace>Betinhos.DriverRecordSharing</RootNamespace>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <Deterministic>true</Deterministic>
    <SignAssembly>true</SignAssembly>
    <AssemblyOriginatorKeyFile>DriverRecordSharing.snk</AssemblyOriginatorKeyFile>
  </PropertyGroup>

  <Target Name="ValidateStrongNameKey" BeforeTargets="BeforeBuild">
    <Error
      Condition="!Exists('$(MSBuildProjectDirectory)\DriverRecordSharing.snk')"
      Text="Strong-name key not found. Run .\generate-strong-name-key.ps1 inside plugins\DriverRecordSharing before building." />
  </Target>

  <ItemGroup>
    <PackageReference Include="Microsoft.CrmSdk.CoreAssemblies" Version="9.0.2.59" />
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies.net462" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>
</Project>
